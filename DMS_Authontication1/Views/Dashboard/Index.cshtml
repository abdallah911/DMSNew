@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/Dashboard.cshtml";
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 17 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}
<div class="dms-container reports">



    <style>
        .dms-container {
            height: 100%;
        }
    </style>
    <div class="portlet box mb-0 dms-container">

        <div class="dashboard-box px-0 mx-auto d-flex flex-wrap">
            <div class="dashboard-categories ">
                <ul>
                    <li class="side-cate "><a href="#" onclick="event.preventDefault(); loadScreen('_Live');"><img class="white" src="~/assets/global/img/Dashboard/dashboard-icon-white.svg" onclick="loadScreen('_Screen1')" /><img class="black" style="display:none;" src="~/assets/global/img/Dashboard/dashboard-icon-black.svg" onclick="loadScreen('_Screen1')" /> Live </a></li>
                    <li class="side-cate "><a href="#" onclick="event.preventDefault(); loadScreen('_Consumptions');"><i class="fas fa-reply" onclick="loadScreen('_Screen2')"></i>Consumptions</a></li>
                    <li class="side-cate "><a><img class="white" src="~/assets/global/img/Dashboard/leadership-icon-white.svg" /><img class="black" style="display:none;" src="~/assets/global/img/Dashboard/leadership-icon-black.svg" />Providers Consumptions</a></li>
                    <li class="side-cate "><a><i class="fas fa-tasks"></i>Consumptions Per Employees</a></li>
                    <li class="side-cate "><a><i class="fas fa-calendar-alt"></i>Consumptions Comparison</a></li>
                    @*<li><a><i class="fas fa-phone"></i>Contact</a></li>*@
                </ul>
            </div>

            <div class="dashboard-body" id="mainScreen">
               
            </div>
         
        </div>
    </div>

</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="https://cdn.amcharts.com/lib/4/core.js"></script>
<script src="https://cdn.amcharts.com/lib/4/themes/material.js"></script>
<script src="https://cdn.amcharts.com/lib/4/themes/animated.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>



<script src="~/Scripts/DMS/Dashbord.js?V=0.2"></script>
<script>
    $(document).ready(function () {
        $('.side-cate').on('click', function () {
            $('.side-cate').removeClass('active');  // إزالة الكلاس من الكل
            $(this).addClass('active');             // إضافة الكلاس للعنصر اللي اتضغط عليه
        });
    }); 
   
    function loadScreen(viewName) {
        $("#mainScreen").load("/Dashboard/LoadPartial?viewName=" + viewName, function () {
            if (viewName === "_Live")
                ChartLiveScreen();
            else if (viewName === "_Consumptions")
                ChartConsumptionsScreen();
        });
    }
    </script>