@model IEnumerable<DMS_Authontication1.Models.MedicineGroup>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}

<section class="container-fluid mt-4">
    <!--  New request -->
    <div class="row bg-overlay">
        <div style="position: relative"
             class="editeRquest fw-bold text-light">
            <div class="m-3 fs-3">
                <i class="fa fa-home me-3"></i>
                Medicine Groups
            </div>
            <div style=" position: absolute;right: 1%;top: 50%;transform: translateY(-50%);">
                <a id="Create" href="/MedicineGroups/Create" class="px-2 text-light border-0 mx-2 rounded-2" style="text-decoration: none;cursor: pointer;padding: 7.2px;">
                    <i class="fas fa-plus"></i> Create New
                </a>
            </div>
        </div>
    </div>
</section>

<div class="sios-bg w-100 m-auto px-4 my-4 pb-5">
    <div class="table-responsive">
        <table id="Index" class="table table-striped mt-3 text-center">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.GroupId)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.GroupName)
                    </th>
                    <th>
                        @Html.DisplayName("IsClosed")
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.GroupId)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.GroupName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.GroupType)
                        </td>
                        <td>
                            @Html.ActionLink("Edit", "Edit", new { id = item.GroupId }, htmlAttributes: new { @class = "py-2 px-3 rounded-1 text-light border-0" ,@style = "text-decoration: none; background: #717382" })
                            @*|@Html.ActionLink("Delete", "Delete", new { id = item.GroupId }, htmlAttributes: new { @class = "btn btn-danger" })*@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script>
    $(function () {
        $('#Index').dataTable();
    })
</script>
