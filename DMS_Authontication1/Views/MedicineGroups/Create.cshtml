@model DMS_Authontication1.Models.MedicineGroup

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<div class="sios-container">
    <section class="container-fluid mt-4">
        <!--  New request -->
        <div class="row bg-overlay">
            <div style="position: relative"
                 class="editeRquest fw-bold text-light">
                <div class="m-3 fs-3">
                    <i class="fa-solid fa-home me-1"></i>
                    Create Medicine Group
                </div>
            </div>
        </div>
    </section>
    <div id="home">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="container col-10 px-0 mt-4">
                <div style="white-space: nowrap" class="employee-form">
                    <div class="flex-column d-flex pe-5">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="forLabel row col-4 col-sm-6 col-md-8 mt-3">
                            @*@Html.LabelFor(model => model.GroupName, htmlAttributes: new { @class = "col-4 fs-5 fw-bold mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                            @Html.EditorFor(model => model.GroupName, new { htmlAttributes = new { @class = "admin-form-control col-12 col-sm-8 " } })
                            @Html.ValidationMessageFor(model => model.GroupName, "", new { @class = "text-danger" })
                            <span style="left:3px">Group Name</span>
                        </div>
                        <div class="forLabel row col-4 col-sm-6 col-md-8 mt-4">
                            @*@Html.Label("IsClosed", htmlAttributes: new { @class = "col-4 fs-5 fw-bold mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                            <select style="color: #000; font-size: 16px" class="admin-form-control fw-bold col-12 col-sm-8 col" id="GroupType" name="GroupType">
                                <option value="YES" class="fw-bold" style="color: #000">YES</option>
                                <option value="NO" class="fw-bold" style="color: #000">NO</option>
                            </select>
                            <span style="left:3px">is Closed</span>
                        </div>
                    </div>
                    <div class="  d-flex  gap-2 justify-content-center  mt-3 mt-sm-auto ">
                        <div class="position-relative ">
                            <i class="fa-solid fa-chevron-left position-absolute start-0 top-50 translate-middle text-white ms-3"></i>
                            <input id="Back" type="button" value="Back" onclick="window.location.replace('/MedicineGroups/index');" class="btn fw-bold text-white rounded-3 ps-4"
                                   style="text-decoration: none;  " /> 
                        </div>
                        <div class="position-relative ">
                            <i class="fa-solid fa-save position-absolute start-0 top-50 translate-middle text-white ms-3"></i>
                            <input id="submit" type="submit" value="Create" class="btn fw-bold text-white rounded-3 ps-4" />    
                        </div> 
                    </div>
                    <div class="mt-5 text-center">
                        
                    </div>
                </div>
                <div class="m-auto col-12 col-lg-4 my-4"></div>
            </div>
        }
    </div>
</div>
<script src="~/assets/NewDesignBackAdmin/JS/jquery.min.js"></script>

@if (ViewBag.exsit == "exsit")
{
    <script type="text/javascript">
        alert("This group is existed");
    </script>

}

