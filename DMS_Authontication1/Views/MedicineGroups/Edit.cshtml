@model DMS_Authontication1.Models.MedicineGroup

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<!-- start section -->
<div class="sios-container">
    <div class="sios-overlay container-fluid mt-4">
        <div class="container">
         
            <h3>   <i class="fa-solid fa-house me-3"></i>Edit Medicine Group</h3>
        </div>
    </div>

    <section class=" print-claim-section mt-5">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.GroupId)

            <div class="container">
                <div class="row mt-3">
                    <div class="row row-cols-sm-3 m-auto m-sm-0">
                        <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 w-100">
                            <div class="row col-12 col-md-2 my-auto">
                                @*@Html.LabelFor(model => model.GroupName, htmlAttributes: new { @class = "fw-bold" })*@
                            </div>
                            <div class="forLabel row col-12 col-md-6">
                                @Html.EditorFor(model => model.GroupName, new { htmlAttributes = new { @class = "admin-form-control", @style = "font-size: 16px" } })
                                @Html.ValidationMessageFor(model => model.GroupName, "", new { @class = "text-danger" })
                                <span style="left:3px"  >Group Name</span>
                            </div>
                        </div>
                        <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 mt-4 w-100">
                            <div class="row col-12 col-md-2 my-auto">
                                @*@Html.Label("IsClosed", htmlAttributes: new { @class = "fw-bold" })*@
                            </div>
                            <div class="forLabel row col-12 col-md-6">
                                <select style="color: #000; font-size: 16px" class="admin-form-control" id="GroupType" name="GroupType">
                                    <option value="YES" class="fw-bold" style="color: #000">YES</option>
                                    <option value="NO" class="fw-bold" style="color: #000">NO</option>
                                </select>
                                <span style="left:3px">Is Closed</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="print-claims-btns d-flex mt-3 justify-content-center">
                    <input id="Back" type="button" value="Back" onclick="window.location.replace('/MedicineGroups/index');" class="btn fw-bold text-white rounded-3"
                           style="text-decoration: none;    />
                    <input id="submit" type="submit" value="Update" class="btn fw-bold text-white rounded-3" />
                    @*<a href="./Management_Medicines_Groups_Management.html"
                           class="claims-search-btn ms-2 rounded-3; fs-5"
                           style="text-decoration: none; background-color: #717382">Back</a>
                        <button type="button "
                                value="Search"
                                class="claims-search-btn ms-2 rounded-3; fs-5"
                                >
                            Update
                        </button>*@
                </div>
            </div>
        }
    </section>
    <div style="display: flex; flex-direction: column">
        <section>
        </section>
    </div>
</div>
<script src="~/assets/NewDesignBackAdmin/JS/jquery.min.js"></script>
<script>
    $(function () {
        // $(' option:selected').val();
        $("#GroupType option").filter(function () {
            return $(this).text() == "@Model.GroupType";
        }).prop('selected', true);
    });

</script>
