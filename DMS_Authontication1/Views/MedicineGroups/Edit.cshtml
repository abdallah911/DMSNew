@model DMS_Authontication1.Models.MedicineGroup

@{
    ViewBag.Title = "Edit";
}
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="panel panel-info dms-container">
        <h2 class="panel-heading title-bg text-white fw-bold" style="margin:1px;">Edit Medicine Group</h2>
        <div class="panel-body">
            <div class="form-horizontal"  style="padding-left: 93px;">
   
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.GroupId)

                <div class="form-group">
                    @Html.LabelFor(model => model.GroupName, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.GroupName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.GroupName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("IsClosed", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        <select class="form-control" id="GroupType" name="GroupType">
                            <option value="YES">YES</option>
                            <option value="NO">NO</option>
                        </select>
                        @*@Html.EditorFor(model => model.GroupType, new { htmlAttributes = new { @class = "form-control" } })*@
                        @Html.ValidationMessageFor(model => model.GroupType, "", new { @class = "text-danger" })
                    </div>
                </div>

 
            </div>
        </div>
        <div class="panel-footer" style="text-align:right;">
            <input id="Back" type="button" value="Back" onclick="window.location.replace('/MedicineGroups/index');" class="btn btn-warning" />
            @*<input id="New" type="reset" value="Reset" class="btn btn-primary" />*@
            <input id="submit" type="submit" value="Update" class="btn btn-success" />
        </div>
    </div>
}

@*<div>
        @Html.ActionLink("Back to List", "Index")
    </div>*@
<script src="~/Scripts/jquery-3.0.0.min.js"></script>
<script>
    $(function () {
        // $(' option:selected').val();
        $("#GroupType option").filter(function () {
            return $(this).text() == "@Model.GroupType";
        }).prop('selected', true);
    });

</script>