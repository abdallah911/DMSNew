<div class="col-lg-12">
    <div class="col-sm-5" id="session_type" style=" padding:10px 20px">
        <div style="margin-top:60px">

            <div style="text-align : right ">

                @*first row*@

                <div>

                    <label class="control-label" id="session_style2">
                        <input id="Seession_Num" onkeyup="Accounting_Info()" type="text" placeholder="ادخل عدد الجلسات" style="text-align : center ; margin-right:10px" size="10" onkeypress="return /[0-9]/i.test(event.key)" />
                        عدد الجلسات
                    </label>

                    <label class="control-label" id="session_style2" style="margin-right:10px">
                        <select id="Specialist" class="search_categories" style="margin-right:10px ; margin-top:20px">
                            <option value="0" selected="selected">اختر التخصص</option>
                            <option value="1">علاج طبيعي</option>
                            <option value="2">اسنان</option>
                        </select>
                         التخصص
                    </label>

                    <label class="control-label" id="session_style2" style="margin-right:10px">
                        <input id="Doct_Name" type="text" placeholder="ادخل اسم الدكتور" style="text-align :center ; margin-right:10px ; margin-top:20px " size="15" readonly/>
                        اسم الدكتور
                    </label>

                </div>

                <br />

                @*second row*@
                <div>
                    <label class="control-label" id="session_style2">

                        <input type="text" id="Members_Num" class="" placeholder="ادخل عدد الاعضاء" style="text-align : center " onkeypress="return /[0-9]/i.test(event.key)" readonly/>
                        عدد الاعضاء

                    </label>

                    <label class="control-label" id="session_style2" style="margin-right:10px">
                        <input type="text" id="Seession_Price" onkeyup="Accounting_Info()" placeholder="ادخل السعر" style="text-align : center ; margin-right:10px ; margin-top:20px" size="10" onkeypress="return /[0-9]/i.test(event.key)" readonly />
                        سعر الجلسه
                    </label>

                </div>

                <br />

                @*Button*@
                <div style="text-align : center ; margin-top:25px ">

                    <input id="sub_Extend" type="button" value="حفظ" onclick="MyFunc_Extend()" class="btn btn-primary" style="padding:10px 20px" disabled="disabled" />

                </div>

            </div>

        </div>
    </div>

    <div class="col-sm-5" id="session_type" style=" padding:10px 20px">
        <div style="margin-top:60px">

            <div >
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                Code

                            </th>

                            <th>
                                Doctor Name
                            </th>
                            <th>
                                Doctor Specialist
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="table1">

                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-sm-2" style="text-align : right ">
        <div style="margin-top:60px">
            <div>
                <fieldset>
                    <legend>  اختر نوع الجلسه</legend>

                    <input id="NEW" style="margin-right:10px" type="checkbox" name="Medical_session" value="New"  onclick="return ValidatePetSelection();">
                    <label class="control-label" id="session_style">جلسه جديده</label><br>

                    <input id="OLD" style="margin-right:11px" type="checkbox" name="Medical_session" value="Old" onclick="return ValidatePetSelection2();">
                    <label class="control-label" id="session_style">جلسه قديمه</label><br>


                    <input id="EXTEND" style="margin-right:28px" type="checkbox" name="Medical_session" value="Extend" checked="checked" onclick="return ValidatePetSelection3();">
                    <label class="control-label" id="session_style">مد جلسه</label><br>


                </fieldset>
            </div>
        </div>
    </div>
</div>
