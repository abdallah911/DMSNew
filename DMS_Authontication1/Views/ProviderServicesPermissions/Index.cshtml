@*@model IEnumerable<DMS_Authontication1.Models.ProviderServicesPermission>*@

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}
<div class="portlet box  green">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa-solid fa-home me-1"></i>Provider Services Permissions
        </div>
        <div class="actions">
            <a id="Create" href="/ProviderServicesPermissions/Create" class="btn btn-success   btn-sm">
                <i class="fa fa-plus"></i> Create New
            </a>
        </div>
    </div>
    <br />
    <div class="portlet-body">
        <table id="Index" class="table">
            <thead>
                <tr>
                    <th>
                       ProviderName
                    </th>
                    <th>
                        Service Name
                    </th>
                    <th>
                        Active
                    </th>
                    <th>
                        CompId
                    </th>
                    <th>
                       ClassCode
                    </th>
                    <th>
                        CardId
                    </th>
                   
                    <th>
                        CreatedBy
                    </th>
                  
                    <th></th>
                </tr>
            </thead>
            <tbody>
               
            </tbody>
        </table>
    </div>
</div>
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script>
    $(function () {
        var id;
        $("#Index").DataTable({
            "sAjaxSource": '/ProviderServicesPermissions/ProviderServicesPermissionList',
            "bServerSide": true,
            "processing": true,
            "bFilter": true,
            "bSort": false,
            "pageLength": 10,
            "bInfo": true,
            "columns": [
                { "data": "ProviderName" },
                {
                    "data": "ServiceCode",
                    "mRender": function (data) {
                        if (data == 11601)
                        { return  "Daily"; }
                        else if (data == 11602) {
                            return  "Chronic";
                        }
                        else if (data == 11603) {
                            return  "Monthly";
                        }
                        else if (data == 11604) {
                            return  "Doctor";
                        }
                        else if (data == 11206) {
                            return  "Lab";
                        }
                        else if (data == 11201)
                        { return  "Ray"; }
                        else{
                            return data;
                        }
                    }
                },
                { "data": "IsActive"},
                { "data": "CompId" },
                { "data": "ClassCode"},
                { "data": "CardId" },
                { "data": "CreatedBy" },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        return '<a class="btn btn-warning" href="/ProviderServicesPermissions/Edit/' + data + '">Edit</a>';
                    }
                }
               

            ]
        });
    });



</script>
