@*@model IEnumerable<DMS_Authontication1.Models.ProviderServicesPermission>*@

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}

<section class="container-fluid mt-4">
    <!--  New request -->
    <div class="row bg-overlay">
        <div style="position: relative"
             class="editeRquest fw-bold text-light">
            <div class="m-3 fs-3">
                <i class="fa fa-home me-3"></i>
                User List
            </div>
            <div style=" position: absolute;right: 1%;top: 50%;transform: translateY(-50%);">
                <a href="/ProviderServicesPermissions/Create"
                   class="px-2 text-light border-0 mx-2 rounded-2"
                   style="
                  background: #83439b;
                  text-decoration: none;
                  cursor: pointer;
                  padding: 7.2px;">
                    <i class="fas fa-plus"></i>
                    Create New
                </a>
            </div>
        </div>
    </div>
</section>

<div class="w-100 m-auto px-4 mt-4 pb-5">
    <div class="table-responsive">
        <table id="Index" class="table table-striped mt-3 text-center">
            <thead>
                <tr>
                    <th>
                        ProviderName
                    </th>
                    <th>
                        Service Name
                    </th>
                    <th>
                        Active
                    </th>
                    <th>
                        CompId
                    </th>
                    <th>
                        ClassCode
                    </th>
                    <th>
                        CardId
                    </th>

                    <th>
                        CreatedBy
                    </th>

                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<script src="~/assets/NewDesignBackAdmin/JS/jquery.min.js"></script>
<script>
    $(function () {
        var id;
        $("#Index").DataTable({
            "sAjaxSource": '/ProviderServicesPermissions/ProviderServicesPermissionList',
            "bServerSide": true,
            "processing": true,
            "bFilter": true,
            "bSort": false,
            "pageLength": 10,
            "bInfo": true,
            "columns": [
                { "data": "ProviderName" },
                {
                    "data": "ServiceCode",
                    "mRender": function (data) {
                        if (data == 11601) { return "Daily"; }
                        else if (data == 11602) {
                            return "Chronic";
                        }
                        else if (data == 11603) {
                            return "Monthly";
                        }
                        else if (data == 11604) {
                            return "Doctor";
                        }
                        else if (data == 11206) {
                            return "Lab";
                        }
                        else if (data == 11201) { return "Ray"; }
                        else {
                            return data;
                        }
                    }
                },
                { "data": "IsActive" },
                { "data": "CompId" },
                { "data": "ClassCode" },
                { "data": "CardId" },
                { "data": "CreatedBy" },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        return '<a class="btn py-1 px-3 rounded-1 text-light border-0"style = "background: #717382;text-decoration: none;" href="/ProviderServicesPermissions/Edit/' + data + '">Edit</a>';
                    }
                }


            ]
        });
    });



</script>
