@model DMS_Authontication1.Models.Serv_Lab

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}



<section class="container-fluid mt-4">
    <!--  New request -->
    <div class="row bg-overlay">
        <div style="position: relative"
             class="editeRquest fw-bold text-light">
            <div class="m-3 fs-3">
                <i class="fa-solid fa-home me-1 me-3"></i>
                Edit Lab
            </div>
            <div style=" position: absolute;right: 1%;top: 50%;transform: translateY(-50%);">
                <a href="/LabsManagement"
                   class="btn fw-bold text-white rounded-3"
                   style="
                
                  text-decoration: none;
                  cursor: pointer;
                  padding: 7.2px;">
                    <i class="fas fa-list"></i>
                    Lab List
                </a>
            </div>
        </div>
    </div>
</section>
<section class="print-claim-section mt-5">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)
        <div class="container">
            <div class="row mt-3">
                <div class="row row-cols-sm-3 m-auto m-sm-0">
                    @if (User.IsInRole("Admin"))
                    {
                    <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 w-100 mt-4">
                        <div class="row col-12 col-md-2 my-auto">
                            @Html.LabelFor(m => m.DMS_CODE, new { @class = "fw-bold" })
                        </div>
                        <div class="row col-12 col-md-6">
                            @Html.EditorFor(model => model.DMS_CODE, new { htmlAttributes = new { @class = "chronic-form-control", @style = "font-size: 16px" } })
                            @Html.ValidationMessageFor(model => model.DMS_CODE, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    }
                    <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 w-100 mt-4">
                        <div class="row col-12 col-md-2 my-auto">
                            @Html.LabelFor(m => m.SERV_CODE, new { @class = "fw-bold" })
                        </div>
                        <div class="row col-12 col-md-6">
                            @Html.EditorFor(model => model.SERV_CODE, new { htmlAttributes = new { @class = "chronic-form-control", @style = "font-size: 16px" } })
                            @Html.ValidationMessageFor(model => model.SERV_CODE, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    
                    <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 w-100 mt-4">
                        <div class="row col-12 col-md-2 my-auto">
                            @Html.LabelFor(m => m.SERV_ANAME, new { @class = "fw-bold" })
                        </div>
                        <div class="row col-12 col-md-6">
                            @Html.EditorFor(model => model.SERV_ANAME, new { htmlAttributes = new { @class = "chronic-form-control", @style = "font-size: 16px" } })
                            @Html.ValidationMessageFor(model => model.SERV_ANAME, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 w-100 mt-4">
                        <div class="row col-12 col-md-2 my-auto">
                            @Html.LabelFor(m => m.SERV_AMOUNT, new { @class = "fw-bold" })
                        </div>
                        <div class="row col-12 col-md-6">
                            @Html.EditorFor(model => model.SERV_AMOUNT, new { htmlAttributes = new { @class = "chronic-form-control", @style = "font-size: 16px" } })
                            @Html.ValidationMessageFor(model => model.SERV_AMOUNT, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 mt-4 w-100">
                        <div class="row col-12 col-md-2 my-auto">
                            @Html.LabelFor(m => m.GRUOP_ID, new { @class = "fw-bold" })
                        </div>
                        <div class="row col-12 col-md-6">
                            @Html.DropDownList("GRUOP_ID", ViewBag.Groups as SelectList, "--Select--", new
                       {
                           @class = "chronic-form-control",
                           @style = "color: #000; font-size: 16px"
                       })
                        </div>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 mt-4 w-100">
                            <div class="row col-12 col-md-2 my-auto">
                                @Html.LabelFor(m => m.GRUOP_TYPE, new { @class = "fw-bold" })
                            </div>
                            <div class="row col-12 col-md-6">
                                @Html.DropDownList("GRUOP_TYPE", ViewBag.GroupType as SelectList, "--Select--", new { @class = "chronic-form-control", @style = "color: #000; font-size: 16px" })

                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="print-claims-btns d-flex gap-2 mt-5 justify-content-end">
                <input id="Back" type="button" value="Back" onclick="window.location.replace('/LabsManagement/index');" class="btn fw-bold text-white rounded-3" />
                @*<input id="New" type="reset" value="Reset" class="btn claims-search-btn ms-2 rounded-3; fs-5"  />*@
                <input id="submit1" type="submit" value="Update" class="btn fw-bold text-white rounded-3"/>

            </div>
        </div>
    }
</section>

