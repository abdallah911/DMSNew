<style>
    #ddlCard {
        margin-top: -55px;
        margin-left: 430px;
        width: 200px;
    }

    #ddlM_Code {
        margin-top: -55px;
        margin-left: 450px;
        width: 200px;
    }

    label {
        font-weight: normal;
    }

    span.error {
        display: block;
        visibility: hidden;
        color: red;
        font-size: 90%;
    }

    tr.error {
        background-color: rgba(255,0,0,0.35);
    }

    #PrescriptionDate[readonly] {
        background-color: white;
        cursor: pointer !important;
    }

    .btn span.glyphicon {
        opacity: 0;
    }

    .btn.active span.glyphicon {
        opacity: 1;
    }
</style>

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
