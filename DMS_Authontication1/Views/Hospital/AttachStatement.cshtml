
@{
    ViewBag.Title = "Hospital";
}

<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<style>
    .labeled-file-box div {
        justify-content: space-between;
    }

    .labeled-file-box input {
        width: 50%
    }
</style>

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

@Html.Partial("_Cards")
@Html.Partial("_Approvel")

<input type="text" id="max_amount0" value="" hidden="hidden" />

<!--Card Id Row-->
<div class="portlet box dms-container mb-0">
    <div class="portlet-title title-bg">
        <div class="caption text-white fw-bold">
            <i class="fa fa-hospital-o me-1"></i>Attach Statement
        </div>
    </div>
    <div class="portlet-body d-flex flex-wrap row-gap-2">
        <div class="forLabel col-12 col-sm-4">
            <input id="Date" type="text" class="  " required placeholder="" />
            <span>Select Month</span>
        </div>
        <div style="margin :0 14px;position:relative">
            <i class="fa fa-download position-absolute" style=" z-index: 5;color: white;top: 50%;transform: translateY(-50%);left: 8px;"></i>
            <input type="button" class="btn " style="padding-left: 26px; border-color: #337ab7 !important; " value="Download Excel" />
        </div>
        <div class="d-flex flex-wrap row-gap-2">
            <div class="labeled-file-box col-12 col-sm-4">
                <div>
                    <span style="padding-left:10px">Attach elmasia</span>
                    <input type="file" style="margin-right: 10px;" class="" />
                </div>
            </div>
            <div class="labeled-file-box col-12 col-sm-4">
                <div>
                    <span style="padding-left:10px">Attach DMS</span>
                    <input type="file" style="margin-right: 10px;" class="" />
                </div>
            </div>
            <div class="labeled-file-box col-12 col-sm-4">
                <div>
                    <span style="padding-left:10px">Attach Misr Insurance</span>
                    <input type="file" style="margin-right: 10px;" class="" />
                </div>
            </div>
        </div>

        <div style="padding-left: 16px;">
            <input type="button" class="btn " style="  border-color: #337ab7 !important; " value="Save" />
        </div>
    </div>
</div>
<script src="~/assets/HomeTemplete/js/intro.js"></script>
<script src="~/Scripts/DMS/HospitalSystem/Hospital.js?V=4.2"></script>

