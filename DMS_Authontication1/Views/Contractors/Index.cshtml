@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardHR.cshtml";

    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 48 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}



<div class="sios-container">
    <div class="">
        <p class="mx-4 my-0 py-3 d-flex gap-2">
            @if (fullcontroll || view)
            {
                @Html.ActionLink(" Company Contracts", "Index", null, htmlAttributes: new { @class = "btn action-btn active", @style = " text-transform: none" })
            }
            @if (fullcontroll || Create)
            {
                @Html.ActionLink(" Providers Contracts", "ProvidersIndex", null, htmlAttributes: new { @class = "btn action-btn ", @style = " text-transform: none" })
            }
        </p>
    </div>
    @if (fullcontroll || view)
    {
<div class="portlet box  green">
    <div class="row bg-overlay portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <i class="fa-solid fa-home me-1"></i> Search
        </div>
    </div>
    <div class="container mx-auto my-4 portlet-body">
        <input id="compname" type="text" value="@ViewBag.CompName" hidden="hidden" />
        <div class="row" style="padding-bottom: 15px;">
            @if (User.IsInRole("HR_Admin"))
            {

                <div class="col-sm-6 col-md-5 forLabel px-2 border-0 form-group" data-step="6" data-intro="Select Contract type Default is Contract">
                    @Html.DropDownList("CompanyNumber", ViewBag.company as SelectList, new { @class = "border-2 sios-form-control w-100 form-control", id = "CompanyNumber" })
                    <span class="start-0"></span>
                </div>

                <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                <script>
                    $(document).ready(function () {
                        $("#CompanyNumber").select2();
                    });
                </script>
            }
            <div class="col-sm-6 col-md-5 forLabel px-2 border-0 form-group" data-step="6" data-intro="Select Contract type Default is Contract">
                <select id="ddlType" class="border-2 sios-form-control w-100 form-control">
                    <option value="">Select Type</option>
                    <option value="Contract">Contract</option>
                    <option value="Endorsement ">Endorsement </option>
                </select>
                <span class="start-0"></span>

            </div>
        </div>
        <div class="container text-center text-sm-end px-4 mt-3 mb-4">
            <input id="resetSearch" type="button" value="Reset" onclick="ClearSearchData();" class="btn  " />
            <input id="adminSearch" type="button" value="Search" class="btn  " />
        </div>
    </div>
</div>

<div class="portlet box  green">
    <div class="row bg-overlay portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <i class="fa fa "></i>Company Contract
        </div>

    </div>

    <div class="portlet-body">

        <table class="ui celled table" id="Index" width="100%">
            <thead>
                <tr>
                    <th></th>
                </tr>
            </thead>
            <tbody id="contractImage"></tbody>

        </table>
    </div>
</div>
    }
    </div>
    <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

    <script>
    $(function () {
        var compNu = $("#compname").val();


        $("#CompanyNumber").change(function () {// class levels
            var compNu = $("#CompanyNumber").val();
            $("#compname").val(compNu);

        });

        $("#CompanyNumber").map(function () {// class levels
            var compNu = $("#CompanyNumber").val();
            $("#compname").val(compNu);
        });

        $('#adminSearch').click(function () {
            if ($("#compname").val() != "") {
                if ($("#ddlType").val() != "") {
                    $('#Index').dataTable().fnDestroy();
                    $("#Index").DataTable({
                        "sAjaxSource": '/Contractors/CompContractList?compId=' + $("#compname").val() + '&&Type=' + $("#ddlType").val(),
                        "bServerSide": true,
                        "processing": true,
                        "bFilter": false,
                        "bSort": false,
                        "pageLength": 1,
                        "bInfo": false,
                        "lengthChange": false,

                        "columns": [
                            {
                                "data": "path",
                                "mRender": function (data) {
                                    if ("@fullcontroll" == "True" || "@view" == "True") {
                                        return '<img style="width: 100%;height: 100%;background: #ccc;" src="' + data+'">';
                                    }
                                    else
                                        return '<input  data-id=' + data + '  hidden  /> ';
                                }
                            },


                        ]
                    });
                }
                else {
                    toastr.error("Please select Type")
                }
            }
            else {
                toastr.error("Please select company")
            }

        });
    })
    </script>
