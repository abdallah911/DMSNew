@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardHR.cshtml";

    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 48 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}


<div class="sios-container">
    <div class="">
        <p class="mx-4 my-0 py-3 d-flex gap-2">
            @if (fullcontroll || view)
            {
                @Html.ActionLink(" Company Contracts", "Index", null, htmlAttributes: new { @class = "btn action-btn  ", @style = " text-transform: none" })
            }
            @if (fullcontroll || Create)
            {
                @Html.ActionLink(" Providers Contracts", "ProvidersIndex", null, htmlAttributes: new { @class = "btn action-btn active ", @style = " text-transform: none" })
            }
        </p>
    </div>
    @if (fullcontroll || view)
    {
        <div class="portlet box  green">
           <div class="row bg-overlay portlet-title">
            <div class="m-3 fs-3 text-white caption">
                    <i class="fa-solid fa-home me-1"></i> Search
                </div>
            </div>
           <div class="portlet-body">
               <input id="compname" type="text" value="@ViewBag.CompName" hidden="hidden" />
               <div class="container mx-auto row row-cols-sm-2 row-cols-lg-3 row-gap-2 mt-4"  >
                   <div class="forLabel px-2 border-0 form-group" data-step="6" data-intro="Select Contract type Default is Contract">
                       @Html.DropDownList("Provider Type", ViewBag.provider as SelectList, "Select Provider Type", new { @class = "border-2 sios-form-control w-100 form-control", @id = "ProviderType" })
                       <span class="start-0"></span>

                   </div>
                   <div class="forLabel px-2 border-0 form-group" data-step="6" data-intro="Select Contract type Default is Contract">
                       @Html.DropDownList("Provider", new SelectList(""), " Select Provider Name", new
                  {
                      @class = "border-2 sios-form-control w-100 form-control",
                           @id = "Provider"
                  })
                       <span class="start-0"></span>

                   </div>
                   <div class="forLabel px-2 border-0 form-group" data-step="6" data-intro="Select Contract type Default is Contract">
                       <select id="ddlType" class="border-2 sios-form-control w-100 form-control">
                           <option value="">Select Type</option>
                           <option value="Contract">Contract</option>
                           <option value="Endorsement">Endorsement </option>
                       </select>
                       <span class="start-0"></span>

                   </div>
               </div>
               <div class="container d-flex gap-2 justify-content-center justify-content-sm-end px-4 mt-3 mb-4">
                   <input id="resetSearch" type="button" value="Reset" onclick="ClearSearchData();" class="btn " />
                   <input id="Print" type="button" value="Print" class="btn  " />
                   @*<input id="adminSearch" type="button" value="Search" class="btn btn-primary fa fa-search" />*@
               </div>
           </div>
        </div>

        <div class="portlet box  green">
            <div class="row bg-overlay portlet-title">
                <div class="m-3 fs-3 text-white caption">
                    <i class=" "></i>Company Contract
                </div>

            </div>

            <div class="portlet-body">

                <table class="ui celled table" id="Index" width="100%">
                    <thead>
                        <tr>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="contractImage"></tbody>

                </table>
            </div>
        </div>
    }
    </div>
    <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

    <script>
    $(function () {
        $("#ProviderType").change(function () {// class levels
            $.get("/Contractors/GetAproveder",
                { id: $("#ProviderType").val() }, function (data) {
                    $("#Provider").empty();
                    $("#Provider").append("<option value='0'>Select Provider</option>");

                    for (var i = 0; i < data.providerslist.length; i++) {
                        $("#Provider").append("<option value='" + data.providerslist[i].Value + "'>" + data.providerslist[i].Text + "</option>");
                    };
                    $("#Provider").select2();
                });

        });

        $('#adminSearch').click(function () {
            if ($("#ProviderType").val() != "") {
                if ($("#Provider").val() != "0") {
                    if ($("#ddlType").val() != "") {
                        $('#Index').dataTable().fnDestroy();
                        $("#Index").DataTable({
                            "sAjaxSource": '/Contractors/ProviderContractList?ProviderCode=' + $("#Provider").val() + '&&ProviderType=' + $("#ProviderType").val() + '&&Type=' + $("#ddlType").val(),
                            "bServerSide": true,
                            "processing": true,
                            "bFilter": false,
                            "bSort": false,
                            "pageLength": 1,
                            "bInfo": false,
                            "lengthChange": false,

                            "columns": [
                                {
                                    "data": "path",
                                    "mRender": function (data) {
                                        if ("@fullcontroll" == "True" || "@view" == "True") {
                                            return '<img style="width: 100%;height: 100%;background: #ccc;" src="' + data + '">';
                                        }
                                        else
                                            return '<input  data-id=' + data + '  hidden  /> ';
                                    }
                                },


                            ]
                        });
                    }
                    else {
                        toastr.error("Please select Type")
                    }
                }
                else {
                    toastr.error("Please select Provider ")
                }
            }
            else {
                toastr.error("Please select Provider Type")
            }

        });

        $('#Print').click(function () {
            var ProviderCode = $('#Provider').val();
            var ProviderType = $('#ProviderType').val();
            var Type = $('#ddlType').val();
            if (ProviderType!="") {
                if (ProviderCode != "") {
                    if (Type != "") {
                        window.open('/Contractors/Print?ProviderCode=' + ProviderCode + '&&ProviderType=' + ProviderType + '&&Type=' + Type);

                    }
                    else {
                        toastr.error('Please select Type');
                    }
                }
                else {
                    toastr.error('Please select Provider Name');
                }
            }
            else {
                toastr.error('Please select Provider Type');
            }

        });
    })
    </script>
