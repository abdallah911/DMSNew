<script>
    $(document).ready(function () { 
    });
    $(function () {
        $('#CardId').select2({
            placeholder: 'Search for a card',
            minimumInputLength: 5,
            ajax: {
                url: '/EmployeeRequest/GetActiveEmployess/',
                delay: 250,
                dataType: 'json',
                data: function (params) {
                    var query = {
                        search: params.term,
                        page: params.page || 1
                    }
                    return query;
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    var obj = {};
                    data.push(obj)
                    return {
                        results: data,//.results,
                        pagination: {
                            more: (params.page * 10) < data.count_filtered
                        }
                    };
                }
                // Additional AJAX parameters go here; see the end of this chapter for the full code of this example

            }
        });


    })

    $('#ClaimsData tbody').on('click', 'tr', function () {
        $('#ClaimsData tbody tr').removeClass('selected');
        $(this).addClass('selected');

        var claimNo = $(this).find('td').eq(0).text();
        GetClaimDetails(claimNo)
        //alert('Selected Claim No:' + claimNo);
        $('#CardInformationDetails').show();

    });


    function ClearSearchData() {
        $("#ServDateFrom").val("");
        $("#ServDateTo").val("");
        $("#RegDateFrom").val("");
        $("#RegDateTo").val("");
        $("#ApprovalNo").val("");
        $('#CardId').val(null).trigger('change');
        $("#InvoicNo").val("");
        $("#BatchNo").val("");

        $('#CardInformationDetails').hide();

        var table = $('#ClaimsData').DataTable({
            "pageLength": 5
        });
        table.clear().draw();
        table.destroy();

        var table2 = $('#ClaimDetails').DataTable({
            "pageLength": 5
        });
        table2.clear().draw();
        table2.destroy();

    }

    function GetClaim() {

        $('#CardInformationDetails').hide();

        var table = $('#ClaimsData').DataTable({
            "pageLength": 5
        });
        table.clear().draw();
        table.destroy();

        var table2 = $('#ClaimDetails').DataTable({
            "pageLength": 5
        });
        table2.clear().draw();
        table2.destroy();

        $('#list_div').hide();
        if ($("#CompNum").val() != "") {
            var compId = $("#CompNum").val();
            var servFrom = $("#ServDateFrom").val();
            var servTo = $("#ServDateTo").val();
            var regFrom = $("#RegDateFrom").val();
            var regTo = $("#RegDateTo").val();
            var aprovNo = $("#ApprovalNo").val();
            var cardId = $("#CardId").val();
            var invocNo = $("#InvoicNo").val();
            var batchNo = $("#BatchNo").val();

            $("#loading").css("display", "flex");

            $.ajax({
                url: '/ReviewClaims/GetClaims/',
                data: {
                    compId: compId, servFrom: servFrom, servTo: servTo, regFrom: regFrom, regTo: regTo,
                    aprovNo: aprovNo, cardId: cardId, invocNo: invocNo, batchNo: batchNo
                },
                dataType: 'Json',
                success: function (r) {
                    $('#ClaimsData').dataTable({
                        "pageLength": 5
                    }).fnDestroy();
                    if (r.msg == "ok") {
                        var setData = $("#ClaimsData Tbody");
                        setData.empty();
                        for (var i = 0; i < r.claimslist.length; i++) {
                            var data = "<tr >" +
                                "<td>" + r.claimslist[i].ClaimNo + "</td>";
                            if (r.claimslist[i].CreatedDate == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].CreatedDate + "</td>";
                            if (r.claimslist[i].ClaimDate == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].ClaimDate + "</td>";
                            //if (r.claimslist[i].ClaimDate == null)
                            //    data += "<td>--</td>";
                            //else
                            //    data += "<td>" + r.claimslist[i].ClaimDate + "</td>";

                            if (r.claimslist[i].CardNo == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].CardNo + "</td>";
                            if (r.claimslist[i].EmpName == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].EmpName + "</td>";

                            if (r.claimslist[i].ProvName == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].ProvName + "</td>";

                            if (r.claimslist[i].ProvType == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].ProvType + "</td>";
                            if (r.claimslist[i].Diagnosis == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].Diagnosis + "</td>";
                            if (r.claimslist[i].ServType == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].ServType + "</td>" +
                                    "</tr>";
                            setData.append(data);
                        }
                        $('#ClaimsData').DataTable({
                            "pageLength": 5
                        });
                        $('#list_div').show();

                         
                        $('html, body').animate({
                            scrollTop: $('#ClaimsData').offset().top
                        }, 'slow');
                    }
                    else {
                        alert(r.msg);
                    }

                },
                complete: function () {
                    $("#loading").hide();
                }
            });
        }
        else
            alert("Comp Id is empty");
    }

    function GetClaimDetails(clm) {

        $('#list_div2').hide();
        if (clm != "") {


            $("#loading").css("display", "flex");

            $.ajax({
                url: '/ReviewClaims/GetClaimDetails/',
                data: {
                    claimNo: clm
                },
                dataType: 'Json',
                success: function (r) {
                    $('#ClaimDetails').dataTable({
                        "pageLength": 5
                    }).fnDestroy();
                    if (r.msg == "ok") {
                        var setData = $("#ClaimDetails Tbody");
                        setData.empty();
                        for (var i = 0; i < r.claimslist.length; i++) {
                            var data = "<tr >" +
                                "<td>" + r.claimslist[i].Services + "</td>";

                            if (r.claimslist[i].SercvName == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].SercvName + "</td>";

                            if (r.claimslist[i].ClaimSubmitted == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].ClaimSubmitted + "</td>";

                            if (r.claimslist[i].OverInsurance == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].OverInsurance + "</td>";

                            if (r.claimslist[i].Discount == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].Discount + "</td>";

                            if (r.claimslist[i].ApprovAmount == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].ApprovAmount + "</td>";

                            if (r.claimslist[i].CopayAmt == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].CopayAmt + "</td>";

                            if (r.claimslist[i].AfterCopay == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].AfterCopay + "</td>";

                            if (r.claimslist[i].LocalAmount == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].LocalAmount + "</td>";

                            if (r.claimslist[i].ImportAmount == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].ImportAmount + "</td>";

                            if (r.claimslist[i].LocalDisc == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].LocalDisc + "</td>";

                            if (r.claimslist[i].ImportDisc == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].ImportDisc + "</td>";

                            if (r.claimslist[i].TotalDiscount == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].TotalDiscount + "</td>";

                            if (r.claimslist[i].Net == null)
                                data += "<td>--</td>";
                            else
                                data += "<td>" + r.claimslist[i].Net + "</td>" +
                                    "</tr>";
                            setData.append(data);
                        }
                        $('#ClaimDetails').DataTable({
                            "pageLength": 5
                        });
                        $('#list_div2').show();

                    }
                    else {
                        alert(r.msg);
                    }

                },
                complete: function () {
                    $("#loading").hide();
                }
            });
        }
        else
            alert("Comp Id is empty");
    }

    function PrintAllClaims() {
        if ($("#CompNum").val() != "") {

            var compId = $("#CompNum").val();
            var servFrom = $("#ServDateFrom").val();
            var servTo = $("#ServDateTo").val();
            var regFrom = $("#RegDateFrom").val();
            var regTo = $("#RegDateTo").val();
            var aprovNo = $("#ApprovalNo").val();
            var cardId = $("#CardId").val();
            var invocNo = $("#InvoicNo").val();
            var batchNo = $("#BatchNo").val();

            $("#loading").css("display", "flex");

            window.open('/ReviewClaims/PrintAllClaims?compId=' + compId +
                '&&cardId=' + cardId + '&&servFrom=' + servFrom + '&&servTo=' +
                servTo + '&&regFrom=' + regFrom + '&&regTo=' + regTo +
                '&&aprovNo=' + aprovNo + '&&invocNo=' + invocNo + '&&batchNo=' + batchNo);

            $("#loading").hide();
        }
        else
            alert('Comp Id is empty')
    }

   
</script>

