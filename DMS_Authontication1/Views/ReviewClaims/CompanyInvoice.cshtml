                    servTo + '&&regFrom=' + regFrom + '&&regTo=' + regTo +
                    '&&aprovNo=' + aprovNo + '&&invocNo=' + invocNo + '&&batchNo=' + batchNo);

                $("#loading").hide();
            }
            else
                alert('Comp Id is empty')
        }

