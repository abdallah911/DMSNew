    function GoToClaimsScreen(RegFrom, RegTo, ServFrom, ServTo, batchNumber, providerID, providerName, invoiceNumber, compNumber, compName) {
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("BatchReview", "ReviewClaims")';  // Specify your controller and action

        // Add hidden inputs for each parameter
        var RegFromInput = document.createElement('input');
        RegFromInput.type = 'hidden';
        RegFromInput.name = 'RegFrom';
        RegFromInput.value = RegFrom;
        form.appendChild(RegFromInput);

        var RegToInput = document.createElement('input');
        RegToInput.type = 'hidden';
        RegToInput.name = 'RegTo';
        RegToInput.value = RegTo;
        form.appendChild(RegToInput);

        var ServFromInput = document.createElement('input');
        ServFromInput.type = 'hidden';
        ServFromInput.name = 'ServFrom';
        ServFromInput.value = ServFrom;
        form.appendChild(ServFromInput);

        var ServToInput = document.createElement('input');
        ServToInput.type = 'hidden';
        ServToInput.name = 'ServTo';
        ServToInput.value = ServTo;
        form.appendChild(ServToInput);

        var batchNumberInput = document.createElement('input');
        batchNumberInput.type = 'hidden';
        batchNumberInput.name = 'batchNumber';
        batchNumberInput.value = batchNumber;
        form.appendChild(batchNumberInput);

        var providerIDInput = document.createElement('input');
        providerIDInput.type = 'hidden';
        providerIDInput.name = 'providerID';
        providerIDInput.value = providerID;
        form.appendChild(providerIDInput);

        var providerNameInput = document.createElement('input');
        providerNameInput.type = 'hidden';
        providerNameInput.name = 'providerName';
        providerNameInput.value = providerName;
        form.appendChild(providerNameInput);

        var invoiceNumberInput = document.createElement('input');
        invoiceNumberInput.type = 'hidden';
        invoiceNumberInput.name = 'invoiceNumber';
        invoiceNumberInput.value = invoiceNumber;
        form.appendChild(invoiceNumberInput);

        var compNumberInput = document.createElement('input');
        compNumberInput.type = 'hidden';
        compNumberInput.name = 'compNumber';
        compNumberInput.value = compNumber;
        form.appendChild(compNumberInput);

        var compNameInput = document.createElement('input');
        compNameInput.type = 'hidden';
        compNameInput.name = 'compName';
        compNameInput.value = compName;
        form.appendChild(compNameInput);

        // Append the form to the body and submit it to open in a new tab
        document.body.appendChild(form);
        form.target = '_blank';  // This ensures the form is submitted in a new tab
        form.submit();
    }
