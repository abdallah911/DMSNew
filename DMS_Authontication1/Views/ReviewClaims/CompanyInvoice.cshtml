    function PrintBatchReviewReport() {

        var invocNo = $('#InvoicNumber').val();
        var compNo = $('#CompNumber').val();

        var servFrom = $("#ServDateFrom").val();
        var servTo = $("#ServDateTo").val();
        var regFrom = $("#RegDateFrom").val();
        var regTo = $("#RegDateTo").val();
        var batchNo = $("#BatchNo").val();

        var typ = 1;
        if (compNo != "" && invocNo != "") {
            if ($("#excel2").is(":checked"))
                typ = 2;

            window.open('/ReviewClaims/PrintBatchReviewReport?compNo=' + compNo +
                '&&invocNo=' + invocNo + '&&servFrom=' + servFrom + '&&servTo=' + servTo +
                '&&regFrom=' + regFrom + '&&regTo=' + regTo +
                '&&batchNo=' + batchNo + '&&typ=' + typ);
        }
        else
            alert("Comp Id Or Invoice no is empty");
    }
</script>

