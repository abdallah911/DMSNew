<script>

        $(function () {
            $('#CardId').select2({
                placeholder: 'Search for a card',
                minimumInputLength: 5,
                ajax: {
                    url: '/EmployeeRequest/GetActiveEmployess/',
                    delay: 250,
                    dataType: 'json',
                    data: function (params) {
                        var query = {
                            search: params.term,
                            page: params.page || 1
                        }
                        return query;
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        var obj = {};
                        data.push(obj)
                        return {
                            results: data,//.results,
                            pagination: {
                                more: (params.page * 10) < data.count_filtered
                            }
                        };
                    }
                    // Additional AJAX parameters go here; see the end of this chapter for the full code of this example

                }
            });


        })

        $('#InvoiceData tbody').on('click', 'tr', function () {
            $('#InvoiceData tbody tr').removeClass('selected');
            $(this).addClass('selected');

            $('#InvoicNumber').val("");
            $('#CompNumber').val("");
            $('#CompName').val("");

            var compNo = $(this).find('td').eq(0).text();
            var compName = $(this).find('td').eq(1).text();
            var invocNo = $(this).find('td').eq(8).text();

            $('#InvoicNumber').val(invocNo);
            $('#CompNumber').val(compNo);
            $('#CompName').val(compName);

            GetAllBatch(compNo, invocNo);


        });


        function ClearSearchData() {
            $("#ServDateFrom").val("");
            $("#ServDateTo").val("");
            $("#RegDateFrom").val("");
            $("#RegDateTo").val("");
            $("#ApprovalNo").val("");
            $('#CardId').val(null).trigger('change');
            $("#InvoicNo").val("");
            $("#BatchNo").val("");

            $('#InvoicNumber').val("");
            $('#CompNumber').val("");
            $('#CompName').val("");

            var table = $('#InvoiceData').DataTable();
            table.clear().draw();
            table.destroy();

            var table2 = $('#BatchDetails').DataTable();
            table2.clear().draw();
            table2.destroy();

            $("#pdf").prop("checked", false);
            $("#excel").prop("checked", false);
            $("#pdf2").prop("checked", false);
            $("#excel2").prop("checked", false);

        }

        function GetCompanyInvoices() {

            var table = $('#InvoiceData').DataTable();
            table.clear().draw();
            table.destroy();

            var table2 = $('#BatchDetails').DataTable();
            table2.clear().draw();
            table2.destroy();

            $('#list_div').hide();


            var compId = $("#CompNum").val();
            var servFrom = $("#ServDateFrom").val();
            var servTo = $("#ServDateTo").val();
            var regFrom = $("#RegDateFrom").val();
            var regTo = $("#RegDateTo").val();
            var invocNo = $("#InvoicNo").val();
            var batchNo = $("#BatchNo").val();

            $("#loading").css("display", "flex");

            $.ajax({
                url: '/ReviewClaims/GetCompanyInvoice/',
                data: {
                    compId: compId, servFrom: servFrom, servTo: servTo, regFrom: regFrom, regTo: regTo,
                    invocNo: invocNo, batchNo: batchNo
                },
                dataType: 'Json',
                success: function (r) {
                    $('#InvoiceData').dataTable({
                        "pageLength": 5
                    }).fnDestroy();
                    if (r.msg == "ok") {
                        var setData = $("#InvoiceData Tbody");
                        setData.empty();
                        for (var i = 0; i < r.invoicelist.length; i++) {
                            //var data = "<tr>" +
                            //    "<td>" + (r.invoicelist[i].CompId || "--") + "</td>" +
                            //    "<td>" + (r.invoicelist[i].CompName || "--") + "</td>" +
                            //    "<td>" + (r.invoicelist[i].StartDate || "--") + "</td>" +
                            //    "<td>" + (r.invoicelist[i].EndDate || "--") + "</td>" +
                            //    "<td>" + (r.invoicelist[i].CountOfClaim || "--") + "</td>" +
                            //    "<td>" + (r.invoicelist[i].Gross || "--") + "</td>" +
                            //    "<td>" + (r.invoicelist[i].Net || "--") + "</td>" +
                            //    "<td>" + (r.invoicelist[i].InvoiceNo || "--") + "</td>" +
                            //    "</tr>";
                            var data = `
                                        <tr>
                                            <td class="text-center">${r.invoicelist[i].CompId || "--"}</td>
                                            <td class="text-center">${r.invoicelist[i].CompName || "--"}</td>
                                            <td class="text-center">${r.invoicelist[i].StartDate || "--"}</td>
                                            <td class="text-center">${r.invoicelist[i].EndDate || "--"}</td>
                                            <td class="text-center">${r.invoicelist[i].CountOfBatch || "--"}</td>
                                            <td class="text-center">${r.invoicelist[i].CountOfClaim || "--"}</td>
                                            <td class="text-center">${r.invoicelist[i].Gross || "--"}</td>
                                            <td class="text-center">${r.invoicelist[i].Net || "--"}</td>
                                            <td class="text-center">${r.invoicelist[i].InvoiceNo || "--"}</td>
                                        </tr>`;
                            setData.append(data);
                        }
                        $('#InvoiceData').DataTable({
                            "pageLength": 5
                        });
                        $('#list_div').show();


                        $('html, body').animate({
                            scrollTop: $('#MainScreenClaims').offset().top
                        }, 'slow');
                    }
                    else {
                        alert(r.msg);
                    }

                },
                complete: function () {
                    $("#loading").hide();
                }
            });
        }

        function GetAllBatch(compNo, invocNo) {

            $('#list_div2').hide();
            if (compNo != "" && invocNo != "") {

               
                var servFrom = $("#ServDateFrom").val();
                var servTo = $("#ServDateTo").val();
                var regFrom = $("#RegDateFrom").val();
                var regTo = $("#RegDateTo").val();               
                var batchNo = $("#BatchNo").val();

                $("#loading").css("display", "flex");

                $.ajax({
                    url: '/ReviewClaims/GetBatchDetails/',
                    data: {
                        compNo: compNo, invocNo: invocNo, servFrom: servFrom, servTo: servTo,
                        regFrom: regFrom, regTo: regTo, batchNo: batchNo
                    },
                    dataType: 'Json',
                    success: function (r) {
                        $('#BatchDetails').dataTable().fnDestroy();
                        if (r.msg == "ok") {
                            var setData = $("#BatchDetails Tbody");
                            setData.empty();
                            for (var i = 0; i < r.batchlist.length; i++) {
                                var data = `
                                        <tr>
                                            <td class="text-center">${r.batchlist[i].BatchNumber || "--"}</td>
                                            <td class="text-center">${r.batchlist[i].ProviderID || "--"}</td>
                                            <td class="text-center">${r.batchlist[i].ProviderName || "--"}</td>
                                            <td class="text-center">${r.batchlist[i].ProviderType || "--"}</td>
                                            <td class="text-center">${r.batchlist[i].CountOfClaim || "--"}</td>
                                            <td class="text-center">${r.batchlist[i].Gross || "--"}</td>
                                            <td class="text-center">${r.batchlist[i].Net || "--"}</td>
                                            <td class="text-center">
                                                 <button class="btn btn-primary"
                                                    onclick="GoToClaimsScreen('${$('#RegDateFrom').val()}', '${$('#RegDateTo').val()}', '${$('#ServDateFrom').val()}','${$('#ServDateTo').val()}',
                                                    '${r.batchlist[i].BatchNumber}', '${r.batchlist[i].ProviderID}', '${r.batchlist[i].ProviderName}',
                                                    '${$('#InvoicNumber').val()}', '${$('#CompNumber').val()}', '${$('#CompName').val()}')">
                    View Claims
                </button>
            </td>
                                        </tr>`;
                                setData.append(data);
                            }
                            $('#BatchDetails').DataTable();
                            $('#list_div2').show();

                        }
                        else {
                            alert(r.msg);
                        }

                    },
                    complete: function () {
                        $("#loading").hide();
                    }
                });
            }
            else
                alert("Comp Id Or Invoice no is empty");
    }


