@model DMS_Authontication1.Models.ProposalClass

@{
    ViewBag.Title = "Create";
}




@using (Html.BeginForm("Create", "ProposalClasses", FormMethod.Post))
{@Html.AntiForgeryToken()
<div class="panel panel-info">
    <h2 class="panel-heading" style="margin:1px;text-align:center ">Create class</h2>
</div>
<div class="panel-body panel-info">
    <div class="row">


        <div asp-validation-summary="ModelOnly" class="text-align-reverse">

            <div class="form-group row">
                <div class=" col-lg-offset-4">
                    @Html.LabelFor(model => model.ClassCode, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-3">
                        @Html.DropDownList("ClassCode", null, "Please select", htmlAttributes: new { @class = "form-control col-md-2 " })
                        @Html.ValidationMessageFor(model => model.ClassCode, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row ">
                <div class="form-group col-lg-offset-1">
                    <div class="form-group ">
                        @Html.LabelFor(model => model.NumMale, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="  col-md-3">
                            @Html.EditorFor(model => model.NumMale, new { htmlAttributes = new { @class = "form-control  " } })
                            @Html.ValidationMessageFor(model => model.NumMale, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="form-group col-lg-offset-1 ">
                    <div class="form-group">
                        @Html.LabelFor(model => model.NumFemael, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            @Html.EditorFor(model => model.NumFemael, new { htmlAttributes = new { @class = "form-control " } })
                            @Html.ValidationMessageFor(model => model.NumFemael, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>


            <div class="row">
                <div class="form-group col-lg-offset-1">
                    <div class="form-group ">
                        @Html.LabelFor(model => model.NumChronic, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            @Html.EditorFor(model => model.NumChronic, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.NumChronic, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="form-group col-lg-offset-1">
                    <div class="form-group">
                        @Html.LabelFor(model => model.TotalChronic, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            @Html.EditorFor(model => model.TotalChronic, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.TotalChronic, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-offset-1">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Premium, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            @Html.EditorFor(model => model.Premium, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Premium, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="form-group col-lg-offset-1">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Max, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            @Html.EditorFor(model => model.Max, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Max, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            @if (ViewBag.Age != null)
            {
                <div class="row">
                    <div class="form-group col-lg-offset-1">
                        <div class="form-group">
                            @Html.LabelFor(model => model.AgeFrom, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-2">
                                @Html.EditorFor(model => model.AgeFrom, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.AgeFrom, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-1">
                                <select name="AgeFromType" class="form-select form-select-sm" aria-label=".form-select-sm example">
                                    <option selected>Select</option>
                                    <option value="Day">Day</option>
                                    <option value="Month">Month</option>
                                    <option value="Year">Year</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-lg-offset-1">
                        <div class="form-group">
                            @Html.LabelFor(model => model.AgeTo, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-2">
                                @Html.EditorFor(model => model.AgeTo, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.AgeTo, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-1">
                                <select name="AgeToType" class="form-select form-select-sm" aria-label=".form-select-sm example">
                                    <option selected>Select</option>
                                    <option value="Day">Day</option>
                                    <option value="Month">Month</option>
                                    <option value="Year">Year</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="row">
                @if (ViewBag.Branch != null)
                {
                    <div class="form-group col-lg-offset-1">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Branch, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.EditorFor(model => model.Branch, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Branch, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>}
                @if (ViewBag.Gender != null)
                {
                    <div class="form-group col-lg-offset-1">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Gender, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                <div class="col-md-8">
                                    <select name="Gender" class="form-select form-select-sm" aria-label=".form-select-sm example">
                                        <option selected>Select Gender</option>
                                        <option value="0">Male</option>
                                        <option value="1">Female</option>
                                        <option value="2">Male and Female</option>
                                    </select>
                                </div>
                                @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>}
            </div>
            @*end*@
        </div>

    </div>
    <div class="panel-footer" style="margin-top:20px; text-align:center;">

        <input id="submit" type="submit" value="Save" class="btn btn-success" /> |
        <a class="btn btn-outline-info" asp-action="Index">Back</a>
        @if (ViewBag.Relations != null)
        {<i> | </i> <a class="btn btn-outline-info" asp-action="Index">Back</a>}


    </div>
</div>

}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
