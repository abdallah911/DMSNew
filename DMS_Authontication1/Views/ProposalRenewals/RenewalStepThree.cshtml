    // Select the element with the 'spacing' class
    var spacingElement = document.querySelector(".spacing");
            $(document).ready(function () {
                // Get all checkboxes with the class 'form-check-input'
                var checkboxes = $(".form-check-input");

                checkboxes.each(function () {
                    // Add an event listener to each checkbox
                    $(this).on("change", function () {
                        // Get the target input ID from the 'data-target' attribute
                        var targetInputId = $(this).attr("data-target");

                        // Get the target input element
                        var targetInput = $("#" + targetInputId);

                        // Disable or enable the input based on the checkbox state
                        targetInput.prop("disabled", !$(this).prop("checked"));
                    });
                });

                // Check the checkboxes on document ready
                checkboxes.each(function () {
                    $(this).trigger("change");
                });
            });
            $(document).ready(function () {
                // Add event listener to all radio buttons
                $(".radio-no").change(function () {
                    // Find the sibling input and disable/enable based on the radio button state
                    $(this).siblings(".dynamic-input").prop("disabled", this.checked);
                });
            });

    function toggleContent() {
        // Get the window width
        var windowWidth =
            window.innerWidth ||
            document.documentElement.clientWidth ||
            document.body.clientWidth;

        // Check if the window width is less than 600
        if (windowWidth < 600) {
            // If true, delete the content inside the 'spacing' div
            if (spacingElement) {
                spacingElement.innerHTML = "";
            }
        } else {
            // If false, restore the original content
            if (spacingElement) {
                spacingElement.innerHTML =
                    "                                                                                                              ";
            }
        }
    }

    // Call the function on page load and resize
    window.onload = toggleContent;
    window.onresize = toggleContent;
    function clearForm() {
        // Replace 'yourFormId' with the actual ID of your form
        var form = document.getElementById('ProposalThirdForm');

        // Reset the form
        form.reset();
    }
    function submitForm(paramValue) {
        var form = document.getElementById('ProposalThirdForm');
        form.action = '/ProposalMain/ProposalStepThreeCreate?BackOrForwardOrMain=' + encodeURIComponent(paramValue);
        form.submit();
    }
    function goToIndex() {
        window.location.href = '/ProposalMain/Index';
    }
    function updateFileNameLabel(input, labelId) {
        if (input.files.length > 0) {
            var fileName = input.files[0].name;
            $("#" + labelId).text(fileName);
        }
    }
