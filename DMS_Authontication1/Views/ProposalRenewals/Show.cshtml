@using DMS_Authontication1.Models;
@using Microsoft.AspNet.Identity;
@model List<RenewalMain>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Proposal.cshtml";
    var currentUserId = User.Identity.GetUserId();
}

@section Styles {
    <link rel="stylesheet" href="~/ProposalAssets/CSS/broker.css" />
}

<!-- ////////////// Main Content ////////////// -->
<div style="display: flex; flex-direction: column; min-height: 90vh">
    <div class="bg-grid-container">
        <div class="flex-container" dir="rtl">
            <div class="part1">
                <div class="part1-1">
                    @using (Html.BeginForm("Index", "ProposalRenewals", FormMethod.Post, new { style = "display: flex; justify-content: center;" }))
                    {

                        <div class="search-cont">
                            <div style="width: 250px; position: relative; display: flex; justify-content: center; height: 90px; align-items: center; flex-wrap: wrap;  ">
                                <input type="text" id="searchInput" placeholder="الكود أو الإسم" style="width: 100%;" name="SearchValue" value="@ViewBag.SearchValue" />
                                <div class="position-absolute d-flex gap-2" style=" left: 5%; top: 24%; transform: translateY(-50%)">
                                    <label for="search-submit">
                                        <i style=" " class="fas fa-search"></i>
                                    </label>
                                    <label for="clearSearch">
                                        <i style=" " class="fas fa-remove"></i>
                                    </label>
                                </div>


                                <button type="button" hidden id="clearSearch">Clear</button>
                                <input id="search-submit" hidden type="Submit" value="بحث برقم الكود الإسم" />
                                <div class="  col">
                                    <div class="date-inp d-flex gap-4 mt-3">
                                        <input class="date-input action-form"
                                               type="text"
                                               id="inputformDate"
                                               name="startDate"
                                               placeholder="من تاريخ" />
                                        <input class="date-input action-form"
                                               type="text"
                                               id="inputToDate"
                                               name="endDate"
                                               placeholder="الى تاريخ" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    }

                    <div class="newDataDiv">
                        @Html.ActionLink("جديد +", "Index", "ProposalRenewals", new { }, new { @class = "newDataBtn", style = "text-decoration:none;" })

                        @*<span class="newDataBtn" onclick="openForm()">جديد +</span>*@
                    </div>
                </div>


                <div class="part1-2">
                    <div class="grey-background">
                        @if (Model?.Count() > 0)
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        @*<th scope="col">ت</th>*@
                                        <th scope="col">كود العملية</th>
                                        <th scope="col">رقم الشركة</th>
                                        <th scope="col">رقم العقد</th>
                                        <th scope="col">عدد الفئات</th>
                                        <th scope="col">عدد الموظفين</th>
                                        @*<th scope="col">المنشئ</th>*@
                                        <th scope="col">تاريخ الإنشاء</th>

                                        <th scope="col">تعديل</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                    <tr>


                                        <td dir="ltr"  style="display:none;">@item.Id</td>
                                        <td dir="ltr">@item.Code</td>
                                        <td dir="ltr">@item.CompId</td>
                                        <td dir="ltr">@item.ContractNo</td>
                                        <td dir="ltr">@item.ClassCount</td>
                                        <td dir="ltr">@item.EmpCount</td>
                                        <td dir="ltr"  style="display:none;">@item.UserId</td>
                                        <td dir="ltr">@item.CreatedDate</td>

                                        <td>
                                            @*@Html.ActionLink("تعديل", "RenewalStepTwoShow", "ProposalRenewals", new { mainId = @item.Id, CompId = @item.CompId, ContractNo = @item.ContractNo, countCat = @item.ClassCount, typeAction = 2 }, new { style = "text-decoration:none;color: #fff; background: #6e7085;padding: 10px 30px;border-radius: 10px;font-weight: var(--font - bold);font-size: 18px;box-shadow: 0 0 2px #14061b4d;cursor: pointer; " })*@
                                            @*@Html.ActionLink("تعديل", "SaveData2", "ProposalRenewals", new { model = @item }, new { style = "text-decoration:none;color: #fff; background: #6e7085;padding: 10px 30px;border-radius: 10px;font-weight: var(--font - bold);font-size: 18px;box-shadow: 0 0 2px #14061b4d;cursor: pointer; " })*@

                                            @using (Html.BeginForm("SaveData2", "ProposalRenewals", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()

                                                @Html.Hidden("model.Code", item.Code)
                                                @Html.Hidden("model.CompId", item.CompId)
                                                @Html.Hidden("model.ContractNo", item.ContractNo)
                                                @Html.Hidden("model.ClassCount", item.ClassCount)
                                                @Html.Hidden("model.EmpCount", item.EmpCount)
                                                @Html.Hidden("model.CreatedDate", item.CreatedDate)
                                                @Html.Hidden("model.Id", item.Id)
                                                @Html.Hidden("model.UserId", item.UserId)

                                                <button type="submit" style="text-decoration:none;color: #fff; background: #6e7085;padding: 10px 30px;border-radius: 10px;font-weight: var(--font - bold);font-size: 18px;box-shadow: 0 0 2px #14061b4d;cursor: pointer;">تعديل</button>
                                            }
                                        </td>


                                        @*@if (currentUserId == item.UserId)
                                        {
                                            <td>
                                                @Html.ActionLink("تعديل", "Edit", "ProposalMain", new { id = @item.Id }, new { style = "text-decoration:none;color: #fff; background: #6e7085;padding: 10px 30px;border-radius: 10px;font-weight: var(--font - bold);font-size: 18px;box-shadow: 0 0 2px #14061b4d;cursor: pointer; " })
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <a class="btn" style="white-space: nowrap;text-decoration: none; color: #fff; background: #6e7085; padding: 10px 30px; border-radius: 10px; font-weight: var(--font - bold); font-size: 18px; box-shadow: 0 0 2px #14061b4d; cursor: pointer; ">غير مسموح</a>

                                            </td>
                                        }*@


                                    </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <h3>لا يوجد عروض!</h3>
                            </div>
                        }
                    </div>
                </div>


            </div>
            <div class="part2"></div>
        </div>

    </div>
</div>
@section Scripts{

    @if (TempData["UnauthorizedEditMessage"] != null)
    {
        <script>
        alert('@TempData["UnauthorizedEditMessage"]');
        </script>
    }
    <script>
    $(document).ready(function () {
        var successMessage = '@ViewBag.SuccessMessage';
        if (successMessage) {
            // Use the JavaScript alert function to display the message
            alert(successMessage);
        }
        // Set the value of the search input on document ready
        $("#searchInput").val("@ViewBag.SearchValue");

        // Handle click event for clear button
        $("#clearSearch").click(function () {
        // Clear the search input
        $("#searchInput").val("");

        // Submit the form to show all data
        $("#search-submit").click();
        });
        });
    </script>
}
