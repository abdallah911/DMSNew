                <div class="pool-field-box mb-2" style="padding-bottom: 30px;">
                    <div class="pool-field shadow-sm py-3 px-2  " style="height:50px;">

                        <h6 class=" sios-color fw-bold">Loss Ratio</h6>
                    </div>
                    <div class="pool-field py-2 shadow-sm position-relative" style="height:50px;">
                        <div class="inputs w-100">
                            <div class="forLabel" style="width: 20%; margin-right: 5%;">
                                <input class="sios-form-control  w-100  border-0 " disabled>
                                <span>expected Loss Ratio</span>
                            </div>
                            <div class="forLabel" style=" width: 20%;   margin-right: 5%;  ">
                                <input class="sios-form-control  w-100  border-0 " disabled>
                                <span>Loss Ratio</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="pool-field-box mb-2 ">
                    <div class="pool-field p-2 py-3 position-relative">
                        <div class="inputs w-100">
                            <div class="forLabel" style="width: 20%; margin-right: 5%;">
                                <input class="sios-form-control  w-100  border-0 ">
                                <span>مصاريف ادارية</span>
                            </div>
                            <div class="forLabel" style=" width: 20%;   margin-right: 5%;  ">
                                <input class="sios-form-control  w-100  border-0 ">
                                <span>مصاريف الإصدار</span>
                            </div>
                        </div>
                        <h6 class="sios-color fw-bold">Expenses</h6>

