                    <input disabled="" id="disabled" style="height: 50px; color:#000;" class="sios-form-control home-input col ps-2 bg-white pb-2  sios-color" type="text">
                    <span class=" sios-color position-absolute top-50 translate-middle-y fw-bold " style="left:10px;">Broker</span>
