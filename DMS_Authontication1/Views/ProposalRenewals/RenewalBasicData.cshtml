@using DMS_Authontication1.Models;
@using Microsoft.AspNet.Identity;
@model List<RenewalMain>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Proposal.cshtml";
    var currentUserId = User.Identity.GetUserId();
}

@section Styles {
    <link rel="stylesheet" href="~/ProposalAssets/CSS/broker.css" />
}

<!-- ////////////// Main Content ////////////// -->
<div style="display: flex; flex-direction: column; min-height: 90vh">
    <div class="bg-grid-container">
        <div class="container">
            <div class="form-bg col-10">
                <div class="pool-box">

                    <!-- PreX Pool -->
                    <div class="pool-field-box pb-2 " style="padding-bottom: 30px;">
                        <div class="pool-field rounded-0">

                            <h6 class=" sios-color"> Pool</h6>
                        </div>
                        <div class="pool-field rounded-top-0" style="height: 50px;">
                            <div class="inputs w-100">
                                <div class="forLabel" style="width: 20%; margin-right: 5%;">
                                    <input class="sios-form-control  w-100  border-0 ">
                                    <span>ALL</span>
                                </div>
                                <div class="forLabel" style=" width: 20%;   margin-right: 5%;  ">
                                    <input class="sios-form-control  w-100  border-0 ">
                                    <span>Midicaion</span>
                                </div>
                            </div>

                        </div>

                        <div class="pool-field">
                            <div class="inputs w-100">
                                <div class="forLabel ms-auto me-4 position-relative  " multible style="width: 70%; padding-right: 30px; ">
                                    <select style="margin-right: 5%;" class="sios-form-control  w-100  border-0 "></select>

                                    <span style=" left: 10px !important; padding-left: 0; ">Multiselection</span>
                                </div>
                            </div>
                            <h6 class=" sios-color"> Services</h6>
                        </div>
                    </div>
                    <div class="pool-field-box mb-2">
                        <div class="pool-field " style="height:50px">
                            <div class="inputs w-100">
                                <input class="sios-form-control home-input text-center " data-val="true" data-val-number="The field PrexPoolVal must be a number." data-val-range="Prex Pool Value cannot be less than zero." data-val-range-max="2147483647" data-val-range-min="0" id="PrexPoolVal" name="PrexPoolVal" placeholder="قيمة" type="text" value="">
                                <input class="sios-form-control home-input text-center " data-val="true" data-val-number="The field PrexPoolPercentage must be a number." data-val-range="Prex pool percentage must be between 0 and 100." data-val-range-max="100" data-val-range-min="0" id="PrexPoolPercentage" name="PrexPoolPercentage" placeholder="نسبة" type="text" value="">

                            </div>

                        </div>
                        <div class="coverage-box d-flex position-relative">
                            <div class="coverage-radio-box d-flex">
                                <div class="coverage-radio-field">
                                    <label style="color:#000;" for="PrexPoolCoverage_PreviousAndLater">سابق ولاحق</label>
                                    <input class="form-check-input" data-val="true" data-val-required="The PrexPoolCoverage field is required." id="PrexPoolCoverage_PreviousAndLater" name="PrexPoolCoverage" type="radio" value="PreviousAndLater">

                                </div>
                                <div class="coverage-radio-field">
                                    <label style="color:#000;" for="PrexPoolCoverage_Later">لاحق</label>
                                    <input class="form-check-input" id="PrexPoolCoverage_Later" name="PrexPoolCoverage" type="radio" value="Later">

                                </div>
                                <div class="coverage-radio-field">
                                    <label style="color:#000;" for="PrexPoolCoverage_Previous">سابق</label>
                                    <input class="form-check-input" id="PrexPoolCoverage_Previous" name="PrexPoolCoverage" type="radio" value="Previous">

                                </div>
                            </div>
                            <p class=" sios-color fs-5 fw-bold" style="  position:absolute ;right:20px">نوع التغطية</p>
                        </div>
                        @*style="margin-right: 150px;"*@
                        <div class="coverage-box d-flex">
                            <div class="coverage-radio-box d-flex">
                                <div class="coverage-radio-field">
                                    <label style="color:#000;" for="PrexPoolCoverage_PreviousAndLater2">عمليات</label>
