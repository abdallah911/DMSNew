@using Microsoft.AspNet.Identity;
@model DMS_Authontication1.ViewModel.RenwalBasicDataViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Proposal.cshtml";
    var currentUserId = User.Identity.GetUserId();

}
@if (ViewBag.Errors != null)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewBag.Errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<!-- ////////////// Main Content ////////////// -->
<div style="display: flex; flex-direction: column; min-height: 90vh">
    @using (Html.BeginForm("SaveDataBasicData", "ProposalRenewals", FormMethod.Post))
    { 
        @Html.AntiForgeryToken() 
        @Html.HiddenFor(model => model.CompId)
        @Html.HiddenFor(model => model.ContractNo)
        @Html.HiddenFor(model => model.CountClass)
        @Html.HiddenFor(model => model.typAction)
        @Html.HiddenFor(model => model.MainId)

        <div class="bg-grid-container">
            <div class="container">
                <div class="form-bg col-10">
                    <div class="pool-box">
                        <!-- PreX Pool -->
                        <div class="pool-field-box pb-2" style="padding-bottom: 30px;">
                            <div class="pool-field rounded-0">
                                <h6 class="sios-color">Pool</h6>
                            </div>
                            <div class="pool-field rounded-top-0" style="height: 50px;">
                                <div class="inputs w-100">
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">
                                        @*<input class="sios-form-control w-100 border-0" />*@
                                        @Html.TextBoxFor(model => Model.ValueAllOld, new { @class = "sios-form-control w-100 border-0", style = "width: 100%", @disabled = "disabled" })

                                        <span>ALL</span>
                                    </div>
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">
                                        @* <input class="sios-form-control w-100 border-0" />*@
                                        @Html.TextBoxFor(model => Model.ValueMedicationOld, new { @class = "sios-form-control w-100 border-0", style = "width: 100%", @disabled = "disabled" })

                                        <span>Midicaion</span>
                                    </div>
                                </div>

                            </div>
                            <div style="height:70px" class="pool-field">
                                <div class="inputs w-100">
                                    <div class="forLabel ms-auto me-4 position-relative" style="width: 70%; padding-right: 30px;">

                                        @*@Html.DropDownListFor(model => Model.poolService, ViewBag.PolServ as SelectList, "Select Services", new { @class = "sios-form-control w-100 border-0", style = "width: 100%", id = "poolService", multiple = "multiple" })*@
                                        @Html.DropDownListFor(model => Model.poolService, ViewBag.PolServ as SelectList, new { @class = "sios-form-control select2 w-100 border-0", style = "width: 100%", id = "poolService" , multiple = "multiple" }) <span style="right: 40px !important; padding-left: 0;">Multiselection</span>
                                    </div>
                                </div>
                                <h6 class="sios-color">Services</h6>
                            </div>
                        </div> 
                        <div class="pool-field-box mb-2">
                            <div class="pool-field" style="height:50px">
                                <div class="inputs w-100">
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">
                                        @*<input class="sios-form-control w-100 border-0" />*@
                                        @*@Html.TextBoxFor(model => Model.ValueAllOld, new { @class = "sios-form-control w-100 border-0", style = "width: 100%", @disabled = "disabled" })*@
                                        @Html.TextBoxFor(model => Model.ValuePool, new { @class = "sios-form-control w-100 border-0 ps-2", style = "width: 100%" })
                                        <span>ALL</span>
                                    </div>
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">
                                        @* <input class="sios-form-control w-100 border-0" />*@
                                        @*@Html.TextBoxFor(model => Model.ValueMedicationOld, new { @class = "sios-form-control w-100 border-0", style = "width: 100%", @disabled = "disabled" })*@
                                        @Html.TextBoxFor(model => Model.PercentPool, new { @class = "sios-form-control w-100 border-0 ps-2", style = "width: 100%" })

                                        <span>Midicaion</span>
                                    </div>
                                </div>
                            </div>
                            <div class="coverage-box d-flex position-relative">
                                <div class="coverage-radio-box d-flex">
                                    <div class="coverage-radio-field">
                                        <label style="color:#000;" for="TypeCovarge">سابق ولاحق</label>
                                        @Html.RadioButtonFor(model => model.TypeCovarge, 1, new { @class = "form-check-input", id = "TypeCovarge" })
                                        @*<input class="form-check-input" data-val="true" data-val-required="The TypeCovarge field is required." id="TypeCovarge" name="TypeCovarge" type="radio" value="1" />*@
                                    </div>
                                    <div class="coverage-radio-field">
                                        <label style="color:#000;" for="TypeCovarge">لاحق</label>
                                        @* <input class="form-check-input" id="TypeCovarge" name="TypeCovarge" type="radio" value="2" />*@
                                        @Html.RadioButtonFor(model => model.TypeCovarge, 2, new { @class = "form-check-input", id = "TypeCovarge" })
                                    </div>
                                    <div class="coverage-radio-field">
                                        <label style="color:#000;" for="TypeCovarge">سابق</label>
                                        @Html.RadioButtonFor(model => model.TypeCovarge, 3, new { @class = "form-check-input", id = "TypeCovarge" })
                                        @*   <input class="form-check-input" id="TypeCovarge" name="TypeCovarge" type="radio" value="3" />*@
                                    </div>
                                </div>
                                <p class="sios-color fs-5 fw-bold" style="position:absolute; right:20px">نوع التغطية</p>
                            </div>
                            <div class="coverage-box d-flex">
                                <div class="coverage-radio-box d-flex">
                                    <div class="coverage-radio-field">
                                        <label style="color:#000;" for="IsInpatient">عمليات</label>
                                        @*<input class="form-check-input" data-val="true" data-val-required="The PrexPoolCoverage field is required." id="PrexPoolCoverage_PreviousAndLater2" name="PrexPoolCoverage" type="checkbox" value="PreviousAndLater" />*@
                                        @Html.CheckBoxFor(model => model.IsInpatient, new { @class = "form-check-input", id = "IsInpatient" })

                                    </div>
                                    <div class="coverage-radio-field">
                                        <label style="color:#000;" for="IsMedication">ادوية</label>
                                        @* <input class="form-check-input" id="PrexPoolCoverage_Later2" name="PrexPoolCoverage" type="checkbox" value="Later" />*@
                                        @Html.CheckBoxFor(model => model.IsMedication, new { @class = "form-check-input", id = "IsMedication" })
                                    </div>
                                    <div class="coverage-radio-field">
                                        <label style="color:#000;" for="IsLab">تحاليل</label>
                                        @Html.CheckBoxFor(model => model.IsLab, new { @class = "form-check-input", id = "IsLab" })
                                        @*<input class="form-check-input" id="PrexPoolCoverage_Previous2" name="PrexPoolCoverage" type="checkbox" value="Previous" />*@
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex flex-column ps-2">
                                <span class="field-validation-valid text-danger" data-valmsg-for="PrexPoolVal" data-valmsg-replace="true"></span>
                                <span class="field-validation-valid text-danger" data-valmsg-for="PrexPoolPercentage" data-valmsg-replace="true"></span>
                                <span class="field-validation-valid text-danger" data-valmsg-for="PrexPoolCoverage" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="pool-field-box mb-2" style="padding-bottom: 30px;">
                            <div class="pool-field rounded-bottom-0">
                                <h6 class="sios-color">Stop Loss</h6>
                            </div>
                            <div class="pool-field rounded-0" style="height: 50px;">
                                <div class="inputs w-100">
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">
                                        @Html.TextBoxFor(model => model.StopLossOld, new { @class = "sios-form-control w-100 border-0", style = "width: 100%", @disabled = "disabled" })

                                        @*<input class="sios-form-control w-100 border-0" disabled />*@
                                        <span></span>
                                    </div>
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">

                                        @Html.TextBoxFor(model => model.StopLoss, new { @class = "sios-form-control w-100 border-0", style = "width: 100%" })

                                        @*<input class="sios-form-control w-100 border-0" />*@
                                        <span></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="pool-field-box mb-2" style="padding-bottom: 30px;">
                            <div class="pool-field rounded-bottom-0">
                                <h6 class="sios-color">Visitors</h6>
                            </div>
                            <div class="pool-field rounded-top-0" style="height: 70px;">
                                <div class="inputs w-100">
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">
                                        @Html.TextBoxFor(model => model.VisitorNumber, new { @class = "sios-form-control w-100 border-0", style = "width: 100%" })

                                        @*<input class="sios-form-control w-100 border-0" />*@
                                        <span>عدد الزيارات</span>
                                        <div class="d-flex gap-3">
                                            <div class="coverage-radio-field">
                                                <label style="color:#000;" for="monthinput">شهر</label>
                                                @Html.RadioButtonFor(model => model.VisitorType, 2, new { @class = "form-check-input", id = "VisitorType" })

                                                @*     <input class="form-check-input" style="padding: 0 !important;" id="monthinput" name="visits" type="radio" value="Later" />*@
                                            </div>
                                            <div class="coverage-radio-field">
                                                <label style="color:#000;" for="weekInput">اسبوع</label>
                                                @Html.RadioButtonFor(model => model.VisitorType, 1, new { @class = "form-check-input", id = "VisitorType" })

                                                @*                                                <input class="form-check-input" style="padding: 0 !important;" id="weekInput" name="visits" type="radio" value="Previous" />*@
                                            </div>
                                        </div>
                                    </div>
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">
                                        @Html.TextBoxFor(model => model.VisitorValue, new { @class = "sios-form-control w-100 border-0", style = "width: 100%" })

                                        @*  <input class="sios-form-control w-100 border-0" />*@
                                        <span>قيمة الزيارة</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="pool-field-box mb-2" style="padding-bottom: 30px;">
                            <div style="padding: 15px 10px;" class="pool-field d-flex justify-content-between rounded-bottom-0">
                                <h6 class="sios-color fw-bold my-auto">Broker</h6>
                                <div class="d-flex align-items-center justify-content-start w-50 gap-2 text-start">
                                    <label for="broker" class="fs-5 fw-bold">يوجد</label>
                                    @Html.CheckBoxFor(model => model.IsBroker, new { @class = "", @style = "box-shadow:none;", onclick = "ShowBroker()", id = "brokerCheck" })


                                    @* <input type="checkbox" style="width:10px;" id="brokerCheck" class="" />*@
                                </div>
                            </div>
                            <div class="pool-field rounded-0" id="brockDisable" style="height: 50px; display:none;">
                                <div class="inputs w-100">
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">

                                        @*@Html.TextBoxFor(model => model.BrokerId, new { @class = "sios-form-control w-100 border-0", style = "width: 100%" })*@

                                        @Html.DropDownListFor(model => model.BrokerId, ViewBag.Brokerss as SelectList, "Select Broker", new { @class = "sios-form-control w-100 border-0", style = "width: 100%", id = "BrokerId" })

                                        @*<input class="sios-form-control w-100 border-0" disabled />*@
                                        <span>الإسم</span>
                                    </div>
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">

                                        @Html.TextBoxFor(model => model.BrokerPercentage, new { @class = "sios-form-control w-100 border-0", style = "width: 100%" })

                                        @*<input class="sios-form-control w-100 border-0" />*@
                                        <span>النسبة</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="pool-field-box mb-2" style="padding-bottom: 30px;">
                            <div class="pool-field shadow-sm py-3 px-2" style="height:50px;">
                                <h6 class="sios-color fw-bold">Loss Ratio</h6>
                            </div>
                            <div class="pool-field py-2 shadow-sm position-relative" style="height:50px;">
                                <div class="inputs w-100">
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">

                                        @Html.TextBoxFor(model => model.ExpectedLossRatioOld, new { @class = "sios-form-control w-100 border-0", style = "width: 100%", @disabled = "disabled" })


                                        @*<input class="sios-form-control w-100 border-0" disabled />*@
                                        <span>expected Loss Ratio</span>
                                    </div>
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">

                                        @Html.TextBoxFor(model => model.LossRatioOld, new { @class = "sios-form-control w-100 border-0", style = "width: 100%", @disabled = "disabled" })

                                        @*<input class="sios-form-control w-100 border-0" disabled />*@
                                        <span>Loss Ratio</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="pool-field-box mb-2">
                            <div class="pool-field p-2 py-3 position-relative">
                                <div class="inputs w-100">
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">
                                        @*<input class="sios-form-control w-100 border-0" />*@
                                        @Html.TextBoxFor(model => model.AdminExpenses, new { @class = "sios-form-control w-100 border-0", style = "width: 100%" })

                                        <span>مصاريف ادارية</span>
                                    </div>
                                    <div class="forLabel" style="width: 20%; margin-right: 5%;">
                                        @Html.TextBoxFor(model => model.IssuanceExpenses, new { @class = "sios-form-control w-100 border-0", style = "width: 100%" })

                                        @*<input class="sios-form-control w-100 border-0" />*@
                                        <span>مصاريف الإصدار</span>
                                    </div>
                                </div>
                                <h6 class="sios-color fw-bold">Expenses</h6>
                            </div>
                        </div>
                    </div>
                    <div>
                        <a style="width: fit-content;">
                            <button type="submit" style="height: 48px;" class="text-align-center btn next-btn fs-5 fw-bold py-2 px-5">التالي</button>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

 
<script src="~/Scripts/DMS/ProposalRenewals/jquery.min.js"></script>
<script src="~/Scripts/DMS/ProposalRenewals/select2.min.js"></script>
<script src="~/Scripts/DMS/ProposalRenewals/ProposalRenewals.js"></script>
 
 <script>
        $(document).ready(function () { 
            $('#poolService').select2();
    });
</script>
 