                                </div>
                                <div class="coverage-radio-field">
                                    <label style="color:#000;" for="PrexPoolCoverage_Later2">ادوية</label>
                                    <input class="form-check-input" id="PrexPoolCoverage_Later2" name="PrexPoolCoverage" type="checkbox" value="Later">

                                </div>
                                <div class="coverage-radio-field">
                                    <label style="color:#000;" for="PrexPoolCoverage_Previous2">تحاليل</label>
                                    <input class="form-check-input" id="PrexPoolCoverage_Previous2" name="PrexPoolCoverage" type="checkbox" value="Previous">

                                </div>
                            </div>
                        </div>
                        <div class="d-flex flex-column ps-2">
                            <span class="field-validation-valid text-danger" data-valmsg-for="PrexPoolVal" data-valmsg-replace="true"></span>
                            <span class="field-validation-valid text-danger" data-valmsg-for="PrexPoolPercentage" data-valmsg-replace="true"></span>
                            <span class="field-validation-valid text-danger" data-valmsg-for="PrexPoolCoverage" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                    <div class="pool-field-box mb-2" style="padding-bottom: 30px;">
