@model DMS_Authontication1.ViewModel.SyncViewModel
@{
    ViewBag.Title = "Synchronize Data Base";
}

<h2>@ViewBag.Title.</h2>

<div class="form-group" style="width:500px; height:300px;">
    @using (Html.BeginForm("Synchronize", "Sync", FormMethod.Post, new { @class = "form-horizontal", role = "form" ,@id="syncId"}))
    {
        @Html.AntiForgeryToken()
        <h4>Synchronize Last Update Data Base .</h4>
        <hr />
        @Html.ValidationSummary("", new { @class = "text-danger" })
        <div class="form-group"  style="margin-top:50px">
            @Html.LabelFor(m => m.title, new { @class = "col-md-5 control-label" })
            <div class="col-md-7">
                @Html.EnumDropDownListFor(m => m.type, "--Select--", new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group" style="margin-top:100px">
            <div class="col-sm-1" style="margin-left:100px">
                <input type="button" class="btn btn-default" onclick="validation()" value="Synchronize" />
            </div>
        </div>
    }
</div>
@if (ViewBag.response!="")
{
    <div>
        <h4>@ViewBag.response</h4>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script>


    $(document).ready(function () {
        
       
        
    });
    function validation() {
        debugger;
        var type = $("#type").val();
        if (type == 0) {
            alert("Please Select Type");
            return false;
        }
        else {
            document.getElementById('syncId').submit();
            return (true);
        }
    };

</script>