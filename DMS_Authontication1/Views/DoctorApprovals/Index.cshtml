@model DMS_TEST.ViewModel.Container1
@{



    <!--Card Id Row-->
    @Html.Partial("_Cards")
    @Html.Partial("_Pharmacies")
    @Html.Partial("_Branches")
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
    <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
</div>

<div class="sios-container editeRquest fw-bold portlet box  green">
    <div class="row bg-overlay  editeRquest fw-bold my-4 portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <i class="fa-solid fa-house me-1"></i>Doctor Daily

        </div>

    </div>
    <div class="portlet-body">
        <div class="container  row  row-cols-2  ">

            <div class="col-8  col-lg-4 form-group">
                <div class="w -100">
                    <input id="txtSearchCard" type="text" placeholder="search for card..." class="w-100 admin-form-control w-100   rounded-3  ps-3 rounded-3 py-2" />


                </div>
            </div>
            <div class="col-4 ">
                <button id="S earch" type="button" class="btn fw-bold">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                </button>
            </div>
        </div>
    </div>




    <div class="row bg-overlay  editeRquest fw-bold my-4 portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <h3 class="mb-0 panel-heading">Card ID</h3>
        </div>
    </div>
    <div class="row row-cols-sm-2  row-gap-2 container mx-auto">
        <div class=" row row-cols-md-3 row-cols-xl-5 row-gap-2 col-md-12 col-lg-6 col-xl-12 px-0 m-auto m-sm-0 text-center form-group">

            <div class="  forLabel admin-form-control   border-0 px-2  ">

                @Html.EditorFor(model => model.contractComp.C_ANAME, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 rounded-3 ", @required = "required", @ReadOnly = "true" } })
                <span>
                    @Html.LabelFor(model => model.contractComp.C_ANAME, htmlAttributes: new { @class = "control-label" })
                </span>
            </div>
            <div class="  forLabel admin-form-control   border-0 px-2  ">

                @Html.EditorFor(model => model.compEmp.EMP_ANAME, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 rounded-3 ", @required = "required", @ReadOnly = "true" } })
                <span>@Html.LabelFor(model => model.compEmp.EMP_ANAME, htmlAttributes: new { @class = "control-label" })</span>
            </div>
            <div class="  forLabel admin-form-control   border-0 px-2  ">
                @Html.EditorFor(model => model.compEmp.INS_END_DATE, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 rounded-3 ", @required = "required", @ReadOnly = "true" } })
                <span>
                    @Html.LabelFor(model => model.compEmp.INS_END_DATE, htmlAttributes: new { @class = "control-label" })

                </span>
            </div>

            <div class="  forLabel admin-form-control   border-0 px-2  ">
                @Html.DropDownList("ddlSpeciality", null, htmlAttributes: new { @class = "admin-form-control w-100 h-100  ", @required = "required", @id = "ddlSpeciality" })
                <span>
                    @Html.LabelFor(model => model.speciality.special_Aname, htmlAttributes: new { @class = "control-label" })
                </span>
            </div>

            <div class="forLabel  admin-form-control  border-0 px-2">
                @Html.EditorFor(model => model.ddEmp.CEILING_PERT, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100   rounded-3", @required = "required", @ReadOnly = "true" } })
                <span>
                    @Html.LabelFor(model => model.ddEmp.CEILING_PERT, htmlAttributes: new { @class = "control-label" })
                </span>
            </div> 
        </div>
        <div class="row row-cols-md-3 row-cols-lg-2 row-cols-xl-5 row-gap-2 col-md-12 col-lg-6 col-xl-12 px-0 m-auto m-sm-0 text-center" style="height:fit-content;">
            <div class="forLabel select2-60  admin-form-control  border-0 px-2">
                @Html.EditorFor(model => model.insurance.LIVEL, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100   rounded-3", @required = "required", @ReadOnly = "true" } })
                <span>
                    @Html.LabelFor(model => model.insurance.LIVEL, htmlAttributes: new { @class = "control-label" })
                </span>
            </div>
            <div class="  forLabel select2-60 ddlDiagnoises admin-form-control   border-0 px-2  " style="height:80px">
                <div id="expandVertical" class="btn d-flex justify-content-center align-items-center  ms-1 ,b-1 text-white rounded-circle position-apsolute start-0 top-0 translate-middle-y   z-2" style="width:20px; height:20px; padding:12px;margin-bottom:20px;">
                    <i class="fa fa-plus " style="font-size:16px;"></i>
                </div>
                <div id="expandHorisontal" class="btn d-flex d-none justify-content-center align-items-center   ms-1 ,b-1 text-white rounded-circle position-apsolute start-0 top-0 translate-middle-y   z-2" style="width:20px; height:20px; padding:12px;margin-bottom:20px;">
                    <i class="fa fa-minus " style="font-size:16px;"></i>
                </div>

                <select id="ddlDiagnoises" class="admin-form-control border-2 ps-3" style="width:100%" multiple></select>
                <span style="right: 20px !important; padding-left: 0; top: 14px; color: var(--color-secondary) !important; font-size: 11px;">
                    @Html.Label("Diagnoise", new { @class = "control-label" })
                </span>
            </div>
        </div>
    </div>


    @*//History*@

    <div class="row bg-overlay  editeRquest fw-bold my-4 portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <h2 class="panel-heading mb-0">History</h2>
        </div>
    </div>


    <div class="sios-bg border-bottom-0 px-3 container-fluid">
        <div class=" table-responsive "position:relative">

            <table class="table" id="History">
                <thead>
                    <tr>
                        <th scope="col">Medicien Code</th>
                        <th scope="col" align="center">Name</th>
                        <th scope="col">Dosage</th>
                        <th scope="col">Dose</th>
                        <th scope="col">Duration</th>
                        <th scope="col">Total Duration</th>
                        <th scope="col">Total Units</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Group</th>
                        <th scope="col">Date</th>
                        <th scope="col">Pharmacy</th>
                        <th scope="col">&nbsp;</th>
                        <th scope="col">&nbsp;</th>
                    </tr>
                </thead>
                <tbody></tbody>

            </table>
        </div>
    </div>




    <div class=" row row-cols-sm-2 row row-cols-sm-2 row-gap-2 d-flex flex-wrap flex-md-nowrap justify-content-center mx-4 mt-4">
        <div class="  forLabel  admin-form-control border-0 px-2     ">

            <input type="text" class="admin-form-control h-100 w-100" disabled />
            <span class="control-label" for="From">From</span>
        </div>
        <div class="  forLabel  admin-form-control border-0 px-2     ">

            <input type="text" class="admin-form-control h-100 w-100" disabled />
            <span class="control-label" for="To">To</span>
        </div>
    </div>

    <div class="row row-cols-sm-2 d-flex flex-wrap row-gap-2 flex-md-nowrap justify-content-center mx-4 mt-2">


        <div class="  forLabel   admin-form-control border-0 px-2     ">
            <input id="PharmacyTxt" type="text" class="admin-form-control h-100 w-100" reqired/>
            <span>Pharmacy</span>
        </div>    <div class="  forLabel admin-form-control border-0 px-2     ">
            <input id="BranchTxt" type="text" style="padding-right: 2rem !important; border: 2px solid var(--color-secondary) ;"reqired
                   class="admin-form-control h-100 w-100" />
            <span>Branch</span>

        </div>

    </div>


    <div class="row bg-overlay  editeRquest fw-bold my-4 portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <h2 class="panel-heading mb-0">Medicines</h2>
        </div>

    </div>
    <!--Dynamic table-->
    <div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;">
        <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
    </div>
    <div class="row">
        <div class="admin-form-control border-0 col-sm-12 position-relative">
            <select id="AddMedicine" multiple="multiple" style="width:100%">
                <option value="0"> </option>
            </select>
            @*<span style="left:20px;" class="sios-color fw-medium fs-5  position-absolute top-50 translate-middle-y">select medicine</span>*@
        </div>
    </div>

    <div class="sios-bg border-bottom-0 my-3 px-3 container-fluid">
        <div class="table-responsive">
            <table class="table" id="Pharmacy">
                <thead>
                    <tr>
                        <th scope="col">Medicien Code</th>
                        <th scope="col" align="center">name</th>
                        <th scope="col">Dosage</th>
                        <th scope="col">Package Size</th>
                        <th scope="col">Package Price</th>
                        <th scope="col">Unit Number</th>
                        <th scope="col">Unit Price</th>
                        <th scope="col">Dose</th>
                        <th scope="col">Duration</th>
                        <th scope="col">Total Duration</th>
                        <th scope="col">Total Units</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Group</th>
                        <th scope="col">&nbsp;</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <!--Caculation-->
    </div>
    <div class="row container mx-auto row">
        <div class=" row row-cols-sm-2 row-cols-lg-3 row-gap-2 mx-auto mb-4 form-group">
            <div class="forLabel admin-form-control border-0 px-2">

                <input id="txtTotalInvoice" type="text" class="admin-form-control w-100 h-100   rounded-3" ReadOnly="readonly" />
                <span class="control-label">Total</span>
            </div>
            <div class="forLabel admin-form-control border-0 px-2">

                <input id="txtTotalCopayment" type="text" class="admin-form-control w-100 h-100   rounded-3" ReadOnly="readonly" />
                <span class="control-label">Person Payments</span>
            </div>
            <div class="forLabel admin-form-control border-0 px-2">

                <input id="txtValueCredit" type="text" class="admin-form-control w-100 h-100   rounded-3" ReadOnly="readonly" />
                <span class="control-label">Value Credit</span>
            </div>
            <div class="forLabel admin-form-control border-0 px-2">

                <input id="txtOverInsurance" type="text" class="admin-form-control w-100 h-100   rounded-3" ReadOnly="readonly" />
                <span class="control-label">Over Insurance</span>
            </div>
            <div class="forLabel admin-form-control border-0 px-2">

                <input id="txtCash" type="text" class="admin-form-control w-100 h-100   rounded-3" ReadOnly="readonly" />
                <span class="control-label">Cash</span>
            </div>
            <div class="forLabel admin-form-control border-0 px-2">

                <input id="txtValueCash" type="text" class="admin-form-control w-100 h-100   rounded-3" ReadOnly="readonly" />
                <span class="control-label">Total cash</span>
            </div>
            <div class="d-flex justify-content-center gap-2 mx-auto" style="padding:10px 0; text-align:right">
                <div class="position-relative  ">
                    <i class="fa-solid fa-rotate position-absolute start-0 top-50 translate-middle text-white ms-3 "></i>
                    <input id="reset" type="button" value="Reset" onclick="ClearCardData();ClearMedicineData();" class="btn ps-4 fw-bold text-white rounded-3 " />
                </div> 
                <div class="position-relative">
                    <i class="fa-solid fa-floppy-disk position-absolute start-0 top-50 translate-middle text-white ms-3 "></i>

                    <input id="submit" type="button" value="Save" class="btn fw-bold text-white rounded-3 ps-4 " />
                </div>
            </div>




        </div><!--Caculation-->


    </div>
</div>
@*//////////////////////////////////////////////////////  Sccripts /////////////////////// *@


<script src="~/Scripts/DMS/DoctorApproval.js?V=2.5"></script>



