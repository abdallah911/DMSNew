@model DMS_TEST.ViewModel.Container1

<div class="modal fade " id="LastApprovalModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog  modal-lg" style="width:1250px;" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h3 class="modal-title">LastApproval</h3>
            </div>
            @*Provider*@
            <div class="modal-body">
                <div class="panel panel-info"><h2 class="panel-heading" style="margin:1px;">Provider</h2> </div>
                <div class="row">
                    <div class="form-group">
                        <div class="col-sm-2">
                            @Html.Label("Approval Id", htmlAttributes: new { @class = "control-label" })
                            @Html.Editor("ApprvalId", new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        </div>
                        <div class="col-sm-2">
                            @Html.Label("Provider", htmlAttributes: new { @class = "control-label" })
                            @Html.Editor("LastProvider_Provider", new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        </div>
                        <div class="col-sm-2">
                            @Html.Label("Branch", htmlAttributes: new { @class = "control-label" })
                            @Html.Editor("LastProvider_Branch", new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        </div>
                        <div class="col-sm-2">
                            @Html.Label("Prescription Date", htmlAttributes: new { @class = "control-label" })
                            @Html.Editor("PrescriptionDate", new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        </div>
                    </div>
                </div>
                @*Card ID*@
                <div class="panel panel-info"><h2 class="panel-heading" style="margin:1px;">Card ID</h2> </div>
                <div class="row">
                    <div class="form-group">
                        <div class="col-sm-2">
                            @Html.LabelFor(model => model.compEmp.CARD_ID, htmlAttributes: new { @class = "control-label" })
                            @Html.Editor("LastProvider_CARD_ID", new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        </div>
                        <div class="col-sm-2">
                          @Html.LabelFor(model => model.compEmp.EMP_ANAME, htmlAttributes: new { @class = "control-label" })
                          @Html.Editor("LastProvider_EMP_ANAME", new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        </div>
                        <div class="col-sm-2">
                            @Html.Label("Company", htmlAttributes: new { @class = "control-label" })
                            @Html.Editor("LastProvider_COMP_ID", new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        </div>



                        <div class="col-sm-2">
                            @Html.LabelFor(model => model.compEmp.INS_END_DATE, htmlAttributes: new { @class = "control-label" })
                            @Html.Editor("LastProvider_INS_END_DATE", new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-2">
                        @Html.Label("Daily Limit", htmlAttributes: new { @class = "control-label" })
                        @Html.Editor("LastProvider_INSURANCE_DAY", new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                    </div>
                    <div class="col-sm-2">
                        @Html.Label("Monthly Limit", htmlAttributes: new { @class = "control-label" })
                        @Html.Editor("LastProvider_INSURANCE_MONTH", new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                    </div>
                    <div class="col-sm-2">
                        @Html.LabelFor(model => model.ddEmp.CEILING_PERT, htmlAttributes: new { @class = "control-label" })
                        @Html.Editor("LastProvider_CEILING_PERT", new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                    </div>


                    <div class="col-sm-2">
                    </div>
                </div>
                <br />
                <div class="panel panel-info">
                    <h2 class="panel-heading" style="margin:1px;">Medicines</h2>
                </div>

                <!--Dynamic table-->
                <div class="container-fluid">
                    <div class="master">
                        <div class="table-responsive">
                            <table class="table" id="LastApprovals">
                                <thead>
                                    <tr>
                                        <th scope="col">Medicien Code</th>
                                        <th scope="col" align="center">name</th>
                                        <th scope="col">Dosage</th>
                                        <th scope="col">Package Size</th>
                                        <th scope="col">Package Price</th>
                                        <th scope="col">Unit Number</th>
                                        <th scope="col">Unit Price</th>
                                        <th scope="col">Dose</th>
                                        <th scope="col">Duration</th>
                                        <th scope="col">Total Units</th>
                                        <th scope="col">Amount</th>
                                        <th scope="col">Type</th>
                                        <th scope="col">&nbsp;</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>

                            </table>
                        </div>
                    </div>
                </div>
                </div>
            <div class="modal-footer">
                <button id="Close" type="button" class="btn btn-secondary glyphicon glyphicon-ok" data-dismiss="modal">Ok</button>
               
            </div>

            </div>
            </div>
        </div>

