
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}

@Html.Partial("_Companies")
@Html.Partial("_Providers")
@Html.Partial("_AddCard")
@Html.Partial("_ApprovalMedicines")
@Html.Partial("_ApprovalEdit")
@Html.Partial("_EditCard")
@Html.Partial("_SearchCards")
@Html.Partial("_LastApproval")
@Html.Partial("_EmployeeData")

@Html.Partial("~/Views/DoctorMedicinesLabsRaysApproval/_ShowDetails.cshtml", (DMS_Authontication1.ViewModel.CustomerService.CustomerServiceViewModel)new DMS_Authontication1.ViewModel.CustomerService.CustomerServiceViewModel())

<div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px; z-index:100000;">
    <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
</div> 
<div class="sios-container editeRquest fw-bold pt-4 portlet box  green">
    <div class="row bg-overlay  portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <i class="fa-solid fa-home me-1"></i>Chronic Management
        </div>
    </div>
    <div class="portlet-body">  
        <div class="tab-content"  >
            <div id="CompaniesTab" class="tab-pane fade ">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="form-group d-flex gap-3">
                            <div class="col-sm-3">
                                <input id="txtSearchCompany" type="text" placeholder="search for company..." class="form-control" />
                            </div> 
                        </div> 
                    </div>
                    <div class="row">
                        <div class="form-group">
                            <div class="col-sm-2">
                                <label>Change Provider</label>
                                <input type="text" id="ChangeProvider" class="form-control" placeholder="New Provider" disabled />
                            </div>
                            <div class="col-sm-2">
                                <label>Change Group</label>
                                @Html.DropDownList("ChangeGroup", new SelectList(string.Empty, "Value", "Text"), "New Group", new { @class = "form-control", disabled = "true" })
                            </div>
                            <div class="col-sm-2">
                                <label>CoPayment Exception</label>
                                <select id="CoPayStatus" class="form-control" disabled>
                                    <option value="N">CoPay Status</option>
                                    <option value="1">On</option>
                                    <option value="0">Off</option>

                                </select>
                            </div>
                            <div class="col-sm-2">
                                <label>Over Exception</label>
                                <select id="OverStatus" class="form-control" disabled>
                                    <option value="N">Over Status</option>
                                    <option value="1">On</option>
                                    <option value="0">Off</option>
                                </select>
                            </div>
                            <div class="col-sm-2">
                                <label>Lock Status</label>
                                <select id="LockStatus2" class="form-control" disabled>
                                    <option value="N">Lock Status</option>
                                    <option value="Open">Open</option>
                                    <option value="Pause">Pause</option>
                                    <option value="Close">Close</option>
                                </select>
                            </div>
                            @*<div class="col-sm-2">
                                    <label for="OldMainProvider" class="col-form-label">Edit Group</label>
                                </div>
                                <div class="col-sm-2">
                                    @Html.DropDownList("OldMainGroup", new SelectList(string.Empty, "Value", "Text"), "Old Group", new { @class = "form-control", disabled = "true" })
                                </div>
                                <div class="col-sm-2">
                                    @Html.DropDownList("MainGroup", new SelectList(string.Empty, "Value", "Text"), "New Group", new { @class = "form-control", disabled = "true" })
                                </div>*@
                        </div>
                    </div>
                </div> 
            </div>
            <div id="IndividualTab" class="tab-pane fade  in active">
                <div class="form-horizontal my-4">
                    <div class="row">
                        <div class="form-group d-flex gap-3 mb-3 ms-sm-4 mx-auto">
                            <div class="col-sm-3">
                                <input id="AddCardTxt" type="text" placeholder="Add Card" class="form-control" />
                            </div>
                            <div class="col-sm-3">
                                @*<button id="AddCard" class=" btn btn-primary glyphicon glyphicon-plus" data-toggle="modal" data-target="#exampleModal"> Add</button>*@
                                <button id="AddCard" type="button" class="btn btn-primary" data-toggle="modal" data-target="#exampleModal">
                                    <i class="glyphicon glyphicon-search"></i> Search
                                </button>
                            </div> 
                        </div>
                    </div>
                    <div class="sios-bg table-responsive">
                        <table class="table table-fixed" id="Cards">
                            <thead>
                                <tr>
                                    <th scope="col">&nbsp;</th>
                                    <th scope="col">Card Id</th>
                                    <th scope="col" align="center">Name</th>
                                    <th scope="col">Provider</th>
                                    <th scope="col">Date</th>
                                    <th scope="col">Exchange</th>
                                    <th scope="col">Group</th>
                                    <th scope="col">Diagnose</th>
                                    <th scope="col">CoPayment</th>
                                    <th scope="col">Over</th>
                                    <th scope="col">Active</th>
                                    <th scope="col">Comments</th>
                                    <th scope="col">Phone</th>
                                    <th scope="col">National Id</th>
                                    <th scope="col">Exception Type</th>
                                    <th scope="col">Date1</th>
                                    <th scope="col">Date2</th>

                                    <th scope="col">&nbsp;</th>
                                </tr>
                            </thead>
                            <tbody></tbody> 
                        </table>
                    </div> 
                    <input id="ShowDetailsCard" type="button" value="Show more details" class="btn text-white fw-bold rounded-3 mt-3 mb-4 ms-sm-4 mx-auto" onclick="ShowDetailsCard($('#AddCardTxt').val())" />
                    
                    <div class="panel panel-info">
                        <div class="row bg-overlay  portlet-title">
                            <div class="m-3 fs-3 text-white caption">
                                <h3 class="panel-heading fw-bold">Medicines</h3>
                                </div>
                            </div>
                                <div class="panel-body">
                                    <!--Search Medicine-->
                                    @*<div class="row">
                        <div class="col-sm-12" data-step="9" data-intro="Select Medicines to Despense">
                            <select id="AddMedicine" multiple="multiple" style="width:100%">
                                <option value="0">select medicine</option>
                            </select>
                        </div>
                    </div>*@
                                    <div class="row row-cols-3 row-gap-2 mx-auto  mt-4">
                                        <div class=" text-center">
                                            <button id="AddMedicien" class=" btn text-white fw-bold rounded-3" data-toggle="modal" data-target="#exampleModal"> Add Medicine</button>
                                        </div>
                                        <div class=" text-center" >
                                            <button id="ActiveMedicine" class=" btn text-white fw-bold rounded-3" onclick="ActiveOrNotActiveMedicine();">Active</button>
                                        </div>
                                        <div class=" text-center">
                                            <button id="EmployeeData" class=" btn text-white fw-bold rounded-3" data-toggle="modal" data-target="#EmplyeeModal" @*onclick="EmployeeData();"*@><i class="fa fa-info-circle" aria-hidden="true"></i>Employee Data</button>
                                        </div>
                                    </div>
                                    <div class="sios-bg container-fluid my-3"  >
                                        @*<div class="master"></div>*@
                                        <div class="table-responsive">
                                            <table class="table" id="CardMedicines">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">Medicien Code</th>
                                                        <th scope="col" align="center">Name</th>
                                                        <th scope="col">Dosage</th>
                                                        <th scope="col">Package Size</th>
                                                        <th scope="col">Package Price</th>
                                                        <th scope="col">Unit Number</th>
                                                        <th scope="col">Unit Price</th>
                                                        <th scope="col">Dose</th>
                                                        <th scope="col">Duration</th>
                                                        <th scope="col">Dose Duration</th>
                                                        <th scope="col">Total Units</th>
                                                        <th scope="col">Excess</th>
                                                        <th scope="col">Amount</th>
                                                        <th scope="col">Medicines Type</th>
                                                        <th scope="col">Months</th>
                                                        <th scope="col">stop Month</th>
                                                        <th scope="col">Active</th>
                                                        <th scope="col">Company Pay</th>
                                                        <th scope="col">Start Date</th>
                                                        <th scope="col">Pool Type</th>
                                                        <th scope="col"> </th>
                                                        <th scope="col"> </th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <!--Save-->
                                <div class="panel-footer text-center text-sm-start ms-sm-4 "  >
                                    <a id="LastApproval" class=" btn text-white fw-bold rounded-3" > Last Approval</a>
                                    <input id="SubmetChronic" type="button" value="Save mediciens" class="btn text-white fw-bold rounded-3 ms-2">
                                </div>
                            </div>
                        </div>
                    </div> 
        </div> 
    </div> 
</div> 



<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script> 
<script src="~/Scripts/DMS/Monthly_Chronic_Approvals.js?V=5.2"></script>
<script src="~/Scripts/DMS/SharedShowDetails.js?V=3"></script>