<div class="modal fade" id="EditCardModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" style="overflow-y: auto; max-height:100%;" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h3 class="modal-title">Card Details</h3>
            </div>

            <div class="modal-body " style="padding:0px 10px 0px 10px">
                <input type="hidden" id="Diagnos" class="form-control" />

                <div class="form-group row col-md-6">
                    <label for="CardId1" class="col-form-label">Card Id</label>
                    <input type="text" id="CardId1" class="form-control" ReadOnly="readonly" />
                </div>
                <div class="form-group row col-md-6">
                    <label for="CardName1" class="col-form-label">Card Name</label>
                    <input type="text" id="CardName1" class="name form-control" ReadOnly="readonly" />
                </div>
                <div class="form-group row col-md-6">
                    <label for="Provider1" class="col-form-label">Provider</label>
                    <input type="text" id="Provider1" class="Dosage form-control" />
                    @*@Html.DropDownList("Provider1", new SelectList(string.Empty, "Value", "Text"), null, new { @class = "form-control" })*@
                </div>
                <div class="form-group row col-md-6">
                    <label for="StartDate1" class="col-form-label">Start Date</label>
                    <input type="text" id="StartDate1" class="StartDate1 form-control" />
                </div>
                <div class="form-group row col-md-6">
                    <label for="ExchangeDay1" class="col-form-label">Exchange Day</label>
                    <select id="ExchangeDay1" class="form-control">
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="7">7</option>
                        <option value="8">8</option>
                        <option value="9">9</option>
                        <option value="10">10</option>
                        <option value="11">11</option>
                        <option value="12">12</option>
                        <option value="13">13</option>
                        <option value="14">14</option>
                        <option value="15">15</option>
                        <option value="16">16</option>
                        <option value="17">17</option>
                        <option value="18">18</option>
                        <option value="19">19</option>
                        <option value="20">20</option>
                        <option value="21">21</option>
                        <option value="22">22</option>
                        <option value="23">23</option>
                        <option value="24">24</option>
                        <option value="25">25</option>
                        <option value="26">26</option>
                        <option value="27">27</option>
                        <option value="28">28</option>
                        <option value="29">29</option>
                        <option value="30">30</option>
                    </select>
                </div>
                <div class="form-group row col-md-6">
                    <label for="Group1" class="col-form-label">Group</label>
                    @* <input type="text" id="Group1" class="unit_number form-control" />*@
                    @Html.DropDownList("Group1", new SelectList(string.Empty, "Value", "Text"), null, new { @class = "form-control" })
                </div>
                <div class="form-group row col-md-6">
                    <label for="Diagnoise1" class="col-form-label">Diagnoise</label>
                    @Html.DropDownList("Diagnoise1", new SelectList(string.Empty, "Value", "Text"), null, new { @class = "form-control", @multiple = "multiple", @style = "width:80%" })
                </div>
                <div class="form-group row col-md-6">
                    <label for="CompanyPaymentLimit1" class="col-form-label">Company Payment Exception</label>
                    <select id="CompanyPaymentLimit1" class="form-control">
                        <option value="1">On</option>
                        <option value="0">Off</option>
                    </select>

                </div>
                <div class="form-group row col-md-6">
                    <label for="OverInsuranceLimit1" class="col-form-label">OverInsurance Exception</label>
                    <select id="OverInsuranceLimit1" class="form-control">
                        <option value="1">On</option>
                        <option value="0">Off</option>

                    </select>

                </div>
                <div class="form-group row col-md-6">
                    <label for="LockStatus1" class="col-form-label">Active Status</label>
                    <select id="LockStatus1" class="form-control">
                        <option value="Open">Open</option>
                        <option value="Pause">Pause</option>
                        <option value="Close">Close</option>
                    </select>

                </div>
                <div class="form-group row col-md-6">
                    <label for="NOTES1" class="col-form-label">Comment</label>
                    <textarea id="NOTES1" class="form-control" type="text" name="NOTES1" placeholder="" value="">
                    </textarea>

                </div>
            </div>
            <div class="modal-footer">
                <button id="Close" type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button id="Edit" type="button" class="btn btn-primary">Edit</button>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script>
    //var input1 = document.getElementById("Provider1");
    //input1.addEventListener("keyup", function (event) {
    //    event.preventDefault();
    //    if (event.keyCode === 13) {
    //        $('.modal-body #StartDate1').focus();
    //    }
    //});
    var input2 = document.getElementById("StartDate1");
    input2.addEventListener("keyup", function (event) {
        event.preventDefault();
        if (event.keyCode === 13) {
            $('.modal-body #Group1').focus();
        }
    });

    var input4 = document.getElementById("Group1");
    input4.addEventListener("keyup", function (event) {
        event.preventDefault();
        if (event.keyCode === 13) {
            $('.modal-body #Diagnoise1').focus();
        }
    });

    $(function () {
        $('#StartDate1').datepicker({
            //dateFormat: 'dd-mm-yyyy',
            minDate: '+0D',
        });
        //debugger;
        //$('#Diagnoise1').select2({
        //    dropdownParent: $('#EditCardModal .modal-content')
        //    //dropdownParent: $("#AddCardModal")
        //});

        //var DiagnosisList = $('.modal-content #Diagnos').val().split('_');
        //for (var i = 0; i < DiagnosisList.length; i++) {
        //    $("#Diagnoise1").select2("val", $("#Diagnoise1 option:contains('" + DiagnosisList[i]+"')").val()).trigger('change');
        //    //$(".modal-content #Diagnoise1").val(DiagnosisList[i]).trigger('change');
        //}
        $('#Edit').click(function () {
            if ($('.modal-body #LockStatus1').val() != null && $('.modal-body #Provider1').val() != "" && $('.modal-body #StartDate1').val() != "") //Insert
            {
                var Lock;
                if ($('.modal-body #LockStatus1').val() == "Close") {
                    Lock = 1;
                }
                else if ($('.modal-body #LockStatus1').val() == "Open") {
                    Lock = 0;
                }
                else {
                    Lock = 2;
                }
                $('#EditCardModal').modal('hide');
                var SelectedDiagnosisList = $('#Diagnoise1').select2('data');
                var DiagnosisStr = SelectedDiagnosisList[0].text;
                if (SelectedDiagnosisList.length > 1) {
                    for (var i = 1; i < SelectedDiagnosisList.length - 1; i++) {

                        DiagnosisStr = DiagnosisStr + '_' + SelectedDiagnosisList[i].text;
                    }
                    DiagnosisStr = DiagnosisStr + '_' + SelectedDiagnosisList[SelectedDiagnosisList.length - 1].text;
                }
                $.ajax({
                    type: 'POST',
                    url: '/DoctorApprovals/UpdateCard/',
                    dataType: 'Json',
                    data: {
                        CARD_NO: $('.modal-body #CardId1').val(),
                        PR_ANAME: $('.modal-body #Provider1').val(),
                        MONTH_START_DATE: $('.modal-body #StartDate1').val(),
                        ST_DAY: $('.modal-body #ExchangeDay1').val(),
                        GROUP_ID: $('.modal-body #Group1').val(),
                        TASHKHES_01: DiagnosisStr /*$('.modal-body #Diagnoise1 :selected').text()*/,
                        NO_PAY: $('.modal-body #CompanyPaymentLimit1').val(),
                        NO_OVER: $('.modal-body #OverInsuranceLimit1').val(),
                        NOTES: $('.modal-body #NOTES1').val(),
                        LOOK_01: Lock
                    },
                    success: function (r) {

                        if (AddOrEdit == 1 || $('#txtSearchCompany').val() == "") {
                            //add
                            $('#Cards').DataTable({
                                "bPaginate": false,
                                "bLengthChange": false,
                                "bFilter": true,
                                "bInfo": false,
                                "bAutoWidth": false
                            }).row.add([
                                "<Button  class='btn btn-Primary glyphicon glyphicon-ok' onclick='SelectCard(this);'></Button>",
                                $('.modal-body #CardId1').val(),
                                $('.modal-body #CardName1').val(),
                                $('.modal-body #Provider1').val(),
                                $('.modal-body #StartDate1').val(),
                                $('.modal-body #ExchangeDay1').val(),
                                $('.modal-body #Group1 :selected').text(),
                                DiagnosisStr,
                                $('.modal-body #CompanyPaymentLimit1').val(),
                                $('.modal-body #OverInsuranceLimit1').val(),
                                $('.modal-body #LockStatus1 :selected').text(),
                                $('.modal-body #NOTES1').val(),
                                "<Button class='btn btn-warning glyphicon glyphicon-pencil' onclick='EditCard(this);'> Edit</Button>"
                            ]).draw();
                            $('#txtSearchCompany').val(CompId);
                        }
                        else {

                            //edit
                            $('#Cards tbody tr').each(function () {
                                var row = $(this);
                                if (row.find("TD").eq(1).html() == $('.modal-body #CardId1').val()) {
                                    $("TD", row).eq(3).html($('.modal-body #Provider1').val());
                                    $("TD", row).eq(4).html($('.modal-body #StartDate1').val());
                                    $("TD", row).eq(5).html($('.modal-body #ExchangeDay1').val());
                                    $("TD", row).eq(6).html($('.modal-body #Group1 :selected').text());
                                    $("TD", row).eq(7).html(DiagnosisStr);
                                    $("TD", row).eq(8).html($('.modal-body #CompanyPaymentLimit1').val());
                                    $("TD", row).eq(9).html($('.modal-body #OverInsuranceLimit1').val());
                                    $("TD", row).eq(10).html($('.modal-body #LockStatus1').val());
                                    $("TD", row).eq(11).html($('.modal-body #NOTES1').val());
                                }
                            });
                        }
                        $('#Cards_filter input[type="search"]').val($('.modal-body #CardId1').val()).keyup();

                    },
                    error: function (err) {
                        toastr.error("Failed to save");
                    }
                });
            } else {
                toastr.warning("please fill required data")
            }
        });
        $('#Provider1').click(function () {
            //providers
            $.ajax({
                url: '/DoctorApprovals/getProviders/',
                dataType: 'Json',
                success: function (r) {
                    prov = "Edit";
                    $('#EditCardModal').modal('hide');
                    $('#ProvidersModal').modal();
                    var setData = $("#Providers Tbody");
                    setData.empty();

                    for (var i = 0; i < r.length; i++) {

                        var data = "<tr >" +
                            "<td >" + "<Button  class='btn btn-Primary glyphicon glyphicon-ok' onclick='SelectProvider(this);'></Button>" + "</td>" +
                            "<td>" + r[i].PR_CODE + "</td>" +
                            "<td>" + r[i].PR_ANAME + "</td>" +
                            "<td>" + r[i].PR_ENAME + "</td>" +
                            "</tr>"
                        setData.append(data);

                    }
                    $('#Providers').DataTable();

                },
                error: function () {
                    alert("Error Retrieve");
                }

            });
        });
    })
</script>
