<div class="modal fade" id="AddCardModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" style="overflow-y: auto; max-height:100%;" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h3 class="modal-title">Card Details</h3>
            </div>

            <div class="modal-body " style="padding:0px 10px 0px 10px">


                <div class="form-group row col-md-6">
                    <label for="CardId" class="col-form-label">Card Id</label>
                    <input type="text" id="CardId" class="form-control" ReadOnly="readonly" />
                </div>
                <div class="form-group row col-md-6">
                    <label for="CardName" class="col-form-label">Card Name</label>
                    <input type="text" id="CardName" class="name form-control" ReadOnly="readonly" />
                </div>
                <div class="form-group row col-md-6">
                    <label for="Provider" class="col-form-label">Provider</label>
                    <input type="text" id="Provider" class="unit_number form-control" />
                    @*@Html.DropDownList("Provider", new SelectList(string.Empty, "Value", "Text"), null, new { @class = "form-control" })*@
                </div>
                <div class="form-group row col-md-6">
                    <label for="StartDate" class="col-form-label">Start Date</label>
                    <input type="text" id="StartDate" class="Package_Size form-control" />
                </div>
                <div class="form-group row col-md-6">
                    <label for="ExchangeDay" class="col-form-label">Exchange Day</label>
                    <select id="ExchangeDay" class="form-control">
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="7">7</option>
                        <option value="8">8</option>
                        <option value="9">9</option>
                        <option value="10">10</option>
                        <option value="11">11</option>
                        <option value="12">12</option>
                        <option value="13">13</option>
                        <option value="14">14</option>
                        <option value="15">15</option>
                        <option value="16">16</option>
                        <option value="17">17</option>
                        <option value="18">18</option>
                        <option value="19">19</option>
                        <option value="20">20</option>
                        <option value="21">21</option>
                        <option value="22">22</option>
                        <option value="23">23</option>
                        <option value="24">24</option>
                        <option value="25">25</option>
                        <option value="26">26</option>
                        <option value="27">27</option>
                        <option value="28">28</option>
                        <option value="29">29</option>
                        <option value="30">30</option>
                    </select>
                </div>
                <div class="form-group row col-md-6">
                    <label for="Group" class="col-form-label">Group</label>
                    @Html.DropDownList("Group", new SelectList(string.Empty, "Value", "Text"), null, new { @class = "form-control" })
                </div>

                <div class="form-group row col-md-6">
                    <label for="NationalId" class="col-form-label">National Id</label>
                    <input type="text" id="NationalId" class="unit_number form-control" onkeypress="return /[0-9]/i.test(event.key)" required />
                    @*@Html.DropDownList("Group", new SelectList(string.Empty, "Value", "Text"), null, new { @class = "form-control" })*@
                </div>
                <div class="form-group row col-md-6">
                    <label for="PhoneNumber" class="col-form-label">Phone</label>
                    <input type="text" id="PhoneNumber" class="unit_number form-control" onkeypress="return /[0-9]/i.test(event.key)" required />
                    @*@Html.DropDownList("Diagnoise", new SelectList(string.Empty, "Value", "Text"), null, new { @class = "form-control", @multiple = "multiple", @style = "width:80%" })*@
                </div>

                <div class="form-group row col-md-6">
                    <label for="Diagnoise" class="col-form-label">Diagnoise</label>
                    @*<input type="text" id="Diagnoise" class="unit_number form-control" />*@
                    @Html.DropDownList("Diagnoise", new SelectList(string.Empty, "Value", "Text"), null, new { @class = "form-control", @multiple = "multiple", @style = "width:80%" })
                </div>



                <div class="form-group row col-md-6">
                    <label for="CompanyPaymentLimit" class="col-form-label">Company Paymen Exception</label>
                    <select id="CompanyPaymentLimit" class="form-control">
                        <option value="0">Off</option>
                        <option value="1">On</option>
                    </select>

                </div>
                <div class="form-group row col-md-6">
                    <label for="OverInsuranceLimit" class="col-form-label">OverInsurance Exception</label>
                    <select id="OverInsuranceLimit" class="form-control">
                        <option value="0">Off</option>
                        <option value="1">On</option>
                    </select>

                </div>
                <div class="form-group row col-md-6">
                    <label for="LockStatus" class="col-form-label">Active Status</label>
                    <select id="LockStatus" class="form-control">
                        <option value="0">Open</option>
                        <option value="2">Pause</option>
                        <option value="1">Close</option>
                    </select>

                </div>
                <div class="form-group row col-md-6">
                    <label for="NOTES" class="col-form-label">Comment</label>
                    <textarea id="NOTES" class="form-control" type="text" name="NOTES" placeholder="" value="">
                    </textarea>

                </div>

                <div class="form-group row col-md-6">
                    <label for="ExceptionType" class="col-form-label">Exception Type</label>
                    <select id="ExceptionType" class="form-control">
                        <option>Select Exception</option>
                        <option value="VIP">VIP</option>
                        <option value="Normal">Normal</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button id="Close" type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button id="Add" type="button" class="btn btn-primary">Add</button>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script>

    var input2 = document.getElementById("StartDate");
    input2.addEventListener("keyup", function (event) {
        event.preventDefault();
        if (event.keyCode === 13) {
            $('.modal-body #Group').focus();
        }
    });

    var input4 = document.getElementById("Group");
    input4.addEventListener("keyup", function (event) {
        event.preventDefault();
        if (event.keyCode === 13) {
            $('.modal-body #Diagnoise').focus();
        }
    });
    var prov;
    $(function () {
        $('#Diagnoise').select2({
            dropdownParent: $('#AddCardModal .modal-content')
            //dropdownParent: $("#AddCardModal")
        })
        $('#Add').click(function () {
            if ($('.modal-body #LockStatus').val() != null && $('.modal-body #Provider').val() != ""
                && $('.modal-body #StartDate').val() != "" && $('.modal-body #NationalId').val() != ""
                && $('.modal-body #PhoneNumber').val() != "") {//Insert

                if ($('.modal-body #PhoneNumber').val().length == 11) {
                    if ($('.modal-body #NationalId').val().length == 14) {
                        $("#Add").attr("disabled", "disabled");
                        var SelectedDiagnosisList = $('#Diagnoise').select2('data');
                        var DiagnosisStr = SelectedDiagnosisList[0].text;
                        if (SelectedDiagnosisList.length > 1) {
                            for (var i = 1; i < SelectedDiagnosisList.length - 1; i++) {

                                DiagnosisStr = DiagnosisStr + '_' + SelectedDiagnosisList[i].text;
                            }
                            DiagnosisStr = DiagnosisStr + '_' + SelectedDiagnosisList[SelectedDiagnosisList.length - 1].text;
                        }
                        $.ajax({
                            type: 'POST',
                            url: '/DoctorApprovals/InsertCard/',
                            dataType: 'Json',
                            data: {
                                CARD_NO: $('.modal-body #CardId').val(),
                                PR_ANAME: $('.modal-body #Provider').val(),
                                MONTH_START_DATE: $('.modal-body #StartDate').val(),
                                ST_DAY: $('.modal-body #ExchangeDay').val(),
                                GROUP_ID: $('.modal-body #Group').val(),
                                TASHKHES_01: DiagnosisStr /*$('.modal-body #Diagnoise :selected').text()*/,
                                NO_PAY: $('.modal-body #CompanyPaymentLimit').val(),
                                NO_OVER: $('.modal-body #OverInsuranceLimit').val(),
                                LOOK_01: $('.modal-body #LockStatus').val(),
                                NOTES: $('.modal-body #NOTES').val(),
                                PhoneNumber: $('.modal-body #PhoneNumber').val(),
                                NationalId: $('.modal-body #NationalId').val(),
                                ExceptionType: $('.modal-body #ExceptionType').val()
                            },
                            success: function (r) {

                                $('#AddCardModal').modal('hide');
                                $('#Cards').dataTable().fnDestroy();

                                var setData = $("#Cards Tbody");
                                $('#Cards').DataTable({
                                    "bPaginate": false,
                                    "bLengthChange": false,
                                    "bFilter": true,
                                    "bInfo": false,
                                    "bAutoWidth": false
                                }).row.add([
                                    "<Button  class='btn btn-Primary glyphicon glyphicon-ok' onclick='SelectCard(this);'></Button>",
                                    $('.modal-body #CardId').val(),
                                    $('.modal-body #CardName').val(),
                                    $('.modal-body #Provider').val(),
                                    $('.modal-body #StartDate').val(),
                                    $('.modal-body #ExchangeDay').val(),
                                    $('.modal-body #Group :selected').text(),
                                    DiagnosisStr,
                                    $('.modal-body #CompanyPaymentLimit').val(),
                                    $('.modal-body #OverInsuranceLimit').val(),
                                    $('.modal-body #LockStatus :selected').text(),
                                    $('.modal-body #NOTES').val(),
                                    $('.modal-body #PhoneNumber').val(),
                                    $('.modal-body #NationalId').val(),
                                    $('.modal-body #ExceptionType').val(),
                                    "<Button class='btn btn-warning glyphicon glyphicon-pencil' onclick='EditCard(this);'> Edit</Button>"
                                ]).draw();
                                $('#Cards_filter input[type="search"]').val($('#AddCardTxt').val()).keyup();
                                $("#Add").attr("disabled", false);
                                $('#txtSearchCompany').val($('.modal-body #CardId').val().split('-', 1)[0]);
                                //reset values
                                $('.modal-body #Provider').val();
                                $('.modal-body #NOTES').val();
                                $('.modal-body #PhoneNumber').val(); 
                                $('.modal-body #NationalId').val();
                                $('.modal-body #ExceptionType').val(),
                                //$('.modal-body #StartDate').val(' ');
                                $('.modal-body #ExchangeDay').val('1');
                                $('.modal-body #Group').val();
                                $('.modal-body #Diagnoise').val();
                                $('.modal-body #CompanyPaymentLimit').val('0');
                                $('.modal-body #OverInsuranceLimit').val('0');
                                $('.modal-body #LockStatus').val('0');

                            },
                            error: function (err) {
                                bootbox.alert("Error Adding");
                                $("#Add").attr("disabled", false);

                            }
                        });


                    }
                    else {
                        toastr.warning("please Enter Correct National Id")
                    }
                }
                else {
                    toastr.warning("please Enter Correct Phone Number")
                }
            }
            else {
                toastr.warning("please fill required data")
            }
        });
        $('#StartDate').datepicker({
            // dateFormat: 'dd-mm-yyyy',
            minDate: '+0D',
        });
        $('#Provider').click(function () {
            //providers
            $.ajax({
                url: '/DoctorApprovals/getProviders/',
                dataType: 'Json',
                success: function (r) {
                    prov = "Add";
                    $('#AddCardModal').modal('hide');
                    $('#ProvidersModal').modal();
                    $('#Providers').dataTable().fnDestroy();
                    var setData = $("#Providers Tbody");
                    setData.empty();

                    for (var i = 0; i < r.length; i++) {

                        var data = "<tr >" +
                            "<td >" + "<Button  class='btn btn-Primary glyphicon glyphicon-ok' onclick='SelectProvider(this);'></Button>" + "</td>" +
                            "<td>" + r[i].PR_CODE + "</td>" +
                            "<td>" + r[i].PR_ANAME + "</td>" +
                            "<td>" + r[i].PR_ENAME + "</td>" +
                            "</tr>"
                        setData.append(data);

                    }
                    $('#Providers').DataTable();

                },
                error: function () {
                    alert("Error Providers");
                }

            });
        });
        //$('#Close').click(function () {
        //    $('.modal-body #Dose').val(' ');
        //    $('.modal-body #Duration').val(' ');
        //    $('.modal-body #NOM').val(' ');
        //});

    })
</script>
