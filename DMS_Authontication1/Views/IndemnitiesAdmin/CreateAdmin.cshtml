@model DMS_Authontication1.ViewModel.HR.IndemnityMasterVm

@{
    ViewBag.Title = "Create ";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}
<input type="text" id="UserCompId" value="@ViewBag.UserCompId" hidden="hidden" />
 
@using (Html.BeginForm("CreateAdmin", "IndemnitiesAdmin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal createInde-form", role = "form" }))
{
    <input type="hidden" id="CompanyName" name="CompanyName" value="@ViewBag.CompName" />

    @Html.AntiForgeryToken()
    <div class="portlet box dms-container "  >
        <div class="portlet-title title-bg">
            <div class="caption">
                <i class="fa fa-gift"></i>New Request
            </div>
        </div>
        <div class="portlet-body">
            <div class="form-horizontal ">
                <div class="d-flex flex-wrap row-gap-2 no-wrap mb-4">
                    @if (ViewBag.error != "0")
                    {
                        <p><h3 class="text-danger"> يجب ادخال جميع المرفقات بطريقه صحيحه  </h3></p>
                    }
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    @if (User.IsInRole("HR_Admin"))
                    {
                        <div class="forLabel col-md-4">
                            @*<span class="required"> * </span>*@
                            @Html.DropDownList("CompanyNumber", ViewBag.company as SelectList, new { @class = "", @required = "true", id = "CompanyNumber" })
                            <span>
                                @Html.Label("Company", htmlAttributes: new { @class = "control-label col-md-3" })
                            </span>
                        </div>
                        <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                        <script>
                            $(document).ready(function () {
                                $("#CompanyNumber").select2();
                            });
                        </script>
                    }

                    <div class="forLabel col-md-4">
                        @*<span class="text-danger">*</span>*@
                        @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @required = "true", @class = "" } })

                        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        <span>
                            @Html.Label("Email", htmlAttributes: new { @class = "control-label col-md-3" })
                        </span>
                    </div>
                    <div class="forLabel col-md-4">
                        @*<span class="text-danger">*</span>*@
                        @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "", @required = "true", @id = "Phone", @onkeypress = "return /[0-9]/i.test(event.key)" } })

                        @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
                        <span>
                            @Html.LabelFor(model => model.Phone, htmlAttributes: new { @class = "control-label col-md-3" })
                        </span>
                    </div>
                    <div class="forLabel col-md-4">
                        @if (User.IsInRole("User"))
                        {
                            @Html.DropDownListFor(m => m.Type, new List<SelectListItem>
                                    {
                                       new SelectListItem{ Text="Individual", Value = "1" ,Selected=true},
                                     }, null, new { @class = "", @required = "True", @disabled = "disabled" })
                        }
                        else
                        {
                            @Html.DropDownListFor(m => m.Type, new List<SelectListItem>
                                 {
                                    new SelectListItem{ Text="Individual", Value = "1" ,Selected=true},
                                    new SelectListItem{ Text="company", Value = "2" },
                                 }, null, new { @class = "", @required = "True" })
                        }
                        <span>
                            @Html.Label("Type of check", new { @class = "col-md-3 control-label" })
                        </span>
                    </div>
                    @if (User.IsInRole("User"))
                    {
                        <div id="divIndividual" class=" w-100 d-flex row-gap-2 ">
                            <div class="forLabel col-md-4">
                                <input type="hidden" id="userRole"required value="1" />
                                @Html.HiddenFor(model => model.RelatedCardId)
                                @*@Html.EditorFor(model=>model.RelatedCardId, new { htmlAttributes = new { @class = "", @value = '"'+ViewBag.cardID+'"' } })*@
                                <input type="text" id="RelatedCardId" required name="RelatedCardId" value="@ViewBag.cardID" class="" disabled />
                                @*@Html.DropDownListFor(model => model.RelatedCardId, Enumerable.Empty<SelectListItem>()
                    , htmlAttributes: new { @class = "js-data-example-ajax", @style = "width: 100%" })*@
                                @*<select id="RelatedCardId" class="js-data-example-ajax" style="width: 100%"></select>*@

                                @*@Html.EditorFor(model => model.CardID, new { htmlAttributes = new { @class = "", @required = "True" } })*@
                                @Html.ValidationMessageFor(model => model.RelatedCardId, "", new { @class = "text-danger" })
                                <span>
                                    @Html.Label("Card Id", htmlAttributes: new { @class = "control-label col-md-3" })
                                </span>
                            </div>
                            <div class="row" hidden>
                                <div class="forLabel col-md-4">
                                    @*<span class="text-danger">*</span>*@
                                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "", @required = "true" } })
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                    <span>
                                        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-3" })
                                    </span>
                                </div>
                            </div>
                            <div class="forLabel col-md-4">
                                @*<span class="text-danger">*</span>*@
                                @Html.EditorFor(model => model.NationalId, new { htmlAttributes = new { @class = "", @required = "true", @onkeypress = "return /[0-9]/i.test(event.key)" } })
                                @Html.ValidationMessageFor(model => model.NationalId, "", new { @class = "text-danger" })
                                <span>
                                    @Html.Label("National Id", htmlAttributes: new { @class = "control-label col-md-3" })
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div id="divIndividual" class=" w-100 d-flex row-gap-2 ">
                            <div class="forLabel col-md-4">
                                <input type="hidden" id="userRole" value="2"required />
                                @Html.DropDownListFor(model => model.RelatedCardId, Enumerable.Empty<SelectListItem>()
                                , htmlAttributes: new { @class = "js-data-example-ajax", @style = "width: 100%" })
                                @*<select id="RelatedCardId" class="js-data-example-ajax" style="width: 100%"></select>*@

                                @*@Html.EditorFor(model => model.CardID, new { htmlAttributes = new { @class = "", @required = "True" } })*@
                                @Html.ValidationMessageFor(model => model.RelatedCardId, "", new { @class = "text-danger" })
                                <span>
                                    @Html.Label("Card Id", htmlAttributes: new { @class = "control-label col-md-3" })
                                </span>
                            </div>
                            <div class="forLabel col-md-4">
                                @*<span class="text-danger">*</span>*@
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "" , @required = "true"} })
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                <span>
                                    @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-3" })
                                </span>
                            </div>
                            <div class="forLabel col-md-4">
                                @*<span class="text-danger">*</span>*@
                                @Html.EditorFor(model => model.NationalId, new { htmlAttributes = new { @class = "", @required = "true", @onkeypress = "return /[0-9]/i.test(event.key)" } })
                                @Html.ValidationMessageFor(model => model.NationalId, "", new { @class = "text-danger" })
                                <span>
                                    @Html.Label("National Id", htmlAttributes: new { @class = "control-label col-md-3" })
                                </span>
                            </div>
                        </div>
                    }
                    @*<div class="row">
        <div class="forLabel col-md-8">
            @Html.Label("Bank Name", htmlAttributes: new { @class = "control-label col-md-3" })
            <span class="text-danger">*</span>
            <div class="col-md-9">
                @Html.EditorFor(model => model.BankName, new { htmlAttributes = new { @class = "", @required = "True" } })
                @Html.ValidationMessageFor(model => model.BankName, "", new { @class = "text-danger" })
            </div>
        </div>
        </div>
        <div class="row">
            <div class="forLabel col-md-8">
                @Html.Label("Bank Branch", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.EditorFor(model => model.BankBranch, new { htmlAttributes = new { @class = "", @required = "True" } })
                    @Html.ValidationMessageFor(model => model.BankBranch, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="forLabel col-md-8">
                @Html.Label("Bank Account", htmlAttributes: new { @class = "control-label col-md-3" })
                <span class="text-danger">*</span>
                <div class="col-md-9">
                    @Html.EditorFor(model => model.BankAccount, new { htmlAttributes = new { @class = "", @required = "True" } })
                    @Html.ValidationMessageFor(model => model.BankAccount, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>*@

                    @*services details*@
                </div>
                <div class="portlet box   ">
                    <div class="portlet-title title-bg">
                        <div class="caption">
                            <i class="fa fa-gift"></i>Add Cards
                        </div>
                    </div>
                    <div class="portlet-body">
                        <div class="form-horizontal">
                            <div class="forLabel col-md-6">
                               <select id="CardId" class="js-data-example-ajax"required style="width: 100%"></select>
                               <span>
                                   @Html.Label("Card Id", htmlAttributes: new { @class = "control -label col-md-3" })
                               </span>
                            </div>

                            <div class="form-group"></div>
                            <div class="portlet box  green">
                                <div class="portlet-title">
                                    <div class="caption">
                                        <i class="fa fa-gift"></i>Card Services
                                    </div>

                                </div>
                                <br />
                                <div class="portlet-body">

                                    <table class="ui celled table" id="CardServices" width="100%">
                                        <thead>
                                            <tr>

                                                <th>
                                                    Card Id
                                                </th>


                                                <th>
                                                    National Id Image
                                                </th>
                                                <th>
                                                    Action
                                                </th>

                                            </tr>
                                        </thead>
                                        <tbody></tbody>

                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="portlet box   ">
                    <div class="portlet-title title-bg">
                        <div class="caption">
                            <i class="fa fa-gift"></i>Add services
                        </div>
                    </div>
                    <div class="portlet-body">
                        <div class="form-horizontal">


                            <div class="forLabel col-md-3">
                                @Html.DropDownList("Specialist", ViewBag.SpecialistId as SelectList, "", new { @class = " col-md-8", @required = "true", id = "Specialist" })
                                <span>
                                    @Html.Label("Specialist", htmlAttributes: new { @class = "control -label col-md-3" })
                                </span>
                            </div>


                            <div class="forLabel col-md-3">
                                @Html.DropDownList("Service", ViewBag.ServiceId as SelectList, "", new { @class = " col-md-8", @required = "true", id = "Services"})
                                <span>
                                    @Html.Label("Service", htmlAttributes: new { @class = "control-label col-md-3" })
                                </span>
                            </div>

                            <div class="forLabel col-md-2">
                                @Html.Editor("ValueTest", new { htmlAttributes = new { @class = "", @required = "True", @min = 1, @onkeypress = "return /[0-9]/i.test(event.key)" } })
                                @Html.ValidationMessage("ValueTest", "", new { @class = "text-danger" })
                                <span>
                                    @Html.Label("Value", htmlAttributes: new { @class = "control-label col-md-4" })
                                </span>
                            </div>

                            <div class="forLabel col-md-4">
                                @Html.Editor("ServiceDateTest", new { htmlAttributes = new { @class = "", @required = "True" } })
                                @Html.ValidationMessage("ServiceDateTest", "", new { @class = "text-danger" })
                                <span>
                                    @Html.Label("Service Date", htmlAttributes: new { @class = "control-label col-md-6" })
                            </span>
                        </div>



                        <input type="button" id="addServices" value="Add" class="btn btn-success" style="text-transform: none" />
                        <div class="form-group"></div>
                        <div class="portlet box  green">
                            <div class="portlet-title">
                                <div class="caption">
                                    <i class="fa fa-gift"></i>Services
                                </div>

                            </div>
                            <br />
                            <div class="portlet-body">

                                <table class="ui celled table" id="tblServices">
                                    <thead>
                                        <tr>
                                            <th>
                                                Card Id
                                            </th>
                                            <th>
                                                Specialist Name
                                            </th>
                                            <th>
                                                Service Name
                                            </th>
                                            <th>
                                                Total
                                            </th>
                                            <th>
                                                Service Date
                                            </th>
                                            <th>
                                                Service Files
                                            </th>
                                            <th style="text-align: center;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>

                                </table>
                            </div>
                        </div>

                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                    </div>
                </div>
            </div>
        </div>
        <div class="panel-footer" style="text-align:right;">
            <input data-step="9" data-intro="Reset Medicine" id="reset" type="button" value="Reset" onclick="ResetSaveIndemnty();" class="btn btn-warning" />
            <button id="btn_create_new" type="submit" class="btn btn-success" style="text-transform: none">
                <i class="fa fa-check"></i> Create
            </button>
        </div>
    </div>
}

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>

<script src="~/Scripts/DMS/HR/IndemnityAdminwithModel.js?V=1.3"></script>
