@model DMS_Authontication1.ViewModel.HR.IndemnityMasterVm

@{
    ViewBag.Title = "Create ";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}
<input type="text" id="UserCompId" value="@ViewBag.UserCompId" hidden="hidden" />

<br />
@using (Html.BeginForm("CreateAdmin", "IndemnitiesAdmin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal createInde-form", role = "form" }))
{
    @Html.AntiForgeryToken()
    <div class="portlet box  green" style="margin-top:40px">
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-gift"></i>New Request
            </div>
        </div>
        <div class="portlet-body">
            <div class="form-horizontal">
                @if (ViewBag.error != "0")
                {
                    <p><h3 class="text-danger"> يجب ادخال جميع المرفقات بطريقه صحيحه  </h3></p>
                }
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @if (User.IsInRole("HR_Admin"))
                {
                    <div class="row">
                        <div class="form-group col-md-6">
                            @Html.Label("Company", htmlAttributes: new { @class = "control-label col-md-3" })
                            <span class="required"> * </span>
                            <div class="col-md-9">
                                @Html.DropDownList("CompanyNumber", ViewBag.company as SelectList, new { @class = "form-control", id = "CompanyNumber" })

                            </div>
                        </div>
                    </div>
                    <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                    <script>
                        $(document).ready(function () {
                            $("#CompanyNumber").select2();
                        });
                    </script>
                }

                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.Label("Type of check", new { @class = "col-md-3 control-label" })
                        @if (User.IsInRole("User"))
                        {
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.Type, new List<SelectListItem>
                                     {
                                        new SelectListItem{ Text="Individual", Value = "1" ,Selected=true},
                                      }, null, new { @class = "form-control", @required = "True", @disabled = "disabled" })
                            </div>
                        }
                        else
                        {
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.Type, new List<SelectListItem>
                                     {
                                        new SelectListItem{ Text="Individual", Value = "1" ,Selected=true},
                                        new SelectListItem{ Text="company", Value = "2" },
                                     }, null, new { @class = "form-control", @required = "True" })
                            </div>
                        }

                    </div>
                </div>
                @if (User.IsInRole("User"))
                {
                    <div id="divIndividual">
                        <div class="row">
                            <div class="form-group col-md-6">
                                <input type="hidden" id="userRole" value="1" />
                                @Html.Label("Card Id", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="text" id="RelatedCardId" value="@ViewBag.cardID" class="form-control" disabled />
                                    @*@Html.DropDownListFor(model => model.RelatedCardId, Enumerable.Empty<SelectListItem>()
                                        , htmlAttributes: new { @class = "js-data-example-ajax", @style = "width: 100%" })*@
                                    @*<select id="RelatedCardId" class="js-data-example-ajax" style="width: 100%"></select>*@

                                    @*@Html.EditorFor(model => model.CardID, new { htmlAttributes = new { @class = "form-control", @required = "True" } })*@
                                    @Html.ValidationMessageFor(model => model.RelatedCardId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="row" hidden>
                            <div class="form-group col-md-6">
                                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-3" })
                                <span class="text-danger">*</span>
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-6">
                                @Html.Label("National Id", htmlAttributes: new { @class = "control-label col-md-3" })
                                <span class="text-danger">*</span>
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.NationalId, new { htmlAttributes = new { @class = "form-control", @onkeypress = "return /[0-9]/i.test(event.key)" } })
                                    @Html.ValidationMessageFor(model => model.NationalId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div id="divIndividual">
                        <div class="row">
                            <div class="form-group col-md-6">
                                <input type="hidden" id="userRole" value="2" />
                                @Html.Label("Card Id", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.RelatedCardId, Enumerable.Empty<SelectListItem>()
                                   , htmlAttributes: new { @class = "js-data-example-ajax", @style = "width: 100%" })
                                    @*<select id="RelatedCardId" class="js-data-example-ajax" style="width: 100%"></select>*@

                                    @*@Html.EditorFor(model => model.CardID, new { htmlAttributes = new { @class = "form-control", @required = "True" } })*@
                                    @Html.ValidationMessageFor(model => model.RelatedCardId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-6">
                                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-3" })
                                @*<span class="text-danger">*</span>*@
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-6">
                                @Html.Label("National Id", htmlAttributes: new { @class = "control-label col-md-3" })
                                <span class="text-danger">*</span>
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.NationalId, new { htmlAttributes = new { @class = "form-control", @onkeypress = "return /[0-9]/i.test(event.key)" } })
                                    @Html.ValidationMessageFor(model => model.NationalId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <div class="row" hidden>
                    <div class="form-group col-md-6" id="divCompany">
                        @Html.LabelFor(model => model.CompanyName, htmlAttributes: new { @class = "control-label col-md-2" })
                        <span class="text-danger">*</span>
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.CompanyName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.CompanyName, "", new { @class = "text-danger" })
                        </div>
                    </div>

                </div>
                <div class="row">

                    <div class="form-group col-md-6">
                        @Html.Label("Bank Name", htmlAttributes: new { @class = "control-label col-md-3" })
                        <span class="text-danger">*</span>
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.BankName, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.BankName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.Label("Bank Branch", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.BankBranch, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.BankBranch, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.Label("Bank Account", htmlAttributes: new { @class = "control-label col-md-3" })
                        <span class="text-danger">*</span>
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.BankAccount, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.BankAccount, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.Label("Email", htmlAttributes: new { @class = "control-label col-md-3" })
                        <span class="text-danger">*</span>
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })

                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.Phone, htmlAttributes: new { @class = "control-label col-md-3" })
                        <span class="text-danger">*</span>
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control", @id = "Phone", @required = "required", @onkeypress = "return /[0-9]/i.test(event.key)" } })

                            @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                @*services details*@

                <div class="portlet box  green">
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-gift"></i>Add Cards
                        </div>
                    </div>
                    <div class="portlet-body">
                        <div class="form-horizontal">
                            <div class="form-group col-md-6">
                                @Html.Label("Card Id", htmlAttributes: new { @class = "control -label col-md-3" })
                                <div class="col-md-10">
                                    <select id="CardId" class="js-data-example-ajax" style="width: 100%"></select>

                                    @*@Html.EditorFor(model => model.IndemnityCardsServices.First().CardId, new { htmlAttributes = new { @class = "form-control", @required = "True" } })*@
                                    @*@Html.ValidationMessageFor(model => model.IndemnityServiceMasters.First().CardId, "", new { @class = "text-danger" })*@
                                </div>
                            </div>
                            @*<div class="form-group col-md-3">
                                    @Html.LabelFor(model => model.IndemnityCardsServices.First().AttachPDF, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-10">
                                        @Html.EditorFor(model => model.IndemnityCardsServices.First().AttachPDF, new { htmlAttributes = new { @class = "form-control", @type = "File", @multiple = "True", @required = "True" } })
                                        @Html.ValidationMessageFor(model => model.IndemnityCardsServices.First().AttachPDF, "", new { @class = "text-danger" })
                                    </div>
                                </div>*@



                            @*<input type="button" id="addCardServices" value="Add" class="btn btn-success" style="text-transform: none" />*@
                            <div class="form-group"></div>
                            <div class="portlet box  green">
                                <div class="portlet-title">
                                    <div class="caption">
                                        <i class="fa fa-gift"></i>Card Services
                                    </div>

                                </div>
                                <br />
                                <div class="portlet-body">

                                    <table class="ui celled table" id="CardServices" width="100 %">
                                        <thead>
                                            <tr>

                                                <th>
                                                    Card Id
                                                </th>


                                                <th>
                                                    National Id Image
                                                </th>
                                                <th>
                                                    Action
                                                </th>

                                            </tr>
                                        </thead>
                                        <tbody></tbody>

                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="portlet box  green">
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-gift"></i>Add services
                        </div>
                    </div>
                    <div class="portlet-body">
                        <div class="form-horizontal">


                            <div class="form-group col-md-3">
                                @Html.Label("Specialist", htmlAttributes: new { @class = "control -label col-md-3" })
                                <div class="col-md-6">
                                    @* @Html.EditorFor(model => model.ServiceID, new { htmlAttributes = new { @class = "form-control" } })*@
                                    @Html.DropDownList("Specialist", ViewBag.SpecialistId as SelectList, "--Select--", new { @class = "form-control col-md-8", id = "Specialist", @required = "True" })

                                    @*@Html.ValidationMessageFor(model => model.ServiceTest.First().ServiceId, "", new { @class = "text-danger" })*@
                                </div>
                            </div>


                            <div class="form-group col-md-3">
                                @Html.Label("Service", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-6">
                                    @* @Html.EditorFor(model => model.ServiceID, new { htmlAttributes = new { @class = "form-control" } })*@
                                    @Html.DropDownList("Service", ViewBag.ServiceId as SelectList, "--Select--", new { @class = "form-control col-md-8", id = "Services", @required = "True" })

                                    @*@Html.ValidationMessageFor(model => model.Service.First().ServiceId, "", new { @class = "text-danger" })*@
                                </div>
                            </div>

                            <div class="form-group col-md-2">
                                @Html.Label("Value", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.Editor("ValueTest", new { htmlAttributes = new { @class = "form-control", @required = "True", @min = 1, @onkeypress = "return /[0-9]/i.test(event.key)" } })
                                    @Html.ValidationMessage("ValueTest", "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group col-md-4">
                                @Html.Label("Service Date", htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-6">
                                    @Html.Editor("ServiceDateTest", new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                                    @Html.ValidationMessage("ServiceDateTest", "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <input type="button" id="addServices" value="Add" class="btn btn-success" style="text-transform: none" />
                            <div class="form-group"></div>
                            <div class="portlet box  green">
                                <div class="portlet-title">
                                    <div class="caption">
                                        <i class="fa fa-gift"></i>Services
                                    </div>

                                </div>
                                <br />
                                <div class="portlet-body">

                                    <table class="ui celled table" id="tblServices">
                                        <thead>
                                            <tr>
                                                <th>
                                                    Card Id
                                                </th>
                                                <th>
                                                    Specialist Name
                                                </th>
                                                <th>
                                                    Service Name
                                                </th>
                                                <th>
                                                    Total
                                                </th>
                                                <th>
                                                    Service Date
                                                </th>
                                                <th>
                                                    Service Files
                                                </th>
                                                <th style="text-align: center;">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>

                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                    </div>
                </div>
            </div>
        </div>
        <div class="panel-footer" style="text-align:right;">
            <input data-step="9" data-intro="Reset Medicine" id="reset" type="button" value="Reset" onclick="ResetSaveIndemnty();" class="btn btn-warning" />
            @*<input type="submit" id="submit" value="Create" class="btn btn-success" style="text-transform: none" />*@
            <button id="btn_create_new" type="submit" class="btn btn-success" style="text-transform: none">
                <i class="fa fa-check"></i> Create
            </button>
        </div>
    </div>
}

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>

<script src="~/Scripts/DMS/HR/IndemnityAdminwithModel.js?V=1.1"></script>
