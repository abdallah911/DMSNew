                        @Html.DisplayFor(modelItem => item.ServiceDate)
                    </td>
                    <td>
                        <div class="btn fw-bold text-white rounded-3">
                            <i class="fa-solid fa-download me-1"></i> 
                            @Html.ActionLink(" Download", "Download", new { id = item.Id }, htmlAttributes: new { @class = " text-white ", @style = "text-decoration:none; text-transform: none" })
                        </div>
                    </td>


                </tr>
            }
