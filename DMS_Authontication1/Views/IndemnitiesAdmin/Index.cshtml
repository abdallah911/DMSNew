@model IEnumerable<DMS_Authontication1.Models.IndemnityMaster>
@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";

    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        if (User.IsInRole("User"))
        {
            modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
            if (modellist != null)
            {
                var obj = modellist.Where(x => x.ModuleName == "Customers Management" && x.PageId == 22 && (x.FullControl || x.EditPermission
                                              || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
                if (obj != null)
                {
                    edit = obj.EditPermission;
                    delete = obj.ActivationControl;
                    view = obj.Preview;
                    fullcontroll = obj.FullControl;
                    Create = obj.AddPermission;

                }
            }
        }
        else
        {
            modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
            if (modellist != null)
            {
                var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 13 && (x.FullControl || x.EditPermission
                                              || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
                if (obj != null)
                {
                    edit = obj.EditPermission;
                    delete = obj.ActivationControl;
                    view = obj.Preview;
                    fullcontroll = obj.FullControl;
                    Create = obj.AddPermission;

                }
            }
        }
    }
}


<div  >
    <p>
        @if (!User.IsInRole("Admin"))
        {
            if (fullcontroll || Create)
            {
                @Html.ActionLink(" New Request", "CreateAdmin", null, htmlAttributes: new { @class = "btn btn-info fa fa-plus", @style = " text-transform: none" })
            }
        }
    </p>
</div>
@if (!User.IsInRole("Admin") || fullcontroll || view)
{
    <div class="sios-container portlet box  green">
        <div class="row bg-overlay  editeRquest fw-bold portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa fa-gift me-3"></i>Requests
            </div>

        </div>
        <div class="cs-bg w-100 m-auto px-4 my-4 pb-5">
            <div class="table-responsive portlet-body">
                <table id="Index" class="table table-striped mt-3 text-center ">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Id)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Name)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.CompanyName)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Status)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.NationalID)
                            </th>
                            @*<th>
                            @Html.DisplayNameFor(model => model.BankName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.BankAccount)
                        </th>*@
                            @if (User.IsInRole("Admin"))
                            {
                                <th>
                                    @Html.DisplayNameFor(model => model.CreatedBy)

                                </th>
                            }

                            <th></th>
                            <th></th>
                        </tr>
                    </thead>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Id)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CompanyName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status)

                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.NationalID)
                            </td>
                            @*<td>
                            @Html.DisplayFor(modelItem => item.BankName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.BankAccount)
                        </td>*@
                            @if (User.IsInRole("Admin"))
                            {
                                <td>
                                    @Html.DisplayFor(modelItem => item.CreatedBy)
                                </td>
                            }
                            @if (!User.IsInRole("Admin") || fullcontroll || view)
                            {
                                <td class="  align-items-center gap-1">
                                    @Html.ActionLink(" Details", "Details", new { id = item.Id }, htmlAttributes: new { @class = " btn fw-bold text-white rounded-3 btn-primary fa fa-list", @style = " text-transform: none" })
                                </td>
                            }
                            @if (!User.IsInRole("Admin") || fullcontroll || delete)
                            {
                                <td style="white-space:nowrap" class="d-flex align-items-center gap-1">
                                    @Html.ActionLink(" Delete", "Delete", new { id = item.Id }, htmlAttributes: new { @class = "btn fw-bold text-white rounded-3 btn-danger fa fa-remove", @style = " text-transform: none" })
                                </td>
                            }
                        </tr>
                    }

                </table>
            </div>
        </div >
    </div>

}
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

<script>
    $(function () {
        $("#Index").DataTable({
        });
    })
</script>
