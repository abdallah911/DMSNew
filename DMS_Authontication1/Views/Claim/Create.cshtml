@model DMS_Authontication1.ViewModel.ClaimPhotoesViewModel
@{
    ViewBag.Title = "Create";
}

@*<h2>@ViewBag.Title.</h2>*@
<div class="dms-container">

    @using (Html.BeginForm("Create", "Claim", FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "createForm", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <div hidden>
            <input id="Speciality" name="Speciality" value="" />
            <input id="DiagnoisesJson" name="DiagnoisesJson" value="" />
        </div>
        <div class="panel panel-info">
            <h2 class="panel-heading title-bg text-white fw-bold" style="margin:1px;">Create Claim</h2>
            <div class="panel-body">
                @if (ViewBag.error != null)
                {
                    <h4 style="color:red;"> Claim added befor for this card</h4>
                }
                <div class="form-horizontal" style="padding-left: 93px;">
                    <hr />
                    @Html.ValidationSummary("", new { @class = "text-danger" })

                    <div class="form-group">
                        @Html.LabelFor(m => m.CardId, new { @class = "col-md-2 control-label" })
                        <div class="col-md-6">
                            @Html.TextBoxFor(m => m.CardId, new { @class = "form-control", @required = "true" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.ClaimNumber, new { @class = "col-md-2 control-label" })
                        <div class="col-md-6">
                            @Html.TextBoxFor(m => m.ClaimNumber, new { @class = "form-control", @id = "ClaimNumber", @required = "true" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Speciality, htmlAttributes: new { @class = "col-md-2 control-label" })
                        <div class="col-md-6">
                            @Html.DropDownList("ddlSpeciality", null, htmlAttributes: new { @class = "form-control", @id = "ddlSpeciality", @required = "true" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Diagnoise", new { @class = "col-md-2 control-label" })
                        <div class="col-md-6">
                            <select id="ddlDiagnoises" style="width:100%" multiple required></select>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Claim Photo", new { @class = "col-md-2 control-label" })
                        <div class="col-md-6">
                            @*<input type="file" id="wizard-picture" name="MainFileFile" accept="application/pdf" />*@
                            <input class="form-control text-box single-line" id="ImageFile" name="ImageFile" required accept="image/*" type="File" value="">
                        </div>
                    </div>
                </div>
            </div>
            <div class="panel-footer" style="text-align:right;">
                <input id="Back" type="button" value="Back" onclick="window.location.replace('/Claim/index');" class="btn btn-warning" />
                @*<input id="New" type="reset" value="Reset" class="btn btn-primary" />*@
                <input id="submit" type="submit" value="Save" onclick="Submitform();" class="btn btn-success" />
            </div>
        </div>
    }
    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }
</div>
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
@*<script src="~/Scripts/jquery-1.10.2.min.js"></script>*@
<script>
    $(function () {
        $("#ddlSpeciality").change(function () {
            $("#wait").css("display", "block");
            $.ajax({
                type: 'POST',
                url: '/Pharmacy/getDiag/',
                dataType: 'json',
                data: { id: $("#ddlSpeciality").val() },
                success: function (r) {
                    $('#ddlDiagnoises').empty();
                    var result = [];
                    for (var i = 0; i < r.length; i++) {
                        var current = {};
                        current.id = r[i].Code;
                        current.text = r[i].Name;
                        result.push(current);
                    }
                    $('#ddlDiagnoises').select2({
                        data: result
                    })
                    $("#wait").css("display", "none");

                },
                error: function (ex) {
                    bootbox.alert('Failed to retrieve Diagnoses , please check your internet connection');
                    $("#wait").css("display", "none");

                }

            });
        });
        $("#ddlSpeciality").map(function () {
            $.ajax({
                type: 'POST',
                url: '/Pharmacy/getDiag/',
                dataType: 'json',
                data: { id: $("#ddlSpeciality").val() },

                success: function (r) {
                    $('#ddlDiagnoises').empty();
                    var result = [];
                    for (var i = 0; i < r.length; i++) {
                        var current = {};
                        current.id = r[i].Code;
                        current.text = r[i].Name;
                        result.push(current);
                    }
                    $('#ddlDiagnoises').select2({
                        data: result
                    })

                    $("#wait").css("display", "none");

                },
                error: function (ex) {
                    bootbox.alert('Failed to retrieve Diagnoses, please check your internet connection');
                }

            });
        });
        $("#ddlSpeciality").select2();
        //$('#submit').click(function () {
        //    var SelectedDiagnosisList = $('#ddlDiagnoises').select2('data');
        //    var diagnose = [];
        //    for (var i = 0; i < SelectedDiagnosisList.length; i++) {
        //        var current = {};
        //        //current.DIAG_CODE = SelectedDiagnosisList[i].id;
        //        current.DIAG_ANAME = SelectedDiagnosisList[i].text;
        //        diagnose.push(current);
        //    }
        //    $("#Speciality").val($('#ddlSpeciality option:selected').text());
        //    $("#ClaimPhotoDiagnoises").val(diagnose);
        //    $("#createForm").submit();
        //});
    });
    function Submitform() {
        var SelectedDiagnosisList = $('#ddlDiagnoises').select2('data');
        var diagnose = [];
        for (var i = 0; i < SelectedDiagnosisList.length; i++) {
            //var current = {};
            //current.DIAG_CODE = SelectedDiagnosisList[i].id;
            //current.DIAG_ANAME = SelectedDiagnosisList[i].text;
            diagnose.push(SelectedDiagnosisList[i].text);
        }
        $("#Speciality").val($('#ddlSpeciality option:selected').text());
        //$("#SpecialOpportunityUsersJson").val(JSON.stringify(specialopport));

        $("#DiagnoisesJson").val(JSON.stringify(diagnose));
        $("#createForm").submit();
    }
</script>
