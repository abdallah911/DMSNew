<div class="container w-100" style=" width: 100%; min-height: calc(100vh - 219px); ">
    <h2>Profile </h2>
    <table class="table">
        <thead class="thead-light">
        <tbody>

            <tr>
                <th>User Name</th>
                <td>@ViewBag.UserName</td>
            </tr>
            <tr>
                <th>First Name</th>
                <td>@Model.FName</td>
            </tr>
            <tr>
                <th>Last Name</th>
                <td>@Model.LName</td>
            </tr>
            <tr>
                <th>Address</th>
                <td>@ViewBag.Address</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>@ViewBag.PhoneNumber</td>
            </tr>
            <tr>
                <th>E-mail</th>
                <td>@ViewBag.Email</td>
            </tr>
            <tr>
                <th>Role</th>
                <td>@Model.Type</td>
            </tr>
            @*<tr>
                <th>Change Password</th>
                <td>[ @Html.ActionLink("Change your password", "ChangePassword", "Manage") ]</td>
            </tr>*@

        </tbody>
    </table>
</div>



