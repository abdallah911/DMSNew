    Layout = "~/Views/Shared/_Layout_DashboardAdminNewWelcome.cshtml";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 259.5px); overflow:hidden;">
    <div class="Admin-container d-flex gap-5 flex-column my-4 m-auto align-items-center justify-content-center my-0">
        <div class="w-100 text-center ">
            <img style="width: 35%"
                 class="m-auto "
