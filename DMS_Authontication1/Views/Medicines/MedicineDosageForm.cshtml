@model DMS_Authontication1.ViewModel.DoasgeViewModel
@{
    ViewBag.Title = "MedicineDosageForm";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<!-- start section -->
<div class="row bg-overlay  editeRquest fw-bold my-4 portlet-title">
    <div class="m-3 fs-3 text-white caption">
        <h3 class=" fw-bold"> <i class="fa-solid fa-home me-1me-1"></i> New Dosage Form </h3>
    </div>
</div>

<section class="print-claim-section mt-4">
    @using (Html.BeginForm("MedicineDosageForm", "Medicines", FormMethod.Post))
    {
        <div class="container">
            <div class="row mt-3">
                <div class="row row-cols-sm-2 row-gap-3 mx-auto">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="col-md-8 ">
                        <div class="row col-12 col-md-2 my-auto">
                            @*@Html.LabelFor(model => model.DosageFormName, htmlAttributes: new { @class = "sios-color fw-bold" })*@
                        </div>
                        <div class="forLabel row col-12 col-md-6">
                            @Html.EditorFor(model => model.DosageFormName, new { htmlAttributes = new { @class = "admin-form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.DosageFormName, "", new { @class = "text-danger d-flex justify-content-end w-100" })
                            <span style="left:3px">Dosage Form Name</span>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex justify-content-center">
                        <input id="submit" type="submit" value="Create" class="btn fw-bold text-white rounded-3" />
                    </div>
                </div>
            </div>

        </div>
    }
</section>
<div style="display: flex; flex-direction: column">
    <section>
        <div class="row bg-overlay  editeRquest fw-bold my-4 portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <h3 class=" fw-bold"> Dosage Form List </h3>
            </div>
        </div>
        <div class="sios-bg claims-section mb-4 container-fluid">
            <div class="table-responsive">
                <table id="example" class="table table-striped mt-3 text-center">
                    <thead>
                        <tr>
                            <th>License Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DosageFormList)
                        {
                            <tr>

                                <td>
                                    @Html.DisplayFor(modelItem => item.DosageFormName)
                                </td>

                                <td>
                                    <button type="button" class="btn fw-bold text-white rounded-3" data-id=@item.Id onclick="Delete(this);"> Delete</button>
                                </td>

                            </tr>
                        }

                    </tbody>
                </table>
            </div>
            <div class="my-4 m-auto border-bottom border-2"></div>
        </div>
    </section>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script src="~/assets/NewDesignBackAdmin/JS/jquery.min.js"></script>

<script>
    $(function () {
        $("#example").DataTable();
    });
    function Delete(button) {

        var id = $(button).data('id');

        bootbox.confirm("Are you sure to delete This Dosage Form ?", function (result) {
            if (result) {
                $.ajax({
                    type: "POST",
                    dataType: "json",
                    url: '/Medicines/MedicineDosageFormDelete',
                    data: { id: id },
                    success: function (returndata) {
                        if (returndata.ok) {
                            toastr.success("Deleted")
                            location.reload();
                        }
                    }
                });
            }
        });
    }
</script>
