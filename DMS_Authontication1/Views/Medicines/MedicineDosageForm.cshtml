@model DMS_Authontication1.ViewModel.DoasgeViewModel
@{
    ViewBag.Title = "MedicineDosageForm";
}
<div class="dms-container">
    @using (Html.BeginForm("MedicineDosageForm", "Medicines", FormMethod.Post))
    {
        <div class="panel panel-primary">
            <h2 class="panel-heading title-bg text-white fw-bold" style="margin:1px;">New Dosage Form</h2>
            <div class="panel-body">
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-group">
                        @Html.LabelFor(model => model.DosageFormName, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.DosageFormName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.DosageFormName, "", new { @class = "text-danger" })
                        </div>
                    </div>


                </div>
            </div>
            <div class="panel-footer" style="text-align:right;">
                <input id="submit" type="submit" value="Create" class="btn btn-success" />
            </div>
        </div>
    }
    <div class="portlet box">
        <div class="portlet-title title-bg text-white fw-bold">
            <div class="caption">
                <i class="fa fa-"></i> Dosage Form List
            </div>
        </div>

        <div class="portlet-body">

            @Html.Partial("_MedicineDosageFormList")

        </div>
    </div>
</div>
<br />
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script>
    function Delete(button) {

        var id = $(button).data('id');

        bootbox.confirm("Are you sure to delete This Dosage Form ?", function (result) {
            if (result) {
                $.ajax({
                    type: "POST",
                    dataType: "json",
                    url: '/Medicines/MedicineDosageFormDelete',
                    data: { id: id },
                    success: function (returndata) {
                        if (returndata.ok) {
                            toastr.success("Deleted")
                            location.reload();
                        }
                    }
                });
            }
        });
    }
</script>
