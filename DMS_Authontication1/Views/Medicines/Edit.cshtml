<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script>
    var DiagnosisList = new Array();
    $(function () {
        $('#MED_GROUP').select2();

        //Retrive current Medicine Diagnoises
        $.ajax({
            type: 'POST',
            url: '/Medicines/GetCurrentDiagnosis/',
            dataType: 'json',
            data: { MedicineId: $('#Id').val() },
            success: function (r) {
                for (var i = 0; i < r.length; i++) {
                    var Diagnoises = {};
                    Diagnoises.DiagnoiseId = r[i].Id;
                    Diagnoises.MedicineId = $('#M_CODE').val();
                    DiagnosisList.push(Diagnoises);
                    $('#Diagnoise').val($('#Diagnoise').val() + r[i].DIAG_ANAME + "\n");
                }

            },
            error: function (ex) {
                alert('Failed to retrieve Diagnoses.');
            }

        });

        //Dignosies
        $.ajax({
            type: 'POST',
            url: '/Medicines/getDiag/',
            dataType: 'json',
            data: {},
            success: function (r) {
                $('#Diagnoises').dataTable().fnDestroy();
                var setData = $("#Diagnoises Tbody");
                setData.empty();

                for (var i = 0; i < r.length; i++) {
                    var data = "<tr>" +
                        "<td>" + "<Button class='btn btn-Primary glyphicon glyphicon-ok' onclick= 'SelectDiagnoise(this);' ></Button>" + "</td>" +
                        "<td>" + r[i].Code + "</td>" +
                        "<td>" + r[i].Name + "</td>" +
                        "</tr>";
                    setData.append(data);
                }

                $('#Diagnoises').DataTable();

            },
            error: function (ex) {
                alert('Failed to retrieve Diagnoses.');
            }

        });
        $('#AddDiagnoise').click(function () {
            $('#DiagnoiseModal').modal();
        });

        $('#RemoveDiagnoise').click(function () {
            DiagnosisList.splice(-1, 1);
            var splited = $('#Diagnoise').val().split("\n");
            if (splited[splited.length - 1] == "") {
                splited.splice(-1, 1);
                splited.splice(-1, 1);
                $('#Diagnoise').val(splited.join("\n") + "\n");
            }
            else {
                splited.splice(-1, 1);
                $('#Diagnoise').val(splited.join("\n"));
            }
        });
        $('#submit').click(function () {
            if ($('#M_CODE').val() != "") {
                if ($('#Diagnoise').val() != "") {
                    $('#submit').attr("disabled", "disabled");
                    $.ajax({
                        type: 'POST',
                        url: '/Medicines/EditData/',
                        dataType: 'Json',
                        data: {
                            M_CODE: $('#M_CODE').val(),
                            LIC_TYPE: $('#LIC_TYPE').val(),
                            MED_GROUP: $('#MED_GROUP').val(),
                            TRADE_NAME: $('#TRADE_NAME').val(),
                            DOSAGE_FORM: $('#DOSAGE_FORM').val(),
                            PACK_SIZE: $('#PACK_SIZE').val(),
                            PACK_PRICE: $('#PACK_PRICE').val(),
                            M_TYPE: $('#M_TYPE').val(),
                            CON_MED: $('#CON_MED').val(),
                            UNIT_NO: $('#UNIT_NO').val(),
                            UNIT_PRICE: $('#UNIT_PRICE').val(),
                            ACTIVE: $('#ACTIVE').val(),
                            GRN_CODE: $('#GRN_CODE').val(),
                            IsCovered: $('#IsCovered').val(),
                            DiagnoiseGender: $('#DiagnoiseGender').val(),
                            DiagnoiseAge: $('#DiagnoiseAge').val(),
                            Diagnose: $('#Diagnoise').val()
                        },
                        success: function (r) {
                            if (r.ok) {
                                bootbox.dialog({
                                    title: 'Success',
                                    message: r.message,
                                    buttons: {
                                        Ok: {
                                            label: "Ok",
                                            className: 'btn-info',
                                            callback: function () {
                                                //location.reload("/Medicines/index");
                                                window.location.replace("/Medicines/index");
                                            }
                                        }
                                    }
                                });
                            } else {
                                bootbox.dialog({
                                    title: 'Alert!',
                                    message: r.message,
                                    buttons: {
                                        Ok: {
                                            label: "Ok",
                                            className: 'btn-info',
                                            callback: function () {
                                                $('#submit').attr("disabled", false);
                                                //location.reload("/Medicines/index");
                                                //location.reload();
                                            }
                                        }
                                    }
                                });
                            }
                        }

                    });
                } else {
                    bootbox.alert("Please,Enter Diagnose Code");
                    $('#submit').attr("disabled", false);
                }
            } else {
                bootbox.alert("Please,Enter Medicine Code");
                $('#submit').attr("disabled", false);
            }
        });


    })
</script>
