@model DMS_Authontication1.ViewModel.MedicineTypeViewmodel
@{
    ViewBag.Title = "MedicineType";
}
<div class="dms-container">
    @using (Html.BeginForm("MedicineType", "Medicines", FormMethod.Post))
    {
        <div class="panel panel-primary">
            <h2 class="panel-heading title-bg text-white fw-bold" style="margin:1px;">New Medicine Type</h2>
            <div class="panel-body">
                <div class="form-horizontal">

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="form-group">
                        @Html.LabelFor(model => model.MedicineTypeName, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.MedicineTypeName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.MedicineTypeName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="panel-footer" style="text-align:right;">
                <input id="submit" type="submit" value="Create" class="btn btn-success" />
            </div>
        </div>
    }

    <div class="portlet box">
        <div class="portlet-title  title-bg text-white fw-bold">
            <div class="caption">
                <i class="fa fa-gift"></i>Medicine Type List
            </div>
        </div>

        <div class="portlet-body">
            @Html.Partial("_MedicineTypeList")
        </div>
    </div>
</div>
<br />

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script>
    function Delete(button) {

        var id = $(button).data('id');

        bootbox.confirm("Are you sure to delete This Medicine Type ?", function (result) {
            if (result) {
                $.ajax({
                    type: "POST",
                    dataType: "json",
                    url: '/Medicines/MedicineTypeDelete',
                    data: { id: id },
                    success: function (returndata) {
                        if (returndata.ok) {
                            toastr.success("Deleted")
                            location.reload();
                        }
                    }
                });
            }
        });
    }
</script>