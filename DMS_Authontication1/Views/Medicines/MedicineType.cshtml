@model DMS_Authontication1.ViewModel.MedicineTypeViewmodel
@{
    ViewBag.Title = "MedicineType";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<div class="sios-container">
    <!-- start section -->
    <div class="row bg-overlay  editeRquest fw-bold my-4 portlet-title">
        <div class="m-3 fs-3 fw-bold text-white caption"> 
            <h3 class=" fw-bold">    <i class="fa-solid fa-house me-1"></i>New Medicine Type</h3>
        </div>
    </div>

    <section class="print-claim-section ">
        @using (Html.BeginForm("MedicineType", "Medicines", FormMethod.Post))
        {
            <div class="container">
                <div class="row mt-3">
                    <div class="row row-cols-sm-2 row-gap-3 mx-auto">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="col-md-8 ">
                            <div class="row col-12 col-md-2 my-auto">
                                @*@Html.LabelFor(model => model.MedicineTypeName, htmlAttributes: new { @class = "sios-color fw-bold" })*@
                            </div>
                            <div class="forLabel row col-12 col-md-6">
                                @Html.EditorFor(model => model.MedicineTypeName, new { htmlAttributes = new { @class = "admin-form-control", @required = "True" } })
                                @Html.ValidationMessageFor(model => model.MedicineTypeName, "", new { @class = "text-danger d-flex justify-content-end w-100" })
                                <span style="left:3px">Medicine Type Name</span>
                            </div>
                        </div>
                        <div class="col-md-4  ">
                            <div class="position-relative ">
                                <i class="fa-solid fa-save position-absolute start-0 top-50 translate-middle text-white ms-3"></i>
                                <input id="submit" type="submit" value="Create" class="btn fw-bold text-white rounded-3 ps-4" />
                            </div> 
                        </div>
                        <div class="col-md-4 d-flex justify-content-center">
                     </div>
                    </div>
                </div>
               
            </div>
        }
    </section>
    <div style="display: flex; flex-direction: column">
        <section>
            <div class="row bg-overlay  editeRquest fw-bold my-4 mt-2 portlet-title">
                <div class="m-3 fs-3 fw-bold text-white caption">
                    <h3 class=" fw-bold">Medicine Type List</h3>
                </div>
            </div>
            <div class="sios-bg claims-section container-fluid mb-4">
                <div class="table-responsive">
                    <table id="example" class="table table-striped mt-3 text-center">
                        <thead>
                            <tr>
                                <th>License Name</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.medtypelist)
                            {
                                <tr>
                                    <td>
                                       @Html.DisplayFor(modelItem => item.MedicineTypeName)
                                    </td>
                                    <td>
                                       <button type="button" class="btn fw-bold text-white rounded-3" data-id=@item.Id onclick="Delete(this);"><i class="fa-solid fa-trash"></i> Delete</button>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
                <div class="my-4 m-auto border-bottom border-2"></div>
            </div>
        </section>
    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script>
    function Delete(button) {

        var id = $(button).data('id');

        bootbox.confirm("Are you sure to delete This Medicine Type ?", function (result) {
            if (result) {
                $.ajax({
                    type: "POST",
                    dataType: "json",
                    url: '/Medicines/MedicineTypeDelete',
                    data: { id: id },
                    success: function (returndata) {
                        if (returndata.ok) {
                            toastr.success("Deleted")
                            location.reload();
                        }
                    }
                });
            }
        });
    }
</script>