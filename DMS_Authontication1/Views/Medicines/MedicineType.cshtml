@model DMS_Authontication1.ViewModel.MedicineTypeViewmodel
@{
    ViewBag.Title = "MedicineType";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<!-- start section -->
<div class="sios-overlay container-fluid mt-4">
    <div class="container">
        <i class="fa-solid fa-house"></i>
        <h3>New Medicine Type</h3>
    </div>
</div>

<section class="print-claim-section  ">
    @using (Html.BeginForm("MedicineType", "Medicines", FormMethod.Post))
    {
        <div class="container">
            <div class="row mt-3">
                <div class="row row-cols-sm-3 m-auto m-sm-0">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 w-100">
                        <div class="row col-12 col-md-2 my-auto">
                            @Html.LabelFor(model => model.MedicineTypeName, htmlAttributes: new { @class = "fw-bold" })
                        </div>
                        <div class="row col-12 col-md-6">
                            @Html.EditorFor(model => model.MedicineTypeName, new { htmlAttributes = new { @class = "chronic-form-control" } })
                            @Html.ValidationMessageFor(model => model.MedicineTypeName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="print-claims-btns d-flex  justify-content-end">
                <input id="submit" type="submit" value="Create" class="btn fw-bold text-white rounded-3"
                       style="background-color: #717382" />
            </div>
        </div>
    }
</section>
<div style="display: flex; flex-direction: column">
    <section  >
        <div class="sios-overlay container-fluid mt-4">
            <div class="container">
                <i class="fa-solid fa-house"></i>
                <h3 class="">Medicine Type List</h3>
            </div>
        </div>
        <div class="sios-bg claims-section container-fluid mb-4">
            <div class="table-responsive">
                <table id="example" class="table table-striped mt-3 text-center">
                    <thead>
                        <tr>
                            <th>License Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.medtypelist)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MedicineTypeName)
                                </td>
                                <td>
                                    <button type="button" class="btn fw-bold text-white rounded-3" data-id=@item.Id onclick="Delete(this);"> Delete</button>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
            <div class="my-4 m-auto border-bottom border-2"></div>
        </div>
    </section>
</div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script>
    function Delete(button) {

        var id = $(button).data('id');

        bootbox.confirm("Are you sure to delete This Medicine Type ?", function (result) {
            if (result) {
                $.ajax({
                    type: "POST",
                    dataType: "json",
                    url: '/Medicines/MedicineTypeDelete',
                    data: { id: id },
                    success: function (returndata) {
                        if (returndata.ok) {
                            toastr.success("Deleted")
                            location.reload();
                        }
                    }
                });
            }
        });
    }
</script>