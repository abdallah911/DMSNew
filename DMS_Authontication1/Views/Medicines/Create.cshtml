@model DMS_Authontication1.ViewModel.MedicienDataViewModal

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
@Html.Partial("_Diagnoise")
<div class="sios-container panel panel-info">

    <div class="row bg-overlay  editeRquest fw-bold my-4 portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <h2 class="panel-heading">
            Create Medicine</h2>
        </div>
    </div>

    <div class="row container row-cols-md-2 mb-4 panel-body">
        <div class="row row-cols-sm-2 col-md-8  mx-auto row-gap-2 m-sm-0 justify-content-center form-horizontal " style="padding-left: 93px;">

            @Html.HiddenFor(x => x.MedicinesDiagnosis, new { id = "MedicinesDiagnosis" })
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @*@Html.Label("Medicine Code", htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="forLabel py-0 admin-form-control   form-control border-0 px-2 ">
                    @Html.EditorFor(model => model.M_CODE, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100   form-control", id = "M_CODE" } })
                    @Html.ValidationMessageFor(model => model.M_CODE, "", new { @class = "text-danger" })

                    <span style="padding-left: 10px;">
                        Medicine Code
                    </span>
                </div>
            </div>

            <div class="form-group">
                @*@Html.Label("License Type", htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="forLabel py-0 admin-form-control  form-control border-0 px-2 ">
                    @Html.DropDownList("LIC_TYPE", ViewBag.LicenceType as SelectList, new { @class = "admin-form-control w-100 h-100   form-control", id = "LIC_TYPE" })

                    @Html.ValidationMessageFor(model => model.LIC_TYPE, "", new { @class = "text-danger" })
                    <span style="padding-left: 10px;">License Type</span>
                </div>
            </div>

            <div class="form-group">
                @*@Html.Label("Medicine Group", htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="forLabel py-0 admin-form-control   form-control border-0 px-2 ">
                    @Html.DropDownList("MED_GROUP", ViewBag.MedicineGroup as SelectList, new { @class = "admin-form-control w-100 h-100   form-control", id = "MED_GROUP" })
                    @Html.ValidationMessageFor(model => model.MED_GROUP, "", new { @class = "text-danger" })
                    <span style="padding-left: 10px;">Medicine Group</span>
                </div>
            </div>

            <div class="form-group">
                @*@Html.Label("Medicine Name", htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="forLabel py-0 admin-form-control  form-control border-0 px-2 ">
                    @Html.EditorFor(model => model.TRADE_NAME, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100   form-control", id = "TRADE_NAME" } })
                    @Html.ValidationMessageFor(model => model.TRADE_NAME, "", new { @class = "text-danger" })
                    <span style="padding-left: 10px;">Medicine Name</span>
                </div>
            </div>

            <div class="form-group">
                @*@Html.Label("Dosage Form", htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="forLabel py-0 admin-form-control  form-control border-0 px-2 ">
                    @Html.DropDownList("DOSAGE_FORM", ViewBag.DosageForm as SelectList, new { @class = "admin-form-control w-100 h-100   form-control", id = "DOSAGE_FORM" })
                    @Html.ValidationMessageFor(model => model.DOSAGE_FORM, "", new { @class = "text-danger" })
                    <span style="padding-left: 10px;">Dosage Form</span>
                </div>
            </div>

            <div class="form-group">
                @*@Html.Label("Package Size", htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="forLabel py-0 admin-form-control   form-control border-0 px-2 ">
                    @Html.EditorFor(model => model.PACK_SIZE, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100   form-control", id = "PACK_SIZE", @onkeypress = "return /[0-9]/i.test(event.key)" } })
                    @Html.ValidationMessageFor(model => model.PACK_SIZE, "", new { @class = "text-danger" })
                    <span style="padding-left: 10px;">Package Size</span>
                </div>
            </div>

            <div class="form-group">
                @*@Html.Label("Package Price", htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="forLabel py-0 admin-form-control    form-control border-0 px-2 ">
                    @Html.EditorFor(model => model.PACK_PRICE, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100   form-control", id = "PACK_PRICE" } })
                    @Html.ValidationMessageFor(model => model.PACK_PRICE, "", new { @class = "text-danger" })
                    <span style="padding-left: 10px;">Package Price</span>
                </div>
            </div>

            <div class="form-group">
                @*@Html.Label("Medicine Type", htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="forLabel py-0 admin-form-control   form-control border-0 px-2 ">
                    @Html.DropDownList("M_TYPE", ViewBag.MedicineType as SelectList, new { @class = "admin-form-control w-100 h-100   form-control", id = "M_TYPE" })
                    @Html.ValidationMessageFor(model => model.M_TYPE, "", new { @class = "text-danger" })
                    <span style="padding-left: 10px;">Medicine Type</span>
                </div>
            </div>

            <div class="form-group">
                @*@Html.Label("Unit Number", htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="forLabel py-0 admin-form-control  form-control border-0 px-2 ">
                    @Html.EditorFor(model => model.UNIT_NO, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100   form-control", id = "UNIT_NO" } })
                    @Html.ValidationMessageFor(model => model.UNIT_NO, "", new { @class = "text-danger" })
                    <span style="padding-left: 10px;">Unit Number</span>
                </div>
            </div>

            <div class="form-group">
                @*@Html.Label("Unit Price", htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="forLabel py-0 admin-form-control   form-control border-0 px-2 ">
                    @Html.EditorFor(model => model.UNIT_PRICE, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100   form-control", id = "UNIT_PRICE" } })
                    @Html.ValidationMessageFor(model => model.UNIT_PRICE, "", new { @class = "text-danger" })
                    <span style="padding-left: 10px;">Unit Price</span>
                </div>
            </div>

            <div class="form-group">
                @*@Html.Label("Gender", htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="forLabel py-0 admin-form-control    form-control border-0 px-2 ">
                    @Html.DropDownList("DiagnoiseGender", new List<SelectListItem> {
                   new SelectListItem{Text="All",Value="3"},
                   new SelectListItem{Text="Male",Value="1"},
                   new SelectListItem{Text="Female",Value="2"}

               }, new { @class = "admin-form-control w-100 h-100   form-control", id = "DiagnoiseGender" })
                    @Html.ValidationMessageFor(model => model.DiagnoiseGender, "", new { @class = "text-danger" })
                    <span style="padding-left: 10px;">Gender</span>
                </div>
            </div>
            <div class="form-group">
                @*@Html.Label("Age", htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="forLabel py-0 admin-form-control   form-control border-0 px-2 ">
                    @Html.DropDownList("DiagnoiseAge", new List<SelectListItem> {
                   new SelectListItem{Text="All",Value="All"},
                   new SelectListItem{Text="Adult",Value="Adult"},
                   new SelectListItem{Text="Child",Value="Child"}


               }, new { @class = "admin-form-control w-100 h-100   form-control", id = "DiagnoiseAge" })
                    @Html.ValidationMessageFor(model => model.DiagnoiseAge, "", new { @class = "text-danger" })
                    <span style="padding-left: 10px;">Age</span>
                </div>
            </div>
            <div class="w-100  row row-cols-sm-2 row-gap-2 px-0">
                <div class="d-flex flex-column  row-gap-2 ">
                    <div class="form-group">
                        @*@Html.Label("IsCovered", htmlAttributes: new { @class = "control-label col-md-2" })*@
                        <div class="forLabel py-0 admin-form-control  form-control border-0 px-2 ">
                            @Html.DropDownList("IsCovered", new List<SelectListItem> {
                           new SelectListItem{Text="True",Value="True"},
                           new SelectListItem{Text="False",Value="False"},

                       }, new { @class = "admin-form-control w-100 h-100   form-control", id = "IsCovered" })
                            @Html.ValidationMessageFor(model => model.IsCovered, "", new { @class = "text-danger" })
                            <span style="padding-left: 10px;">Is Covered</span>
                        </div>
                    </div>


                    <div class="form-group">
                        @*@Html.Label("International Code", htmlAttributes: new { @class = "control-label col-md-2" })*@
                        <div class="forLabel py-0 admin-form-control border-0 px-2 ">
                            @Html.EditorFor(model => model.GRN_CODE, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100   form-control", id = "GRN_CODE" } })
                            @Html.ValidationMessageFor(model => model.GRN_CODE, "", new { @class = "text-danger" })
                            <span style="padding-left: 10px;">International Code</span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    @*@Html.Label("Diagnoise", new { @class = "col-md-2 control-label" })*@
                    <div class="input-group col-md-6" style="height:88px">
                        <div class="forLabel py-0 admin-form-control border-0 px-2 h-100 w-100   input-group-btn">
                            <div class="position-absolute end-0 top-0 mt-1 me-3">
                                <a id="AddDiagnoise" class="btn btn-default">
                                    <i class="fa-solid fa-plus text-white glyphicon glyphicon-plus-sign"></i>
                                </a>
                                <a id="RemoveDiagnoise" class="btn btn-default">
                                    <i class="fa-solid fa-minus text-white glyphicon glyphicon-minus-sign"></i>
                                </a>
                            </div>
                            <textarea id="Diagnoise" type="text" class="admin-form-control w-100 h-100   form-control " name="Diagnoise" placeholder="" value="" disabled></textarea>
                            <span style="padding-left: 10px;">diagnosis</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>


        <div class="col-md-4 d-flex  gap-2 justify-content-center  mt-3 mt-sm-auto ">
            <div class="position-relative ">
                <i class="fa-solid fa-chevron-left position-absolute start-0 top-50 translate-middle text-white ms-3"></i>
                <input id="Back" type="button" value="Back" onclick="window.location.replace('/Medicines/index');" class="btn fw-bold text-white rounded-3 ps-4" />
            </div>
            <div class="position-relative ">
                <i class="fa-solid fa-save position-absolute start-0 top-50 translate-middle text-white ms-3"></i>
                <input id="submit" type="submit" value="Update" class="btn fw-bold text-white rounded-3 ps-4" />
            </div>
        </div>
    </div>
</div>
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script>
    $(function () {

        //Dignosies
        $.ajax({
            type: 'POST',
            url: '/Medicines/getDiag/',
            dataType: 'json',
            data: {},
            success: function (r) {
                $('#Diagnoises').dataTable().fnDestroy();
                var setData = $("#Diagnoises Tbody");
                setData.empty();

                for (var i = 0; i < r.length; i++) {
                    var data = "<tr>" +
                        "<td>" + "<Button class='btn btn-Primary glyphicon glyphicon-ok' onclick= 'SelectDiagnoise(this);' ></Button>" + "</td>" +
                        "<td>" + r[i].Code + "</td>" +
                        "<td>" + r[i].Name + "</td>" +
                        "</tr>";
                    setData.append(data);
                }

                $('#Diagnoises').DataTable();

            },
            error: function (ex) {
                alert('Failed to retrieve Diagnoses.');
            }

        });
        $('#MED_GROUP').select2();
        $('#AddDiagnoise').click(function () {
            $('#DiagnoiseModal').modal();
        });

        $('#RemoveDiagnoise').click(function () {
            DiagnosisList.splice(-1, 1);
            var splited = $('#Diagnoise').val().split("\n");
            if (splited[splited.length - 1] == "") {
                splited.splice(-1, 1);
                splited.splice(-1, 1);

                $('#Diagnoise').val(splited.join("\n") + "\n");
            }
            else {
                splited.splice(-1, 1);
                $('#Diagnoise').val(splited.join("\n"));
            }
        });

        $('#submit').click(function () {
            if ($('#M_CODE').val() != "") {
                if ($('#Diagnoise').val() != "") {
                    $.ajax({
                        type: 'POST',
                        url: '/Medicines/SaveDatas/',
                        dataType: 'Json',
                        data: {

                            M_CODE: $('#M_CODE').val(),
                            LIC_TYPE: $('#LIC_TYPE').val(),
                            MED_GROUP: $('#MED_GROUP').val(),
                            TRADE_NAME: $('#TRADE_NAME').val(),
                            DOSAGE_FORM: $('#DOSAGE_FORM').val(),
                            PACK_SIZE: $('#PACK_SIZE').val(),
                            PACK_PRICE: $('#PACK_PRICE').val(),
                            M_TYPE: $('#M_TYPE').val(),
                            CON_MED: $('#CON_MED').val(),
                            UNIT_NO: $('#UNIT_NO').val(),
                            UNIT_PRICE: $('#UNIT_PRICE').val(),
                            ACTIVE: $('#ACTIVE').val(),
                            GRN_CODE: $('#GRN_CODE').val(),
                            IsCovered: $('#IsCovered').val(),
                            DiagnoiseGender: $('#DiagnoiseGender').val(),
                            DiagnoiseAge: $('#DiagnoiseAge').val(),
                            Diagnose: $('#Diagnoise').val()
                        },
                        success: function (r) {
                            if (r.ok) {
                                bootbox.dialog({
                                    title: 'Success',
                                    message: r.message,
                                    buttons: {
                                        Ok: {
                                            label: "Ok",
                                            className: 'btn-info',
                                            callback: function () {
                                                window.location.replace("/Medicines/index");
                                            }
                                        }
                                    }
                                });
                            } else {
                                bootbox.dialog({
                                    title: 'Alert!',
                                    message: r.message,
                                    buttons: {
                                        Ok: {
                                            label: "Ok",
                                            className: 'btn-info',
                                            callback: function () {
                                            }
                                        }
                                    }
                                });
                            }
                        }

                    });
                } else {
                    bootbox.alert("Please,Enter Diagnose Code");
                }
            } else {
                bootbox.alert("Please,Enter Medicine Code");
            }
        });
    })
</script>
