@model IEnumerable<DMS_Authontication1.Models.MedicineData>

@{
    ViewBag.Title = "Index";
}


<div class="portlet box dms-container">
    <div class="portlet-title title-bg text-white fw-bold">
        <div class="caption">
            <i class="fa fa-gift"></i>Medicines
        </div>
        <div class="actions">
            <a id="Create" href="/Medicines/Create" class="btn btn-success     btn-sm">
                <i class="fa fa-plus"></i> Create
            </a>
        </div>

    </div>

    <div class="portlet-body">
        <table class="ui celled table" id="Mediciness" style="width:100%">
            <thead>
                <tr>

                    <th>
                        Medicien Code
                    </th>
                    <th>
                        Medicien Name
                    </th>
                    <th>
                        Dosage Form
                    </th>
                    <th>
                        Package Price
                    </th>
                    <th>
                        Package size
                    </th>
                    <th>
                        Units Numbers
                    </th>

                    <th>
                        Unit Price
                    </th>
                    <th>
                        Group
                    </th>
                    <th>
                        license Type
                    </th> 
                    <th>
                        ACTIVE
                    </th>

                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>

        </table>
    </div>
</div>


<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script>
    $(function () {
        var id;
        $("#Mediciness").DataTable({
            "sAjaxSource": '/Medicines/MedList',
            "bServerSide": true,
            "processing": true,
            "bFilter": true,
            "bSort": false,
            "pageLength": 10,
            "bInfo": true,
            "columns": [
                { "data": "M_CODE", "name": "Medicine Code" },
                { "data": "TRADE_NAME", "name": "Medicine Name" },
                { "data": "DOSAGE_FORM", "name": "Dosage" },
                { "data": "PACK_PRICE", "name": "Package Price" },
                { "data": "PACK_SIZE", "name": "Package Size" },
                { "data": "UNIT_NO", "name": "UNIT_NO" },
                { "data": "UNIT_PRICE", "name": "UNIT_PRICE" },
                { "data": "MED_GROUP", "name": "Med Group" },
                { "data": "LIC_TYPE", "name": " LIC Type" },
                { "data": "ACTIVE", "name": "ACTIVE" },
                
                //{ "data": "M_TYPE", "name": "M Type" },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        return '<a class="btn btn-warning" href="/Medicines/Edit/' + data + '">Edit</a>';
                    }
                },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        return '<a class="btn btn-danger" href="/Medicines/MedicineActivation/' + data + '">Change Activation</a>';
                    }
                }


            ]
        });
    });



</script>