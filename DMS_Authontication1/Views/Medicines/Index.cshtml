@model IEnumerable<DMS_Authontication1.Models.MedicineData>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}

<section class="container-fluid mt-4">
    <!--  New request -->
    <div class="row bg-overlay">
        <div style="position: relative"
             class="editeRquest fw-bold text-light">
            <div class="m-3 fs-3">
                <i class="fa fa-home me-3"></i>
                Medicines
            </div>
            <div style=" position: absolute;right: 1%;top: 50%;transform: translateY(-50%);">
                <a id="Create" href="/Medicines/Create" class="px-2 text-light border-0 mx-2 rounded-2" style="background: #83439b;text-decoration: none;cursor: pointer;padding: 7.2px;">
                    <i class="fas fa-plus"></i> Create
                </a>
            </div>
        </div>
    </div>
</section>

<div class="w-100 m-auto px-4 mt-4 pb-5">
    <div class="table-responsive">
        <table id="Mediciness" class="table table-striped mt-3 text-center">
            <thead>
                <tr>

                    <th>
                        Medicien Code
                    </th>
                    <th>
                        Medicien Name
                    </th>
                    <th>
                        Dosage Form
                    </th>
                    <th>
                        Package Price
                    </th>
                    <th>
                        Package size
                    </th>
                    <th>
                        Units Numbers
                    </th>

                    <th>
                        Unit Price
                    </th>
                    <th>
                        Group
                    </th>
                    <th>
                        license Type
                    </th>
                    <th>
                        ACTIVE
                    </th>

                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>


<script src="~/assets/NewDesignBackAdmin/JS/jquery.min.js"></script>
<script>
    $(function () {
        var id;
        $("#Mediciness").DataTable({
            "sAjaxSource": '/Medicines/MedList',
            "bServerSide": true,
            "processing": true,
            "bFilter": true,
            "bSort": false,
            "pageLength": 10,
            "bInfo": true,
            "columns": [
                { "data": "M_CODE", "name": "Medicine Code" },
                { "data": "TRADE_NAME", "name": "Medicine Name" },
                { "data": "DOSAGE_FORM", "name": "Dosage" },
                { "data": "PACK_PRICE", "name": "Package Price" },
                { "data": "PACK_SIZE", "name": "Package Size" },
                { "data": "UNIT_NO", "name": "UNIT_NO" },
                { "data": "UNIT_PRICE", "name": "UNIT_PRICE" },
                { "data": "MED_GROUP", "name": "Med Group" },
                { "data": "LIC_TYPE", "name": " LIC Type" },
                { "data": "ACTIVE", "name": "ACTIVE" },

                //{ "data": "M_TYPE", "name": "M Type" },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        return '<a class="btn py-1 px-3 rounded-1 text-light border-0"style = "background: #717382;text-decoration: none;" href="/Medicines/Edit/' + data + '">Edit</a>';
                    }
                },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        return '<a class="btn py-1 px-3 rounded-1 text-light border-0"style = "background: #717382;text-decoration: none; " href="/Medicines/MedicineActivation/' + data + '">Change Activation</a>';
                    }
                }


            ]
        });
    });



</script>