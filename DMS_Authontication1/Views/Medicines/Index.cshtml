@model IEnumerable<DMS_Authontication1.Models.MedicineData>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<div class="sios-container">
    <section class="container-fluid mt-4">
        <!--  New request -->
        <div class="row bg-overlay">
            <div style="position: relative"
                 class="editeRquest fw-bold text-light">
                <div class="m-3 fw-bold fs-3">
                    <h3> <i class="fa-solid fa-home me-1"></i>  Medicines</h3>
                </div>
                <div style=" position: absolute;right: 1%;top: 50%;transform: translateY(-50%);">
                    <a id="Create" href="/Medicines/Create" class="btn fw-bold text-white rounded-3" style="cursor: pointer;padding: 7.2px;">
                        <i class="fa-solid fa-plus"></i> Create
                    </a>
                </div>
            </div>
        </div>
    </section>

    <div class="sios-bg w-100 m-auto px-4 my-4 pb-5">
        <div class="table-responsive">
            <table style="white-space:nowrap;" id="Mediciness" class="table table-striped mt-3 text-center">
                <thead>
                    <tr>

                        <th>
                            Medicien Code
                        </th>
                        <th>
                            Medicien Name
                        </th>
                        <th>
                            Dosage Form
                        </th>
                        <th>
                            Package Price
                        </th>
                        <th>
                            Package size
                        </th>
                        <th>
                            Units Numbers
                        </th>

                        <th>
                            Unit Price
                        </th>
                        <th>
                            Group
                        </th>
                        <th>
                            license Type
                        </th>
                        <th>
                            ACTIVE
                        </th>

                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/assets/NewDesignBackAdmin/JS/jquery.min.js"></script>
<script>
    $(function () {
        var id;
        $("#Mediciness").DataTable({
            "sAjaxSource": '/Medicines/MedList',
            "bServerSide": true,
            "processing": true,
            "bFilter": true,
            "bSort": false,
            "pageLength": 10,
            "bInfo": true,
            "columns": [
                { "data": "M_CODE", "name": "Medicine Code" },
                { "data": "TRADE_NAME", "name": "Medicine Name" },
                { "data": "DOSAGE_FORM", "name": "Dosage" },
                { "data": "PACK_PRICE", "name": "Package Price" },
                { "data": "PACK_SIZE", "name": "Package Size" },
                { "data": "UNIT_NO", "name": "UNIT_NO" },
                { "data": "UNIT_PRICE", "name": "UNIT_PRICE" },
                { "data": "MED_GROUP", "name": "Med Group" },
                { "data": "LIC_TYPE", "name": " LIC Type" },
                { "data": "ACTIVE", "name": "ACTIVE" },

                //{ "data": "M_TYPE", "name": "M Type" },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        return '<a class="btn fw-bold text-white rounded-3"style = "  text-decoration: none;" href="/Medicines/Edit/' + data + '"><i class="fa-solid fa-pen-to-square me-1"></i>Edit</a>';
                    }
                },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        return '<a class="btn fw-bold text-white rounded-3"style = "  text-decoration: none; " href="/Medicines/MedicineActivation/' + data + '"><i class="fa-solid fa-file-shield me-1"></i>Change Activation</a>';
                    }
                }


            ]
        });
    });



</script>