@model DMS_Authontication1.ViewModel.LicTypeViewModel
@{
    ViewBag.Title = "MedicineLicenseType";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<div class="sios-container">
    <!-- start section -->
    <div class="sios-overlay container-fluid mt-4">
        <div class="m-3 fs-3 text-white">
   
            <h3><i class="fa-solid fa-house me-3"></i>New License Type</h3>
        </div>
    </div>

    <section class="print-claim-section mb-4">
        @using (Html.BeginForm("MedicineLicenseType", "Medicines", FormMethod.Post))
        {
            <div class="container mb-0">
                <div class="row mt-3">
                    <div class="row row-cols-sm-2 row-gap-3 mx-auto">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class=" col-md-8  ">
                            <div class="  col-12 col-md-2 my-auto">
                                @*@Html.LabelFor(model => model.licType, htmlAttributes: new { @class = "sios-color fw-bold" })*@
                            </div>
                            <div class="forLabel row col-12 col-md-6">
                                @Html.EditorFor(model => model.licType, new { htmlAttributes = new { @class = "admin-form-control" } })
                                @Html.ValidationMessageFor(model => model.licType, "", new { @class = "text-danger" })
                                <span style="left:3px ">License Name</span>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex justify-content-center">
                            <input id="submit" type="submit" value="Create" class="btn mx-auto fw-bold text-white rounded-3" />
                        </div>
                    </div>
                </div>
               
            </div>
        }
    </section>
    <div style="display: flex; flex-direction: column">
        <section>
            <div class="sios-overlay container-fluid ">
                <div class="m-3 fs-3 text-white">
                   
                    <h3 class=""> <i class="fa-solid fa-house me-3"></i>Medicine License List</h3>
                </div>
            </div>
            <div class="sios-bg claims-section my-4 container-fluid">
                <div class="table-responsive">
                    <table id="example" class="table table-striped mt-4 text-center">
                        <thead>
                            <tr>
                                <th>License Name</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Licenses)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.LicenseName)
                                    </td>
                                    <td>
                                        <button type="button" class="btn fw-bold text-white rounded-3" data-id=@item.Id onclick="Delete(this);"> Delete</button>
                                    </td>

                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
                <div class="my-4 m-auto border-bottom border-2"></div>
            </div>
        </section>
    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script>
    function Delete(button) {

        var id = $(button).data('id');

        bootbox.confirm("Are you sure to delete This License Type ?", function (result) {
            if (result) {
                $.ajax({
                    type: "POST",
                    dataType: "json",
                    url: '/Medicines/MedicineLicenseDelete',
                    data: { id: id },
                    success: function (returndata) {
                        if (returndata.ok) {
                            toastr.success("Deleted")
                            location.reload();
                        }
                    }
                });
            }
        });
    }
</script>