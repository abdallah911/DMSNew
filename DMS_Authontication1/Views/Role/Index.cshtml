@model IEnumerable<DMS_Authontication1.Models.RoleViewModel>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}

<section class="container-fluid mt-4">
    <!--  New request -->
    <div class="row bg-overlay">
        <div style="position: relative"
             class="editeRquest fw-bold text-light">
            <div class="m-3 fs-3">
                <i class="fa-solid fa-home me-1 me-3"></i>
                Roles
            </div>
            <div style=" position: absolute;right: 1%;top: 50%;transform: translateY(-50%);">
                <a href="/Role/Create"
                   class="btn fw-bold text-white rounded-3"
                 >
                    <i class="h-100 fa-solid fa-plus"></i>
                    Create
                </a>
            </div>
        </div>
    </div>
</section>

<div class="sios-bg w-100 m-auto px-4 my-4 pb-5">
    <div class="table-responsive">
        <table id="Roles" class="table table-striped mt-3 text-center">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            <a class="btn fw-bold text-white rounded-3"  href="/Role/RolePermision/?RoleId=@item.Id"> Permisions</a>

                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="~/assets/NewDesignBackAdmin/JS/jquery.min.js"></script>

<script>

    $(function () {
        $("#Roles").DataTable();
    })
</script>