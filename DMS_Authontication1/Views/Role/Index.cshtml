@model IEnumerable<DMS_Authontication1.Models.RoleViewModel>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}

<section class="container-fluid mt-4">
    <!--  New request -->
    <div class="row bg-overlay">
        <div style="position: relative"
             class="editeRquest fw-bold text-light">
            <div class="m-3 fs-3">
                <i class="fa fa-home me-3"></i>
                Roles
            </div>
            <div style=" position: absolute;right: 1%;top: 50%;transform: translateY(-50%);">
                <a href="/Role/Create"
                   class="px-2 text-light border-0 mx-2 rounded-2"
                   style="
                  background: #83439b;
                  text-decoration: none;
                  cursor: pointer;
                  padding: 7.2px;">
                    <i class="fas fa-plus"></i>
                    Create
                </a>
            </div>
        </div>
    </div>
</section>

<div class="w-100 m-auto px-4 mt-4 pb-5">
    <div class="table-responsive">
        <table id="Roles" class="table table-striped mt-3 text-center">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            <a class="btn py-1 px-3 rounded-1 text-light border-0"style = "background: #717382;text-decoration: none;" href="/Role/RolePermision/?RoleId=@item.Id"> Permisions</a>

                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="~/assets/NewDesignBackAdmin/JS/jquery.min.js"></script>

<script>

    $(function () {
        $("#Roles").DataTable();
    })
</script>