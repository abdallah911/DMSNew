@model DMS_Authontication1.ViewModel.CustomerService.CustomerServiceViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}

<br />
<br />
@Html.Partial("_MedicalNetworkCustomerService")


<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

<div class="panel panel-info">
    <h2 class="panel-heading" style="margin:1px;">Card ID</h2>

    <div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
        <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
    </div>

    <div class="row">

        <div class="col-sm-3" data-step="1" data-hint='Step one!' data-intro="Enter Card ID OR Phone">
            <input id="txtSearch" type="text" placeholder="Enter Card Or Phone ...." class="form-control" />
        </div>
        <div class="col-sm-4" data-step="2" data-intro="click Search">
            <button id="Search" type="button" class="btn btn-primary">
                <i class="glyphicon glyphicon-search"></i> Search
            </button>
        </div>


        @*<div data-step="1" data-hint='Step one!' data-intro="Enter Card ID" class="col-sm-1">
                <input id="txtSearchCard" type="text" placeholder="search for card..." class="form-control" />
            </div>*@

        <div class="col-sm-3" data-step="3" data-intro="Select speciality">
            <select id="txtCardRelation" class="form-control" placeholder="Card Relation ..."></select>
        </div>



        <div class="col-sm-2" data-step="4" data-intro="click Search">
            <button id="SearchRelation" type="button" class="btn btn-primary">
                <i class="glyphicon glyphicon-search"></i> Search
            </button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12" style="margin-top:40px;margin-bottom:40px;margin-left:40px">
            @*Button Start Metting*@

            @*background-color: #e6b3cc;*@
            @*Label Timer*@
            <div class="col-md-4" style="text-align: center;margin-top: 5px;font:bold;font-size:20px;font-style:italic">
                <span id="hours"></span>:<span id="minutes"></span>:<span id="seconds"></span>
            </div>



            @*Button End Metting*@
            <div class="col-md-4">
                <input data-step="8" data-intro="End Call" type="button" value="End Call" class="btn btn-success" onclick="StopTime()" style="background-color:cornflowerblue; text-transform: none" />
            </div>

            <div class="col-sm-3" data-step="3" data-intro="Select speciality">
                <select id="txtPhone" class="form-control" placeholder="Phone Numbers ..."></select>
            </div>
        </div>


    </div>

    <div class="row" style=" text-align:right">
        <div class="col-md-12">
            <input id="ResetSearch" type="button" value="New" onclick="ClearAll();" class="btn btn-warning" />
            <input id="ShowInformation" type="button" value="Show Information" class="btn btn-primary fa fa-file-pdf-o" onclick="ShowInformationCard()" />
            @*<input id="PrintExcel" type="button" value="Excel" class="btn btn-success fa-file-excel-o " />
                <input id="AfterSalesSearch" type="button" value="Search" class="btn btn-default  fa fa-search" />*@

        </div>
    </div>
</div>

