@model DMS_Authontication1.ViewModel.CustomerService.CustomerServiceViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}
<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

<div class="portlet box  blue-pink">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-gift"></i>Hello world
        </div>
    </div>


    <div class="panel panel-info">
        <h2 class="panel-heading" style="margin:1px;">Card ID</h2>
        <div class="panel-body">
            <div class="row">
                <div class="form-group">
                    <div class="col-sm-2">
                        @Html.LabelFor(model => model.EmployeeName, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                    </div>
                    <div class="col-sm-2">
                        @Html.LabelFor(model => model.BirthDate, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.BirthDate, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                    </div>
                    <div class="col-sm-2">
                        @Html.LabelFor(model => model.Age, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.Age, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                    </div>
                    <div class="col-sm-2">
                        @Html.LabelFor(model => model.StartDate, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.StartDate, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                    </div>

                    <div class="col-sm-2" data-step="3" data-intro="Select speciality">
                        <label class="control-label">Main Services</label>
                        <select id="main_services" class="form-control">
                        </select>
                        @*@Html.LabelFor(model => model.speciality.special_Aname, htmlAttributes: new { @class = "control-label" })*@
                        @*@Html.DropDownList("ddlSpeciality", null, htmlAttributes: new { @class = "form-control", @id = "ddlSpeciality" })*@
                    </div>
                    <div class="col-sm-2" id="div_of_serv" data-step="4" data-intro="Select Sub Services">
                        <label class="control-label">Sub Services</label>
                        <select id="Services" class="form-control">
                            <option value="0"> اختر نوع الخدمه المطلوبه </option>
                        </select>

                    </div>


                    @*<div class="col-sm-2" data-step="8" data-intro="Select Diagnoises">
                            @Html.Label("Diagnoise", new { @class = "control-label" })
                            <select id="ddlDiagnoises" style="width:100%" multiple></select>
                        </div>*@
                    <div class="col-sm-2">
                        <input type="text" id="Con_Num" value="" hidden="hidden" />
                        <input type="text" id="Class_Code" value="" hidden="hidden" />
                        <input type="text" id="Company_ID" value="" hidden="hidden" />
                        <input type="text" id="IsCash" value="0" hidden="hidden" />
                        <input type="text" id="Num_Seessions" value="" hidden="hidden" />
                        <input type="text" id="Seession_Code" value="" hidden="hidden" />
                        <input type="text" id="providerHospialCode" value="@ViewBag.Provider" hidden="hidden" />

                    </div>
                </div>
            </div>
            <div class="row">
                @*<div class="col-sm-2">
                        @Html.LabelFor(model => model.compEmp.BIRTH_DATE, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.compEmp.BIRTH_DATE, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                    </div>*@
                <div class="col-sm-2" hidden="hidden">
                    <label class="control-label"> Limit </label>
                    <input id="Limit" type="text" class="form-control " ReadOnly="readonly" />
                </div>

                @*   نسبة تحمل المريض  *@

                <div class="col-sm-2">
                    <label class="control-label">Patient Percent </label>
                    <input id="celling-pert" type="text" class="form-control celling-pert" ReadOnly="readonly" />
                </div>

                <div id="serviceselect" class="col-sm-4" data-step="5" data-intro="Select Diagnoises" hidden="hidden">
                    @Html.Label("Service", new { @class = "control-label" })
                    <select id="ddlDiagnoises" style="width:100%" multiple="multiple">
                        <option value="0"> اختر نوع الخدمه المطلوبه </option>

                    </select>
                </div>
                <div id="SpecialityDiv" class="col-sm-4" data-step="5" data-intro="Select Diagnoises" hidden="hidden">
                    @Html.Label("Speciality", new { @class = "control-label" })
                    @Html.DropDownList("SpecialitySelect", null, htmlAttributes: new { @style = "width:100%", @id = "SpecialitySelect" })
                    @*<select id="SpecialitySelect" style="width:100%" multiple="multiple">
                            <option value="0"> اختر نوع الخدمه المطلوبه </option>

                        </select>*@
                </div>

                <div id="divNotes" class="col-sm-2" hidden="hidden" @*data-step="5" data-intro="Select Diagnoises"*@>
                    @Html.Label("Notes", new { @class = "control-label" })
                    <textarea id="Notetext" @*style="width:100%" multiple="multiple"*@>
                        </textarea>
                </div>

                @*<div id="DoctortDegree" class="col-sm-2" hidden="hidden" >
                        @Html.Label("Degree", new { @class = "control-label" })
                        <select id="degreeSelect" style="width:100%">
                            <option value="0"> اختر الدرجه العلميه </option>
                        </select>
                    </div>*@

                <div id="DoctortName" class="col-sm-4" hidden="hidden" @*data-step="5" data-intro="Select Diagnoises"*@>
                    @Html.Label("Doctor Name", new { @class = "control-label" })
                    <select id="doctorNameSelect" style="width:100%" multiple="multiple">
                    </select>
                </div>



            </div>
            <br />
            <div class="row" id="other-data">
                <div class="form-group">
                    <div class="col-sm-2" data-step="6" data-intro="Enter Phone Number">
                        @Html.Label("Phone Number", htmlAttributes: new { @class = "control-label" })
                        @Html.Editor("PhoneNumber", new { htmlAttributes = new { @class = "form-control", @onkeypress = "return /[0-9]/i.test(event.key)", @required = "true" } })
                    </div>
                    @*<div class="col-sm-2" data-step="7" data-intro="Enter Claim Number">
                            @Html.Label("Claim Number", htmlAttributes: new { @class = "control-label" })
                            @Html.Editor("ClaimNumber", new { htmlAttributes = new { @class = "form-control", @onkeypress = "return /[0-9]/i.test(event.key)", @required = "true" } })
                        </div>*@
                    <div class="col-sm-2" data-step="8" data-intro="National Id">
                        @Html.Label("National Id", htmlAttributes: new { @class = "control-label " })
                        @Html.Editor("NationalId", new { htmlAttributes = new { @class = "form-control", @maxlength = "14", @minlength = "14", @required = "true" } })
                        @Html.ValidationMessage("NationalId", "", new { @class = "text-danger" })

                    </div>
                </div>
            </div>
            <br />
            <div id="total_id" class="row">

                <div class="form-group">
                    <div class="col-sm-2" data-step="9" data-intro="Total Value">
                        <label class="control-label">Total Value </label>
                        <input id="txtTotal" type="text" class="form-control" onkeyup="PersonPayments()" onkeypress="return /[0-9 .]/i.test(event.key)" />
                    </div>

                    <div class="col-sm-2">
                        @Html.Label("Company Payment", htmlAttributes: new { @class = "control-label" })
                        @Html.Editor("CompanyPayment", new { htmlAttributes = new { @class = "form-control", @onkeypress = "return /[0-9]/i.test(event.key)", @ReadOnly = "readonly" } })
                    </div>
                    <div class="col-sm-2">
                        @Html.Label("Patient Co-Payment", htmlAttributes: new { @class = "control-label" })
                        @Html.Editor("PatientCoPayment", new { htmlAttributes = new { @class = "form-control", @onkeypress = "return /[0-9]/i.test(event.key)", @ReadOnly = "readonly" } })
                    </div>
                    <div class="col-sm-2">
                        @Html.Label("Over Insurance", htmlAttributes: new { @class = "control-label" })
                        @Html.Editor("OverInsurance", new { htmlAttributes = new { @class = "form-control", @onkeypress = "return /[0-9]/i.test(event.key)", @ReadOnly = "readonly" } })
                        @Html.ValidationMessage("OverInsurance", "", new { @class = "text-danger" })

                    </div>

                    <div class="col-sm-2">
                        <label class="control-label">Total Cash </label>
                        <input id="txtTotalCopayment" type="text" class="form-control" ReadOnly="readonly" />
                    </div>
                    <div class="col-sm-2">
                        <label class="control-label"> Cash </label>
                        <input id="Cash" type="text" class="form-control" ReadOnly="readonly" />
                    </div>

                </div>
            </div>


        </div>
    </div>


