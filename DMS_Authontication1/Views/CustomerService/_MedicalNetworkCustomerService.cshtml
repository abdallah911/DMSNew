@*@model IEnumerable<DMS_TEST.ViewModel.Container1>*@
@model DMS_Authontication1.ViewModel.CustomerService.DetailsCustomerServiceViewModel


<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

<div class="modal fade" id="MedicalNetworkCustomerServiceModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog  modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h3 id="TitleMedical" class="modal-title">Medical Network Screen</h3>
                <h3 id="TitleDetails" class="modal-title">Claim Details</h3>
            </div>

            <div class="modal-body" style="padding:10px 10px 0px 10px">

                <div id="MedicalNetworkScreen" class="form-group row col-xl-12">


                    <div class="form-group row col-xl-12">
                        <div class="col-md-2">
                            @Html.Label("Provider Type", htmlAttributes: new { @class = "control-label" })
                        </div>
                        @*@Html.DropDownList("Provider_Type", ViewBag.provider as SelectList, "Select Provider", new { @class = "form-control", id = "provider_Type" })*@
                        <div class="col-md-6">
                            <select id="provider_Type" class="form-control col-md-6"></select>
                        </div>
                    </div>

                    <div class="form-group row col-xl-12">
                        <div class="col-md-2">
                            @Html.Label("Governorate", htmlAttributes: new { @class = "control-label" })
                        </div>
                        @*@Html.DropDownList("Provider_Type", ViewBag.provider as SelectList, "Select Provider", new { @class = "form-control", id = "provider_Type" })*@
                        <div class="col-md-6">
                            <select id="Country_select" class="form-control col-md-6"></select>
                        </div>
                    </div>

                    <div class="form-group row col-xl-12">
                        <div class="col-md-2">
                            @Html.Label("Region", htmlAttributes: new { @class = "control-label" })
                        </div>
                        @*@Html.DropDownList("Provider_Type", ViewBag.provider as SelectList, "Select Provider", new { @class = "form-control", id = "provider_Type" })*@
                        <div class="col-md-6">
                            <select id="Region_select" class="form-control  col-md-6"></select>
                        </div>
                    </div>

                    <div class="form-group row col-xl-12">
                        <div class="col-md-2">
                            <button id="SearchProviderbtn" type="button" class="btn btn-success" onclick="SearchProvider()">
                                <span class="glyphicon glyphicon-search"></span> Search
                            </button>
                        </div>
                        <div class="col-md-2" id="div_of_serv">
                            <button id="new" type="button" class="btn btn-secondary-outline" onclick="NewRequest()">
                                <span class="fa fa-reply"></span> New
                            </button>

                        </div>
                    </div>

                    <div class="form-group row col-xl-12">
                        <div class="col-md-12" style="margin-top:80px;margin-bottom:100px" id="list_div">
                            <table class="table" id="ProviderList">
                                <thead>
                                    <tr>
                                        <th>
                                            @Html.DisplayName("PRENAME")
                                        </th>
                                        <th>
                                            @Html.DisplayName("ADDRESS 1")
                                        </th>
                                        <th>
                                            @Html.DisplayName("ADDRESS 2")
                                        </th>
                                        <th>
                                            @Html.DisplayName("TEL 1")
                                        </th>
                                        <th>
                                            @Html.DisplayName("TEL 2")
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="ProviderListBody"></tbody>
                            </table>
                        </div>

                    </div>

                </div>


                <div class="form-group row col-xl-12" id="ClaimsDetailsScreen">

                    <div class="form-group row col-xl-12">
                        <div class="col-md-2">
                            @Html.Label("Claims No", htmlAttributes: new { @class = "control-label" })
                        </div>


                        <div class="col-md-6">
                            @Html.EditorFor(model => model.ClaimNo, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        </div>
                    </div>

                    <div class="col-md-12" style="margin-top:80px;margin-bottom:100px" id="list_div">
                        <table class="table" id="ClaimsDataDetails">
                            <thead>
                                <tr>
                                    <th scope="col" align="center">PRV NAME</th>
                                    <th scope="col" align="center">SERV ANAME</th>
                                    <th scope="col" align="center">DIAGNOSIS</th>
                                    <th scope="col" align="center">INVT NO</th>
                                    <th scope="col" align="center">INVT NAM</th>
                                    <th scope="col" align="center">AMOUNT</th>
                                    <th scope="col" align="center">NOTES DET</th>
                                </tr>
                            </thead>
                            <tbody id="ClaimsDetailsBody"></tbody>
                        </table>
                    </div>

                </div>


                <div class="form-group row col-xl-12" id="IndemnityDetailsScreen">

                    <div class="form-group row col-xl-12">
                        <div class="col-md-2">
                            @Html.Label("Claims No", htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-6">
                            @Html.EditorFor(model => model.ClaimNo, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        </div>
                    </div>

                    <div class="col-md-6" style="margin-top:80px;margin-bottom:100px" id="list_div">
                        <table class="table" id="IndemnityDetailsData">
                            <thead>
                                <tr>
                                    <th scope="col" align="center">DIA CODE</th>
                                    <th scope="col" align="center">DIA ENAME</th>
                                    <th scope="col" align="center">DIA NOTES</th>
                                </tr>
                            </thead>
                            <tbody id="IndemnityListBody"></tbody>
                        </table>
                    </div>


                    <div class="col-md-6" style="margin-top:80px;margin-bottom:100px" id="list_div">
                        <table class="table" id="IndemnityDedDetails">
                            <thead>
                                <tr>
                                    <th scope="col" align="center">DED CODE</th>
                                    <th scope="col" align="center">DED DESC</th>

                                </tr>
                            </thead>
                            <tbody id="IndemnityDedDetailsBody"></tbody>
                        </table>
                    </div>

                </div>

                <div class="form-group row col-xl-12" id="MonthlyDetailsScreen">

                    <div class="form-group row col-xl-12">
                        <div class="col-md-2">
                            @Html.Label("Card No", htmlAttributes: new { @class = "control-label" })
                        </div>


                        <div class="col-md-6">
                            @Html.EditorFor(model => model.CardIdM, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        </div>
                    </div>

                    <div class="col-md-12" style="margin-top:80px;margin-bottom:100px" id="list_div">
                        <table class="table" id="MonthlyDataDetails">
                            <thead>
                                <tr>
                                    <th scope="col" align="center">MED CODE</th>
                                    <th scope="col" align="center">MED NAME</th>
                                    <th scope="col" align="center">DOSAGE FORM</th>
                                    <th scope="col" align="center">UNIT NO</th>
                                    <th scope="col" align="center">PACK SIZE</th>
                                    <th scope="col" align="center">DOS DUR</th>
                                    <th scope="col" align="center">TOT DUR</th>
                                    <th scope="col" align="center">CON MED</th>
                                    <th scope="col" align="center">ACTIVE</th>
                                    <th scope="col" align="center">INV DATE</th>
                                    <th scope="col" align="center">STATE</th>
                                </tr>
                            </thead>
                            <tbody id="MonthlyDetailsBody"></tbody>
                        </table>
                    </div>

                </div>


                <div class="form-group row col-xl-12" id="ClaimsLiveDetailsScreen">

                    <div class="form-group row col-xl-12">
                        <div class="col-md-2">
                            @Html.Label("Claims No", htmlAttributes: new { @class = "control-label" })
                        </div>


                        <div class="col-md-6">
                            @Html.EditorFor(model => model.ClaimNo, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        </div>
                    </div>

                    <div class="col-md-12" style="margin-top:80px;margin-bottom:100px" id="list_div">
                        <table class="table" id="ClaimsLiveDataDetails">
                            <thead>
                                <tr>
                                    <th scope="col" align="center">INVT NO</th>
                                    <th scope="col" align="center">INVT NAM</th>
                                    <th scope="col" align="center">DOSAGE</th>
                                    <th scope="col" align="center">PACK PRICE</th>
                                    <th scope="col" align="center">SIZE UNIT</th>
                                    <th scope="col" align="center">UNIT</th>
                                    <th scope="col" align="center">PRICE UNIT</th>
                                    <th scope="col" align="center">DOSE</th>
                                    <th scope="col" align="center">DUR</th>
                                    <th scope="col" align="center">DURATION</th>
                                    <th scope="col" align="center">REPEAT</th>
                                    <th scope="col" align="center">COUNT</th>
                                    <th scope="col" align="center">AMOUNT</th>                                
                                </tr>
                            </thead>
                            <tbody id="ClaimsLiveDetailsBody"></tbody>
                        </table>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

<script>
    //var input = document.getElementById("txtSearchCard");
    //input.addEventListener("keyup", function (event) {
    //    event.preventDefault();
    //    if (event.keyCode === 13) {

    //        $('#Search').click();
    //    }
    //});
    var searchtype = "unselect";
    $(document).ready(function () {
        // $('#ProviderList').DataTable();
        //    $('#list_div').hide();
        /* $("#Country_selectCountry_select").select2();
         $("#Region_select").select2();
         $("#provider_Type").select2();
         */
        // debugger;

        $("#Country_select").change(function () {//address
            if ($("#Country_select").val() != "" && $("#Country_select").val() != "0") {
                $.get("/MedicalNetwork/GetStateList",
                    { id: $("#Country_select").val() }, function (data) {
                        $("#Region_select").empty();
                        $('#Region_select').append('<option value="0">Select Region</option>');
                        $.each(data, function (index, row) {
                            $("#Region_select").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                        });
                    });
            }
            else {
                $("#Region_select").empty();
                $('#Region_select').append('<option value="0">Select Region</option>');
            }
        });
    });
    //Search Provider
    function SearchProvider() {
        debugger;
        $('#list_div').hide();

        //$("#ProviderListBody").html("");
        if ($('#CardID').val() != "") {
            var cardId = $("#CardID").val();
            var arraycomp = cardId.split('-');
            var CompId = arraycomp[0];

            if (arraycomp.length == 4 && arraycomp[3] != "") {

                // final chick if card id start with company id or not

                if ($("#provider_Type").val() == "") {
                    alert("Please select Provider ...");
                }
                else if ($("#Country_select").val() == "") {
                    alert("Please select Country ...");
                }
                else {

                    $.ajax({
                        url: '/CustomerService/GetProviders/',
                        data: {
                            cardId: cardId, compId: CompId, country: $("#Country_select").val(),
                            region: $("#Region_select").val(), providerId: $("#provider_Type").val()
                        },
                        dataType: 'Json',
                        success: function (r) {
                            $('#ProviderList').dataTable().fnDestroy();
                            if (r.msg == "ok") {
                                var setData = $("#ProviderList Tbody");
                                setData.empty();
                                for (var i = 0; i < r.providerslist.length; i++) {
                                    var data = "<tr >" +
                                        "<td>" + r.providerslist[i].PR_ANAME + "</td>";
                                    if (r.providerslist[i].ADDRESS1 == null)
                                        data += "<td>--</td>";
                                    else
                                        data += "<td>" + r.providerslist[i].ADDRESS1 + "</td>";
                                    if (r.providerslist[i].ADDRESS2 == null)
                                        data += "<td>--</td>";
                                    else
                                        data += "<td>" + r.providerslist[i].ADDRESS2 + "</td>";
                                    if (r.providerslist[i].TEL1 == null)
                                        data += "<td>--</td>";
                                    else
                                        data += "<td>" + r.providerslist[i].TEL1 + "</td>";
                                    if (r.providerslist[i].TEL2 == null)
                                        data += "<td>--</td>";
                                    else
                                        data += "<td>" + r.providerslist[i].TEL2 + "</td>" +
                                            "</tr>";
                                    setData.append(data);
                                }
                                $('#ProviderList').DataTable();
                                $('#list_div').show();
                            }
                            else {
                                alert(r.msg);
                            }

                        },
                        error: function () {
                            alert("Invalid Card ID ");
                        }
                    });
                }
            }
        }
    }
</script>

