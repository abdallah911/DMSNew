@model DMS_Authontication1.ViewModel.AdminChangeUserPasswordNM
@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<!-- start section -->
<div class="sios-overlay container-fluid mt-4">
    <div class="container">
        <i class="fa-solid fa-house"></i>
        <h3> Reset Password</h3>
    </div>
</div>

<section class="print-claim-section mt-5">
    @using (Html.BeginForm("AdminResetPassword", "User", FormMethod.Post, new { role = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.UserId, new { @value = ViewBag.UserId })
        @Html.ValidationSummary("", new { @class = "text-danger" })
        <div class="container">
            <div class="row mt-3" style="white-space:nowrap;">
                <div class="row row-cols-sm-3 m-auto m-sm-0">

                    <div class="forLabel   d-flex justify-content-start flex-column flex-md-row gap-md-5 w-100">
                        <div class="me-3 row col-12 col-md-2 my-auto">
                            @Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "sios-color fw-bold" })
                        </div>
                        <div class="row col-12 col-md-6">
                            @Html.PasswordFor(model => model.Password, htmlAttributes : new { @class = "admin-form-control", @style = "font-size: 16px" } )
                            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })

                        </div>
                    </div>
                    <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 mt-4 w-100">
                        <div class="me-3 row col-12 col-md-2 my-auto">
                            @Html.LabelFor(model => model.ConfirmPassword, htmlAttributes: new { @class = "sios-color fw-bold" })
                        </div>
                        <div class="row col-12 col-md-6">
                            @Html.PasswordFor(model => model.ConfirmPassword,    htmlAttributes: new { @class = "admin-form-control", @style = "font-size: 16px" } )
                            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })

                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3 justify-content-center">
                <input id="Back" type="button" value="Back" onclick="window.location.replace('/User/index');" class="btn fw-bold text-white rounded-3 "
                      />
                <input id="submit" type="submit" value="Change password" class="btn fw-bold text-white rounded-3 "
                    />
            </div>
        </div>
    }
</section>

<div style="display: flex; flex-direction: column">
    <section style="
          min-height: 80vh;
          display: flex;
          flex-direction: column;
          flex-grow: 1;
        ">
    </section>
</div>