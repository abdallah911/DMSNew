@model DMS_Authontication1.Models.ProposalBenefit

@{
    ViewBag.Title = "Create";
}




@using (Html.BeginForm("Create", "ProposalBenefits", FormMethod.Post))
{
@Html.AntiForgeryToken()
<div class="panel panel-info">
    <h2 class="panel-heading" style="margin:2px; text-align:center">Create Proposal Benefit</h2>
    <div class="panel-body">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })



        <div class="row">
            <div class="form-group col-lg-offset-4">
                @Html.LabelFor(model => model.TypeBenefitsId, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    <select class="form-select " name="TypeBenefitsId" id="ClassType" aria-label="Default select example">
                        <option value="1">annual ceiling</option>
                        <option value="2">network</option>
                        <option value="3">emergency room </option>
                        <option value="3">Medication Coverage</option>
                        <option value="4">Dental </option>
                        <option value="5">optical</option>
                    </select>
                        @Html.ValidationMessageFor(model => model.TypeBenefitsId, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group col-lg-offset-4">
                @Html.LabelFor(model => model.Match, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Match, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Match, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

          
        </div>
    </div>
<div class="panel-footer" style="text-align:center;">

    <input id="submit" type="submit" value="Create" class="btn btn-success" /> |
    <a class="btn btn-outline-info" asp-action="Index">"Back to List</a>
</div>
     }


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
