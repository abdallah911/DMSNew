@using DMS_Authontication1.ViewModel;
@using Microsoft.AspNet.Identity;
@model List<ProposalMainViewModel>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Proposal.cshtml";
    var currentUserId = User.Identity.GetUserId();
}

@section Styles {
    <link rel="stylesheet" href="~/ProposalAssets/CSS/broker.css" />
}

<!-- ////////////// Main Content ////////////// -->
<div style="display: flex; flex-direction: column; min-height: 90vh">
    <div class="bg-grid-container">
        <div class="flex-container" dir="rtl">
            <div class="part1">
                <div class="part1-1">
                    @using (Html.BeginForm("Index", "ProposalMain", FormMethod.Post, new { style = "display: flex; justify-content: center;" }))
                    {

                        <div class="search-cont">
                            <div style="width: 250px; position: relative; display: flex; justify-content: center; height: 90px; align-items: center; flex-wrap: wrap;  ">
                                <input type="text" id="searchInput" placeholder="الكود أو الإسم" style="width: 100%;" name="SearchValue" value="@ViewBag.SearchValue" />
                                <div class="position-absolute d-flex gap-2" style=" left: 5%; top: 24%; transform: translateY(-50%)">
                                    <label for="search-submit">
                                        <i style=" " class="fas fa-search"></i>
                                    </label>
                                    <label for="clearSearch">
                                        <i style=" " class="fas fa-remove"></i>
                                    </label>
                                </div>


                                <button type="button" hidden id="clearSearch">Clear</button>
                                <input id="search-submit" hidden type="Submit" value="بحث برقم الكود الإسم" />
                                <div class="  col">
                                    <div class="date-inp d-flex gap-4 mt-3">
                                        <input class="date-input action-form"
                                               type="text"
                                               id="inputformDate"
                                               name="startDate"
                                               placeholder="من تاريخ" />
                                        <input class="date-input action-form"
                                               type="text"
                                               id="inputToDate"
                                               name="endDate"
                                               placeholder="الى تاريخ" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    }

                    <div class="newDataDiv">
                        @Html.ActionLink("جديد +", "Create", "ProposalMain", new { }, new { @class = "newDataBtn", style = "text-decoration:none;" })

                        @*<span class="newDataBtn" onclick="openForm()">جديد +</span>*@
                    </div>
                </div>


                <div class="part1-2">
                    <div class="grey-background">
                        @if (Model?.Count() > 0)
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th scope="col">كود العملية</th>
                                        <th scope="col">اسم السمسار</th>
                                        <th scope="col">نسبة السمسار</th>

                                        <th scope="col">الاسم بالعربي</th>
                                        @*<th scope="col">الاسم بالانجليوي</th>*@
                                        @*<th scope="col">رقم التلفون</th>
                                            <th scope="col"> المنطقة</th>


                                            <th scope="col">اسم المسئول</th>
                                            <th scope="col">رقم الموبايل</th>*@

                                        <th scope="col">تاريخ العقد</th>
                                        @*  <th scope="col">البريد الالكتروني</th>*@
                                        <th scope="col"> نشاط الشركة</th>

                                        <th scope="col"> تأمين</th>

                                        <th scope="col">عدد الفئات</th>
                                        <th scope="col">الاستهلاكات </th>

                                        <th scope="col">تعديل</th>

                                        @*<th scope="col">تسعير</th>*@
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                    <tr>
                                        @if (@item.Code != null)
                                        {

                                            <td dir="ltr">@item.Code</td>
                                        }
                                        else
                                        {
                                            <td>لا يوجد</td>
                                        }
                                        @if (@item.BrokerName != null)
                                        {

                                            <td>@item.BrokerName</td>
                                            <td>@item.BrokerPercentage</td>
                                        }
                                        else
                                        {
                                            <td>لا يوجد</td>
                                            <td>لا يوجد</td>
                                        }
                                        <td>@item.CompanyArabicName</td>
                                        @*<td>@item.CompanyEnglishName</td>*@
                                        @*<td>@item.CompanyTelePhone</td>

        <td>@item.AreaName</td>
        <td>@item.AdministratorName</td>
        <td>@item.AdministratorPhone</td>*@
                                        <td>@item.ContractDate</td>
                                        @*<td>@item.Email</td>*@
                                        <td>@item.CompanyActivityName</td>

                                        <td>@item.InsuranceExists</td>


                                        <td>@item.CategoriesCount</td>
                                        @if (@item.ConsumptionFile != null)
                                        {
                                            <td>
                                                <a href="~/ProposalAssets/Files/ConsumptionFiles/@item.ConsumptionFileName" class="btn" style="text-decoration:none;color: #fff; background: #6e7085;padding: 10px 30px;border-radius: 10px;font-weight: var(--font - bold);font-size: 18px;box-shadow: 0 0 2px #14061b4d;cursor: pointer; " target="_blank">الاستهلاكات</a>

                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <a class="btn" style="white-space: nowrap;text-decoration: none; color: #fff; background: #6e7085; padding: 10px 30px; border-radius: 10px; font-weight: var(--font - bold); font-size: 18px; box-shadow: 0 0 2px #14061b4d; cursor: pointer; ">لا يوجد</a>

                                            </td>
                                        }
                                        @if (currentUserId == item.UserId)
                                        {
                                            <td>
                                                @Html.ActionLink("تعديل", "Edit", "ProposalMain", new { id = @item.Id }, new { style = "text-decoration:none;color: #fff; background: #6e7085;padding: 10px 30px;border-radius: 10px;font-weight: var(--font - bold);font-size: 18px;box-shadow: 0 0 2px #14061b4d;cursor: pointer; " })
                                            </td>
                                        }
                                        else
                                        {
                                    <td>
                                        <a class="btn" style="white-space: nowrap;text-decoration: none; color: #fff; background: #6e7085; padding: 10px 30px; border-radius: 10px; font-weight: var(--font - bold); font-size: 18px; box-shadow: 0 0 2px #14061b4d; cursor: pointer; ">غير مسموح</a>

                                    </td>
                                        }

                                        @*<td>
            @Html.ActionLink("تسعير", "PricingPage1", "ProposalMain", new { proposalMainId = @item.Id }, new { style = "text-decoration:none;color: #fff; background: #6e7085;padding: 10px 30px;border-radius: 10px;font-weight: var(--font - bold);font-size: 18px;box-shadow: 0 0 2px #14061b4d;cursor: pointer; " })
        </td>*@
                                    </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <h3>لا يوجد عروض!</h3>
                            </div>
                        }
                    </div>
                </div>


            </div>
            <div class="part2"></div>
        </div>

    </div>
</div>
@section Scripts{

    @if (TempData["UnauthorizedEditMessage"] != null)
    {
        <script>
        alert('@TempData["UnauthorizedEditMessage"]');
        </script>
    }
    <script>
    $(document).ready(function () {
        var successMessage = '@ViewBag.SuccessMessage';
        if (successMessage) {
            // Use the JavaScript alert function to display the message
            alert(successMessage);
        }
        // Set the value of the search input on document ready
        $("#searchInput").val("@ViewBag.SearchValue");

        // Handle click event for clear button
        $("#clearSearch").click(function () {
        // Clear the search input
        $("#searchInput").val("");

        // Submit the form to show all data
        $("#search-submit").click();
        });
        });
    </script>
}
