            const $toggleEnable = $("#toggleEnable");
            const $disabled = $("#disabled");
            const $brokeDisabled = $(".brokeDisabled");
            const $brokeEnabled = $(".brokeEnabled");

            function handleToggleEnableChange() {
                if ($toggleEnable.prop("checked")) {
                    $toggleEnable.css("marginTop", "10px");
                    $disabled.prop("disabled", false);
                    $brokeDisabled.hide();
                    $brokeEnabled.show();
                } else {
                    $toggleEnable.css("marginTop", "3px");
                    $disabled.prop("disabled", true);
                    $brokeDisabled.show();
                    $brokeEnabled.hide();
                }
            }

            $toggleEnable.change(handleToggleEnableChange);

            // Check the state of toggleEnable on page load
            if ($toggleEnable.prop("checked")) {
                handleToggleEnableChange(); // Call the function directly
            }

            // Assuming you have a function clearForm that resets your form
            $("#NewForm").click(function () {
                clearForm();
                handleToggleEnableChange(); // Call the function after clearing the form
            });
        });
        function clearForm() {
            // Replace 'yourFormId' with the actual ID of your form
            var form = document.getElementById('ProposalMainForm');

            // Reset the form
            form.reset();
            document.getElementById('districtBroker').value = '';
            document.getElementById('toggleEnable').checked = false;
            document.getElementById('BrokerPercentage').value = '';
            // Clear input values
            var inputElements = form.getElementsByTagName('input');
            for (var i = 0; i < inputElements.length; i++) {
                // Check if the input type is not 'submit', 'reset', 'button', or 'hidden'
                if (inputElements[i].type !== 'submit' && inputElements[i].type !== 'reset' &&
                    inputElements[i].type !== 'button' && inputElements[i].type !== 'hidden') {
                    inputElements[i].value = '';  // Clear the value of the input element
                }
            }
            // Clear radio button selections
            var radioElements = form.querySelectorAll('input[type="radio"]');
            for (var i = 0; i < radioElements.length; i++) {
                radioElements[i].checked = false;  // Uncheck the radio button
            }
            // Clear dropdown list selections
            var selectElements = form.getElementsByTagName('select');
            for (var i = 0; i < selectElements.length; i++) {
                selectElements[i].selectedIndex = -1;  // Clear the selected index of the dropdown list
            }
            // Clear validation messages
            var validationMessages = form.getElementsByClassName('text-danger');
            for (var i = 0; i < validationMessages.length; i++) {
                validationMessages[i].textContent = '';  // Clear the content of the validation message element
            }
        }
        function submitForm() {
            // Replace 'yourFormId' with the actual ID of your form
            var form = document.getElementById('ProposalMainForm');
            sessionStorage.setItem('formStepOneSubmitted', 'true');
            // Submit the form
            form.submit();
        }
        function goToIndex() {
            window.location.href = '/ProposalMain/Index';
        }
        function updateFileNameLabel(input, labelId) {

            if (input.files.length > 0) {
                var fileName = input.files[0].name;
                $("#" + labelId).text(fileName);
            }
        }
    </script>
