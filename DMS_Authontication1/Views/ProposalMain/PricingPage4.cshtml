    @section Scripts{
        <script>
            function updateCoronaVaccineCoverage(index, value) {
                // Update the corresponding property based on the radio button changes
                formData.Model.ProposalOutsideMedicalAuthorities[index].CoronaVaccineCoverage = value;

                // You can do additional logic here if needed
            }
    // Select the element with the 'spacing' class
    var spacingElement = document.querySelector(".spacing");
    document.addEventListener("DOMContentLoaded", function () {
        // Get all checkboxes with the class 'disable-checkbox'
        var checkboxes = document.querySelectorAll(".form-check-input");

        checkboxes.forEach(function (checkbox) {
            // Add an event listener to each checkbox
            checkbox.addEventListener("change", function () {
                // Get the target input ID from the 'data-target' attribute
                var targetInputId = checkbox.getAttribute("data-target");

                // Get the target input element
                var targetInput = document.getElementById(targetInputId);

                // Disable or enable the input based on the checkbox state
                targetInput.disabled = !checkbox.checked;
            });
        });
    });
            $(document).ready(function () {
                $('.form-check-input').prop('disabled', true);
                // Add event listener to all radio buttons
                //$(".radio-no").change(function () {
                //    // Find the sibling input and disable/enable based on the radio button state
                //    $(this).siblings(".dynamic-input").prop("disabled", this.checked);
                //});
            });
    function toggleContent() {
        // Get the window width
        var windowWidth =
            window.innerWidth ||
            document.documentElement.clientWidth ||
            document.body.clientWidth;

        // Check if the window width is less than 600
        if (windowWidth < 600) {
            // If true, delete the content inside the 'spacing' div
            if (spacingElement) {
                spacingElement.innerHTML = "";
            }
        } else {
            // If false, restore the original content
            if (spacingElement) {
                spacingElement.innerHTML =
                    "                                                                                                              ";
            }
        }
    }

    // Call the function on page load and resize
    window.onload = toggleContent;
    window.onresize = toggleContent;
    function clearForm() {
        // Replace 'yourFormId' with the actual ID of your form
        var form = document.getElementById('ProposalThirdForm');

        // Reset the form
        form.reset();
    }
    function submitForm() {
        // Replace 'yourFormId' with the actual ID of your form
        var form = document.getElementById('ProposalThirdForm');

        // Submit the form
        form.submit();
    }
    function goToIndex() {
        window.location.href = '/ProposalMain/Index';
    }
    function updateFileNameLabel(input, labelId) {
        if (input.files.length > 0) {
            var fileName = input.files[0].name;
            $("#" + labelId).text(fileName);
        }
    }
    function goBack() {
            window.history.back();
        @*var previousUrl = '@ViewBag.PreviousUrl';
        if (previousUrl) {
            window.location.href = previousUrl;
        } else {
            // If the referrer is not available, you can use a default URL or handle it as needed
            window.history.back();
        }*@
            }
            function updateHiddenInput(hiddenInputId, checkbox) {
                var hiddenInput = document.getElementById(hiddenInputId);
                if (hiddenInput) {
                    hiddenInput.value = checkbox.checked.toString();
                }
            }
        </script>
    }
