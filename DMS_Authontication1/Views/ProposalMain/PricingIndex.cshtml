@using DMS_Authontication1.ViewModel;
@model List<ProposalMainViewModel>
@{
    ViewBag.Title = "Pricing";
    Layout = "~/Views/Shared/_Layout_Proposal.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/ProposalAssets/CSS/broker.css" />
}

<!-- ////////////// Main Content ////////////// -->
<div style="display: flex; flex-direction: column; min-height: 90vh">
    <div class="bg-grid-container">
        <div class="flex-container" dir="rtl">
            <div class="part1">
                <div class="part1-1">
                    @using (Html.BeginForm("PricingIndex", "ProposalMain", FormMethod.Post, new { style = "display: flex; justify-content: center;" }))
                    {

                        <div class="search-cont">
                            <div style="width: 250px; position: relative; display: flex; justify-content: center; height: 90px; align-items: center; flex-wrap: wrap;  ">
                                <input type="text" id="searchInput" placeholder="بحث برقم الكود الإسم" style="width: 100%;" name="SearchValue" />
                                <div class="position-absolute d-flex gap-2" style=" left: 5%; top: 24%; transform: translateY(-50%)">
                                    <label for="search-submit">
                                        <i style=" " class="fas fa-search"></i>
                                    </label>
                                    <label for="clearSearch">
                                        <i style=" " class="fas fa-remove"></i>
                                    </label>
                                </div>


                                <button type="button" hidden id="clearSearch">Clear</button>
                                <input id="search-submit" hidden type="Submit" value="بحث برقم الكود الإسم" />
                                <div class="  col">
                                    <div class="date-inp d-flex gap-4 mt-3">
                                        <input class="date-input action-form"
                                               type="text"
                                               id="inputformDate"
                                               name="startDate"
                                               placeholder="من تاريخ" />
                                        <input class="date-input action-form"
                                               type="text"
                                               id="inputToDate"
                                               name="endDate"
                                               placeholder="الى تاريخ" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    }

                    <div class="newDataDiv">

                    </div>
                </div>


                <div class="part1-2">
                    <div class="grey-background">
                        @if (Model?.Count() > 0)
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th scope="col">كود العملية</th>

                                        <th scope="col">الاسم بالانجليوي</th>
                                        <th scope="col">رقم التلفون</th>

                                        <th scope="col">تاريخ العقد</th>

                                        <th scope="col"> نشاط الشركة</th>

                                        <th scope="col"> تأمين</th>

                                        <th scope="col">عدد الفئات</th>

                                        <th scope="col">تسعير</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            @if (@item.Code != null)
                                            {

                                                <td dir="ltr">@item.Code</td>
                                            }
                                            else
                                            {
                                                <td>لا يوجد</td>
                                            }


                                            <td>@item.CompanyEnglishName</td>
                                            <td>@item.CompanyTelePhone</td>


                                            <td>@item.ContractDate</td>

                                            <td>@item.CompanyActivityName</td>
                                            @if (item.InsuranceExists == true)
                                            {
                                                <td> يوجد تأمين</td>

                                            }
                                            else
                                            {
                                                <td>لا يوجد</td>

                                            }




                                            <td>@item.CategoriesCount</td>

                                            <td>
                                                @Html.ActionLink("تسعير", "PricingPage1", "ProposalMain", new { proposalMainId = @item.Id }, new { style = "text-decoration:none;color: #fff; background: #6e7085;padding: 10px 30px;border-radius: 10px;font-weight: var(--font - bold);font-size: 18px;box-shadow: 0 0 2px #14061b4d;cursor: pointer; " })
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <h3>لا يوجد عروض!</h3>
                            </div>
                        }
                    </div>
                </div>


            </div>
            <div class="part2"></div>
        </div>

    </div>
</div>
@section Scripts{
    @if (TempData["UnauthorizedEditMessage"] != null)
    {
        <script>
        alert('@TempData["UnauthorizedEditMessage"]');
        </script>
    }
    <script>
    $(document).ready(function () {

        // Set the value of the search input on document ready
        $("#searchInput").val("@ViewBag.SearchValue");

        // Handle click event for clear button
        $("#clearSearch").click(function () {
            // Clear the search input
            $("#searchInput").val("");

            // Submit the form to show all data
            $("#search-submit").click();
        });
    });
    </script>
}
