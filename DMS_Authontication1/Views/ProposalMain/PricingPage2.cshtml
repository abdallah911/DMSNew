@section Scripts{
    <script>

        window.onbeforeunload = function () {
            var formData = [];
            console.log("hellooooooooooooooooooooooooooooo");
            // Loop through each form item
            for (var index = 0; index < @Model.Catcount; index++) {
                var formItem = {
                    NewPrice: document.getElementsByName("Model.NewPrices[" + index + "]")[0].value,
                    // Add other fields as needed
                };

                // Add the formItem to the formData array
                formData.push(formItem);
                console.log(formItem);
            }

            // Store the formData in sessionStorage
            sessionStorage.setItem('formDataPricing', JSON.stringify(formData));

        };
       
        // Function to restore the form data from sessionStorage
        function restoreFormData() {
                // The form has been submitted, load and restore the formData
                var storedData = sessionStorage.getItem('formDataPricing');
                if (storedData) {
                    var formData = JSON.parse(storedData);

                    // Loop through each form item and populate the corresponding fields
                    for (var index = 0; index < formData.length; index++) {
                        document.getElementsByName("Model.NewPrices[" + index + "]")[0].value = formData[index].NewPrice;
                    }
                }
        }
        window.onload = restoreFormData;
        function goToIndex() {
            window.location.href = '/ProposalMain/Index';
        }
        function updateFileNameLabel(input, labelId) {
            if (input.files.length > 0) {
                var fileName = input.files[0].name;
                $("#" + labelId).text(fileName);
            }
        }
        function goBack() {
                window.history.back();
        }
    </script>
    }
