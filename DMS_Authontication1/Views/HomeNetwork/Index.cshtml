@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Search";
    Layout = "~/Views/Shared/_Layout_DashboardHomePage.cshtml";

}
@*<h2>Index</h2>*@
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>
<input type="text" id="compname" value="@ViewBag.CompName" hidden="hidden" />

<div style="min-height: calc(100vh - 241.5px);">
    <div class="row bg-overlay portlet-title">
        <div class="m-3 my-2 fs-3 fw-bold text-white caption">
            <i class="fa-solid fa-home me-1"></i>Network
        </div>
    </div>
    <div class="container mx-auto">
        <div class=" col-md-4  forLabel px-2 border-0 mt-4 mb-3">
            <input type="number" class="border-2 admin-form-control w-100" required="required" />
            <span>Card Number</span>
        </div>
    </div>
    <div class="container mx-auto row row-cols-sm-2 row-cols-md-3 row-gap-2 ">
        <div class="forLabel px-2 border-0 ">
            <select class="border-2 admin-form-control w-100" required="required"></select>
            <span>Provider Type</span>
        </div>
        <div class="forLabel px-2 border-0 ">
            <select class="border-2 admin-form-control w-100" required="required"></select>
            <span>Governorate</span>
        </div>
        <div class="forLabel px-2 border-0 ">
            <select class="border-2 admin-form-control w-100" required="required"></select>
            <span>Region</span>
        </div>

    </div>
    @*Date of Service*@
    <div class=" container m-auto px-4 my-4">
        <div class=" mx-auto my-4 table-responsive" id="">
            <table class="table home-page-table border-1" id="homePage">
                <thead class="rounded">
                    <tr>
                        <th>Pre Name</th>
                        <th>Address</th>
                        <th>Address</th>
                        <th>Tel</th>
                        <th>Tel</th>
                        <th>Specialist</th>
                    </tr>
                </thead>
                <tbody id="ProviderListBody"></tbody>
            </table>
        </div>
    </div>
    <div class="container mx-auto row row-cols-md-2 mb-4">
        <div style="height:420px" class="sios-bg border-0 rounded-4 p-4">
            <video class="w-100 h-100 rounded-4 video-js" controls="controls"  preload="auto" data-setup="{}" >
                <source src="~/assets/NewDesign/img/Animation/Dms-Video.mp4" type="video/mp4" />
            </video>
        </div>
        <h3 class="sios-color my-auto fw-medium">DMS Description</h3>
    </div>
</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script> 
<script src="~/assets/NewDesign/js/video.min.js"></script>
<script>

    $(document).ready(function () {
        $("#homePage").DataTable();

    });
</script>