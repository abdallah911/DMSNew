                        alert('Failed to retrieve Comanies.');
                    }

                });
            }
            else if ($(this).val() == "7") {// Hr Admin
                $("#hideProvider").hide();
                $("#hideCompny").show();
                $("#RoleName").val(0);
                $("#RoleName").prop("disabled", false);
                $.ajax({
                    type: 'POST',
                    url: '/Account/getCompines/',
                    dataType: 'json',
                    success: function (r) {
