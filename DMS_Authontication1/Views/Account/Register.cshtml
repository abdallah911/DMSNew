                $("#hideProvider").hide();
                $("#RoleName").val(0);
                $("#RoleName").prop("disabled", false);
            }
            else if ($(this).val() == "6" || $(this).val() == "8") {
                $("#hideProvider").show();
                $("#hideCompny").hide();
                //$("#RoleName").val(0);
                //$("#RoleName").prop("disabled", false);
