@model DMS_Authontication1.Models.RegisterViewModel
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>


@using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
<div>
    @Html.AntiForgeryToken()
    <section class="container-fluid mt-4">
        <!--  New request -->
        <div class="row bg-overlay">
            <div style="position: relative"
                 class="editeRquest fw-bold text-light">
                <div class="m-3 fs-3">
                    <i class="fa-solid fa-home me-1"></i>
                    Create User
                </div>
            </div>
        </div>
    </section>
    <div class="sios-container">
        <div class="container col-10 px-0">
            <div style="white-space: nowrap"
                 class=" mt-4">
                <div class="row row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 row-gap-3  m-auto m-sm-0 mt-4 text-center ">
                    <div class="forLabel admin-form-control   border-0 px-2">
                        @*@Html.LabelFor(m => m.Type, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.DropDownListFor(m => m.Type, new List<SelectListItem>
                            {
                               new SelectListItem{ Text="Hospital", Value = "1" },
                               new SelectListItem{ Text="Pharmacy", Value = "2" },
                               new SelectListItem{ Text="Lab", Value = "3" },
                               new SelectListItem{ Text="Rays lab", Value = "4" },
                               new SelectListItem{ Text="Doctor", Value = "5" },
                               new SelectListItem{ Text="Physical Therapy", Value = "6" },
                               new SelectListItem{ Text="Dental Clinic", Value = "7" },
                               new SelectListItem{ Text="After Sale", Value = "8" },
                               new SelectListItem{ Text="HR", Value = "9" },
                               new SelectListItem{ Text="HR Admin", Value = "10" },
                               //,new SelectListItem{ Text="Pharmacy Admin", Value = "9" }
                            }, "--Select--", new { @class = "admin-form-control w-100 h-100 " })
                        <span>
                            Register type
                        </span>
                    </div>

                    <div class="forLabel admin-form-control   border-0 px-2" id="hideProvider">
                        @*@Html.LabelFor(m => m.Provider, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.DropDownList("Provider", ViewBag.provider as SelectList, "--Select--", new { @class = "admin-form-control w-100 h-100 " })
                        <span>The Provider</span>
                    </div>
                    <div class="forLabel admin-form-control   border-0 px-2" id="hideCompny" hidden="hidden">
                        @*@Html.Label("Compines", new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        <select id="AddCompanies" name="AddCompanies" multiple="multiple" class="admin-form-control w-100 h-100 ">
                            <option value="0">All</option>
                        </select>
                        <span> </span>
                    </div>
                    <div class="forLabel admin-form-control   border-0 px-2">
                        @*@Html.LabelFor(m => m.RoleName, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.DropDownListFor(m => m.RoleName, new SelectList(ViewBag.Roles, "Value", "Text"), "--Select--", new { @class = "admin-form-control w-100 h-100 " })
                        <span>RoleName</span>

                    </div>
                    <div class="forLabel admin-form-control   border-0 px-2">
                        @*@Html.LabelFor(m => m.UserName, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.TextBoxFor(m => m.UserName, new { @class = "admin-form-control w-100 h-100 " })
                        <span>User Name</span>
                    </div>
                    <div class="forLabel admin-form-control   border-0 px-2">
                        @*@Html.LabelFor(m => m.FName, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.TextBoxFor(m => m.FName, new { @class = "admin-form-control w-100 h-100 ", @id = "FName" })
                        <span>
                            First Name
                        </span>

                    </div>
                    <div class="forLabel admin-form-control   border-0 px-2">
                        @*@Html.LabelFor(m => m.LName, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.TextBoxFor(m => m.LName, new { @class = "admin-form-control w-100 h-100 ", @id = "LName" })
                        <span>Last Name</span>

                    </div>

                    @if (ViewBag.address != null)
                    {
                        <div class="forLabel admin-form-control   border-0 px-2">
                            @*@Html.LabelFor(m => m.Address, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                            @Html.DropDownList("Address", ViewBag.address as SelectList, "--Select--", new
                            {
                                @class = "admin-form-control w-100 h-100 "@*, id = "Select"*@})
                            <span>Address</span>
                        </div>
                    }
                    <div class="forLabel admin-form-control   border-0 px-2">
                        @*@Html.LabelFor(m => m.state, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.DropDownList("State", new SelectList(""), new
                        {
                            @class = "admin-form-control w-100 h-100 "@*, id = "Selected"*@})
                        <span>state</span>

                    </div>
                    <div class="forLabel admin-form-control   border-0 px-2">
                        @*@Html.LabelFor(m => m.PhoneNumber, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "admin-form-control w-100 h-100 " })
                        <span>
                            Phone 1
                        </span>
                    </div>
                    <div class="forLabel admin-form-control   border-0 px-2">
                        @*@Html.LabelFor(m => m.PhoneNumber1, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.TextBoxFor(m => m.PhoneNumber1, new { @class = "admin-form-control w-100 h-100 " })
                        <span>
                            Phone 2
                        </span>
                    </div>
                    <div class="forLabel admin-form-control   border-0 px-2">
                        @*@Html.LabelFor(m => m.Email, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2 ps-md-3" })*@
                        @Html.TextBoxFor(m => m.Email, new { @class = "admin-form-control w-100 h-100 " })
                        <span>Email</span>
                    </div>
                    <div class="forLabel admin-form-control   border-0 px-2">
                        @*@Html.LabelFor(m => m.Password, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.PasswordFor(m => m.Password, new { @class = "admin-form-control w-100 h-100 " })
                        <span>Password</span>
                    </div>
                    <div class="forLabel admin-form-control   border-0 px-2">
                        @*@Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-4 mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "admin-form-control w-100 h-100 " })
                        <span>
                            Confirm password
                        </span>

                    </div>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
               <div class="position-relative">
                   <i class="fa-solid fa-chevron-left position-absolute start-0 top-50 translate-middle text-white ms-3 "></i>
                   <input id="Back" type="button" value="Back" onclick="window.location.replace('/User/index');" class="btn fw-bold text-white rounded-3 ps-4" />
               </div>
               <div class="position-relative">
                   <i class="fa-solid fa-rotate position-absolute start-0 top-50 translate-middle text-white ms-3 "></i>
                   <input id="New" type="reset" value="Reset" class="btn fw-bold text-white rounded-3 ps-4" />
               </div>
               <div class="position-relative">
                   <i class="fa-solid fa-registered position-absolute start-0 top-50 translate-middle text-white ms-3 "></i>
                   <input id="submit1" type="submit" value="Register" class="btn fw-bold text-white rounded-3 ps-4" />
               </div>
                

                @*<button class="py-2 px-3 border-0 rounded text-light"
                >
            back
        </button>
        <button class="py-2 px-3 border-0 rounded text-light"
                >
            Reset
        </button>
        <button class="py-2 px-3 border-0 rounded text-light"
                >
            Register
        </button>*@
            </div>
    
            <div class="m-auto col-12 col-lg-4 my-4"></div>
        </div>
    </div>
</div>
}
<!-- Include jQuery first -->
<script src="~/assets/NewDesignBackAdmin/JS/jquery.min.js"></script>


<script>


    $(document).ready(function () {
        $("#Address").select2();
        $("#Provider").select2();//providers
        $("#State").select2();//state
        $("#AddCompines").empty();
        $("#Address").change(function () {//address
            $.get("/Account/GetStateList",
                { id: $("#Address").val() }, function (data) {
                    $("#State").empty();
                    $.each(data, function (index, row) {
                        $("#State").append("<option value='" + row.Text + "'>" + row.Value + "</option>")
                    });
                });
        });
        $("#Type").change(function () {
            if ($(this).val() == "5") {//Doctor or Hr
                $("#hideProvider").hide();
                $("#RoleName").val(0);
                $("#RoleName").prop("disabled", false);
            }
            else if ($(this).val() == "9" || $(this).val() == "8") {
                $("#hideProvider").show();
                $("#hideCompny").hide();
                //$("#RoleName").val(0);
                //$("#RoleName").prop("disabled", false);
                //provider
                $.ajax({
                    type: 'POST',
                    url: '/Account/getCompines/',
                    dataType: 'json',
                    // data: { id: $(this).val() },
                    success: function (diag) {
                        $("#Provider").empty();
                        for (var i = 0; i < diag.length; i++) {
                            $("#Provider").append('<option value="' + diag[i].Code + '">' +
                                diag[i].Name + '</option>');
                        }
                        //$.each(diag, function (i, ddlDiag1) {
                        //    $("#Provider").append('<option value="' + ddlDiag1.Value + '">' +
                        //        ddlDiag1.Text + '</option>');

                        //});
                        //$('#Provider  option:eq(0)').attr('selected', 'selected');
                    },
                    error: function (ex) {
                        alert('Failed to retrieve Comanies.');
                    }

                });
            }
            else if ($(this).val() == "10") {// Hr Admin
                $("#hideProvider").hide();
                $("#hideCompny").show();
                $("#RoleName").val(0);
                $("#RoleName").prop("disabled", false);
                $.ajax({
                    type: 'POST',
                    url: '/Account/getCompines/',
                    dataType: 'json',
                    success: function (r) {
                        //debugger;
                        // $('#AddCompanies').empty();
                        var result = [];
                        var current2 = {};
                        current2.id = "All";
                        current2.text = " All ";
                        result.push(current);
                        for (var i = 0; i < r.length; i++) {
                            var current = {};
                            current.id = r[i].Code;
                            current.text = r[i].Name;
                            result.push(current);
                        }
                        $('#AddCompanies').select2({
                            data: result
                        })
                        $("#wait").css("display", "none");
                        $("#RoleName").val("HR_Admin").change();
                    },
                    error: function (ex) {
                        bootbox.alert('Failed to retrieve Diagnoses.');
                        $("#wait").css("display", "none");

                    }

                });
            }

            else {
                $("#hideCompny").hide();
                $("#hideProvider").show();

                $("#RoleName").val(0);
                $("#RoleName").prop("disabled", false);
                //provider
                $.ajax({
                    type: 'POST',
                    url: '/Account/Provider/',
                    dataType: 'json',
                    data: { id: $(this).val() },
                    success: function (diag) {
                        $("#Provider").empty();
                        $.each(diag, function (i, ddlDiag1) {
                            $("#Provider").append('<option value="' + ddlDiag1.Value + '">' +
                                ddlDiag1.Text + " || " + ddlDiag1.Value + '</option>');

                        });
                        $('#Provider  option:eq(0)').attr('selected', 'selected');
                    },
                    error: function (ex) {
                        alert('Failed to retrieve providers.');
                    }

                });
            }
        });
        $("#submit1").click(function () {
            var FName = $('#FName').val();
            var LName = $('#LName').val();
            if (FName == "") {
                alert("Please Enter Your Name");
                return false;
            }
            if (LName == "") {
                alert("Please Enter Your Name");
                return false;
            }
            if (!isNaN(FName)) {
                bootbox.alert("Please Enter Only Characters");
                return false;
            }
            if (!isNaN(LName)) {
                bootbox.alert("Please Enter Only Characters");
                return false;
            }
            if ($("#Type").val() == "7") {
                var SelectedCompaniesList = $('#AddCompanies').select2('data');
                if (SelectedCompaniesList.length > 1 || SelectedCompaniesList[0].id == 0) {
                    var CompaniesList = [];
                    for (var i = 0; i < SelectedCompaniesList.length; i++) {
                        var current = SelectedCompaniesList[i].id;
                        CompaniesList.push(current);
                    }
                    $('#AddCompanies').val(CompaniesList);
                    $('#RoleName[value=HR_Admin]').attr('selected', 'true');
                }
                else {
                    bootbox.alert('Select more than one company');
                    return false;
                }

            }

        });
    });
</script>
