                <!-- Intro Form -->
                <div class="col-11 col-sm-10 mx-auto ml-lg-0 col-lg-6 intro_col " id="loginForm">

                    @if (ViewBag.evnt == 1)
                    {
                        <div class="event-welcome" style="width: 300px; margin: auto; padding-bottom: 30px;">
