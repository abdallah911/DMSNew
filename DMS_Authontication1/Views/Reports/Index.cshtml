@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Reports";
    Layout = "~/Views/Shared/_Layout_DashboardHR.cshtml";
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 17 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}

<div class="sios-container">
    <div class="">
        <p class="mx-4 my-0 py-3 d-flex flex-wrap no-wrap gap-2">
            @if (fullcontroll || view)
            {
                @Html.ActionLink(" Inquiries About An Invoice", "Inquiries", null, htmlAttributes: new { @class = "btn action-btn active", @style = " text-transform: none" })
            }
            @if (fullcontroll || Create)
            {
                @Html.ActionLink("Staff Report ", "StaffConsumption", null, htmlAttributes: new { @class = "btn action-btn", @style = " text-transform: none" })
            }
            @if (fullcontroll || edit)
            {
                @Html.ActionLink(" Consumption", "ConsumptionHR", null, htmlAttributes: new { @class = "btn action-btn", @style = " text-transform: none" })
            }
            @if (fullcontroll || delete)
            {
                @Html.ActionLink(" Online Claims", "HrClaims", null, htmlAttributes: new { @class = "btn action-btn", @style = " text-transform: none" })
            }
        </p>
    </div>
    @if (fullcontroll || view)
    {
<div class="portlet box  green">
    <div class="row bg-overlay portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <i class="fa-solid fa-home me-1"></i>Inquiries about an invoice
        </div>
    </div>
    <div class="portlet-body">
        <div class="row ">
            <div class="col-md-12">
                <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">
                    <!-- BEGIN PAGE HEADER-->
                    <!-- BEGIN THEME PANEL -->

                    <div class="form-wizard">
                        <div class="form-body">
                            <div class="tab-content">
                                <div asp-validation-summary="All" class="text-danger"></div>
                                <div class=" row row-cols-md-2 row-gap-2 container mx-auto">
                                    <div class=" d-flex flex-column gap-2 my-4 no-wrap">

                                        @*Date of Registration*@
                                        <div class="d-flex align-items-center sios-form-control w-100 form-group" style="padding: 0 10px !important;">
                                            <label class="col-4 hr-color control-label ">
                                                Date of Registration
                                            </label>
                                            <div class="col-8   d-flex align-items-baseline  position-relative">
                                                <input type="text" id="RegistrationFrom" style="outline:none;box-shadow:none!important;" class="date-input border-0 w-100 h-100 p-2 bg-transparent text-center hr-color" name="end-date" required="" placeholder="From"><i class="fa-solid fa-calendar-days opacity-75 me-2 hr-color"></i>
                                                <div style="width: 1px; height: 20px;  right: 49%;" class="line position-absolute top-50  translate-middle-y opacity-75  "></div>
                                                <input type="text" id="RegistrationTo" style="outline:none;box-shadow:none!important;" class="date-input outli border-0 w-100 h-100 p-2 bg-transparent text-center hr-color" name="end-date" required="" placeholder="to"><i class="fa-solid fa-calendar-days opacity-75 hr-color"></i>
                                            </div>
                                        </div>
                                        @*Date of Service*@
                                        <div class="d-flex align-items-center sios-form-control w-100 form-group" style="padding: 0 10px !important;">
                                            <label class="col-4 hr-color control-label ">
                                                Date of Service
                                            </label>
                                            <div class="col-8   d-flex align-items-baseline  position-relative">
                                                <input type="text" id="ServiceFrom" style="outline:none;box-shadow:none!important;" class="date-input border-0 w-100 h-100 p-2 bg-transparent text-center hr-color" name="end-date" required="" placeholder="From"><i class="fa-solid fa-calendar-days opacity-75 me-2 hr-color"></i>
                                                <div style="width: 1px; height: 20px;  right: 49%;" class="line position-absolute top-50  translate-middle-y opacity-75  "></div>
                                                <input type="text" id="ServiceTo" style="outline:none;box-shadow:none!important;" class="date-input outli border-0 w-100 h-100 p-2 bg-transparent text-center hr-color" name="end-date" required="" placeholder="to"><i class="fa-solid fa-calendar-days opacity-75 hr-color"></i>
                                            </div>
                                        </div>

                                        @* Claim Number *@
                                        <div class="d-flex align-items-center sios-form-control w-100 form-group" style="padding: 0 10px !important;">
                                            <label class="col-4 hr-color control-label ">
                                                Claim Number
                                            </label>
                                            <div class="col-8   d-flex align-items-baseline  position-relative">
                                                <input type="text" id="ClaimFrom" style="outline:none;box-shadow:none!important;" class="date-input border-0 w-100 h-100 p-2 bg-transparent text-center hr-color" name="end-date" required="" placeholder="From"><i class="fa-solid fa-calendar-days opacity-75 me-2 hr-color"></i>
                                                <div style="width: 1px; height: 20px;  right: 49%;" class="line position-absolute top-50  translate-middle-y opacity-75  "></div>
                                                <input type="text" id="ClaimTo" style="outline:none;box-shadow:none!important;" class="date-input outli border-0 w-100 h-100 p-2 bg-transparent text-center hr-color" name="end-date" required="" placeholder="to"><i class="fa-solid fa-calendar-days opacity-75 hr-color"></i>
                                            </div>
                                        </div>


                                        @* Copmany Number *@
                                        <div class="d-flex align-items-center sios-form-control w-100 form-group" style="padding: 0 10px !important;"> 
                                            <label class="col-4 hr-color control-label ">
                                                Copmany Number
                                            </label>
                                            <div class="col-8   d-flex align-items-baseline  position-relative">

                                                @if (User.IsInRole("HR_Admin"))
                                                {
                                                    @Html.DropDownList("CopmanyNumber", ViewBag.company as SelectList, "Select Company", new { @class = " outli border-0 w-100 h-100 p-2 bg-transparent text-center hr-color", id = "CopmanyNumber" })

                                                    <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                                                    <script>
                                                        $(document).ready(function () {
                                                            $('#CopmanyNumber').select2();
                                                        });
                                                    </script>
                                                }
                                                else
                                                {
                                                    <input id="CopmanyNumber" type="number" class=" outli border-0 w-100 h-100 p-2 bg-transparent text-center hr-color" value="@ViewBag.compnum" min="0" readonly="readonly" />

                                                }
                                            </div>

                                        </div>


                                        @* Service provider number *@

                                        <div class="forLabel px-0 border-0 form-group">

                                            <input id="SerProvNumber" type="number" class="col-md-2 border-2 sios-form-control w-100 form-control " required min="0" />
                                            <span class="start-0 top-50 translate-middle-y"  style=" transform: translateY(-6px); padding-left:12px"><label class="control-label fw-bold col-md-4">Service Provider Number</label></span>


                                        </div>


                                    </div>
           
                                    @* For Buttons *@

                                <div class="d-flex flex-column gap-2 justify-content-end align-items-start  no-wrap">

                                    <div class=" " id="div_of_serv">
                                        <button id="MedicalServices" type="button" class="btn btn-primary" onclick="PrintMedicalServices('MedicalServices')">
                                            <span class="fa fa-save"></span> Medical Services
                                        </button>

                                    </div>

                                    <div class=" " id="div_of_serv">
                                        <button id="OtherServices" type="button" class="btn btn-primary" onclick="PrintMedicalServices('OtherServices')">
                                            <span class="fa fa-save"></span> Other Services
                                        </button>

                                    </div>

                                    <div class=" " id="div_of_serv">
                                        <button id="SerOutMediAuth" type="button" class="btn btn-primary" onclick="PrintMedicalServices('SerOutMediAuth')">
                                            <span class="fa fa-save"></span> Services Outside the Medical Authority
                                        </button>

                                    </div>

                                    @*Print Type*@

                                    <div class="w-100 d-flex gap-3 justify-content-start px-0 border-0 form-group">
                                        <label class="control-label fw-bold col-md-3">
                                            Print Type
                                        </label>
                                        <div class="col-md-2">
                                            <div class="checkbox-inline">
                                                <input type="checkbox" id="pdf" name="pdf" value="pdf" data-name="pdf">
                                                <label for="pdf">
                                                    PDF
                                                </label>
                                            </div>
                                        </div>

                                        @*<div class="col-md-2">
                                             <div class="checkbox-inline">
                                                 <input type="checkbox" id="excel" name="excel" value="excel" data-name="excel">
                                                 <label for="excel">
                                                     EXCEL
                                                 </label>
                                             </div>
                                         </div>*@

                                    </div>

                                </div>
                            </div>
                            </div>
                        </div>
                    </div>
                    @*<div class="panel-footer" style="text-align:right;">
                            <input data-step="9" data-intro="Reset Medicine" id="reset" type="button" value="Reset" onclick="ClearSaveRequest();" class="btn btn-warning" />
                            <input type="submit" id="submit" value="Create" class="btn btn-success" style="text-transform: none" />

                        </div>*@
                </form>
            </div>
        </div>

    </div>

</div>
    }
    </div>
    <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
    <script>
        //$(document).ready(function () {

        //    $('.hr-footer-parent').insertAfter('.sios-container');

        //});

        $(function () {
            var id;
            $('#RegistrationFrom').datepicker({});
            $('#RegistrationTo').datepicker({});

            $('#ServiceFrom').datepicker({});
            $('#ServiceTo').datepicker({});


        });

        function PrintMedicalServices(ButtonType) {
            var RegistrationFrom = $('#RegistrationFrom').val();
            var RegistrationTo = $('#RegistrationTo').val();
            var ServiceFrom = $('#ServiceFrom').val();
            var ServiceTo = $('#ServiceTo').val();
            var Claimfrom = $('#ClaimFrom').val();
            var Claimto = $('#ClaimTo').val();
            var CompNum = $('#CopmanyNumber').val();
            var ServNum = $('#SerProvNumber').val();

            if ((RegistrationFrom != "" && RegistrationTo != "") || (ServiceFrom != "" && ServiceTo != "")) {

                if (CompNum != 0) {

                    if ($("#excel").is(":checked")) {
                        // do something if the excel is  checked
                        if ($("#pdf").is(":checked")) {
                            // do something if the pdf is  checked
                            // Print PDF and EXCEL
                            window.open('/Reports/PrintMedicalServices?Regfrom=' + RegistrationFrom +
                                '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                                '&&Serto=' + ServiceTo + '&&Claimfrom=' + Claimfrom + '&&Claimto=' +
                                Claimto + '&&CompNum=' + CompNum + '&&ServNum=' + ServNum + '&&ButtType=' + ButtonType);

                            window.open('/Reports/PrintXlxMedicalServices?Regfrom=' + RegistrationFrom +
                                '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                                '&&Serto=' + ServiceTo + '&&Claimfrom=' + Claimfrom + '&&Claimto=' +
                                Claimto + '&&CompNum=' + CompNum + '&&ServNum=' + ServNum + '&&ButtType=' + ButtonType);
                        }
                        else {
                            // Print EXCEL Only
                            window.open('/Reports/PrintXlxMedicalServices?Regfrom=' + RegistrationFrom +
                                '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                                '&&Serto=' + ServiceTo + '&&Claimfrom=' + Claimfrom + '&&Claimto=' +
                                Claimto + '&&CompNum=' + CompNum + '&&ServNum=' + ServNum + '&&ButtType=' + ButtonType);
                        }

                    }
                    else {
                        // Print PDF as Default
                        window.open('/Reports/PrintMedicalServices?Regfrom=' + RegistrationFrom +
                            '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                            '&&Serto=' + ServiceTo + '&&Claimfrom=' + Claimfrom + '&&Claimto=' +
                            Claimto + '&&CompNum=' + CompNum + '&&ServNum=' + ServNum + '&&ButtType=' + ButtonType);
                    }
                }
                else {
                    toastr.info('Select  valid Company Number');
                }
            }
            else {
                toastr.info('select date " From " and " TO " of Registration or date of Service  first');
            }


        }
    </script>
