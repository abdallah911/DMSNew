                                                @*<input id="ServiceType" type="text" class="col-md-2 form-control " />*@

                                            </div>

                                        </div>
                                    </div>




                                    @* For Buttons *@
                                <div class="d-flex flex-column gap-2 justify-content-end align-items-start  no-wrap my-4">

                                    @*<div class="col-sm-4" id="div_of_serv">
            <button id="EmployeeConsumption" type="button" class="btn btn-primary" onclick="EmployeeConsumptionPrint()">
                <span class="fa fa-save"></span> Employee Consumption
            </button>

        </div>*@

                                    <div class=" " id="div_of_serv">
                                        <button id="ActiveEmployees" type="button" class="btn btn-primary" onclick="EmployeesPrint('Active')">
                                            <span class="fa fa-save"></span> Active Employees
                                        </button>

                                    </div>

                                    <div class=" " id="div_of_serv">
                                        <button id="ClosedEmployees" type="button" class="btn btn-primary" onclick="EmployeesPrint('Closed')">
                                            <span class="fa fa-save"></span> Closed Employees
                                        </button>

                                    </div>

                                    @*Print Type*@

                                    <div class="w-100 d-flex gap-3 justify-content-start px-0 border-0 form-group">
                                        <label class="control-label fw-bold col-md-3">
                                            Print Type
                                        </label>
                                        <div class="col-md-2">
                                            <div class="checkbox-inline">
                                                <input type="checkbox" id="pdf" name="pdf" value="pdf" data-name="pdf">
                                                <label for="pdf">
                                                    PDF
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <div class="checkbox-inline">
                                                <input type="checkbox" id="excel" name="excel" value="excel" data-name="excel">
                                                <label for="excel">
                                                    EXCEL
                                                </label>
                                            </div>
                                        </div>

                                    </div>

                                </div>

                                </div>

                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>

</div>
    }
    </div>

    <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

    <script>

        $(function () {
            $('#RegistrationFrom').datepicker({});
            $('#RegistrationTo').datepicker({});

        });

        function EmployeesPrint(ButtonType) {
            var RegistrationFrom = $('#RegistrationFrom').val();
            var RegistrationTo = $('#RegistrationTo').val();
            var CompNum = $('#CopmanyNumber').val();
            var CardNum = $('#CardNumber').val();
            var Family = "0";
            if ($("#Family").is(":checked")) {
                Family = "1";
            }

            if (RegistrationFrom != "" && RegistrationTo != "") {

                if (CompNum != 0) {

                    if ($("#excel").is(":checked")) {
                        // do something if the excel is  checked
                        if ($("#pdf").is(":checked")) {
                            // do something if the pdf is  checked
                            // Print PDF and EXCEL
                            window.open('/Reports/PrintEmployees?Regfrom=' + RegistrationFrom +
                                '&&Regto=' + RegistrationTo + '&&CompNum=' + CompNum +
                                '&&CardNum=' + CardNum + '&&Family=' + Family + '&&ButtType=' + ButtonType);

                            window.open('/Reports/PrintXlxEmployees?Regfrom=' + RegistrationFrom +
                                '&&Regto=' + RegistrationTo + '&&CompNum=' + CompNum +
                                '&&CardNum=' + CardNum + '&&Family=' + Family + '&&ButtType=' + ButtonType);
                        }
                        else {
                            // Print EXCEL Only
                            window.open('/Reports/PrintXlxEmployees?Regfrom=' + RegistrationFrom +
                                '&&Regto=' + RegistrationTo + '&&CompNum=' + CompNum +
                                '&&CardNum=' + CardNum + '&&Family=' + Family + '&&ButtType=' + ButtonType);
                        }

                    }
                    else {
                        // Print PDF as Default
                        window.open('/Reports/PrintEmployees?Regfrom=' + RegistrationFrom +
                            '&&Regto=' + RegistrationTo + '&&CompNum=' + CompNum +
                            '&&CardNum=' + CardNum + '&&Family=' + Family + '&&ButtType=' + ButtonType);
                    }
                }
                else {
                    toastr.info('Enter valid Company Number');
                }
            }
            else {
                toastr.info('select date " From " and " TO " of Registration ');
            }


        }


        function EmployeeConsumptionPrint() {
            var RegistrationFrom = $('#RegistrationFrom').val();
            var RegistrationTo = $('#RegistrationTo').val();
            var CompNum = $('#CopmanyNumber').val();
            var CardNum = $('#CardNumber').val();
            var ServiceType = $('#ServiceType').val();
            var Family = "0";
            if ($("#Family").is(":checked")) {
                Family = "1";
            }

            if (RegistrationFrom != "" && RegistrationTo != "") {
                if (CompNum != 0) {
                    if (CardNum == "") {
                        toastr.info("Please Enter Valid Card ID ...");
                    }
                    else {
                        var arra = CardNum.split("-");

                        // chick card id is correct or not
                        if (arra.length == 4 && arra[3] != "") {

                            // final chick if card id start with company id or not
                            if (arra[0] == CompNum) {

                                if ($("#excel").is(":checked")) {
                                    // do something if the excel is  checked
                                    if ($("#pdf").is(":checked")) {
                                        // do something if the pdf is  checked
                                        // Print PDF and EXCEL
                                        window.open('/Reports/PrintEmployeesConsumption?Regfrom=' + RegistrationFrom +
                                            '&&Regto=' + RegistrationTo + '&&CompNum=' + CompNum + '&&ServiceType=' + ServiceType +
                                            '&&CardNum=' + CardNum + '&&Family=' + Family);

                                        window.open('/Reports/PrintXlxEmployeesConsumption?Regfrom=' + RegistrationFrom +
                                            '&&Regto=' + RegistrationTo + '&&CompNum=' + CompNum + '&&ServiceType=' + ServiceType +
                                            '&&CardNum=' + CardNum + '&&Family=' + Family);
                                    }
                                    else {
                                        // Print EXCEL Only
                                        window.open('/Reports/PrintXlxEmployeesConsumption?Regfrom=' + RegistrationFrom +
                                            '&&Regto=' + RegistrationTo + '&&CompNum=' + CompNum + '&&ServiceType=' + ServiceType +
                                            '&&CardNum=' + CardNum + '&&Family=' + Family);
                                    }

                                }
                                else {
                                    // Print PDF as Default
                                    window.open('/Reports/PrintEmployeesConsumption?Regfrom=' + RegistrationFrom +
                                        '&&Regto=' + RegistrationTo + '&&CompNum=' + CompNum + '&&ServiceType=' + ServiceType +
                                        '&&CardNum=' + CardNum + '&&Family=' + Family);
                                }
                            }
                            else {
                                toastr.info("Please enter correct card that belongs to your company only start with : " + CompNum);
                            }
                        }
                        else {
                            toastr.info("Please enter correct card ... ");
                        }
                    }
                }
                else {
                    toastr.info('Enter valid Company Number');
                }
            }
            else {
                toastr.info('select date " From " and " TO " of Registration ');
            }



        }

    </script>
