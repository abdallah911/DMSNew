@model DMS_Authontication1.ViewModel.RequestAddProvidersVM
@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "StaffReport";
    Layout = "~/Views/Shared/_Layout_DashboardHR.cshtml";
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 17 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}

<div class="sios-container">
    <div class="">
        <p class="mx-4 my-0 py-3 d-flex flex-wrap no-wrap gap-2">
            @if (User.Identity.Name != "sofico-hr")
            {
                if (fullcontroll || view)
                {
                    @Html.ActionLink(" Inquiries About An Invoice", "Inquiries", null, htmlAttributes: new { @class = "btn action-btn", @style = " text-transform: none" })
                }
            }
            @if (fullcontroll || Create)
            {
                @Html.ActionLink("Staff Report ", "StaffConsumption", null, htmlAttributes: new { @class = "btn action-btn active", @style = " text-transform: none" })
            }
            @if (fullcontroll || edit)
            {
                @Html.ActionLink(" Consumption", "ConsumptionHR", null, htmlAttributes: new { @class = "btn action-btn", @style = " text-transform: none" })
            }
            @if (fullcontroll || delete)
            {
                @Html.ActionLink(" Online Claims", "HrClaims", null, htmlAttributes: new { @class = "btn action-btn", @style = " text-transform: none" })
            }
        </p>
    </div>
    @if (fullcontroll || Create)
    {
<div class="portlet box  green">
    <div class="row bg-overlay portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <i class="fa-solid fa-home me-1"></i>Inquiries about an invoice
        </div>
    </div>
    <div class="portlet-body">
        <div class="row ">
            <div class="col-md-12">
                <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">
                    <!-- BEGIN PAGE HEADER-->
