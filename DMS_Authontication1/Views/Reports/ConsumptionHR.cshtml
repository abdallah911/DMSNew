@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Consumption";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 17 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}
<br />
<div style="margin-top:40px">
    <p>
        @if (fullcontroll || view)
        {
            @Html.ActionLink(" Inquiries About An Invoice", "Inquiries", null, htmlAttributes: new { @class = "btn btn-info ", @style = " text-transform: none" })
        }
        @if (fullcontroll || Create)
        {
            @Html.ActionLink("Staff Report ", "StaffConsumption", null, htmlAttributes: new { @class = "btn btn-info ", @style = " text-transform: none" })
        }
        @if (fullcontroll || edit)
        {
            @Html.ActionLink(" Consumption", "ConsumptionHR", null, htmlAttributes: new { @class = " btn btn-secondary-outline", @style = " text-transform: none" })
        }
    </p>
</div>
@if (fullcontroll || edit)
{
    <div class="portlet box  green">
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-gift"></i>Inquiries about an invoice
            </div>
        </div>
        <div class="portlet-body">
            <div class="row ">
                <div class="col-md-12">
                    <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">
                        <!-- BEGIN PAGE HEADER-->
                        <!-- BEGIN THEME PANEL -->

                        <div class="form-wizard">
                            <div class="form-body">
                                <div class="tab-content">
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class="row">
                                        @*Date of Registration*@
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Date of Registration :
                                                    <span class="required"> * </span>
                                                </label>
                                                <div class="col-md-6">
                                                    <label class="control-label sbold col-md-3">
                                                        From
                                                        <span class="required"> * </span>
                                                    </label>
                                                    <div class="col-md-9">
                                                        <input id="RegistrationFrom" type="text" class="col-md-2 form-control " placeholder="From" />
                                                    </div>
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="control-label sbold col-md-2">
                                                TO
                                                <span class="required"> * </span>
                                            </label>
                                            <div class="col-md-10">
                                                <input id="RegistrationTo" type="text" class="col-md-2 form-control " placeholder="To" />
                                            </div>
                                        </div>

                                        @*Date of Service*@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Date of Service :
                                                    <span class="required"> * </span>
                                                </label>
                                                <div class="col-md-6">
                                                    <label class="control-label sbold col-md-3">
                                                        From
                                                    </label>
                                                    <div class="col-md-9">
                                                        <input id="ServiceFrom" type="text" class="col-md-2 form-control " placeholder="From" />
                                                    </div>
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="control-label sbold col-md-2">
                                                TO
                                            </label>
                                            <div class="col-md-10">
                                                <input id="ServiceTo" type="text" class="col-md-2 form-control " placeholder="To" />
                                            </div>
                                        </div>

                                        @* Company Number *@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Company Number :
                                                </label>
                                                <div class="col-md-6">
                                                    <label class="control-label sbold col-md-3">
                                                        From
                                                    </label>


                                                    @if (User.IsInRole("HR_Admin"))
                                                    {
                                                        <div class="col-md-9">
                                                            @Html.DropDownList("CompanyFrom", ViewBag.company as SelectList, "Select Company", new { @class = "form-control", id = "CompanyFrom" })

                                                        </div>
                                                        <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                                                        <script>
                                                            $(document).ready(function () {
                                                                $('#CompanyFrom').select2();
                                                            });
                                                        </script>
                                                    }
                                                    else
                                                    {
                                                        <div class="col-md-9">
                                                            <input id="CompanyFrom" type="number" class="col-md-2 form-control " value="@ViewBag.compnum" min="0" readonly="readonly" />

                                                        </div>
                                                    }
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="control-label sbold col-md-2">
                                                TO
                                            </label>

                                            @if (User.IsInRole("HR_Admin"))
                                            {
                                                <div class="col-md-10">
                                                    @Html.DropDownList("CompanyTo", ViewBag.company as SelectList, "Select Company", new { @class = "form-control", id = "CompanyTo" })

                                                </div>
                                                <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                                                <script>
                                                    $(document).ready(function () {
                                                        $('#CompanyTo').select2();
                                                    });
                                                </script>
                                            }
                                            else
                                            {
                                                <div class="col-md-10">
                                                    <input id="CompanyTo" type="number" class="col-md-2 form-control " value="@ViewBag.compnum" min="0" readonly="readonly" />

                                                </div>
                                            }

                                        </div>


                                        @* Class Number *@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Class Number :
                                                </label>
                                                <div class="col-md-6">
                                                    <label class="control-label sbold col-md-3">
                                                        From
                                                    </label>
                                                    <div class="col-md-9">
                                                        <input id="ClassFrom" type="text" class="col-md-2 form-control " placeholder="From" onkeypress="return /[0-9 .]/i.test(event.key)" />
                                                    </div>
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="control-label sbold col-md-2">
                                                TO
                                            </label>
                                            <div class="col-md-10">
                                                <input id="ClassTo" type="text" class="col-md-2 form-control " placeholder="To" onkeypress="return /[0-9 .]/i.test(event.key)" />
                                            </div>
                                        </div>



                                        @* Card Number *@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Card Number :
                                                    <span class="required"> * </span>
                                                </label>
                                                <div class="col-md-6">
                                                    <label class="control-label sbold col-md-3">
                                                        From
                                                    </label>
                                                    <div class="col-md-9">
                                                        <input id="CardFrom" type="text" class="col-md-2 form-control " placeholder="From" />
                                                    </div>
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="control-label sbold col-md-2">
                                                TO
                                            </label>
                                            <div class="col-md-10">
                                                <input id="CardTo" type="text" class="col-md-2 form-control " placeholder="To" />
                                            </div>
                                        </div>

                                        @* Contract Number *@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Contract Number :
                                                </label>
                                                <div class="col-md-6">
                                                    <input id="ContractNumber" type="number" class="col-md-2 form-control " min="0" onkeypress="return /[0-9 .]/i.test(event.key)" />

                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />

                                        @* Repot Type *@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Repot Type :
                                                </label>
                                                <div class="col-md-6">
                                                    <select id="RepotType" class="form-control">
                                                        <option value="1">106-1-Consumption Per Employee VS. Service</option>
                                                        @*<option value="2">106-2-Consumption Per Super Group Service</option>*@
                                                        <option value="3">106-3-Medicine Consumption</option>
                                                        <option value="4">106-4-Consumption Per Employee</option>
                                                        <option value="5">106-5-Consumption Summary</option>
                                                        <option value="6">106-6-Consumption Per Relation</option>
                                                        <option value="7">106-7-Consumption Details</option>
                                                        <option value="8">106-8-Consumption Per Provider</option>
                                                        <option value="9">106-9-Consumption Per Service Group</option>
                                                        <option value="10">106-2-2-Consumption Per Super Group Service New</option>

                                                    </select>
                                                    @*<input id="ServiceType" type="text" class="col-md-2 form-control " />*@

                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />

                                        @*Print Type*@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Print Type :
                                                </label>
                                                <div class="col-md-2">
                                                    <div class="checkbox-inline">
                                                        <input type="checkbox" id="pdf" name="pdf" value="pdf" data-name="pdf">
                                                        <label for="pdf">
                                                            PDF
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-md-2">
                                                    <div class="checkbox-inline">
                                                        <input type="checkbox" id="excel" name="excel" value="excel" data-name="excel">
                                                        <label for="excel">
                                                            EXCEL
                                                        </label>
                                                    </div>
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />

                                        @*Compare Number*@

                                        <div class="form-group col-md-12">
                                            <div class="col-md-12">
                                                <div class="col-md-offset-2" style="margin-top:20px">
                                                    <label class="control-label sbold col-md-2">
                                                        Claimnet :
                                                    </label>
                                                    <div class="col-md-10 row">
                                                        <div class="checkbox-inline col-md-3">
                                                            <label for="Greater">
                                                                Greater Than
                                                            </label>
                                                            <input type="radio" id="Greater" name="Greater" value="GreaterThan" data-name="GreaterThan">

                                                        </div>
                                                        <div class="checkbox-inline col-md-3">
                                                            <label for="Smaller">
                                                                Smaller Than
                                                            </label>
                                                            <input type="radio" id="Greater" name="Greater" value="SmallerThan" data-name="SmallerThan">

                                                        </div>
                                                        <div class="col-md-4">
                                                            <input id="CompareNumber" type="text" class="col-md-2 form-control " onkeypress="return /[0-9 .]/i.test(event.key)" />

                                                        </div>
                                                    </div>
                                                </div>

                                                <br />


                                            </div>
                                        </div>
                                        <br />



                                        @* For Buttons *@
                                        <div class="col-md-12" style="margin-left:30px;margin-right:30px;margin-top:80px;margin-bottom:80px;text-align:right;">

                                            <div class="col-sm-4" id="div_of_serv">
                                                <button id="Consumption" type="button" class="btn btn-primary" onclick="ConsumptionPrint()">
                                                    <span class="fa fa-save"></span> Print
                                                </button>

                                            </div>

                                        </div>


                                    </div>


                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>

        </div>

    </div>

}
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

<script>
    var larg = "0";
    var smal = "0";
    $(function () {
        var id;
        $('#RegistrationFrom').datepicker({});
        $('#RegistrationTo').datepicker({});

        $('#ServiceFrom').datepicker({});
        $('#ServiceTo').datepicker({});

        $('input:radio[name="Greater"]').change(
            function () {
                if ($(this).is(':checked')) {
                    // append goes here
                    if ($(this).val() == 'SmallerThan') {
                        smal = $('#CompareNumber').val();
                    }
                    else if ($(this).val() == 'GreaterThan') {
                        larg = $('#CompareNumber').val().tostring();

                    }
                }
            });

    });

    function ConsumptionPrint() {
        var RegistrationFrom = $('#RegistrationFrom').val();
        var RegistrationTo = $('#RegistrationTo').val();
        var ServiceFrom = $('#ServiceFrom').val();
        var ServiceTo = $('#ServiceTo').val();
        var CompanyFrom = $('#CompanyFrom').val();
        var CompanyTo = $('#CompanyTo').val();
        var ClassFrom = $('#ClassFrom').val();
        var ClassTo = $('#ClassTo').val();
        var CardFrom = $('#CardFrom').val();
        var CardTo = $('#CardTo').val();
        var ContractNumber = $('#ContractNumber').val();
        var RepotType = $('#RepotType').val();

        if ((RegistrationFrom != "" && RegistrationTo != "") || (ServiceFrom != "" && ServiceTo != "")) {

            if (CompanyFrom != 0 && CompanyTo != 0) {

                //chick if not search with card number
                if (CardFrom == "" && CardTo == "") {
                    if ($("#excel").is(":checked")) {
                        // do something if the excel is  checked
                        if ($("#pdf").is(":checked")) {
                            // do something if the pdf is  checked
                            // Print PDF and EXCEL
                            window.open('/Reports/PrintConsumption?Regfrom=' + RegistrationFrom +
                                '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                                '&&Serto=' + ServiceTo + '&&CompanyFrom=' + CompanyFrom + '&&CompanyTo=' +
                                CompanyTo + '&&ClassFrom=' + ClassFrom + '&&ClassTo=' +
                                ClassTo + '&&CardFrom=' + CardFrom + '&&CardTo=' +
                                CardTo + '&&ContractNumber=' + ContractNumber + '&&RepotType=' + RepotType +
                                '&&larg=' + larg + '&&smal=' + smal + '&&Percent=' + $('#CompareNumber').val());

                            window.open('/Reports/PrintXlxConsumption?Regfrom=' + RegistrationFrom +
                                '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                                '&&Serto=' + ServiceTo + '&&CompanyFrom=' + CompanyFrom + '&&CompanyTo=' +
                                CompanyTo + '&&ClassFrom=' + ClassFrom + '&&ClassTo=' +
                                ClassTo + '&&CardFrom=' + CardFrom + '&&CardTo=' +
                                CardTo + '&&ContractNumber=' + ContractNumber + '&&RepotType=' + RepotType +
                                '&&larg=' + larg + '&&smal=' + smal + '&&Percent=' + $('#CompareNumber').val());
                        }
                        else {
                            // Print EXCEL Only
                            window.open('/Reports/PrintXlxConsumption?Regfrom=' + RegistrationFrom +
                                '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                                '&&Serto=' + ServiceTo + '&&CompanyFrom=' + CompanyFrom + '&&CompanyTo=' +
                                CompanyTo + '&&ClassFrom=' + ClassFrom + '&&ClassTo=' +
                                ClassTo + '&&CardFrom=' + CardFrom + '&&CardTo=' +
                                CardTo + '&&ContractNumber=' + ContractNumber + '&&RepotType=' + RepotType +
                                '&&larg=' + larg + '&&smal=' + smal + '&&Percent=' + $('#CompareNumber').val());
                        }

                    }
                    else {
                        // Print PDF as Default
                        window.open('/Reports/PrintConsumption?Regfrom=' + RegistrationFrom +
                            '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                            '&&Serto=' + ServiceTo + '&&CompanyFrom=' + CompanyFrom + '&&CompanyTo=' +
                            CompanyTo + '&&ClassFrom=' + ClassFrom + '&&ClassTo=' +
                            ClassTo + '&&CardFrom=' + CardFrom + '&&CardTo=' +
                            CardTo + '&&ContractNumber=' + ContractNumber + '&&RepotType=' + RepotType +
                            '&&larg=' + larg + '&&smal=' + smal + '&&Percent=' + $('#CompareNumber').val());
                    }
                }
                //chick if card from have value and card to hasnot value to search with card number
                else if (CardFrom != "" && CardTo == "") {
                    toastr.info("Please Enter Valid Card To ...");
                }
                //chick if card to  have value and card from hasnot value to search with card number
                else if (CardFrom == "" && CardTo != "") {
                    toastr.info("Please Enter Valid Card From ...");
                }
                //chick if  search with card number , card form and card to have values
                else {
                    var arraFrom = CardFrom.split("-");
                    var arraTo = CardTo.split("-");
                    // chick card id is correct or not
                    if ((arraFrom.length == 4 && arraFrom[3] != "") || (arraTo.length == 4 && arraTo[3] != "")) {

                        // final chick if card id start with company id or not
                        if ((arraFrom[0] == CompanyFrom) && (arraTo[0] == CompanyTo)) {

                            // Code For Excute her
                            if ($("#excel").is(":checked")) {
                                // do something if the excel is  checked
                                if ($("#pdf").is(":checked")) {
                                    // do something if the pdf is  checked
                                    // Print PDF and EXCEL
                                    window.open('/Reports/PrintConsumption?Regfrom=' + RegistrationFrom +
                                        '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                                        '&&Serto=' + ServiceTo + '&&CompanyFrom=' + CompanyFrom + '&&CompanyTo=' +
                                        CompanyTo + '&&ClassFrom=' + ClassFrom + '&&ClassTo=' +
                                        ClassTo + '&&CardFrom=' + CardFrom + '&&CardTo=' +
                                        CardTo + '&&ContractNumber=' + ContractNumber + '&&RepotType=' + RepotType +
                                        '&&larg=' + larg + '&&smal=' + smal + '&&Percent=' + $('#CompareNumber').val());

                                    window.open('/Reports/PrintXlxConsumption?Regfrom=' + RegistrationFrom +
                                        '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                                        '&&Serto=' + ServiceTo + '&&CompanyFrom=' + CompanyFrom + '&&CompanyTo=' +
                                        CompanyTo + '&&ClassFrom=' + ClassFrom + '&&ClassTo=' +
                                        ClassTo + '&&CardFrom=' + CardFrom + '&&CardTo=' +
                                        CardTo + '&&ContractNumber=' + ContractNumber + '&&RepotType=' + RepotType +
                                        '&&larg=' + larg + '&&smal=' + smal + '&&Percent=' + $('#CompareNumber').val());
                                }
                                else {
                                    // Print EXCEL Only
                                    window.open('/Reports/PrintXlxConsumption?Regfrom=' + RegistrationFrom +
                                        '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                                        '&&Serto=' + ServiceTo + '&&CompanyFrom=' + CompanyFrom + '&&CompanyTo=' +
                                        CompanyTo + '&&ClassFrom=' + ClassFrom + '&&ClassTo=' +
                                        ClassTo + '&&CardFrom=' + CardFrom + '&&CardTo=' +
                                        CardTo + '&&ContractNumber=' + ContractNumber + '&&RepotType=' + RepotType +
                                        '&&larg=' + larg + '&&smal=' + smal + '&&Percent=' + $('#CompareNumber').val());
                                }

                            }
                            else {
                                // Print PDF as Default
                                window.open('/Reports/PrintConsumption?Regfrom=' + RegistrationFrom +
                                    '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                                    '&&Serto=' + ServiceTo + '&&CompanyFrom=' + CompanyFrom + '&&CompanyTo=' +
                                    CompanyTo + '&&ClassFrom=' + ClassFrom + '&&ClassTo=' +
                                    ClassTo + '&&CardFrom=' + CardFrom + '&&CardTo=' +
                                    CardTo + '&&ContractNumber=' + ContractNumber + '&&RepotType=' + RepotType +
                                    '&&larg=' + larg + '&&smal=' + smal + '&&Percent=' + $('#CompareNumber').val());
                            }

                        }
                        else {
                            toastr.info("Please enter correct card that belongs to your company only start with : " + CompanyTo);
                        }
                    }
                    else {
                        toastr.info("Please enter correct Card From and Card To ... ");
                    }
                }
            }
            else {
                toastr.info('Enter valid Company Number From and To must be with you compinies range ');
            }
        }
        else {
            toastr.info('select date " From " and " TO " of Registration or date of Service  first');
        }


    }

</script>
