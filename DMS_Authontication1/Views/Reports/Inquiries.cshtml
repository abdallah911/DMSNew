@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Inquiries";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 17 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}
<div class="dms-container reports">

    <div>
        <p class="ms-4 mt-0 pt-4">
            @if (fullcontroll || view)
            {
                @Html.ActionLink(" Inquiries About An Invoice", "Inquiries", null, htmlAttributes: new { @class = "btn btn-secondary-outline ", @style = " text-transform: none" })
            }
            @if (fullcontroll || Create)
            {
                @Html.ActionLink("Staff Report ", "StaffConsumption", null, htmlAttributes: new { @class = "btn btn-info ", @style = " text-transform: none" })
            }
            @if (fullcontroll || edit)
            {
                @Html.ActionLink(" Consumption", "ConsumptionHR", null, htmlAttributes: new { @class = "btn btn-info ", @style = " text-transform: none" })
            }
            @if (fullcontroll || delete)
            {
                @Html.ActionLink(" Online Claims", "HrClaims", null, htmlAttributes: new { @class = "btn btn-info ", @style = " text-transform: none" })
            }
        </p>
    </div>
    @if (fullcontroll || view)
    {
        <div class="portlet box  ">
            <div class="portlet-title title-bg">
                <div class="caption">
                    <i class="fa fa-gift"></i>Inquiries about an invoice
                </div>
            </div>
            <div class="portlet-body">
                <div class="row ">
                    <div class="col-md-12">
                        <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">
                            <!-- BEGIN PAGE HEADER-->
                            <!-- BEGIN THEME PANEL -->

                            <div class="form-wizard">
                                <div class="form-body">
                                    <div class="tab-content">
                                        <div asp-validation-summary="All" class="text-danger"></div>

                                        <div class="row d-flex flex-column row-gap-2">
                                            @*Date of Registration*@
                                            <div class="labeled-file-box col-md-8">
                                                <div>
                                                    <span>
                                                        <label class="">
                                                            Date of Registration

                                                        </label>
                                                    </span>
                                                    <div class="selected-date">
                                                        <input id="RegistrationFrom" type="text" class="col-md-2 form-control " placeholder="From" />
                                                        <input id="RegistrationTo" type="text" class="col-md-2 form-control " placeholder="To" />
                                                    </div>
                                                    
                                                </div>
                                            </div> 

                                            @*Date of Service*@

                                            <div class="labeled-file-box col-md-8">
                                                <div >
                                                    <span> 
                                                        <label class="">
                                                            Date of Service

                                                        </label>
                                                    </span>
                                                    <div class="selected-date">
                                                        <input id="ServiceFrom" type="text" class="col-md-2 form-control " placeholder="From" />
                                                        <input id="ServiceTo" type="text" class="col-md-2 form-control " placeholder="To" />
                                                    </div>
                                                </div>
                                            </div> 
                                            @* Claim Number *@

                                            <div class="labeled-file-box col-md-8">
                                                <div>
                                                    <span>
                                                        <label class="">
                                                            Claim Number

                                                        </label>
                                                    </span>
                                                    <div class="selected-date">
                                                        <input id="ClaimFrom" type="number" class="col-md-2 form-control " placeholder="From" min="0" step="1" />
                                                        <input id="ClaimTo" type="number" class="col-md-2 form-control " placeholder="To" min="0" step="1" />
                                                    </div>

                                                </div>
                                            </div> 
                                            @* Copmany Number *@

                                            <div class="labeled-file-box col-md-8">
                                                <div>
                                                    <span>
                                                        <label class="">
                                                            Copmany Number
                                                        </label>
                                                    </span>
                                                    <div class="selected-date">
                                                        @if (User.IsInRole("HR_Admin"))
                                                        {

                                                            @Html.DropDownList("CopmanyNumber", ViewBag.company as SelectList, "Select Company", new { @class = "form-control", id = "CopmanyNumber" })

                                                            <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                                                            <script>
                                                                $(document).ready(function () {
                                                                    $('#CopmanyNumber').select2();
                                                                });
                                                            </script>
                                                        }
                                                        else
                                                        {
                                                            <input id="CopmanyNumber" type="number" class="  form-control " value="@ViewBag.compnum" min="0" readonly="readonly" />

                                                      
                                                    }
                                                        <input id="SerProvNumber" type="number" class="col-md-2 form-control " min="0" />
                                                    </div>
                                                </div>
                                            </div>
                                            

                                            @* Service provider number *@

                                            <div class="labeled-file-box col-md-8"> 
                                                <div>
                                                    <span>
                                                        <label class="control-label fw-bold col-md-4">
                                                            Service Provider Number

                                                        </label>
                                                    </span>
                                                    <div class="field" style="width:60%">
                                                        <input id="SerProvNumber" required type="number" class="w-100 form-control " min="0" />
                                                    </div>
                                                </div>
                                            </div>
                                            

                                            @*Print Type*@

                                            <div class="labeled-file-box col-md-8">
                                                <div>
                                                    <span>
                                                        <label class="">
                                                            Print Type
                                                        </label>
                                                    </span>
                                                    <div class=" ">
                                                        <div class="checkbox-inline">
                                                            <input type="checkbox" id="pdf" name="pdf" value="pdf" data-name="pdf">
                                                            <label for="pdf">
                                                                PDF
                                                            </label>
                                                        </div>
                                                    </div>

                                                    @*<div class="col-md-2">
                                                         <div class="checkbox-inline">
                                                             <input type="checkbox" id="excel" name="excel" value="excel" data-name="excel">
                                                             <label for="excel">
                                                                 EXCEL
                                                             </label>
                                                         </div>
                                                     </div>*@

                                                </div>
                                            </div>
                                            

                                            @* For Buttons *@

                                            <div class="col-md-12" style="margin-left:30px;margin-right:30px;margin-top:20px;margin-bottom:20px">

                                                <div class="col-sm-4" id="div_of_serv">
                                                    <button id="MedicalServices" type="button" class="btn btn-primary" onclick="PrintMedicalServices('MedicalServices')">
                                                        <span class="fa fa-save"></span> Medical Services
                                                    </button>

                                                </div>

                                                <div class="col-sm-4" id="div_of_serv">
                                                    <button id="OtherServices" type="button" class="btn btn-primary" onclick="PrintMedicalServices('OtherServices')">
                                                        <span class="fa fa-save"></span> Other Services
                                                    </button>

                                                </div>

                                                <div class="col-sm-4" id="div_of_serv">
                                                    <button id="SerOutMediAuth" type="button" class="btn btn-primary" onclick="PrintMedicalServices('SerOutMediAuth')">
                                                        <span class="fa fa-save"></span> Services Outside the Medical Authority
                                                    </button>

                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @*<div class="panel-footer" style="text-align:right;">
                                    <input data-step="9" data-intro="Reset Medicine" id="reset" type="button" value="Reset" onclick="ClearSaveRequest();" class="btn btn-warning" />
                                    <input type="submit" id="submit" value="Create" class="btn btn-success" style="text-transform: none" />

                                </div>*@
                        </form>
                    </div>
                </div>

            </div>

        </div>
    }
</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

<script>

    $(function () {
        var id;
        $('#RegistrationFrom').datepicker({});
        $('#RegistrationTo').datepicker({});

        $('#ServiceFrom').datepicker({});
        $('#ServiceTo').datepicker({});
    });

    function PrintMedicalServices(ButtonType) {
        var RegistrationFrom = $('#RegistrationFrom').val();
        var RegistrationTo = $('#RegistrationTo').val();
        var ServiceFrom = $('#ServiceFrom').val();
        var ServiceTo = $('#ServiceTo').val();
        var Claimfrom = $('#ClaimFrom').val();
        var Claimto = $('#ClaimTo').val();
        var CompNum = $('#CopmanyNumber').val();
        var ServNum = $('#SerProvNumber').val();

        if ((RegistrationFrom != "" && RegistrationTo != "") || (ServiceFrom != "" && ServiceTo != "")) {

            if (CompNum != 0) {

                if ($("#excel").is(":checked")) {
                    // do something if the excel is  checked
                    if ($("#pdf").is(":checked")) {
                        // do something if the pdf is  checked
                        // Print PDF and EXCEL
                        window.open('/Reports/PrintMedicalServices?Regfrom=' + RegistrationFrom +
                            '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                            '&&Serto=' + ServiceTo + '&&Claimfrom=' + Claimfrom + '&&Claimto=' +
                            Claimto + '&&CompNum=' + CompNum + '&&ServNum=' + ServNum + '&&ButtType=' + ButtonType);

                        window.open('/Reports/PrintXlxMedicalServices?Regfrom=' + RegistrationFrom +
                            '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                            '&&Serto=' + ServiceTo + '&&Claimfrom=' + Claimfrom + '&&Claimto=' +
                            Claimto + '&&CompNum=' + CompNum + '&&ServNum=' + ServNum + '&&ButtType=' + ButtonType);
                    }
                    else {
                        // Print EXCEL Only
                        window.open('/Reports/PrintXlxMedicalServices?Regfrom=' + RegistrationFrom +
                            '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                            '&&Serto=' + ServiceTo + '&&Claimfrom=' + Claimfrom + '&&Claimto=' +
                            Claimto + '&&CompNum=' + CompNum + '&&ServNum=' + ServNum + '&&ButtType=' + ButtonType);
                    }

                }
                else {
                    // Print PDF as Default
                    window.open('/Reports/PrintMedicalServices?Regfrom=' + RegistrationFrom +
                        '&&Regto=' + RegistrationTo + '&&Serfrom=' + ServiceFrom +
                        '&&Serto=' + ServiceTo + '&&Claimfrom=' + Claimfrom + '&&Claimto=' +
                        Claimto + '&&CompNum=' + CompNum + '&&ServNum=' + ServNum + '&&ButtType=' + ButtonType);
                }
            }
            else {
                toastr.info('Enter valid Companu Number');
            }
        }
        else {
            toastr.info('select date " From " and " TO " of Registration or date of Service  first');
        }


    }

</script>
