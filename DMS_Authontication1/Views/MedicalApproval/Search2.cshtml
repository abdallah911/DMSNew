@model IEnumerable<DMS_Authontication1.ViewModel.ApprovalComp>
@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Search";
    Layout = "~/Views/Shared/_Layout_DashboardHR.cshtml";
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 15 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}
@*<h2>Index</h2>*@
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>
<input type="text" id="compname" value="@ViewBag.CompId" hidden="hidden" />

<div class="sios-container">
    <div class="">
        <p class="mx-4 my-0 py-3 d-flex gap-2">

            @if (fullcontroll || view)
            {
                @Html.ActionLink(" Approvals", "Search2", null, htmlAttributes: new { @class = "btn action-btn active", @style = " text-transform: none" })
                @Html.ActionLink(" Search", "Search", null, htmlAttributes: new { @class = "btn action-btn", @style = " text-transform: none" })
            }
            @if (fullcontroll || Create)
            {
                @Html.ActionLink(" Create Request ", "CreateRequest", null, htmlAttributes: new { @class = "btn action-btn", @style = " text-transform: none" })
            }
        </p>
    </div>

    @if (fullcontroll || view)
    {
        <div class="portlet box  green">
            <div class="row bg-overlay portlet-title">
                <div class="m-3 fs-3 text-white caption">
                    <i class="fa fa-home me-1"></i>Approval Search
                </div>
            </div>
            <div class="portlet-body">
                <div class="row ">
                    <div class="col-md-12">
                        <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">
                            <!-- BEGIN PAGE HEADER-->
                            <!-- BEGIN THEME PANEL -->
                            <div class="form-wizard">
                                <div class="form-body">
                                    <div class="tab-content">
                                        <div asp-validation-summary="All" class="text-danger"></div>

                                        <div class="row">

                                        </div>

                                        <div class="row" style="padding-bottom: 15px;">
                                            @if (User.IsInRole("HR_Admin"))
                                            {
                                                <div class="">
                                                    @Html.DropDownList("CopmanyNumber", ViewBag.company as SelectList, new { @class = "border-2 sios-form-control w-100 form-control", id = "CopmanyNumber" })

                                                </div>
                                                <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                                                <script>
                                                    $(document).ready(function () {
                                                        $('#CopmanyNumber').select2();
                                                    });
                                                </script>
                                            }
                                            else
                                            {
                                                <div class="col-md-6" hidden>
                                                    <input id="CopmanyNumber" type="number" class=" border-2 sios-form-control w-100 form-control " value="@ViewBag.CompId" min="0" readonly="readonly" />
                                                    @*@ViewBag.CompId*@
                                                </div>


                                            }
                                        </div>
                                        <div class="row row-cols-sm-2 row-cols-lg-4 container mx-auto row-gap-2 ">
                                            <div class=" forLabel px-2 border-0 rounded-2">
                                                <input id="RegistrationFrom" type="text" class=" border-2 sios-form-control w-100 form-control " placeholder="" required />
                                                <span class="start-0">Registration From</span>
                                                @*<input id="RegistrationFrom" type="text" class=" border-2 sios-form-control w-100 form-control " placeholder="From" />*@ 
                                            </div>

                                            <div class=" forLabel px-2 border-0 rounded-2">
                                                <input id="RegistrationTo" type="text" class=" border-2 sios-form-control w-100 form-control " placeholder="" required />
                                                <span class="start-0">Registration To</span> 
                                                @*<input id="RegistrationTo" type="text" class=" border-2 sios-form-control w-100 form-control " placeholder="To" />*@ 
                                            </div>

                                            <div class=" forLabel px-2 border-0 rounded-2">
                                                <input id="txtSearchCard" type="text" class=" border-2 sios-form-control w-100 form-control " placeholder="" required />
                                                <span class="start-0">Card ID</span> 
                                                @*<input class="border-2 sios-form-control w-100 form-control col-md-6" id="txtSearchCard" type="text" placeholder="search  card ..." />*@ 
                                            </div>

                                            <div class=" forLabel px-2 border-0 rounded-2">
                                                @*<input class="border-2 sios-form-control w-100 form-control col-md-6" id="txtSearchCode" type="text" placeholder="search  code..." />*@

                                                <input id="txtSearchCode" type="text" class=" border-2 sios-form-control w-100 form-control " placeholder="" required />
                                                <span class="start-0">Code</span>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="container text-center text-sm-end px-4 mt-3 mb-4">
                    <button id="new" type="button" class="btn me-2 " onclick="ResetSearch()"><span class="fa fa-refresh"></span> Reset</button>
                    @* <button id="Search" type="button" class="btn btn-success" onclick="SearchProvider()"><span class="glyphicon glyphicon-search"></span> Search</button>*@
                    <input id="Print" type="button" value="Print" class="btn  " onclick="PrintApprovalXsl()" />

                    @*<input id="resetSearch" type="button" value="Reset" onclick="ClearSearchData();" class="btn btn-warning" />
                        <input id="adminSearch" type="button" value="Search" class="btn btn-primary fa fa-search" />*@

                </div>
            </div>
        </div>


        <div class="portlet box  green">
            <div class="row bg-overlay portlet-title">
                <div class="m-3 fs-3 text-white caption">
                    <i class="fa "></i>Approvals
                </div>
            </div>
            <div class="portlet-body">
                <div class="row ">
                    <div class="col-md-12">
                        @*<form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">*@
                        <!-- BEGIN PAGE HEADER-->
                        <!-- BEGIN THEME PANEL -->

                        <div class="form-wizard">
                            <div class="form-body">
                                <div class="tab-content">
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class="row">
                                        <div class="col-md-12" style="width:100%;" id="list_div">
                                            @if (User.IsInRole("HR_Admin"))
                                            {
                                                <div class="form-group col-md-6">
                                                    @*<input id="CARD_ID" value="@ViewBag.CardId" hidden />*@
                                                    @Html.Label("Select Company", new { @class = "col-md-3 control-label sbold" })
                                                    @*<span class="required"> * </span>*@
                                                    <div class="col-md-5">
                                                        @Html.DropDownList("CompanyId", ViewBag.company as SelectList, "Select Company", new { @class = "border-2 sios-form-control w-100 form-control", @id = "CompanyId", @required = "True" })

                                                        @*@Html.ValidationMessageFor(model => model.CARD_ID, "", new { @class = "text-danger" })*@
                                                    </div>
                                                    
                                                </div>
                                                
                                                <hr />
                                                <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                                                <script>
                                            $(function () {
                                            $("#CompanyId").select2();
                                            $("#CompanyId").val(@ViewBag.CompId).change();
                                            });

                                                </script>
                                            }
                                            @*<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                                                <script>
                                                    $('#AproveList').dataTable().fnClearTable();
                                                    $('#AproveList').dataTable().fnDestroy();
                                                </script>*@
                                        <div class="container mx-auto my-4 table-responsive">
                                            <table class="table " id="AproveList">
                                                <thead>
                                                    <tr>

                                                        <th>
                                                            @Html.DisplayName("Code")
                                                        </th>

                                                        <th>
                                                            @Html.DisplayName("Type")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Card Id")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Medical Replay")
                                                        </th>

                                                        <th>
                                                            @Html.DisplayName("Value After")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Recieve Date")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Created Date")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Created By")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("End Date")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Expaire Date")
                                                        </th>
                                                        <th></th>

                                                    </tr>

                                                </thead>
                                                <tbody id="AproveListBody">
                                                    @if (Model.Count() > 0)
                                                    {


                                                        foreach (var item in Model)
                                                        {
                                                            <tr>

                                                                <td> @item.Code</td>
                                                                <td> @item.Approval_Type </td>
                                                                <td> @item.CardId </td>
                                                                <td> @item.Medical_Replay </td>
                                                                <td> @item.Value_After </td>
                                                                <td> @item.Recieve_Date </td>
                                                                <td> @item.Created_Date </td>
                                                                <td> @item.CreatedBy </td>
                                                                <td> @item.End_Date </td>
                                                                <td> @item.Expaire_Date </td>
                                                                <td> <Button class="btn btn-Primary" onclick="Print('@item.Code');">Print</Button> </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        </div>
                                        

                                    </div>
                                </div>
                            </div>
                        </div>
                        @*</form>*@
                    </div>
                </div>

            </div>

        </div>


    }
</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

<script>
    $(document).ready(function () {
        $('#RegistrationFrom').datepicker({});
        $('#RegistrationTo').datepicker({});
        $('#AproveList').DataTable();

        //$("#CopmanyNumber").change(function () {// class levels
        //    var compNu = $("#CopmanyNumber").val();
        //    $("#compname").val(compNu);
        //});

        //$("#CopmanyNumber").map(function () {// class levels
        //    var compNu = $("#CopmanyNumber").val();
        //    $("#compname").val(compNu);
        //});
    });
    $(function () {
        $("#CompanyId").change(function () {//address
            window.location.replace('/MedicalApproval/Search2?CompId=' + $("#CompanyId").val());
        });
    });
    function Print(AppCode) {
        var x = String(AppCode);
        //  window.location.reload();
        window.open('/Hospital/Print?ApprovalCode=' + AppCode);
    }

    function ResetSearch() {

        $("#RegistrationFrom").val("");
        $('#RegistrationTo').val("");
        $('#txtSearchCard').val("");
        $('#txtSearchCode').val("");

    }
    //Print Approval xls
    function PrintApprovalXsl() {

        window.open('/MedicalApproval/PrintApprovalXsl/?DateFrom=' + $("#RegistrationFrom").val() +
            '&&DateTo=' + $("#RegistrationTo").val() + '&&ApprovalCode=' + $("#txtSearchCode").val() +
            '&&CardId=' + $("#txtSearchCard").val() + '&&CopmanyNumber=' + $("#CopmanyNumber").val());
    }
</script>
