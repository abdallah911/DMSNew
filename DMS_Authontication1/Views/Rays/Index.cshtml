@model IEnumerable<DMS_Authontication1.Models.Roshita>
@using Microsoft.AspNet.Identity;
@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    if (User.IsInRole("Admin"))
    {

        var modellist = new List<ModulesPagesViewModel>();
        var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
        if (claim != null)
        {
            modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
            if (modellist != null)
            {
                var obj = modellist.Where(x => x.ModuleName == "Pharmacies Management" && x.PageId == 4 && (x.FullControl || x.EditPermission
                                              || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
                if (obj != null)
                {
                    edit = obj.EditPermission;
                    delete = obj.ActivationControl;
                    view = obj.Preview;
                    fullcontroll = obj.FullControl;

                }
            }
        }

    }
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}

@if (!User.IsInRole("Admin"))
{
    <div class="sios-overlay container-fluid mt-4">
        <div class="container">
            <i class="fa-solid fa-house"></i>
            <h3>Print Claims</h3>
        </div>
    </div>

    <section class="print-claim-section">
        <form name="formValidation"
              id="formValidation"
              action="Pharmacy_claims.html">
            <div class="container">
                <div class="row">
                    <div class="row row-cols-sm-3 m-auto m-sm-0">
                        <div class="forLabel">
                            <input class="admin-form-control mb-3 ps-3" type="date" name="From" id="From" required="required" />
                            <span for="From">From</span>
                        </div>
                        <div class="forLabel">
                            <input class="admin-form-control mb-3 ps-3" type="date" name="To" id="To" required="required" />
                            <span for="To">To</span>
                        </div>
                        <div class="forLabel">
                            <input class="admin-form-control mb-3 ps-3" type="Number" name="RaysApprovalNo" id="RaysApprovalNo" required="required" />
                            <span for="RaysApprovalNo">ApprovalNo.</span>
                        </div>
                        <div class="forLabel">
                            <input class="admin-form-control mb-3 ps-3" type="text" id="RaysCardId" name="RaysCardId" required="required" />
                            <span for="RaysCardId">Card ID</span>
                        </div>
                        @if (User.IsInRole("Rays_Admin"))
                        {
                            <div class="forLabel">
                                @Html.DropDownList("ddlUsers", null, "All", htmlAttributes: new { @class = "admin-form-control mb-3 ps-3", @id = "ddlUsers" })

                                <span for="Select Group">Select User</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </form>
</section>
     
}
