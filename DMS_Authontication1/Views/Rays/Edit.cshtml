@model IEnumerable<DMS_TEST.ViewModel.DoctorContainerViewModel>

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";

}
<div class="sios-container">

    <div hidden>
        <input id="IsFamily" name="IsFamily" value="" />
        <input id="IsPool" name="IsPool" value="" />
    </div>

    <div class="portlet box  green">
        <div class="row bg-overlay  editeRquest fw-bold my-4 portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa-solid fa-home me-1 me-1"></i>Edit perception
            </div>
        </div>

        <div class="portlet-body" style="padding-bottom: 0px;">
            <div class="row container mx-auto ms-sm-4">
                <div class=" col-sm-5 ">
                    <select id="AddRays" multiple="multiple" style="width:100%">
                        <option value="0">select Rsy</option>
                    </select>
                </div>
            </div>
            <!--Dynamic table-->
            <div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
                <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
            </div>
            <div class="sios-bg claims-section container-fluid my-4">
                <div class="table-responsive">
                    <table class="table" id="Rays">
                        <thead>
                            <tr>
                                <th>
                                    Ray Code
                                </th>
                                <th>
                                    Ray Name
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Amount)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.PaymentGroup)
                                </th>

                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <TBODY>
                            @foreach (var item in (Model.Where(x => x.PaymentGroup != "Pending" && x.IsDealed == true).ToList()))
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.MedicienCode)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.MedicienName)
                                    </td>

                                    <td>
                                        @Html.EditorFor(modelItem => item.Amount, new { htmlAttributes = new { @class = "admin-form-control   form-control  Amount ", @onkeyup = "Calculation(this);" } })
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.PaymentGroup)
                                    </td>

                                </tr>
                            }
                        </TBODY>
                    </table>
                </div>
            </div>


            @*Hiden table for pendin medicine*@

            <div class="sios-bg claims-section container-fluid my-4" hidden>
                <div class="table-responsive" hidden>
                    <table class="table" id="PharmacyPending">
                        <thead>
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.MedicienCode)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.MedicienName)
                                </th>
                            </tr>
                        </thead>
                        <TBODY>
                            @foreach (var item in (Model.Where(m => m.PaymentGroup == "Pending" || m.PaymentGroup == "Accepted" || m.PaymentGroup == "Rejected").ToList()))
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.MedicienCode)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.MedicienName)
                                    </td>

                                </tr>
                            }
                        </TBODY>
                    </table>
                </div>
            </div>


            <!--Caculation-->
            <div class="row row-cols-sm-3 row-gap-2 m-auto m-sm-0">
                <div class="forLabel ">
                    <input id="txtTotalInvoice" type="text" class="admin-form-control   form-control " ReadOnly="readonly" />
                    <span class="control-label">Total</span>
                </div>
                <div class="forLabel  ">
                    <input id="txtTotalCopayment" type="text" class="admin-form-control   form-control " ReadOnly="readonly" />
                    <span class="control-label">Person Payments</span>
                </div>
                <div class="forLabel ">
                    <input id="txtValueCredit" type="text" class="admin-form-control   form-control " ReadOnly="readonly" />
                    <span class="control-label">Value Credit</span>
                </div>
                <div class="forLabel ">
                    <input id="txtOverInsurance" type="text" class="admin-form-control   form-control " ReadOnly="readonly" />
                    <span class="control-label">Over Insurance</span>
                </div>
                <div class="forLabel ">
                    <input id="txtCash" type="text" class="admin-form-control   form-control " ReadOnly="readonly" />
                    <span class="control-label">Cash</span>
                </div>
                <div class="forLabel ">
                    <input id="txtValueCash" type="text" class="admin-form-control   form-control " ReadOnly="readonly" />
                    <span class="control-label">Total cash</span>
                </div>
            </div> 

            <!--Save-->

            <div class=" d-flex justify-content-center justify-content-sm-end gap-2 mt-3 mb-4 px-2">
                <input id="Update" type="button" value="Update" class="btn fw-bold text-white rounded-3 " />

            </div>
        </div>
    </div>
</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/Ray/RayEdit.js?V=4.4"></script>

