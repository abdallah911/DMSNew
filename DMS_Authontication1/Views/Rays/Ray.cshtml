@model DMS_TEST.ViewModel.Container1
@{
    ViewBag.Title = "Ray";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<div hidden>
    <input id="IsFamily" name="IsFamily" value="" />
    <input id="IsPool" name="IsPool" value="" />
</div>

<div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
    <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
</div>
<!--Card Id Row-->
<div class="sios-container portlet box  green">
    <div class="d-flex bg-overlay justify-content-between editeRquest fw-bold my-4 portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <i class="fa fa-gift me-3"></i>Radiology
        </div> 
            <div class="d-flex editeRquest fw-bold  portlet-title  actions">
                <div class="m-3 fs-3 text-white ">
                    <a id="Pending" href="javascript:;" class="d-flex align-items-center me-3 btn btn-primary  btn-sm" disabled>
                        <i class="fa fa-pencil me-3"></i> Pending
                    </a>
                </div> 
        </div>
    </div>
    
    <div class="portlet-body">
        <div class="row mx-auto">
            <div class="row form-group">
                <div data-step="1" data-hint='Step one!' data-intro="Enter Card ID" style="width: 250px;  " class="col-md-3">
                    <input id="txtSearchCard" type="text" placeholder="search for card..." style=" padding-left: 80px;" class="w-100 admin-form-control w-100 h-100 form-control" />
                </div>
                <div   class="position-absolute col-md-2" data-step="2" data-intro="click Search">
                    <button id="Search" type="button" style="height: 35.67px !important;" class="h-100 btn btn-primary">
                        <i class="glyphicon glyphicon-search"></i> Search
                    </button>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <div class="col-md-offset-3 col-md-3">
                        @Html.DropDownList("ddlUsers", null, htmlAttributes: new { @class = "admin-form-control w-100 h-100 form-control", @id = "ddlUsers" })
                    </div>
                }

            </div>
        </div>
        @Html.Partial("_Cards")  
    <div class="panel panel-info">
        <div class="row bg-overlay editeRquest fw-bold my-4">
            <div class="m-3 fs-3 text-white ">
                <h2 class="panel-heading" style="margin:1px;">Card ID</h2>
            </div>
        </div> <div class="panel-body">
            @*  <div class="panel panel-info"><h2 class="panel-heading" style="margin:1px;">Card ID</h2> </div>*@
            <div class="row container mx-auto">
                <div class="mx-auto row row-cols-sm-2 row-cols-lg-3 row-gap-2  form-group">
                    @*<div class="forLabel admin-form-control border-0 px-2">
            @Html.LabelFor(model => model.contractComp.C_ANAME, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.contractComp.C_ANAME, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 form-control", @ReadOnly = "true" } })
        </div>*@
                    <div class="forLabel admin-form-control border-0 px-2">
                        @*@Html.LabelFor(model => model.compEmp.EMP_ANAME, htmlAttributes: new { @class = "control-label" })*@
                        @Html.EditorFor(model => model.compEmp.EMP_ANAME, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 form-control", @ReadOnly = "true" } })
                        <span>Name</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2">
                        @*@Html.LabelFor(model => model.compEmp.INS_END_DATE, htmlAttributes: new { @class = "control-label" })*@
                        @Html.EditorFor(model => model.compEmp.INS_END_DATE, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 form-control", @ReadOnly = "true" } })
                        <span>End Date</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2" data-step="4" data-intro="Enter speciality ">
                        @*@Html.LabelFor(model => model.speciality.special_Aname, htmlAttributes: new { @class = "control-label" })*@
                        @Html.DropDownList("ddlSpeciality", null, htmlAttributes: new { @class = "admin-form-control w-100 h-100 form-control", @id = "ddlSpeciality" })
                        <span>Speciality</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2" data-step="5" data-intro="Select Diagnoises">
                        @*@Html.Label("Diagnoise", new { @class = "control-label" })*@
                        <select id="ddlDiagnoises" style="width:100%" multiple></select>
                        <span>Diagnoise</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2" data-step="6" data-intro="Comment optional">
                        @*@Html.Label("Comment", htmlAttributes: new { @class = "control-label" })*@
                            <textarea id="Comments" style="height: 31px;" type="text" class="admin-form-control w-100 h-100 form-control" name="Comments" placeholder="" value=""></textarea>
                            <span>Comment</span> 
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2">
                        @*@Html.LabelFor(model => model.Co_insurance.INSURANCE_DAY_LAB, htmlAttributes: new { @class = "control-label" })*@
                        @Html.EditorFor(model => model.Co_insurance.INSURANCE_DAY_LAB, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 form-control", @ReadOnly = "true" } })
                        <span>Daily limit</span>
                    </div>
                    @*<div class="forLabel admin-form-control border-0 px-2">
            @Html.LabelFor(model => model.Co_insurance.INSURANCE_MONTH_LAB, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.Co_insurance.INSURANCE_MONTH_LAB, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 form-control", @ReadOnly = "true" } })
        </div>*@

                    <div class="forLabel admin-form-control border-0 px-2">
                        @*@Html.LabelFor(model => model.ddEmp.CEILING_PERT, htmlAttributes: new { @class = "control-label" })*@
                        @Html.EditorFor(model => model.ddEmp.CEILING_PERT, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 form-control", @ReadOnly = "true" } })
                        <span>Company Percent</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2" data-step="3" data-intro="Enter Preception Date">
                        @*@Html.Label("Prescription Date", htmlAttributes: new { @class = "control-label", @title = "لابد ان يكون ف اخر 14 ايام " })*@
                        @Html.Editor("PrescriptionDate", new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 form-control", @title = "لابد ان يكون ف اخر 14 ايام " } })
                        <span>Prescription Date</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2" data-step="3" data-intro="Enter Phone with 11 Number " id="phone">
                        @*@Html.Label("Phone Number", htmlAttributes: new { @class = "control-label" })*@
                        @Html.Editor("PhoneNumber", new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 form-control", @id = "PhoneNumber", required = "required", @onkeypress = "return /[0-9]/i.test(event.key)" } })
                        <span>Phone Number</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2" data-step="4" data-intro="Enter Clame Number">
                        @*@Html.Label("Claim Number", htmlAttributes: new { @class = "control-label" })*@
                        @Html.Editor("ClaimNumber", new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 form-control", @id = "ClaimNumber", @required = "required", @onkeypress = "return /[0-9]/i.test(event.key)" } })
                        <span>Claim Number</span>
                    </div>

                    <div class="forLabel admin-form-control border-0 px-2">
                        @*@Html.LabelFor(model => model.compEmp.CompHolderName, htmlAttributes: new { @class = "control-label" })*@
                        @Html.EditorFor(model => model.compEmp.CompHolderName, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100 form-control", @style = " border-color: red; font-weight: 700!important; box-shadow: 0 0 3px 1px #e1434369;", @ReadOnly = "true" } })
                        <span>Comp Name</span>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <div class="panel panel-info">
        <div class="row bg-overlay editeRquest fw-bold my-4">
            <div class="m-3 fs-3 text-white ">
                <h2 class="panel-heading" style="margin:1px;">Rays</h2>
            </div>
        </div>
        <div class="panel-body">
            <!--Search Medicine-->
            <div class="row">
                <div class="col-sm-12" data-step="7" data-intro="Select ray to Despense">
                    <select id="AddRay" multiple="multiple" style="width:100%">
                        <option value="0">select ray</option>
                    </select>
                </div>
            </div>
            <div class="container-fluid  my-4">
                <div class="sios-bg container-fluid master">
                    <div class="table-responsive">
                        <table class="table table-striped mt-3 text-center " id="Ray">
                            <thead>
                                <tr>
                                    <th class="col-md-3">Code</th>
                                    <th class="col-md-3">Name</th>
                                    <th class="col-md-3">Amount</th>
                                    <th class="col-md-3">Group</th>
                                    @*<th scope="col">&nbsp;</th>*@
                                </tr>
                            </thead>
                            <tbody></tbody>

                        </table>
                    </div>
                    <!--Caculation-->

                    <div class="row container mt-3  ">
                        <div class="mx-auto row row-cols-sm-2 row-cols-lg-3 row-gap-2 form-group form-group">
                            <div class="forLabel admin-form-control border-0 px-2">
                                <input id="txtTotalInvoice" type="text" class="admin-form-control w-100 h-100 form-control" ReadOnly="readonly" />
                                <span class="control-label">Total</span>
                            </div>
                            <div class="forLabel admin-form-control border-0 px-2">
                                <input id="txtTotalCopayment" type="text" class="admin-form-control w-100 h-100 form-control" ReadOnly="readonly" />
                                <span class="control-label">Person Payments</span>
                            </div>
                            <div class="forLabel admin-form-control border-0 px-2">
                                <input id="txtValueCredit" type="text" class="admin-form-control w-100 h-100 form-control" ReadOnly="readonly" />
                                <span class="control-label">Value Credit</span>
                            </div>  <div class="forLabel admin-form-control border-0 px-2">
                                <input id="txtOverInsurance" type="text" class="admin-form-control w-100 h-100 form-control" ReadOnly="readonly" />
                                <span class="control-label">Over Insurance</span>
                            </div>
                                <div class="forLabel admin-form-control border-0 px-2">
                                    <input id="txtCash" type="text" class="admin-form-control w-100 h-100 form-control" ReadOnly="readonly" />
                                    <span class="control-label">Cash</span>
                                </div>
                            <div class="forLabel admin-form-control border-0 px-2">
                                <input id="txtValueCash" type="text" class="admin-form-control w-100 h-100 form-control" ReadOnly="readonly" />
                                <span class="control-label">Total cash</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container mt-3 mb-4 panel-footer" style="text-align:right;">
            <input style="float: left;" id="Help" type="button" value="Help" class="btn fw-bold text-white rounded-3 btn-info" />
            <a data-step="11" style="float: left; margin-left:40px;" class="btn fw-bold text-white rounded-3 btn fw-bold text-white rounded-3-primary" href="@Url.Action("GetFile","Pharmacy",new { fileName = "Ray" })" download="PharmacyManual.pdf"><i class="fa fa-download"></i> Manual</a>
            <input data-step="8" data-intro="Reset Labs" id="reset" type="button" value="Reset" onclick="ClearRayData();" class="btn fw-bold text-white rounded-3 btn-warning" />
            <input data-step="9" data-intro="Save Labs" id="submit" type="button" value="Save" class="btn fw-bold text-white rounded-3 btn-success" />
        </div>
    </div>
                                  

                    </div>
        </div>
        @*scripts*@
        <script src="~/assets/HomeTemplete/js/intro.js"></script>

        <script src="~/Scripts/DMS/Ray/Ray.js?V=4.3"></script>


