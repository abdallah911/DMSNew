@model IEnumerable<DMS_Authontication1.Models.Specialities1>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}
<div class="portlet box dms-container">
    <div class="portlet-title title-bg text-white fw-bold">
        <div class="caption">
            <i class="fa-solid fa-home"></i>Specialities
        </div>
        <div class="actions">
            <a id="Create" href="/Specialities/Create" class="btn btn-success   btn-sm">
                <i class="fa fa-plus"></i> Create New
            </a>
        </div>
    </div>
    <br />
    <div class="portlet-body">
        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.SPEC_ID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SPEC_ANAME)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SPEC_ENAME)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ACTIVE)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CREATED_DATE)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CREATED_BY)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var CREATED_DATE = item.CREATED_DATE.Value.ToString("dd/MM/yyyy");
                    string Activation = item.ACTIVE == "1" ? "Deactivate" : "activate";
                    var btnClass = item.ACTIVE == "1" ? "btn btn-warning" : "btn btn-info";
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.SPEC_ID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SPEC_ANAME)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SPEC_ENAME)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ACTIVE)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => CREATED_DATE)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CREATED_BY)
                        </td>

                        <td>
                            @*@Html.ActionLink("Edit", "Edit", new { id=item.SPEC_ID }) |*@
                            @*@Html.ActionLink("Diagnoises", "Diagnoisis", new { id = item.SPEC_ID })*@
                            <a class="btn btn-default fa fa-list" style=" text-transform: none" href="/Specialities/Diagnoisis/@item.SPEC_ID"> Diagnoisis</a>
                            |
                            @*@Html.ActionLink("Change Activatation", "Delete", new { id = item.SPEC_ID })*@
                            <button type="button" class="@btnClass" data-id=@item.SPEC_ID onclick="Activation(this);">@Activation</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script>
    $(function () {
        $('#Index').dataTable();
    })
    function Activation(button) {

            var id = $(button).data('id');

            bootbox.confirm("Are you sure to change this activaion ?", function (result) {
                if (result) {
                    $.ajax({
                        type: "POST",
                        dataType: "json",
                        url: '/Specialities/Activation',
                        data: { id: id },
                        success: function (returndata) {
                            if (returndata.ok) {
                                toastr.success("Changed")
                                location.reload();
                            }
                        }
                    });
                }
            });
        }
</script>
