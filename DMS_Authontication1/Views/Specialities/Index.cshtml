@model IEnumerable<DMS_Authontication1.Models.Specialities1>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}

<section class="container-fluid mt-4">
    <!--  New request -->
    <div class="row bg-overlay">
        <div style="position: relative"
             class="editeRquest fw-bold text-light">
            <div class="m-3 fs-3">
                <i class="fa-solid fa-home me-3"></i>
                Specialities
            </div>
            <div style=" position: absolute;right: 1%;top: 50%;transform: translateY(-50%);">
                <a id="Create" href="/Specialities/Create" class="btn fw-bold text-white rounded-3n" style="text-decoration: none;cursor: pointer; padding: 7.2px;">
                    <i class="fas fa-plus"></i> Create New
                </a>
            </div>
        </div>
    </div>
</section>

<div class="sios-bg w-100 m-auto px-4 my-4 pb-5">
    <div class="table-responsive">
        <table id="Index" class="table table-striped mt-3 text-center">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.SPEC_ID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SPEC_ANAME)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SPEC_ENAME)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ACTIVE)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CREATED_DATE)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CREATED_BY)
                    </th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var CREATED_DATE = item.CREATED_DATE.Value.ToString("dd/MM/yyyy");
                    string Activation = item.ACTIVE == "1" ? "Deactivate" : "activate";
                    var btnClass = item.ACTIVE == "1" ? "btn btn-warning" : "btn btn-info";
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.SPEC_ID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SPEC_ANAME)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SPEC_ENAME)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ACTIVE)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => CREATED_DATE)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CREATED_BY)
                        </td>

                        <td>
                            <a class="btn fw-bold text-white rounded-3"   href="/Specialities/Diagnoisis/@item.SPEC_ID"><i class="fa-solid fa-comment-medical me-1"></i> Diagnoisis</a>
                        </td>
                        <td>
                            <button type="button" class="btn fw-bold text-white rounded-3"  data-id=@item.SPEC_ID onclick="Activation(this);"><i class="fa-solid fa-file-shield me-1"></i>@Activation</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<script src="~/assets/NewDesignBackAdmin/JS/jquery.min.js"></script>

<script>
    $(function () {
        $('#Index').dataTable();
    })
    function Activation(button) {

        var id = $(button).data('id');

        bootbox.confirm("Are you sure to change this activaion ?", function (result) {
            if (result) {
                $.ajax({
                    type: "POST",
                    dataType: "json",
                    url: '/Specialities/Activation',
                    data: { id: id },
                    success: function (returndata) {
                        if (returndata.ok) {
                            toastr.success("Changed")
                            location.reload();
                        }
                    }
                });
            }
        });
    }
</script>
