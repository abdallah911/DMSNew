@model DMS_Authontication1.Models.Specialities1
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<div class="sios-container">
<section class="container-fluid mt-4">
    <!--  New request -->
    <div class="row bg-overlay">
        <div style="position: relative"
             class="editeRquest fw-bold text-light">
            <div class="m-3 fs-3">
                <i class="fa-solid fa-home me-1"></i>
                Create  a Speciality
            </div>
        </div>
    </div>
</section>
<div id="home">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
    <div class="row my-4">
        <div class="container mx-auto col-sm-8 col-lg-6  px-0">
            <div style="white-space: nowrap" class="employee-form">
                <div class="flex-column d-flex gap-2  ">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="forLabel admin-form-control border-0 px-2">
                        @*@Html.LabelFor(model => model.SPEC_ANAME, htmlAttributes: new { @class = "sios-color col-4 fs-5 fw-bold mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.EditorFor(model => model.SPEC_ANAME, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100" } })
                        @Html.ValidationMessageFor(model => model.SPEC_ANAME, "", new { @class = "text-danger" })
                        <span>SPEC ANAME</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2">
                        @*@Html.LabelFor(model => model.SPEC_ENAME, htmlAttributes: new { @class = "sios-color col-4 fs-5 fw-bold mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.EditorFor(model => model.SPEC_ENAME, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100" } })
                        @Html.ValidationMessageFor(model => model.SPEC_ENAME, "", new { @class = "text-danger" })
                        <span>SPEC ENAME</span>

                    </div>
                    <div class="forLabel admin-form-control border-0 px-2">
                        @*@Html.LabelFor(model => model.special_notes, htmlAttributes: new { @class = "sios-color col-4 fs-5 fw-bold mx-auto mb-3 mb-sm-2 my-auto ps-2" })*@
                        @Html.EditorFor(model => model.special_notes, new { htmlAttributes = new { @class = "admin-form-control w-100 h-100" } })
                        @Html.ValidationMessageFor(model => model.special_notes, "", new { @class = "text-danger" })
                        <span>special notes</span>

                    </div>
                </div>

            </div>
        </div>
        <div class=" col-md-4 d-flex gap-2 justify-content-center mt-3 mt-md-auto ">
            <div class="position-relative ">
                <i class="fa-solid fa-chevron-left position-absolute start-0 top-50 translate-middle text-white ms-3"></i>
                <input id="Back" type="button" value="Back" class="btn fw-bold text-white rounded-3 ps-4"
                       style="text-decoration: none;  " />
            </div>
            <div class="position-relative ">
                <i class="fa-solid fa-save position-absolute start-0 top-50 translate-middle text-white ms-3"></i>
                <input id="submit" type="submit" value="Create" class="btn fw-bold text-white rounded-3 ps-4" />
            </div>
        </div>
    </div>
    }
</div>
</div>


