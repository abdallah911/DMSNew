<script>
    const ctx = document.getElementById('doughnutChart');
    const ctxTwo = document.getElementById('graphChart');
    const ctxThree = document.getElementById('graphChartTwo');
    const ctxFour = document.getElementById('graphChartThree');

    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: [ 
                'Blue',
                'Dark Blue'
            ],
            datasets: [{
                label: 'My First Dataset',
                data: [12, 19 ],
                backgroundColor: [
                    '#8389eb',
                    '#de8383'
                ],
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: false
                }
            }
        }
    });
    new Chart(ctxTwo, {
        type: 'bar',
        data: {
            labels: ['Red', 'Blue', 'Yellow', 'Green', 'Purple', 'Orange'],
            datasets: [{
                label: '# of employees',
                data: [12, 19, 3, 5, 2, 3],
                backgroundColor: [ 
                    '#8389eb', 
                    '#de8383'
                ],
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
    new Chart(ctxThree, {
        type: 'bar',
        data: {
            labels: ['Red', 'Blue', 'Yellow', 'Green', 'Purple', 'Orange'],
            datasets: [{
                label: '# of employees',
                data: [12, 19, 3, 5, 2, 3],
                backgroundColor: [ 
                    '#8389eb', 
                    '#de8383'
                ],
                borderWidth: 1
            }]
        },
        options: {
            indexAxis: 'y',
            // Elements options apply to all of the options unless overridden in a dataset
            // In this case, we are setting the border of each horizontal bar to be 2px wide
            elements: {
                bar: {
                    borderWidth: 2,
                }
            },
            responsive: true,
            plugins: {
                legend: {
                    position: 'right',
                },
                title: {
                    display: true,
                    text: 'Chart.js Horizontal Bar Chart'
                }
            }
        },
    });
    new Chart(ctxFour, {
        type: 'bar',
