@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Index";
    
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";

    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 12 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}



<div  >
    @if (!User.IsInRole("Admin"))
    {
        <p>
            @if (fullcontroll || view)
            {
                @Html.ActionLink(" Search", "Index", null, htmlAttributes: new { @class = "btn btn-info-outline fa fa-search", @style = " text-transform: none" })
            }
            @if (fullcontroll || Create)
            {
                @Html.ActionLink(" Create Request", "EditRequest", null, htmlAttributes: new { @class = "btn btn-info fa fa-pencil", @style = " text-transform: none" })
            }
        </p>
    }
</div>
@if (fullcontroll || view)
{
<div class=" sios-container editeRquest fw-bold pt-4 mb-4 portlet box  green">
    <div class="row bg-overlay portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <i class="fa fa-gift me-3"></i>Operation
        </div>

    </div>
    <div class="cs-bg w-100 m-auto px-4 mt-4 pb-4">
        <div class="table-responsive portlet-body">

            <table class="table table-striped mt-3 text-center ui celled table" id="Index" width="100%">
                <thead>
                    <tr>

                        <th>
                            Id
                        </th>
                        <th>
                            Card Id
                        </th>
                        <th>
                            Name
                        </th>
                        <th>
                            Request Type
                        </th>
                        <th>
                            status
                        </th>
                        <th>
                            CreatedDate
                        </th>
                        <th></th>
                        @*<th></th>
                            <th></th>
                            <th></th>*@
                    </tr>
                </thead>
                <tbody></tbody>

            </table>
        </div>
    </div>
</div>
}
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

<script>
    $(function () {
        $("#Index").DataTable({
            "sAjaxSource": '/EmployeeRequest/RequestList',
            "bServerSide": true,
            "processing": true,
            "bFilter": true,
            "bSort": false,
            "pageLength": 10,
            "bInfo": true,
            "lengthChange": false,

            "columns": [
                { "data": "REQUEST_CODE", "name": "REQUEST_CODE" },
                { "data": "CARD_ID", "name": "Card Id" },
                { "data": "CHANG_EMP_NAME", "name": "NAME" },
                {
                    "data": "TYPE",
                    "name": "TYPE",
                    "mRender": function (data) {
                        if (data == "1") {
                            return "Addition";

                        } else if (data == "2") {
                            return "Edit Level";

                        } else if (data == "3") {
                            return "Termination";

                        } else if (data == "4") {
                            return "Reprint";

                        } else if (data == "5") {
                            return "Reactivation";

                        } else if (data == "6") {
                            return "Change Employee Number";

                        } else if (data == "7") {
                            return "Change Name";

                        }
                        return "Other";

                    }
                },
                { "data": "APPROVE_FLAG", "name": "APPROVE FLAG" },

                {
                    "data": "CREATED_DATE",
                    "name": "Created Date",
                    "mRender": function (data) {
                        var value = new Date(parseFloat(data.replace(/(^.*\()|([+-].*$)/g, '')));
                        var date = value.getDate() + "/" + (value.getMonth() + 1) + "/" + value.getFullYear();
                        return date;
                    }
                },
                {
                    "data": "REQUEST_CODE",
                    "mRender": function (data) {
                        if ("@fullcontroll" == "True" || "@view" == "True") {
                            return '<a class="btn btn-primary fa fa-list" href="/EmployeeRequest/Details/' + data + '"> Details </a>';
                        }
                        else
                            return '<input  data-id=' + data + '  hidden  /> ';
                    }
                },


            ]
        });
    })
</script>