<div class="portlet box  green">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-gift"></i>Requests
        </div>

    </div>
    <br />
    <div class="portlet-body">

        <table class="ui celled table" id="Index" width="100%">
            <thead>
                <tr>

                    <th>
                        Id
                    </th>
                    <th>
                        Card Id
                    </th>
                    <th>
                        Name
                    </th>
                    <th>
                        Request Type
                    </th>
                    <th>
                        status
                    </th>
                    <th>
                        CreatedDate
                    </th>
                    <th></th>
                    @*<th></th>
                        <th></th>
                        <th></th>*@
                </tr>
            </thead>
            <tbody></tbody>

        </table>
    </div>
</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

<script>
    $(function () {
        $("#Index").DataTable({
            "sAjaxSource": '/EmployeeRequest/RequestList',
            "bServerSide": true,
            "processing": true,
            "bFilter": true,
            "bSort": false,
            "pageLength": 10,
            "bInfo": true,
            "lengthChange": false,

            "columns": [
                { "data": "REQUEST_CODE", "name": "REQUEST_CODE" },
                { "data": "CARD_ID", "name": "Card Id" },
                { "data": "CHANG_EMP_NAME", "name": "NAME" },
                {
                    "data": "TYPE",
                    "name": "TYPE",
                    "mRender": function (data) {
                        if (data == "1") {
                            return "Addition";

                        } else if (data == "2") {
                            return "Edit Level";

                        } else if (data == "3") {
                            return "Termination";

                        } else if (data == "4") {
                            return "Reprint";

                        } else if (data == "5") {
                            return "Reactivation";

                        } else if (data == "6") {
                            return "Change Employee Number";

                        } else if (data == "7") {
                            return "Change Name";

                        }
                        return "Other";

                    }
                },
                { "data": "APPROVE_FLAG", "name": "APPROVE FLAG" },

                {
                    "data": "CREATED_DATE",
                    "name": "Created Date",
                    "mRender": function (data) {
                        var value = new Date(parseFloat(data.replace(/(^.*\()|([+-].*$)/g, '')));
                        var date = value.getDate() + "/" + (value.getMonth() + 1) + "/" + value.getFullYear();
                        return date;
                    }
                },
                {
                    "data": "REQUEST_CODE",
                    "mRender": function (data) {
                        return '<a class="btn btn-info" href="/EmployeeRequest/Create/' + data + '">Edit</a>';
                    }
                },


            ]
        });
    })
</script>