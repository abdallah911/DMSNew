        {
            @Html.ActionLink(" Back to List", "Index", null, htmlAttributes: new { @class = "btn btn-primary fa fa-backward", @style = " text-transform: none" })
        }
        else
        {
            <div class="portlet-body">

                <div class="panel panel-info">
                    <h2 class="panel-heading" style="margin:1px;">Update Status</h2>
                    <div class="panel-body">
                        <div class="row">
                            <div class="form-group">
                                <input type="text" id="id" value="@Model.REQUEST_CODE" hidden />
                                <div class="col-lg-3">
                                    <h4>@Html.Label("Update Status :", htmlAttributes: new { @class = "control-label" })</h4>

                                </div>
                                <div class="col-lg-3" data-step="7" data-intro="Select speciality">
                                    @Html.TextAreaFor(model => model.APPROVE_FLAG, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                            </div>
                        </div>
                    </div>

                    <!--Save-->
                    <div class="panel-footer" style="text-align:right;">
                        @*<input data-step="10" data-intro="Help" style="float: left;" id="Help" type="button" value="Help" class="btn btn-info" />*@
                        @*<input data-step="11" data-intro="Reset Medicine" id="reset" type="button" value="Reset" onclick="ClearMedicineData();" class="btn btn-warning" />*@
                        @Html.ActionLink(" Back to List", "Index", null, htmlAttributes: new { @class = "btn btn-primary fa fa-backward", @style = " text-transform: none" })
                        <input data-step="12" data-intro="Update Status" id="submit" type="button" value="Update" class="btn btn-success fa fa-check" />
                    </div>

