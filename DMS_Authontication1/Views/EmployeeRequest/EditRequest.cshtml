@model DMS_Authontication1.Models.Employee_Request
@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "EditRequest";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";


    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 12 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}
<style>
    div > span:not(.select2 ) {
        display: flex;
        white-space: nowrap;
        top: 15% !important;
    }
    .labeled-file-box { 
    }
        .labeled-file-box > div {
            border: 1px solid #c2cad8;
            display: flex;
            padding: 2px 0;
            border-radius: 4px;
            height: 40px;
        }
        .labeled-file-box label {
            padding-left: 20px;
            color: #337ab7;
        }
        .labeled-file-box input {
            width: 60%;
            border: 1px solid #afa9a9;
            border-radius: 4px; 
        }
    .labeled-file-box span {
        width: 40% ;
        color:#337ab7;
    }
    .download-btn {
        display: flex;
        align-items: center;
        gap: 20px;
    }
    .download-btn label {
        color: #337ab7;
        font-weight: 700;
    }
    i.fa.fa-download {
        position: relative;
    }
    .fa-download:before {
        content: "\f019";
        position: absolute;
        top: 50%;
        left: 10px;
        transform: translateY(-50%);
        z-index: 1;
        color: white;
    }
    .fa.fa-download input {
        padding-left: 30px !important;
    }
    span.ar {
        right: 30px !important;
        left: unset !important;
    }
    label{
        padding-top:0 !important;
    }
</style>
