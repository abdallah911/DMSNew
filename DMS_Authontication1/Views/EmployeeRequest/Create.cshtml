@model DMS_Authontication1.Models.Employee_Request

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}
    <div style="margin-top:150px">
        <p>
            @Html.ActionLink(" New Employee", "Create", null, htmlAttributes: new { @class = "btn btn-info fa fa-plus", @style = " text-transform: none" })
            @Html.ActionLink(" Edit Employee", "EditRequest", null, htmlAttributes: new { @class = "btn btn-warning fa fa-pencil", @style = " text-transform: none" })
            @Html.ActionLink(" Termination Request", "Termination", null, htmlAttributes: new { @class = "btn btn-danger fa fa-remove", @style = " text-transform: none" })
        </p>

        <div class="portlet box  green">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-gift"></i>New Employee
                </div>
            </div>
            <div class="portlet-body">
                <div class="form-horizontal">

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.REQUEST_CODE)

                    <div class="form-group col-md-3">
                        <label class="control-label  col-md-5">
                            FirstName
                            <span class="required"> * </span>
                        </label>
                        <div class="col-md-7">
                            @Html.EditorFor(model => model.EMP_ENAME_ST, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.EMP_ENAME_ST, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-3">
                        <label class="control-label  col-md-5">
                            Second
                            <span class="required"> * </span>
                        </label>
                        @*@Html.Label("Second", htmlAttributes: new { @class = "control-label col-md-3" })
                        <span class="required"> * </span>*@
                        <div class="col-md-7">
                            @Html.EditorFor(model => model.EMP_ENAME_SC, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.EMP_ENAME_SC, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-3">
                        <label class="control-label  col-md-5">
                            Third
                            <span class="required"> * </span>
                        </label>
                        @*@Html.Label("Third", htmlAttributes: new { @class = "control-label col-md-3" })
                        <span class="required"> * </span>*@
                        <div class="col-md-7">
                            @Html.EditorFor(model => model.EMP_ENAME_TH, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.EMP_ENAME_TH, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-3">
                        @Html.Label("Fourth", htmlAttributes: new { @class = "control-label col-md-5" })
                        <div class="col-md-7">
                            @Html.EditorFor(model => model.EMP_ENAME_FR, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.EMP_ENAME_FR, "", new { @class = "text-danger" })
                        </div>
                    </div>




                    <div class="form-group col-md-3">

                        <div class="col-md-9">
                            @Html.EditorFor(model => model.EMP_ANAME_FR, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.EMP_ANAME_FR, "", new { @class = "text-danger" })
                        </div>
                        @Html.Label("الرابع", htmlAttributes: new { @class = "control-label col-md-3" })

                    </div>

                    <div class="form-group col-md-3">
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.EMP_ANAME_TH, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.EMP_ANAME_TH, "", new { @class = "text-danger" })
                        </div>
                        <label class="control-label  col-md-3">
                            <span class="required"> * </span>
                            الثالث

                        </label>
                        @*@Html.Label("الثالث", htmlAttributes: new { @class = "control-label col-md-3" })
                        <span class="required"> * </span>*@

                    </div>

                    <div class="form-group col-md-3">
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.EMP_ANAME_SC, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.EMP_ANAME_SC, "", new { @class = "text-danger" })
                        </div>
                        <label class="control-label  col-md-3">
                            <span class="required"> * </span>
                            الثانى

                        </label>

                        @*@Html.Label("الثانى", htmlAttributes: new { @class = "control-label col-md-3" })
                        <span class="required"> * </span>*@

                    </div>

                    <div class="form-group col-md-3">
                        <div class="col-md-7">
                            @Html.EditorFor(model => model.EMP_ANAME_ST, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.EMP_ANAME_ST, "", new { @class = "text-danger" })
                        </div>
                        <label class="control-label  col-md-5">
                            <span class="required"> * </span>
                            الاسم الاول

                        </label>
                        @*@Html.Label("الاسم الاول", htmlAttributes: new { @class = "control-label col-md-3" })
                        <span class="required"> * </span>*@

                    </div>


                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.EMP_CLASS, htmlAttributes: new { @class = "control-label col-md-2" })
                        <span class="required"> * </span>
                        <div class="col-md-10">
                            @* @Html.EditorFor(model => model.ServiceID, new { htmlAttributes = new { @class = "form-control" } })*@
                            @Html.DropDownList("EMP_CLASS", ViewBag.levels as SelectList, "--Select--", new { @class = "form-control", id = "EMP_CLASS", @required = "True" })

                            @Html.ValidationMessageFor(model => model.EMP_CLASS, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        @Html.Label("Relation", new { @class = "col-md-2 control-label" })
                        <span class="required"> * </span>
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.EMP_RELATION, new List<SelectListItem>
                                 {
                                    new SelectListItem{ Text="موظف", Value = "1" },
                                    new SelectListItem{ Text="زوج/ه", Value = "2" },
                                    new SelectListItem{ Text="ابن/ه", Value = "3" },
                                    new SelectListItem{ Text="اب/ام", Value = "4" },
                                 }, "--Select--", new { @class = "form-control", @required = "True" })
                        </div>
                    </div>

                    <div class="form-group col-md-6" id="divCardId" style="display: none;">
                        @Html.LabelFor(model => model.CARD_ID, htmlAttributes: new { @class = "control-label col-md-2" })
                        <span class="required"> * </span>
                        <div class="col-md-10">
                            <select id="CARD_ID" class="js-data-example-ajax" style="width: 100%"></select>
                            @Html.ValidationMessageFor(model => model.CARD_ID, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.NATIONAL_ID, htmlAttributes: new { @class = "control-label col-md-2" })
                        <span class="required"> * </span>
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.NATIONAL_ID, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.NATIONAL_ID, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.BIRTHDATE, htmlAttributes: new { @class = "control-label col-md-2" })
                        <span class="required"> * </span>
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.BIRTHDATE, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.BIRTHDATE, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        @Html.Label("Gender", new { @class = "col-md-2 control-label" })
                        <span class="required"> * </span>
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.GENDER, new List<SelectListItem>
                                 {
                                    new SelectListItem{ Text="Male", Value = "1" },
                                    new SelectListItem{ Text="Female", Value = "2" },
                                 }, "--Select--", new { @class = "form-control", @required = "True" })
                        </div>
                    </div>


                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.MOBILE, htmlAttributes: new { @class = "control-label col-md-2" })
                        <span class="required"> * </span>
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.MOBILE, new { htmlAttributes = new { @class = "form-control", @onkeypress = "return /[0-9]/i.test(event.key)" } })
                            @Html.ValidationMessageFor(model => model.MOBILE, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.EMAIL, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.EMAIL, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.EMAIL, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.START_DATE, htmlAttributes: new { @class = "control-label col-md-2" })
                        <span class="required"> * </span>
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.START_DATE, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.START_DATE, "", new { @class = "text-danger" })
                        </div>
                    </div>


                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.ADDRESS, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.ADDRESS, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ADDRESS, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.BRANCH, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @* @Html.EditorFor(model => model.ServiceID, new { htmlAttributes = new { @class = "form-control" } })*@
                            @Html.DropDownList("BRANCH", ViewBag.Branchs as SelectList, "--Select--", new { @class = "form-control", id = "BRANCH" })

                            @Html.ValidationMessageFor(model => model.BRANCH, "", new { @class = "text-danger" })
                        </div>
                    </div>


                    <div class="form-group col-md-6">
                        @Html.Label("هل ترتدى نظاره؟", new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.GLASSES, new List<SelectListItem>
                                 {
                                    new SelectListItem{ Text="Yes", Value = "1" },
                                    new SelectListItem{ Text="No", Value = "2" },
                                 }, "--Select--", new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        @Html.Label("هل تعانى من امراض سابقه؟", new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.DISEASE, new List<SelectListItem>
                                 {
                                    new SelectListItem{ Text="Yes", Value = "1" },
                                    new SelectListItem{ Text="No", Value = "0" },
                                 }, "--Select--", new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.EMP_IMG, htmlAttributes: new { @class = "control-label col-md-2" })
                        <span class="required"> * </span>
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.EMP_IMG, new { htmlAttributes = new { @class = "form-control", @type = "File", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.EMP_IMG, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-10 col-md-2">
                        </div>
                    </div>
                </div>

            </div>
            <div class="panel-footer" style="text-align:right;">
                <input data-step="9" data-intro="Reset Medicine" id="reset" type="button" value="Reset" onclick="ClearSaveRequest();" class="btn btn-warning" />
                @* <input data-step="10" data-intro="Save Preception" id="submit" type="button" value="Save" class="btn btn-success" />*@
                <input type="submit" id="submit" value="Save" class="btn btn-success" style="text-transform: none" />

            </div>
        </div>

    </div>
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>

<script src="~/Scripts/DMS/HR/Requests.js"></script>
