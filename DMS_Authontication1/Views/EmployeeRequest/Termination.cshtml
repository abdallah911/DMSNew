@model DMS_Authontication1.Models.Employee_Request

@{
    ViewBag.Title = "Termination";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}
<div style="margin-top:150px">
    <p>
        @Html.ActionLink(" New Employee", "Create", null, htmlAttributes: new { @class = "btn btn-info fa fa-plus", @style = " text-transform: none" })
        @Html.ActionLink(" Edit Employee", "EditRequest", null, htmlAttributes: new { @class = "btn btn-warning fa fa-pencil", @style = " text-transform: none" })
        @Html.ActionLink(" Termination Request", "Termination", null, htmlAttributes: new { @class = "btn btn-danger fa fa-remove", @style = " text-transform: none" })
    </p>
    <div class="portlet box  green">
        <div class="portlet-title">
            <div class="caption">
                <i class="fa-solid fa-home me-1"></i>Termination Request
            </div>
        </div>
        <div class="portlet-body">
            <div class="form-horizontal">

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="row">
                    <div class="form-group  col-md-7">
                        @Html.LabelFor(model => model.CARD_ID, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <select id="CARD_ID" class="js-data-example-ajax" style="width: 100%"></select>

                            @*@Html.EditorFor(model => model.CARD_ID, new { htmlAttributes = new { @class = "form-control" } })*@
                            @Html.ValidationMessageFor(model => model.CARD_ID, "", new { @class = "text-danger", @required = "True" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-7">
                        @Html.Label("Termination Date", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.TERMINATE_DATE, new { htmlAttributes = new { @class = "form-control", @required = "True" } })
                            @Html.ValidationMessageFor(model => model.TERMINATE_DATE, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-7">
                        @Html.Label("Do you take Card?", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.DELIVER_CARD_FLAG, new List<SelectListItem>
                                                    {
                                                       new SelectListItem{ Text="Yes", Value = "Yes" },
                                                       new SelectListItem{ Text="No", Value = "No" },
                                                    }, "--Select--", new { @class = "form-control", @required = "True" })
                        </div>
                    </div>
                </div>
                <div class="row" id="divDELIVER_CARD_DATE" hidden>
                    <div class="form-group col-md-7">
                        @Html.Label("Take Card Date", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.DELIVER_CARD_DATE, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.DELIVER_CARD_DATE, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>


                @*<div class="form-group col-md-6">
                        @Html.Label("Gender", new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.GENDER, new List<SelectListItem>
                                 {
                                    new SelectListItem{ Text="Male", Value = "1" },
                                    new SelectListItem{ Text="Female", Value = "2" },
                                 }, "--Select--", new { @class = "form-control",@required="True" })
                        </div>
                    </div>*@


                <div class="form-group">
                    <div class="col-md-offset-10 col-md-2">
                    </div>
                </div>
            </div>

        </div>
        <div class="panel-footer" style="text-align:right;">
            <input data-step="9" data-intro="Reset Medicine" id="reset" type="button" value="Reset" onclick="ClearTerminationRequest();" class="btn btn-warning" />
            @* <input data-step="10" data-intro="Save Preception" id="submit" type="button" value="Save" class="btn btn-success" />*@
            <input type="submit" id="submit" value="Save" class="btn btn-success" style="text-transform: none" />

        </div>
    </div>
</div>
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>

<script src="~/Scripts/DMS/HR/Termination.js"></script>
