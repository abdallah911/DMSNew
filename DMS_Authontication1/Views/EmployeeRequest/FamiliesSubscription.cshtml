@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";

    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 12 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}
<style>
    .forLabel > span:not(.select2-container), .select {
        left: unset;
        right: 20px;
    }

    label {
        color: #337ab7;
        font-weight: 700;
        font-size: 16px;
    }

    ::placeholder {
        color: #337ab7;
        font-weight: 700;
        font-size: 16px;
    }
</style>
<div class="dms-container">
    <div class="portlet box" dir="rtl">
        <div class="portlet-title title-bg text-white fw-bold">
            <div class="caption">
                <i class="fa fa-home"></i>Families
            </div>
        </div>
        <div class="d-flex flex-wrap row-gap-2 container mt-4 ">
            <div class="w-100 d-flex justify-content-center justify-content-md-start mb-4">
                <div class="forLabel col-sm-8 px-2">
                    <select required></select>
                    <span>كارت الموظف</span>
                </div>
            </div>
            <div class="w-100 d-flex align-items-center gap-3 me-3 mb-3">
                <div class="d-flex align-items-cente">
                    <label for="husbandRadio">زوج</label>
                    <input type="radio" id="husbandRadio" name="parentRadio" />
                </div>
                <div class="d-flex align-items-cente">
                    <label for="wifeRadio">زوجة</label>
                    <input type="radio" id="wifeRadio" name="parentRadio" />
                </div>
            </div>
            <div class="d-flex flex-column row-gap-2 w-100">
                <div class="d-flex align-items-center w-100 labeled-file-box gap-2">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2 col-sm-3">
                            <label for="sonCheck">إبن</label>
                            <input type="checkbox" style="width:unset" id="sonCheck" />
                        </div>
                        <div class="mx-auto col-sm-4 px-2 d-none" id="sonsInputWrapper">
                            <input class="w-100" type="number" placeholder="عدد الأولاد" required />
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center w-100 labeled-file-box gap-2">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2 col-sm-3">
                                <label for="daughterCheck">إبنة</label>
                                <input type="checkbox" style="width:unset" id="daughterCheck" />
                            </div>
                            <div class="mx-auto col-sm-4 px-2 d-none" id="daughtersInputWrapper">
                                <input class="w-100" type="number" placeholder="عدد البنات" required />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

<script>
    $(document).ready(function () {
        $('#sonCheck').on('change', function () {
            if ($(this).is(':checked')) {
                $('#sonsInputWrapper').removeClass('d-none').hide().slideDown();
            } else {
                $('#sonsInputWrapper').slideUp(function () {
                    $(this).addClass('d-none');
                });
            }
        });

        $('#daughterCheck').on('change', function () {
            if ($(this).is(':checked')) {
                $('#daughtersInputWrapper').removeClass('d-none').hide().slideDown();
            } else {
                $('#daughtersInputWrapper').slideUp(function () {
                    $(this).addClass('d-none');
                });
            }
        });
    });
</script>