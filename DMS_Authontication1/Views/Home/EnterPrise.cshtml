
@{
    ViewBag.Title = "EnterPrise";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DMS - @ViewBag.Title</title>
    <link rel="stylesheet" href="~/assets/NewDesign/css/all.min.css" />
    <link rel="stylesheet" href="~/assets/NewDesign/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/NewDesign/css/owl.carousel.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/assets/NewDesign/css/hr.css" />
</head>
<body>
    <div id="btnUp" class="btn">
        <i class="fa-solid fa-chevron-up fs-2"></i>
    </div>
    <div id="HR">
        <div id="product-details" class="container py-5">
            <div class="row">
                <div class="col-md-8">
                    <div class="product-details">
                        <h2>CUSTOM ENTERPRISE APPLICATION DEVELOPMENT</h2>
                        <p class="text-muted my-5">
                            IntexSoft provides enterprise application development services
                            for corporations and big market players to enhance their inner
                            processes, providing relevant and scalable software solutions.
                            Leverage our expertise in software development to cover the
                            resource gap, unlock new potential and streamline business
                            capacities.
                        </p>
                        <hr />
                        <div class="details-product rounded-4">
                            <h4>Enterprise web development</h4>
                            <p>
                                Within custom enterprise application development services, we
                                build turnkey tools and applications based on the ecosystem of
                                your organization to meet specific business goals. We take
                                care of all the technical staff while you are focused on major
                                issues.
                            </p>
                            <h4>Mobile app development for HR</h4>
                            <p>
                                Enterprise mobile development We cover the design,
                                development, third-party integrations and maintenance of
                                custom native or cross-platform applications. Fit corporate
                                communication, human resource processes, employee tracking and
                                even document flow into a small and portable solution.
                            </p>
                            <h4>ERP software development services</h4>
                            <p>
                                Gather, track and handle all company’s operations from sales
                                to logistics in one system. Within ERP software development
                                services we are able to create custom solution from the ground
                                up, or adjust an existing Enterprise Resource Planning system
                                for flawless and secure performance of your business.
                            </p>
                            <h4>CRM development services</h4>
                            <p>
                                Secure customer data management and storage with our CRM
                                development services. We deliver custom CRM systems to provide
                                quality business-to-client communication, automate manual
                                tasks and accumulate expertise of the company for further
                                business growth.
                            </p>
                            <h4>Enterprise application modernization</h4>
                            <p>
                                If your existing system becomes expensive to manage, lacks
                                agility and scalability, and no longer meets accelerating
                                business needs – it’s time for software overhaul. We offer
                                re-engineering of legacy and outdated enterprise solutions to
                                help companies get the most of their business. Improve system
                                performance, migrate to cutting-edge technologies and get rid
                                of hidden maintenance costs with enterprise application
                                modernization services.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="productImgs h-100">
                        <div id="carouselExampleIndicators" class="carousel slide">
                            <div class="carousel-indicators">
                                <button type="button"
                                        data-bs-target="#carouselExampleIndicators"
                                        data-bs-slide-to="0"
                                        class="active"
                                        aria-current="true"
                                        aria-label="Slide 1"></button>
                                <button type="button"
                                        data-bs-target="#carouselExampleIndicators"
                                        data-bs-slide-to="1"
                                        aria-label="Slide 2"></button>
                                <button type="button"
                                        data-bs-target="#carouselExampleIndicators"
                                        data-bs-slide-to="2"
                                        aria-label="Slide 3"></button>
                            </div>
                            <div class="carousel-inner">
                                <div class="carousel-item active">
                                    <img src="~/assets/NewDesign/img/enterPrice/website S  7-17.png"
                                         class="d-block w-100"
                                         alt="..." />
                                </div>
                                <div class="carousel-item">
                                    <img src="~/assets/NewDesign/img/enterPrice/website S  80-17.png"
                                         class="d-block w-100"
                                         alt="..." />
                                </div>
                                <div class="carousel-item">
                                    <img src="~/assets/NewDesign/img/enterPrice/website S  70-17.png"
                                         class="d-block w-100"
                                         alt="..." />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer>
            <div class="footer py-0">
                <div class="container-fluid pt-5">
                    <div class="row m-auto">
                        <div class="col-md-5">
                            <div class="footerP1 me-4 p-3">
                                <h1 class="mb-1 ms-3">COMPANY</h1>
                                <div class="line"></div>
                                <p class="h6">
                                    SIOS is a software development company. We develop end-to-end
                                    software for midsize companies and enterprises, mainly from
                                    EGYPT. We help business to upscale creating valuable and
                                    best-fit custom so.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="footerP2">
                                <h1>Head-Office</h1>
                                <div class="line ms-0"></div>
                                <h6>12 Abdelazim Awadallah St., Heliopolis, Cairo</h6>
                                <h5 class="mt-5">Contact</h5>
                                <p><i class="fa-regular fa-envelope"></i> SIOS@gmail.com</p>
                                <p>
                                    <i class="fa-solid fa-phone"></i> 01032274222 – 01026006177
                                </p>
                            </div>
                        </div>

                        <div class="col-md-3 ms-4">
                            <div class="footerP3">
                                <h1>Servives</h1>
                                <div class="line ms-0"></div>

                                <p>
                                    <i class="fa-solid fa-caret-right me-2"></i>
                                    Business Analysis Services
                                </p>
                                <p>
                                    <i class="fa-solid fa-caret-right me-2"></i>
                                    Web Development Services
                                </p>
                                <p>
                                    <i class="fa-solid fa-caret-right me-2"></i>
                                    Mobile Development
                                </p>
                                <p>
                                    <i class="fa-solid text-capitalize fa-caret-right me-2"></i>
                                    Graphic Design Software
                                </p>
                                <p>
                                    <i class="fa-solid text-capitalize fa-caret-right me-2"></i>
                                    Software Product Design
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
    <script src="~/assets/NewDesign/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/NewDesign/js/bootstrap.min.js"></script>
    <script src="~/assets/NewDesign/js/jquery-3.6.3.min.js"></script>
    <script src="~/assets/NewDesign/js/owl.carousel.min.js"></script>
    <script src="~/assets/NewDesign/js/wow.min.js"></script>
    <script src="~/assets/NewDesign/js/index.js"></script>
</body>
</html>

