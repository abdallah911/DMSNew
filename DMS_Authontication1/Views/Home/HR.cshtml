
@{
    ViewBag.Title = "HR";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIOS - @ViewBag.Title</title>
    <link rel="stylesheet" href="~/assets/NewDesign/css/all.min.css" />
    <link rel="stylesheet" href="~/assets/NewDesign/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/NewDesign/css/owl.carousel.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/assets/NewDesign/css/hr.css" />
</head>
<body>
    <div id="btnUp" class="btn">
        <i class="fa-solid fa-chevron-up fs-2"></i>
    </div>
    <div id="HR">
        <div id="product-details" class="container py-5">
            <div class="row">
                <div class="col-md-8">
                    <div class="product-details">
                        <h2>HR SOFTWARE DEVELOPMENT SERVICES</h2>
                        <p class="text-muted my-5">
                            Embrace our background to scale your HR capacities and
                            streamline the workflow efficiently. We are proud of the fact
                            that the products developed by our team were successfully
                            implemented among our clients and distributed to their customers
                            as a SaaS (software-as-a-service) product. We can develop a
                            turnkey product based on your requirements or provide you with a
                            specialist or a team of experts who will assist you or your
                            in-house team.
                        </p>
                        <hr />
                        <div class="details-product rounded-4">
                            <h4>Custom web development for HRM</h4>
                            <p>
                                Make your company work quickly and efficiently with web HR
                                management software. Working on such applications, we
                                emphasize security to protect critical information about inner
                                processes and employees
                            </p>
                            <h4>Mobile app development for HR</h4>
                            <p>
                                Stay up-to-date with the company's activities wherever you
                                are. Mobile HR applications are a must-have for companies in
                                our mobile-addicted world. These apps allow companies to
                                synchronize and optimize the workflow between departments with
                                prompt notifications on new tasks, comments, etc
                            </p>
                            <h4>Single-process automation</h4>
                            <p>
                                HR management systems developed by our team can function as
                                simple HRM system or module for automation of a single
                                particular process as well as a full-fledged HR platform
                                including the modules needed to optimize adequate processes in
                                your company.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="productImgs h-100">
                        <div id="carouselExampleIndicators" class="carousel slide">
                            <div class="carousel-indicators">
                                <button type="button"
                                        data-bs-target="#carouselExampleIndicators"
                                        data-bs-slide-to="0"
                                        class="active"
                                        aria-current="true"
                                        aria-label="Slide 1"></button>
                                <button type="button"
                                        data-bs-target="#carouselExampleIndicators"
                                        data-bs-slide-to="1"
                                        aria-label="Slide 2"></button>
                                <button type="button"
                                        data-bs-target="#carouselExampleIndicators"
                                        data-bs-slide-to="2"
                                        aria-label="Slide 3"></button>
                            </div>
                            <div class="carousel-inner">
                                <div class="carousel-item active">
                                    <img src="~/assets/NewDesign/img/Hr/hr1.jpg"
                                         class="d-block w-100"
                                         alt="..." />
                                </div>
                                <div class="carousel-item">
                                    <img src="~/assets/NewDesign/img/Hr/hr2.jpg"
                                         class="d-block w-100"
                                         alt="..." />
                                </div>
                                <div class="carousel-item">
                                    <img src="~/assets/NewDesign/img/Hr/h3.jpg"
                                         class="d-block w-100"
                                         alt="..." />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer>
            <div class="footer py-0">
                <div class="container-fluid pt-5">
                    <div class="row m-auto">
                        <div class="col-md-5">
                            <div class="footerP1 me-4 p-3">
                                <h1 class="mb-1 ms-3">COMPANY</h1>
                                <div class="line"></div>
                                <p class="h6">
                                    SIOS is a software development company. We develop end-to-end
                                    software for midsize companies and enterprises, mainly from
                                    EGYPT. We help business to upscale creating valuable and
                                    best-fit custom so.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="footerP2">
                                <h1>Head-Office</h1>
                                <div class="line ms-0"></div>
                                <h6>12 Abdelazim Awadallah St., Heliopolis, Cairo</h6>
                                <h5 class="mt-5">Contact</h5>
                                <p><i class="fa-regular fa-envelope"></i> SIOS@gmail.com</p>
                                <p>
                                    <i class="fa-solid fa-phone"></i> 01032274222 – 01026006177
                                </p>
                            </div>
                        </div>

                        <div class="col-md-3 ms-4">
                            <div class="footerP3">
                                <h1>Servives</h1>
                                <div class="line ms-0"></div>

                                <p>
                                    <i class="fa-solid fa-caret-right me-2"></i>
                                    Business Analysis Services
                                </p>
                                <p>
                                    <i class="fa-solid fa-caret-right me-2"></i>
                                    Web Development Services
                                </p>
                                <p>
                                    <i class="fa-solid fa-caret-right me-2"></i>
                                    Mobile Development
                                </p>
                                <p>
                                    <i class="fa-solid text-capitalize fa-caret-right me-2"></i>
                                    Graphic Design Software
                                </p>
                                <p>
                                    <i class="fa-solid text-capitalize fa-caret-right me-2"></i>
                                    Software Product Design
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
    <script src="~/assets/NewDesign/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/NewDesign/js/bootstrap.min.js"></script>
    <script src="~/assets/NewDesign/js/jquery-3.6.3.min.js"></script>
    <script src="~/assets/NewDesign/js/owl.carousel.min.js"></script>
    <script src="~/assets/NewDesign/js/wow.min.js"></script>
    <script src="~/assets/NewDesign/js/index.js"></script>
</body>
</html>

