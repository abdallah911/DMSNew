
@{
    ViewBag.Title = "Admin";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIOS - @ViewBag.Title</title>
    <link rel="stylesheet" href="~/assets/NewDesign/css/all.min.css" />
    <link rel="stylesheet" href="~/assets/NewDesign/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/NewDesign/css/owl.carousel.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/assets/NewDesign/css/hr.css" />
</head>
<body>
    <div id="btnUp" class="btn">
        <i class="fa-solid fa-chevron-up fs-2"></i>
    </div>
    <div id="HR">
        <div class=" ">
            <div class="row px-0">
                <div class="w-100 position-relative">
                    <img src="~/assets/NewDesign/img/adminProfil/self adminProfile-2.jpg"  class="d-block w-100"  alt="..." />
                    <div class="position-absolute  start-50 translate-middle-x    p-4 rounded-5" style="white-space: nowrap; white-space: nowrap; top: 70%; background: linear-gradient(45deg, #22060657, #070f1840); ">
                        <h2 class=" text-white fw-bold fs-1 ">SELF-ADMIN COMPANIES SYSTEMS</h2>
                    </div>
                </div>
                <div class="container">
                    <div class="product-details"> 
                        <p class="text-muted mx-3 my-5">
                            Based on our experience managing multiple healthcare companies,
                            we have designed a system that is compatible with most
                            organizations that independently manage healthcare. This system
                            combines simplicity, accuracy and professionalism in
                            performance.
                        </p>
                        <hr />
                        <div class="details-product rounded-4">
                            <h4>Medical Network Management System</h4>
                            <p>
                                We rely mainly on our presence with most service providers in
                                Egypt, so this makes it easier for us to form a selected
                                medical network according to the client’s desires on the one
                                hand and according to the geographical distribution of its
                                employees.
                            </p>
                            <h4>E-Claims Management System</h4>
                            <p>
                                The review system of self-management companies is based on our
                                accumulated experience working for medical care companies to
                                ensure obtaining the highest benefit and to prevent any
                                tampering that may occur. Our system also enables it to
                                integrate with the organization’s employee payroll system so
                                that the deduction process is automated.
                            </p>
                            <h4>Reports</h4>
                            <p>
                                Our system provides many reports in an automated manner to
                                serve all needs and help provide assistance in making
                                appropriate decisions
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer>
            <div class="footer py-0">
                <div class="container-fluid pt-5">
                    <div class="row m-auto">
                        <div class="col-md-5">
                            <div class="footerP1 me-4 p-3">
                                <h1 class="mb-1 ms-3">COMPANY</h1>
                                <div class="line"></div>
                                <p class="h6">
                                    SIOS is a software development company. We develop
                                    end-to-end software for midsize companies and enterprises,
                                    mainly from EGYPT. We help business to upscale creating
                                    valuable and best-fit custom so.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="footerP2">
                                <h1>Head-Office</h1>
                                <div class="line ms-0"></div>
                                <h6>12 Abdelazim Awadallah St., Heliopolis, Cairo</h6>
                                <h5 class="mt-5">Contact</h5>
                                <p><i class="fa-regular fa-envelope"></i> SIOS@gmail.com</p>
                                <p>
                                    <i class="fa-solid fa-phone"></i> 01032274222 – 01026006177
                                </p>
                            </div>
                        </div>

                        <div class="col-md-3 ms-4">
                            <div class="footerP3">
                                <h1>Servives</h1>
                                <div class="line ms-0"></div>

                                <p>
                                    <i class="fa-solid fa-caret-right me-2"></i>
                                    Business Analysis Services
                                </p>
                                <p>
                                    <i class="fa-solid fa-caret-right me-2"></i>
                                    Web Development Services
                                </p>
                                <p>
                                    <i class="fa-solid fa-caret-right me-2"></i>
                                    Mobile Development
                                </p>
                                <p>
                                    <i class="fa-solid text-capitalize fa-caret-right me-2"></i>
                                    Graphic Design Software
                                </p>
                                <p>
                                    <i class="fa-solid text-capitalize fa-caret-right me-2"></i>
                                    Software Product Design
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
    <script src="~/assets/NewDesign/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/NewDesign/js/bootstrap.min.js"></script>
    <script src="~/assets/NewDesign/js/jquery-3.6.3.min.js"></script>
    <script src="~/assets/NewDesign/js/owl.carousel.min.js"></script>
    <script src="~/assets/NewDesign/js/wow.min.js"></script>
    <script src="~/assets/NewDesign/js/index.js"></script>
</body>
</html>

