
@{
    ViewBag.Title = "Health";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIOS - @ViewBag.Title</title>
    <link rel="stylesheet" href="~/assets/NewDesign/css/all.min.css" />
    <link rel="stylesheet" href="~/assets/NewDesign/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/NewDesign/css/owl.carousel.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/assets/NewDesign/css/hr.css" />
</head>
<body>
    <div id="btnUp" class="btn">
        <i class="fa-solid fa-chevron-up fs-2"></i>
    </div>
    <div id="HR">
        <div class="container py-5">
            <div class="row">
                <div class="col-md-8">
                    <div class="product-details">
                        <h2>Healthcare Company Management System</h2>
                        <p class="text-muted my-5">
                            We have extensive experience in the field of managing health
                            care companies in Egypt for more than 25 years, through a
                            partnership with one of the largest health care companies in
                            Egypt. The expertise of our partners in the field of health care
                            was exploited to design an application that is compatible with
                            all companies operating in the Egyptian market.
                        </p>
                        <hr />
                        <div class="details-product rounded-4">
                            <h4>E-Approvals Management System</h4>
                            <p>
                                We are honored that our system is available to most service
                                providers in Egypt, spread throughout all governorates of the
                                Republic, and ongoing training is followed up with them on a
                                permanent basis.
                            </p>
                            <h4>E-Claims Management System</h4>
                            <p>
                                Through the latest applications in the field of programming, a
                                complete system has been built to review claims automatically
                                through an auxiliary system that contains medical review rules
                                supported by a complete system that includes price lists of
                                all service providers to facilitate the review process.
                            </p>
                            <h4>Policy and Employee Data Building system</h4>
                            <p>
                                Our system includes an integrated part for building policies
                                in a very professional and flexible manner in order to ensure
                                the complete application of all policies items. This system is
                                also supported by the latest international coding systems,
                                whether the disease coding system or the medical procedures
                                coding system.
                            </p>
                            <h4>Pricing and Risk Management System</h4>
                            <p>
                                Our system includes an integrated part to complete the pricing
                                process in a professional manner, based on the expertise of
                                many actuarial experts accredited by the competent authorities
                                to ensure the maximum degree of protection against risks.
                            </p>
                            <h4>Medical Network Management System</h4>
                            <p>
                                We believe that service providers are our success partners, so
                                we have allocated part of our system to meet all their
                                requests in terms of building price lists - following up on
                                claims - collection - following up on discounts, etc.
                            </p>
                            <h4>Reports</h4>
                            <p>
                                Our system provides many reports in an automated manner to
                                serve all needs and help provide assistance in making
                                appropriate decisions
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="productImgs h-100">
                        <div id="carouselExampleIndicators" class="carousel slide">
                            <div class="carousel-indicators">
                                <button type="button"
                                        data-bs-target="#carouselExampleIndicators"
                                        data-bs-slide-to="0"
                                        class="active"
                                        aria-current="true"
                                        aria-label="Slide 1"></button>
                                <button type="button"
                                        data-bs-target="#carouselExampleIndicators"
                                        data-bs-slide-to="1"
                                        aria-label="Slide 2"></button>
                                <button type="button"
                                        data-bs-target="#carouselExampleIndicators"
                                        data-bs-slide-to="2"
                                        aria-label="Slide 3"></button>
                            </div>
                            <div class="carousel-inner">
                                <div class="carousel-item active">
                                    <img src="~/assets/NewDesign/img/commerce/1.png"
                                         class="d-block w-100"
                                         alt="..." />
                                </div>
                                <div class="carousel-item">
                                    <img src="~/assets/NewDesign/img/commerce/2.png"
                                         class="d-block w-100"
                                         alt="..." />
                                </div>
                                <div class="carousel-item">
                                    <img src="~/assets/NewDesign/img/commerce/3.png"
                                         class="d-block w-100"
                                         alt="..." />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer>
            <div class="footer py-0">
                <div class="container-fluid pt-5">
                    <div class="row m-auto">
                        <div class="col-md-5">
                            <div class="footerP1 me-4 p-3">
                                <h1 class="mb-1 ms-3">COMPANY</h1>
                                <div class="line"></div>
                                <p class="h6">
                                    SIOS is a software development company. We develop
                                    end-to-end software for midsize companies and enterprises,
                                    mainly from EGYPT. We help business to upscale creating
                                    valuable and best-fit custom so.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="footerP2">
                                <h1>Head-Office</h1>
                                <div class="line ms-0"></div>
                                <h6>12 Abdelazim Awadallah St., Heliopolis, Cairo</h6>
                                <h5 class="mt-5">Contact</h5>
                                <p><i class="fa-regular fa-envelope"></i> SIOS@gmail.com</p>
                                <p>
                                    <i class="fa-solid fa-phone"></i> 01032274222 – 01026006177
                                </p>
                            </div>
                        </div>

                        <div class="col-md-3 ms-4">
                            <div class="footerP3">
                                <h1>Servives</h1>
                                <div class="line ms-0"></div>

                                <p>
                                    <i class="fa-solid fa-caret-right me-2"></i>
                                    Business Analysis Services
                                </p>
                                <p>
                                    <i class="fa-solid fa-caret-right me-2"></i>
                                    Web Development Services
                                </p>
                                <p>
                                    <i class="fa-solid fa-caret-right me-2"></i>
                                    Mobile Development
                                </p>
                                <p>
                                    <i class="fa-solid text-capitalize fa-caret-right me-2"></i>
                                    Graphic Design Software
                                </p>
                                <p>
                                    <i class="fa-solid text-capitalize fa-caret-right me-2"></i>
                                    Software Product Design
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
    <script src="~/assets/NewDesign/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/NewDesign/js/bootstrap.min.js"></script>
    <script src="~/assets/NewDesign/js/jquery-3.6.3.min.js"></script>
    <script src="~/assets/NewDesign/js/owl.carousel.min.js"></script>
    <script src="~/assets/NewDesign/js/wow.min.js"></script>
    <script src="~/assets/NewDesign/js/index.js"></script>
</body>
</html>

