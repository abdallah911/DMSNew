@model DMS_Authontication1.ViewModel.HospitalClaimPhotoesViewModel

@{
    ViewBag.Title = "Search";
    Layout = "~/Views/Shared/_Layout_DashboardHomePage.cshtml";

}
@*<h2>Index</h2>*@
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>
@*<input type="text" id="compname" value="@ViewBag.CompName" hidden="hidden" />*@
<style>
    .form-control {
        background: transparent;
    }

    .form-horizontal .form-group {
        display: flex
    }

        .form-horizontal .form-group label {
            width: 20%;
        }

        .form-horizontal .form-group div {
            width: 80%;
        }

    select#ddlDiagnoises,
    input.admin-form-control {
        border-radius: 6px;
    }
</style>
@{
    bool showSearch = (ViewBag.stat?.ToString() ?? "") != "NoData";
}
<div style="min-height: calc(100vh - 275.9px); direction: rtl; " class="ar-page pb-4">
    @using (Html.BeginForm("UploadClaimPhoto", "Claims", FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "createForm", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="panel panel-info" style="direction:ltr">
            <h2 class="panel-heading title-bg text-white fw-bold" style="margin:1px;">Create Claim</h2>
            <div class="panel-body ">
                @if (ViewBag.error != null)
                {
                <h4 style="color:red;">@ViewBag.error</h4>
                    @*<h4 style="color:red;">Claim added befor for this card</h4>*@
                }

                @*@if (ViewBag.stat != "NoData")
        {*@
                <div id="SearchScreen" class="form-horizontal col-md-8 mx-auto row row-gap-2" style="padding-left: 93px; display:@(showSearch ? "none" : "block");">
                    <div class="form-group">
                        <label>ادخل رقم النموذج</label>
                        <div class="admin-form-control">
                            <input type="number" id="ClaimId" class="form-control" onkeydown="if(event.key === 'Enter'){ event.preventDefault(); searchClaim(); }"/>
                        </div>

                        <input id="search" type="button" value="Search" onclick="searchClaim();" class="btn btn-success" />
                    </div>
                </div>
                @* }*@
                <br />
                <br />
                <br />
                <br />



                <div id="MainScreen" class="form-horizontal col-md-6 mx-auto row row-gap-2" style="padding-left: 93px; display:@(showSearch ? "block" : "none");">


                    <div class="form-group">
                        <label>Card ID</label>
                        <div class="admin-form-control">
                            @Html.TextBoxFor(m => m.CardId, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Claim Number</label>
                        <div class="admin-form-control">
                            @Html.TextBoxFor(m => m.ClaimNumber, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Speciality</label>
                        <div class="admin-form-control">
                            @Html.TextBoxFor(m => m.Speciality, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Claim Photo</label>
                        <div class="">
                            @*<input type="file" id="wizard-picture" name="MainFileFile" accept="application/pdf" />*@
                            <input class="form-control admin-form-control p-2 text-box single-line" id="ImageFile" name="ImageFile" required accept="image/*" type="File" value="">
                        </div>
                    </div>

                    <div class="panel-footer col-md-6 mx-auto mt-3 text-center text-sm-end pe-sm-2" style="text-align:right;">
                        <input id="Back" type="button" value="Back" onclick="window.location.replace('/Claims/UploadClaimPhoto');" class="btn btn-warning" />
                        @*<input id="New" type="reset" value="Reset" class="btn btn-primary" />*@
                        <input id="submit" type="submit" value="Save" onclick="Submitform();" class="btn btn-success" />
                    </div>
                </div>

            </div>

        </div>
    }
    <div id="loading" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
        <img src="~/assets/NewDesign/img/loading.gif" alt="Loading..." style="width:250px; height:250px;">
    </div>
</div>
<script>
    function searchClaim() {     
        if ($('#ClaimId').val() != "" && !isNaN($('#ClaimId').val())) {
            //$("#wait").css("display", "block");
            $("#loading").show();
            $.ajax({
                type: "POST",
                dataType: "json",
                url: '/Claims/getData',
                data: { claimId: $('#ClaimId').val() },
                success: function (data) {

                    $("#loading").hide();

                    if (data.success) {

                        $('#CardId').val(data.data.CardId);
                        $('#ClaimNumber').val(data.data.ClaimNumber);
                        $('#Speciality').val(data.data.Speciality); 
                                                
                        $("#MainScreen").show();
                    } else {
                        alert(data.message);
                    }
                },               
                error: function () {
                    alert("error");
                }
            });
        }
        else
            toastr.error("من فضلك إختر رقم الشركة أولا");
    }

    function Submitform() {
        var SelectedDiagnosisList = $('#ddlDiagnoises').select2('data');
        var diagnose = [];
        for (var i = 0; i < SelectedDiagnosisList.length; i++) {
            //var current = {};
            //current.DIAG_CODE = SelectedDiagnosisList[i].id;
            //current.DIAG_ANAME = SelectedDiagnosisList[i].text;
            diagnose.push(SelectedDiagnosisList[i].text);
        }
        $("#Speciality").val($('#ddlSpeciality option:selected').text());
        //$("#SpecialOpportunityUsersJson").val(JSON.stringify(specialopport));

        $("#DiagnoisesJson").val(JSON.stringify(diagnose));
        $("#createForm").submit();
    }
</script> 