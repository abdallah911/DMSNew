@model DMS_Authontication1.ViewModel.HospitalClaimPhotoesViewModel

@{
    ViewBag.Title = "Search";
    Layout = "~/Views/Shared/_Layout_DashboardHomePage.cshtml";

}
@*<h2>Index</h2>*@
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
