    </div>
    <div id="loading" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
        <img src="~/assets/NewDesign/img/loading.gif" alt="Loading..." style="width:250px; height:250px;">
    </div>
</div>

<script>
    $(document).ready(function () {
        $('input[name="addressType"]').on('change', function () {
            $('.section').hide();

            const selectedId = $(this).attr('id') + 'Sec';

            $('#' + selectedId).fadeIn(300);
        });
        $('input[name="addressType"]:checked').trigger('change');
    });
</script>