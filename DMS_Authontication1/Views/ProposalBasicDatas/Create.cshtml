@model DMS_Authontication1.Models.ProposalBasicData

@{
    ViewBag.Title = "Create";
}
@*<form asp-action="Create ">*@
@using (Html.BeginForm("Create", "ProposalClasses", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="panel panel-info">
        <h2 class="panel-heading" style="margin:2px;">Create Proposal</h2>
        <div class="panel-body">
            <div class="row">
                <div class=" col-md-10 d-flex justify-content-center bd-highlight mb-3">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group col-md-offset-3">

                        <div class="form-check form-check-inline ">
                            <input style="margin: 0px 0px 20px 0px;" class="form-check-input" type="radio" name="TypeProposal" id="TypeProposalN" value="true">
                            <label style="font-family: sans-serif ;font:bolder " class="form-check-label sbold  panel-body " for="inlineRadio1">  New</label>

                            <input style="margin: 10px 10px 20px 20px; " class="form-check-input" type="radio" name="TypeProposal" id="TypeProposalR" value="false" checked="checked">
                            <label style="font-family: sans-serif ;font:bolder " class="form-check-label sbold  panel-body " for="inlineRadio2">Renewal</label>
                        </div>
                    </div>

                    <div class="form-group col-md-offset-2 col-md-12">

                        @Html.LabelFor(model => model.Id, htmlAttributes: new { @class = "control-label col-md-2 ", @style = "font-family: sans-serif text-align:left  ", @font = "bolder" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Id, new { htmlAttributes = new { @class = "control-label col-md-2" } })
                            @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <br />
                    <div class="form-group  col-md-12 " id="divCompName">
                        @Html.Label("Company Name", htmlAttributes: new { @class = "control-label col-md-2", @style = "text-align:left" })
                        <div class="col-md-4">
                            @Html.EditorFor(model => model.CompName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.CompName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group  col-md-12">
                        @Html.LabelFor(model => model.ClassType, htmlAttributes: new { @class = "control-label col-md-2 ", @style = "text-align:left" })
                        <div class="col-md-4">
                            @*@Html.DropDownList("ClassType", ViewBag.address as SelectList, "Select Country", new { @class = "form-control", id = "Country_select" })*@
                            <select class="form-select " name="ClassType" id="ClassType" aria-label="Default select example">
                                <option value="فئات فقط">فئات فقط</option>
                                <option value="فئات + أعمار">فئات + أعمار</option>
                                <option value="فئات + النوع">فئات + النوع</option>
                                <option value="فئات + الفرع">فئات + الفرع</option>
                                <option value="فئات + علاقات">فئات + علاقات</option>
                                <option value="فئات + علاقات و أعمار">فئات + علاقات و أعمار</option>

                            </select>


                            @Html.ValidationMessageFor(model => model.ClassType, "", new { @class = "text-danger" })
                        </div>
                    </div>







                    <div id="NewProposal" class="row">

                        <div class="form-group col-md-offset-3">

                            <h4 class="sbold">  Insured Before</h4>
                        </div>
                        <div class="form-group col-md-offset-3">

                            <div class="form-check form-check-inline ">
                                <input style="margin: 10px 10px 20px 0px;" class="form-check-input" type="radio" name="InsuredBefore" id="InsuredBeforeY" value="true">
                                <label class="form-check-label " for="inlineRadio1">Yes</label>

                                <input style="margin: 10px 10px 20px 20px; " class="form-check-input" type="radio" name="InsuredBefore" id="InsuredBeforeF" value="false" checked>
                                <label class="form-check-label" for="inlineRadio2">No</label>
                            </div>
                        </div>



                        <div id="divInsuredBefore">





                            <div class="form-group col-md-offset-3">

                                <h4 class="sbold">  Insured Other Company</h4>
                            </div>
                            <div class="form-group col-md-offset-3">

                                <div class="form-check form-check-inline ">
                                    <input style="margin: 10px 10px 20px 0px;" class="form-check-input" type="radio" name="InsuredOtherComp" id="InsuredOtherCompY" value="true">
                                    <label class="form-check-label " for="inlineRadio1">Yes</label>

                                    <input style="margin: 10px 10px 20px 20px; " class="form-check-input" type="radio" name="InsuredOtherComp" id="InsuredOtherCompF" value="false">
                                    <label class="form-check-label" for="inlineRadio2">No</label>
                                </div>
                            </div>


                            <div class="form-group  col-md-12 " id="divOtherCompName">
                                @Html.Label("Other Company Name", htmlAttributes: new { @class = "control-label col-md-2", @style = "text-align:left" })
                                <div class="col-md-4">
                                    @Html.EditorFor(model => model.OtherCompName, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.OtherCompName, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="form-group col-md-offset-3">

                                <h4 class="sbold">  Previous Client</h4>
                            </div>
                            <div class="form-group col-md-offset-3">

                                <div class="form-check form-check-inline ">
                                    <input style="margin: 10px 10px 20px 0px;" class="form-check-input" type="radio" name="ExClient" id="ExClientY" value="true">
                                    <label class="form-check-label " for="inlineRadio1">Yes</label>

                                    <input style="margin: 10px 10px 20px 20px; " class="form-check-input" type="radio" name="ExClient" id="ExClientF" value="false">
                                    <label class="form-check-label" for="inlineRadio2">No</label>
                                </div>
                            </div>




                        </div>
                    </div>









                    <div id="PreviousClient">
                        <div class="form-group col-md-12">
                            @Html.Label("company ", htmlAttributes: new { @class = "control-label col-md-2", @style = "text-align:left" })
                            <div class="col-md-4">
                                @*@Html.DropDownListFor(x => x.CompId, new SelectList(ViewBag.Accounts, "C_COMP_ID", "C_ENAME"))*@

                                @Html.DropDownList("CompId", null, "Please select", htmlAttributes: new { @class = "form-control " })
                                @Html.ValidationMessageFor(model => model.CompId, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group  col-md-12">
                            @Html.LabelFor(model => model.ContractNo, htmlAttributes: new { @class = "control-label col-md-2", @style = "text-align:left" })
                            <div class="col-md-4">
                                @Html.DropDownList("ContractNo", new SelectList(""), new { @class = "form-control", id = "ContractNo" })

                                @*@Html.EditorFor(model => model.ContractNo, new { htmlAttributes = new { @class = "form-control" } })*@
                                @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
                            </div>
                        </div>


                    </div>












                    <div class="form-group  col-md-12">
                        @Html.LabelFor(model => model.Conclusion, htmlAttributes: new { @class = "control-label col-md-2", @style = "text-align:left" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Conclusion, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Conclusion, "", new { @class = "text-danger" })
                        </div>
                    </div>


                </div>







            </div>

            @*end*@
        </div>
        <div class="panel-footer" style="text-align:center;">

            <input id="submit" type="submit" value="Create" class="btn btn-success" /> |
            <a class="btn btn-outline-info" asp-action="Index">"Back to List</a>
        </div>
    </div>

}
@*</form>*@

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/Scripts/DMS/Proposal/Create.js"></script>
