
@{
    ViewBag.Title = "Map";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}
<style>

    #map {
        height: 350px;
        width: 100%;
    }
</style>
<div class="modal" id="LocationModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <form action="" method="post">
                <div class="modal-header text-center">
                    <h5 class="modal-title w-100 font-weight-bold py-2"><strong><span id="time_title_head_span"> Your Location On Google Map (Drag Marker) </span></strong></h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <!--Body-->
                <div class="modal-body">

                    @*<script src="add-new-location.js"></script>*@

                    <script async defer
                            src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCL7QEOry6wSZgHIv8Ke_mgi839dtQaX7s&callback=initMap">
                    </script>

                    <div class="row">
                        <div id="map"></div>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>
<script>
    // Note: This example requires that you consent to location sharing when
    // prompted by your browser. If you see the error "The Geolocation service
    // failed.", it means you probably did not give permission for the browser to
    // locate you.
    var map, infoWindow, marker;
    function initMap() {
        map = new google.maps.Map(document.getElementById('map'), {
            center: { lat: -34.397, lng: 150.644 },
            zoom: 6
        });
        infoWindow = new google.maps.InfoWindow;
        var geocoder = new google.maps.Geocoder;

        // Try HTML5 geolocation.
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (position) {
                var pos = {
                    lat: position.coords.latitude,
                    lng: position.coords.longitude
                };
                console.log(position)

                map.setZoom(15);
                marker = new google.maps.Marker({
                    position: pos,
                    map: map,
                    draggable: true,
                    animation: google.maps.Animation.DROP,
                });

                google.maps.event.addListener(marker, 'dragend', function (mark) {

                    geocodePosition(marker.getPosition(), mark);
                });
                //console.log(results[0].formatted_address)
                // $('#MapLocation').val('location');
                // $('#Lat').val(position.coords.latitude);
                // $('#Lng').val(position.coords.longitude);
                infoWindow.setContent('location');
                infoWindow.open(map, marker);

            }, function () {
                handleLocationError(true, infoWindow, map.getCenter());
            });
        } else {
            // Browser doesn't support Geolocation
            handleLocationError(false, infoWindow, map.getCenter());
        }
    }


    function geocodePosition(pos, mark) {

        map.setZoom(11);
        debugger;
        var latLng = mark.latLng;
        currentLatitude = latLng.lat();
        currentLongitude = latLng.lng();
        console.log(currentLatitude);
        console.log(currentLongitude);

        // $('#MapLocation').val('location');
        // $('#Lat').val(currentLatitude);
        // $('#Lng').val(currentLongitude);
        infoWindow.setContent('location');
        infoWindow.open(map, marker);
    }

    function handleLocationError(browserHasGeolocation, infoWindow, pos) {
        infoWindow.setPosition(pos);
        infoWindow.setContent(browserHasGeolocation ?
            'Error: The Geolocation service failed.' :
            'Error: Your browser doesn\'t support geolocation.');
        infoWindow.open(map);
    }

</script>
