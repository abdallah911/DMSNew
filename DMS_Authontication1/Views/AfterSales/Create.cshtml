@model DMS_Authontication1.ViewModel.AfterSale.AfterSaleViewModel
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}

<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>


<div class="sios-container">
    <div class="portlet box red-pink" style="margin:auto">
        <div class="d-flex justify-content-between bg-overlay my-4   portlet-title">
            <div class="m-3 fs-3  text-white caption">
                <i class="fa fa-creative-commons"></i>Visit List
            </div>
            <div class="d-flex align-items-center me-3 actions">
                <a id="Create" href="/AfterSales/Index" style=" text-transform: none" class="btn btn-primary  btn-sm">
                    <i class="fa fa-list"></i> Visit List
                </a>
            </div>
        </div>

        <div class="panel panel-info">

            <div class="portlet-body">
                <div class="row containw ">
                    <div class="col-md-12">
                        <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">
                            <!-- BEGIN PAGE HEADER-->
                            <!-- BEGIN THEME PANEL -->

                            <div class="form-wizard">

                                <div class="form-body">
                                    <div class="tab-content">
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <div class="row container ">

                                            <div class="col-lg-8 text-center row row-cols-3 mx-auto  mb-3"  >
                                                @*Button Start Metting*@
                                                <div class="">
                                                    <input data-step="8" data-intro="Save Visit" type="button" value="Start Meeting" class="btn fw-bold text-white rounded-3 btn-success" onclick="StartTime()"  />
                                                </div>

                                                @*Label Timer*@
                                                <div class=" fw-bold text-white rounded-3" style="text-align: center;  background-color:var(--color-btn);  margin-top: 5px;font:bold;font-size:20px;font-style:italic">
                                                    <span id="hours"></span>:<span id="minutes"></span>:<span id="seconds"></span>
                                                </div>

                                                @*Button End Metting*@
                                                <div class="">
                                                    <input data-step="8" data-intro="Save Visit" type="button" value="End Meeting" class="btn fw-bold text-white rounded-3 btn-success" onclick="StopTime()" />
                                                </div>
                                            </div>





                                            <div class="col-md-6 ">
                                                <div class="col-md-12" style="margin-left:100px">
                                                    <div class="form-group">
                                                        <div class="col-md-6">
                                                            <div class="checkbox-inline">
                                                                <input data-step="1" data-intro="Check if company new or old one" type="checkbox" id="New" name="New" value="New" data-name="New" onclick="ShowCompanyDiv()">
                                                                <label for="New">
                                                                    New Company
                                                                </label>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>


                                                <div class="form-group CompanyTypeOld" id="CompanyTypeOld">

                                                    @*@Html.DisplayNameFor(model => model.CompanyName) :*@

                                                    <div class="forLabel  col-md-8">
                                                        @Html.DropDownList("CompanyNameList", ViewBag.company as SelectList, "Select Company", new { @class = "mb-2  admin-form-control   form-control", @id = "CompanyNameList" })
                                                        @*<input type="text" class="mb-2  admin-form-control   form-control" asp-for="FirstName" />*@
                                                        @Html.ValidationMessageFor(model => model.CompanyName, "", new { @class = "text-danger" })
                                                        <span style="left:0px"> Company Name * </span>
                                                    </div>
                                                </div>
                                                <div class="form-group  " style="display:none;" id="CompanyTypeNew">
                                                    @*@Html.DisplayNameFor(model => model.CompanyName) :*@
                                                    <div class="forLabel  col-md-8">
                                                        @Html.EditorFor(model => model.CompanyName, new { htmlAttributes = new { @class = "mb-2  admin-form-control   form-control" } })
                                                        @Html.ValidationMessageFor(model => model.CompanyName, "", new { @class = "text-danger" })
                                                        <span style="left:0px"> Company Name * </span>
                                                    </div>
                                                </div>

                                                <div class="form-group CompanyTypeOld">
                                                    @*@Html.DisplayNameFor(model => model.BranchName) :*@
                                                    <div class="forLabel col-md-8">
                                                        <select id="BranchName" class="mb-2  admin-form-control   form-control" data-step="2" data-intro="Select BranchName">
                                                        </select>
                                                        @*@Html.DropDownListFor(model => model.Department, ViewBag.Department as SelectList, "Select Department", new { @class = "mb-2  admin-form-control   form-control", id = "Department" })*@
                                                        @Html.ValidationMessageFor(model => model.BranchName, "", new { @class = "text-danger" })
                                                    <span style="left:0px"> Branch Name </span>

                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    @*@Html.DisplayNameFor(model => model.PersonName) :*@
                                                    <div class="forLabel col-md-8">
                                                        @Html.EditorFor(model => model.PersonName, new { htmlAttributes = new { @class = "mb-2  admin-form-control   form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PersonName, "", new { @class = "text-danger" })
                                                        <span style="left:0px">Person Name </span> 
                                                    </div>
                                                </div> 
                                                <div class="form-group">
                                                    @*@Html.DisplayNameFor(model => model.VisitReason) :*@ 
                                                    <div class="forLabel col-md-8">
                                                        <select id="VisitReasonList" class="mb-2  admin-form-control   form-control" data-step="3" data-intro="Select Visit Reason">
                                                            <option>Select Reason</option>
                                                            <option valur="حل مشكلة ال Network">حل مشكلة ال Network</option>
                                                            <option valur="متابعة دورية">متابعة دورية</option>
                                                            <option valur="حل مشكة تحصيل">حل مشكة تحصيل</option>
                                                            <option valur="اخري">اخري</option>
                                                        </select>
                                                        @*<input type="text" class="mb-2  admin-form-control   form-control" value="" id="ComplaintReason" />*@
                                                        @Html.ValidationMessageFor(model => model.VisitReason, "", new { @class = "text-danger" })
                                                    <span style="left:0px">Visit Reason *  </span>

                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    @*@Html.DisplayNameFor(model => model.VisitDate) :*@
                                                    <div class="forLabel col-md-8">
                                                        @Html.EditorFor(model => model.VisitDate, new { htmlAttributes = new { @class = "col-md-2 mb-2 date-input  admin-form-control   form-control CreatDate", @placeholder = "Date" } })
                                                        @*<input id="CreatedDate" type="datetime" class="col-md-2 mb-2  admin-form-control   form-control " placeholder="Date" />*@
                                                        @Html.ValidationMessageFor(model => model.VisitDate, "", new { @class = "text-danger" })
                                                        <span style="left:0px"> Visit Date</span>

                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    @*@Html.DisplayNameFor(model => model.Region) :*@
                                                    <div class="forLabel col-md-8">
                                                        @Html.EditorFor(model => model.Region, new { htmlAttributes = new { @class = "mb-2  admin-form-control   form-control" } })
                                                        @Html.ValidationMessageFor(model => model.Region, "", new { @class = "text-danger" })
                                                        <span style="left:0px">Region </span>

                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    @*@Html.DisplayNameFor(model => model.Phone) :*@ 
                                                    <div class="forLabel col-md-8">
                                                        @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "mb-2  admin-form-control   form-control ", @onkeypress = "return /[0-9]/i.test(event.key)" } })
                                                        @*<input type="text" class="mb-2  admin-form-control   form-control" id="Phone" value="" onkeypress="return /[0-9]/i.test(event.key)" />*@
                                                        @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
                                                        <span style="left:0px">Phone * </span>

                                                    </div>
                                                </div>

                                            </div>

                                            <div class="col-md-6">
                                                <div class="col-md-12" style="margin-left:100px">
                                                    <div class="form-group">
                                                        <div class="col-md-6">
                                                            <div class="checkbox-inline">
                                                                <input type="checkbox" id="HasFeedBack" name="HasFeedBack" value="HasFeedBack" data-name="HasFeedBack" onclick="ShowFeedBackDiv()" data-step="4" data-intro="Has Feed Back">
                                                                <label for="HasFeedBack">
                                                                    Feed Back
                                                                </label>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>

                                                <div id="feedBackDiv" style="display:none;">
                                                    <div class="form-group">
                                                        <label class="sios-color control-label sbold col-md-4">
                                                            @Html.DisplayNameFor(model => model.FeedBackText) :
                                                            <span class="required"> * </span>
                                                        </label>
                                                        <div class="col-md-7">
                                                            <select id="FeedBackText" class="mb-2  admin-form-control   form-control" multiple="multiple" data-step="5" data-intro="Feed Back Text" style="height:100%;">

                                                                <option valur="Network">Network</option>
                                                                <option valur="Indemnity">Indemnity</option>
                                                                <option valur="Medical approval">Medical approval</option>
                                                                <option valur="Hotline Services">Hotline Services</option>
                                                                <option valur="Opeation">Opeation</option>
                                                                <option valur="Consumption Report">Consumption Report</option>
                                                                <option valur="Presentation">Presentation</option>
                                                                <option valur="Contract wording ,Issues">Contract wording ,Issues</option>
                                                                <option valur="Exceptions">Exceptions</option>
                                                                <option valur="Recollection">Recollection</option>
                                                                <option valur="Endorsement Reqest">Endorsement Reqest</option>
                                                                <option valur="Others">Others</option>

                                                            </select>
                                                            @*<input type="text" class="mb-2  admin-form-control   form-control" value="" id="ComplaintReason" />*@
                                                            @Html.ValidationMessageFor(model => model.FeedBackText, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="sios-color control-label sbold col-md-4">
                                                            @Html.DisplayNameFor(model => model.Note) :
                                                            <span class="required"> * </span>
                                                        </label>
                                                        <div class="col-md-7">
                                                            @Html.TextAreaFor(model => model.Note, new { @class = "mb-2  admin-form-control   form-control", @style = "width:346px;height:55px;" })
                                                            @*<textarea type="text" class="mb-2  admin-form-control   form-control" id="ComplaintDescription"></textarea>*@
                                                            @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>



        </div>



    </div>

    <div class="container mt-3 mb-4 panel panel-info" >
        <!--Save-->
        <div class="panel-footer" style="text-align:right;">
            <input data-step="6" data-intro="Help" style="float: left;" id="Help" type="button" value="Help" class="btn fw-bold text-white rounded-3  " />
            <input data-step="7" data-intro="Reset " id="reset" type="button" value="Reset" onclick="ClearVisitDataData();" class="btn fw-bold text-white rounded-3  " />
            <input data-step="8" data-intro="Save Visit" id="submit" type="button" value="Save" class="btn fw-bold text-white rounded-3   " onclick="Submit_Save()" />
        </div>
    </div>
</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/assets/HomeTemplete/js/intro.js"></script>
<script src="~/Scripts/DMS/AfterSale/Create.js?V=3.2"></script>

