<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

<script>
    $(function () {
        $("#Index").DataTable({
            "sAjaxSource": '/CompIcdCp/RequestList',
            "bServerSide": true,
            "processing": true,
            "bFilter": true,
            "bSort": false,
            "pageLength": 10,
            "bInfo": true,
            "lengthChange": false,

            "columns": [
                { "data": "CARD_NO", "name": "Card Id" },
                { "data": "EMP_ANAME", "name": "Name" },
                { "data": "CLAIM_NO", "name": "Claim No" },

                {
                    "data": "CLAIM_DATE",
                    "name": "Claim Date",
                    "mRender": function (data) {
                        var value = new Date(parseFloat(data.replace(/(^.*\()|([+-].*$)/g, '')));
                        var date = value.getDate() + "/" + (value.getMonth() + 1) + "/" + value.getFullYear();
                        return date;
                    }
                },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        if ("@fullcontroll" == "True" || "@view" == "True") {
                            return '<a class="btn btn-primary fa fa-list" href="/CompIcdCp/Details/' + data + '"> Details </a>';
                        }
                        else
                            return '<input  data-id=' + data + '  hidden  /> ';
                    }
                },


            ]
        });
    })
</script>