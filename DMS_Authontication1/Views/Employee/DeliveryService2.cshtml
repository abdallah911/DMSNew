        var row = $(button).closest("TR");
        var amount = parseFloat($("TD", row).eq(5).html());
        var editamount = $("TD", row).eq(4).html();
        if (parseFloat($("TD", row).find(".editvalue").val()) > amount) {
            toastr.error("Medicine amount isn't covered");
            $("TD", row).find(".editvalue").val(0)
        }
