<script>
    $(document).ready(function () {
        $("#Help").click(function () {
            introJs().start();
        });

    });
    $(function () {
        $('#AddAll').click(function () {

            $('#First TBODY TR').each(function () {
                var row = $(this);
                Add(row.find("TD").eq(0));
            });
        });

        $('#RemoveAll').click(function () {
            $('#Secand TBODY TR').each(function () {
                var row = $(this);
                Remove(row.find("TD").eq(6));
            });
        });


        $("#CountryId").select2();
        $("#RegionId").select2();
        $("#ProviderId").select2();
        $("#BranchId").select2();

        $('#Time').datetimepicker({
            format: " LT "
        });

        $("#CountryId").change(function () {//address
            $.get("/Employee/GetStateList",
                { id: $("#CountryId").val() }, function (data) {
                    $("#RegionId").empty();
                    $.each(data, function (index, row) {
                        $("#RegionId").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                    });
                });
        });

        $("#CountryId").map(function () {//address
            $.get("/Employee/GetStateList",
                { id: $("#CountryId").val() }, function (data) {
                    $("#RegionId").empty();
                    $.each(data, function (index, row) {
                        $("#RegionId").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                    });
                });
        });

        $("#ProviderId").change(function () {//Branch
            if ($("#ProviderId").val() != "") {
                $.get("/Complaint/GetBranchList",
                    { id: $("#ProviderId").val() },
                    function (data) {
                        $("#BranchId").empty();
                        //if (data.length > 0) {
                        $.each(data, function (index, row) {
                            $("#BranchId").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                        });
                        //}
                        //else {
                        //    $("#BranchId").append("<option value='" + $("#ProviderId option:selected").val() + "'>" + $("#ProviderId option:selected").text() + "</option>");

                        //}
                        //$('#BranchId').val(sel).change();
                    });
            }
        });

        $("#ProviderId").map(function () {//Branch
            if ($("#ProviderId").val() != "") {
                $.get("/Complaint/GetBranchList",
                    { id: $("#ProviderId").val() },
                    function (data) {
                        $("#BranchId").empty();
                        //if (data.length > 0) {
                        $.each(data, function (index, row) {
                            $("#BranchId").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                        });
                        //}
                        //else {
                        //    $("#BranchId").append("<option value='" + $("#ProviderId option:selected").val() + "'>" + $("#ProviderId option:selected").text() + "</option>");

                        //}
                        //$('#BranchId').val(sel).change();
                    });
            }
        });

        $('#submit').click(function () {
            var valid = true;
            var Medicines = new Array();
            $("#Secand TBODY TR").each(function () {

                var row = $(this);
                var Medicien = {};
                Medicien.MED_CODE = row.find("TD").eq(1).html();
                Medicien.MED_NAME = row.find("TD").eq(2).html();
                Medicien.DOSAGE_FORM = row.find("TD").eq(3).html();
                Medicien.TOTAL_AMT = $("TD", row).find(".editvalue").val();
                Medicines.push(Medicien);
            });
            debugger;
            if ($('#CountryId').val() == "") { toastr.error("Please,select Governorate ."); valid = false; }
            if ($('#RegionId').val() == "") { toastr.error("Please,select Region  ."); valid = false; }
            if ($('#StreetName').val() == "") { toastr.error("Please enter Street Name  ."); valid = false; }
            if ($('#BuldingNo').val() == "") { toastr.error("Please enter Bulding No ."); valid = false; }
            if ($('#FlatNo').val() == "") { toastr.error("Please enter Flat No  ."); valid = false; }
            if ($('#Phone1').val() == "" && $('#Phone1').val().length != 11) { toastr.error("Please enter Phone1 correctly  ."); valid = false; }
            if ($('#Time').val() == "") { toastr.error("Please enter Time To Deliverd  ."); valid = false; }
            if (valid) {
                if (Medicines.length != 0) {
                    var SaveDelieveryRequest = {
                        CountryId: $('#CountryId').val(),
                        RegionId: $('#RegionId').val(),
                        NeighborHood: $('#NeighborHood').val(),
                        StreetName: $('#StreetName').val(),
                        BuldingNo: $('#BuldingNo').val(),
                        FlatNo: $('#FlatNo').val(),
                        Phone1: $('#Phone1').val(),
                        Phone2: $('#Phone2').val(),
                        ProviderId: $('#ProviderId').val(),
                        BranchId: $('#BranchId').val(),
                        Time: $('#Time').val(),
                        CardId: $('#cardId').val(),
                        Medicines: Medicines
                    };
                    $.ajax({
                        type: 'POST',
                        url: '/Employee/SaveDeleiveryRequest/',
                        dataType: 'Json',
                        data: SaveDelieveryRequest,
                        success: function (result) {
                            toastr.success("Added Sucessfully");

                        },
                        error: function (err) {
                            toastr.error("Error saving Request");
                        }
                    });
                }
                else { toastr.error("Please select medicines"); }
            }
            else {

            }
        });

    });


    function Add(button) {

