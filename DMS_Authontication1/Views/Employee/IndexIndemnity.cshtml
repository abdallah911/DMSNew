@model IEnumerable<DMS_Authontication1.Models.IndemnityMaster>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}

<br />
<p>
    @Html.ActionLink(" New Request", "CreateAdmin", null, htmlAttributes: new { @class = "btn btn-info fa fa-plus", @style = " text-transform: none" })

</p>

<div class="portlet box  green">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-gift"></i>Requests
        </div>

    </div>
    <br />
    <div class="portlet-body">
        <table id="Index" class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Id)
                    </th>
                    @*<th>
                            @Html.DisplayNameFor(model => model.ServiceCardID)
                        </th>*@
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CompanyName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NationalID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.BankName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.BankBranch)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.BankAccount)
                    </th>
                    @*<th>
                            @Html.DisplayNameFor(model => model.Type)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ServiceID)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ServiceDate)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Total)
                        </th>*@
                    @if (User.IsInRole("Admin"))
                    {
                        <th>
                            @Html.DisplayNameFor(model => model.CreatedBy)

                        </th>
                    }
                    @*<th>
                                        @Html.DisplayNameFor(model => model.CreatedDate)

                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.UpdateDate)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.UpdateBy)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.DeletedBy)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.DeletedDate)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.IsDeleted)
                        </th><th>
                            @Html.DisplayNameFor(model => model.AttachPDF)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Status)
                        </th>*@

                    <th></th>
                </tr>
            </thead>

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Id)
                    </td>
                    @*<td>
                            @Html.DisplayFor(modelItem => item.ServiceCardID)
                        </td>*@
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CompanyName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NationalID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BankName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BankBranch)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BankAccount)
                    </td>
                    @*<td>
                            @Html.DisplayFor(modelItem => item.Type)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ServiceID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ServiceDate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Total)
                        </td>*@
                    @if (User.IsInRole("Admin"))
                    {
                        <td>
                            @Html.DisplayFor(modelItem => item.CreatedBy)
                        </td>
                    }
                    @*<td>
                            @Html.DisplayFor(modelItem => item.CreatedDate)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.UpdateDate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.UpdateBy)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DeletedBy)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DeletedDate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsDeleted)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.AttachPDF)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Status)
                            </td>*@
                    <td>
                        @*  @Html.ActionLink("Edit", "Edit", new { id=item.BatchID }) |*@
                        @Html.ActionLink(" Details", "Details", new { id = item.Id }, htmlAttributes: new { @class = "btn btn-primary fa fa-list", @style = " text-transform: none" }) |
                        @Html.ActionLink(" Delete", "Delete", new { id = item.Id }, htmlAttributes: new { @class = "btn btn-danger fa fa-remove", @style = " text-transform: none" })
                    </td>
                </tr>
            }

        </table>
    </div>
</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

<script>
    $(function () {
        $("#Index").DataTable({
        });
    })
</script>