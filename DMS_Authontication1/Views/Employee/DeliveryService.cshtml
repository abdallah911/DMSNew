<script>
    $(document).ready(function () {
        $("#Help").click(function () {
            introJs().start();
        });

    });
    $(function () {
        $("#CountryId").select2();
        $("#RegionId").select2();
        $("#ProviderId").select2();
        $("#BranchId").select2();

        $('#Time').datetimepicker({
            format: " LT "
        });

        $("#CountryId").change(function () {//address
            $.get("/Employee/GetStateList",
                { id: $("#CountryId").val() }, function (data) {
                    $("#RegionId").empty();
                    $.each(data, function (index, row) {
                        $("#RegionId").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                    });
                });
        });

        $("#CountryId").map(function () {//address
            $.get("/Employee/GetStateList",
                { id: $("#CountryId").val() }, function (data) {
                    $("#RegionId").empty();
                    $.each(data, function (index, row) {
                        $("#RegionId").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                    });
                });
        });

        $("#ProviderId").change(function () {//Branch
            if ($("#ProviderId").val() != "") {
                $.get("/Complaint/GetBranchList",
                    { id: $("#ProviderId").val() },
                    function (data) {
                        $("#BranchId").empty();
                        //if (data.length > 0) {
                        $.each(data, function (index, row) {
                            $("#BranchId").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                        });
                        //}
