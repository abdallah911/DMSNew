                        //}
                        //$('#BranchId').val(sel).change();
                    });
            }
        });

        $("#ProviderId").map(function () {//Branch
            if ($("#ProviderId").val() != "") {
                $.get("/Complaint/GetBranchList",
                    { id: $("#ProviderId").val() },
                    function (data) {
                        $("#BranchId").empty();
                        //if (data.length > 0) {
                        $.each(data, function (index, row) {
                            $("#BranchId").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                        });
                        //}
                        //else {
                        //    $("#BranchId").append("<option value='" + $("#ProviderId option:selected").val() + "'>" + $("#ProviderId option:selected").text() + "</option>");

                        //}
                        //$('#BranchId').val(sel).change();
                    });
            }
        });

    });
    function ClearVisitDataData() {
        $("select[name='CountryId'] :contains('Select Country')").attr('selected', 'selected');
        $("select[name='CountryId']").trigger('change');
        $("select[name='ProviderId'] :contains('Select Provider')").attr('selected', 'selected');
        $("select[name='ProviderId']").trigger('change');
        //$('#CountryId option:contains("Select Country")').prop('selected', true);
        //$("#CountryId").val("Select Country");
