@model IEnumerable<DMS_Authontication1.ViewModel.Approval>
@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Approvales";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {

            var obj = modellist.Where(x => x.ModuleName == "Customers Management" && x.PageId == 24 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}
<link href="~/assets/HomeTemplete/Content/css/select2.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

<div style="margin-top:40px">
    <p>
        @if (fullcontroll || view)
        {
            @Html.ActionLink(" Approvales", "Approvales", "Employee", null, htmlAttributes: new { @class = "btn btn-secondary-outline fa fa-search ", @style = " text-transform: none" })
        }
        @if (fullcontroll || Create)
        {
            @Html.ActionLink(" Create Request ", "CreateRequest", "MedicalApproval", null, htmlAttributes: new { @class = "btn btn-info fa fa-plus ", @style = " text-transform: none" })
        }
    </p>
</div>
@if (fullcontroll || view)
{
    <div class="portlet box  green">
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-gift"></i> Approvales
            </div>
        </div>
        <br />
        <div class="portlet-body">
            <div class="form-group col-md-6">
                @Html.Label("Select CardId", new { @class = "col-md-3 control-label sbold" })
                <div class="col-md-5">
                    @Html.DropDownList("CARD_ID", ViewBag.Cardslist as SelectList, new { @class = "form-control", @id = "CARD_ID", @required = "True" })

                </div>
                <br />
            </div>
            <br />
            <hr />
            <table class="table" id="Index">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Code)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Approval_Type)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Medical_Replay)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Value_After)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Recieve_Date)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Created_Date)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.End_Date)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Expaire_Date)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Code</td>

                            <td>@item.Approval_Type</td>

                            <td>@item.Medical_Replay</td>

                            <td>@item.Value_After</td>

                            <td>@item.Recieve_Date</td>

                            <td>@item.Created_Date</td>

                            <td>@item.End_Date</td>

                            <td>@item.Expaire_Date</td>

                            <td>
                                @Html.ActionLink("Print", "PrintApproval", "Employee", new { id = @item.Code }, new { @class = "btn btn-default" })
                            </td>
                        </tr>

                    }
                </tbody>

            </table>
        </div>
    </div>
}
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script>
    $(function () {
        $('#Index').dataTable();
        $("#CARD_ID").select2();
        $("#CARD_ID").val(@ViewBag.CardId).change();
        $("#CARD_ID").change(function () {//address
            $.get("/Employee/Approvales",
                { card: $("#CARD_ID").val() }, function (data) {
                });
        });
    });
</script>

