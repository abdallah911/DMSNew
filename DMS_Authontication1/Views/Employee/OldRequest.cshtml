@*@model IEnumerable<DMS_Authontication1.Models.Employee_Request>*@

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}


<div class="sios-container my-4">
    <div class="m-4">

        <p>
            <div class="btn fw-bold text-white rounded-3 me-2">
                <i class="fa fa-search me-1"></i>
                @Html.ActionLink(" Last Request", "IndexAdmin", null, htmlAttributes: new { @class = " text-white ", @style = " text-transform: none" })
            </div>
            <div class="btn fw-bold text-white rounded-3">
                <i class=" fa fa-pencil me-1"></i> 
                @Html.ActionLink(" Old Request", "OldRequest", null, htmlAttributes: new { @class = "  text-white ", @style = " text-transform: none" })
               </div>
                @*@Html.ActionLink(" New Operation", "Create", null, htmlAttributes: new { @class = "btn btn-info fa fa-plus", @style = " text-transform: none" })*@
                @*@Html.ActionLink(" Edit Operation", "EditRequest", null, htmlAttributes: new { @class = "btn btn-warning fa fa-pencil", @style = " text-transform: none" })
            @Html.ActionLink(" Termination Operation", "Termination", null, htmlAttributes: new { @class = "btn btn-danger fa fa-remove", @style = " text-transform: none" })*@
        </p>
    </div>
    <div class="portlet box  green">
        <div class="row bg-overlay  editeRquest fw-bold my-4 portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa-solid fa-home me-1"></i>Old Request
            </div>

        </div>

        <div class="sios-bg border-0 container-fluid  my-4 portlet-body">
            <div class="table-responsive">
                <table class="table table-striped mt-3 text-center ui celled table" id="Index" width="100%">
                    <thead>
                        <tr>

                            <th>
                                Id
                            </th>
                            <th>
                                Card Id
                            </th>
                            @*<th>
                                Name
                            </th>*@
                            <th>
                                Phone
                            </th>
                            <th>
                                Time
                            </th>
                            <th>
                                Created Date
                            </th>
                            <th></th>
                            @*<th></th>
                            <th></th>
                            <th></th>*@
                        </tr>
                    </thead>
                    <tbody></tbody>

                </table>
            </div>
        </div>
    </div>
</div>
    <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

<script>
    $(function () {
        $("#Index").DataTable({
            "sAjaxSource": '/Employee/RequestListOld',
            "bServerSide": true,
            "processing": true,
            "bFilter": true,
            "bSort": false,
            "pageLength": 10,
            "bInfo": true,
            "lengthChange": false,

            "columns": [
                { "data": "Id", "name": "Id" },
                { "data": "CardId", "name": "Card Id" },
                /* { "data": "EmployeePersonalData.FullName", "name": "Name" },*/
                { "data": "Phone1", "name": "Phone" },

                { "data": "Time", "name": "Time" },

                {
                    "data": "CreatedDate",
                    "name": "Created Date",
                    "mRender": function (data) {
                        var value = new Date(parseFloat(data.replace(/(^.*\()|([+-].*$)/g, '')));
                        var date = value.getDate() + "/" + (value.getMonth() + 1) + "/" + value.getFullYear();
                        return date;
                    }
                },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        return '<a class="btn text-white fw-bold rounded-3" href="/Employee/DelieveryDetails/' + data + '"> Details </a>';
                    }
                },


            ]
        });
    })
</script>