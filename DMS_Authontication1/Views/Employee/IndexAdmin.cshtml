@*@model IEnumerable<DMS_Authontication1.Models.Employee_Request>*@

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}
<div style="min-height: calc(100vh - 264.1px);">

    <div @*style="margin-top:40px"*@>
        <p style="padding-left:20px"> 
            @Html.ActionLink(" Last Request", "IndexAdmin", null, htmlAttributes: new { @class = "btn btn-info-outline fa fa-search", @style = " text-transform: none" })
            @Html.ActionLink(" Old Request", "OldRequest", null, htmlAttributes: new { @class = "btn btn-info fa fa-pencil", @style = " text-transform: none" })
            @*@Html.ActionLink(" New Operation", "Create", null, htmlAttributes: new { @class = "btn btn-info fa fa-plus", @style = " text-transform: none" })*@
            @*@Html.ActionLink(" Edit Operation", "EditRequest", null, htmlAttributes: new { @class = "btn btn-warning fa fa-pencil", @style = " text-transform: none" })
            @Html.ActionLink(" Termination Operation", "Termination", null, htmlAttributes: new { @class = "btn btn-danger fa fa-remove", @style = " text-transform: none" })*@
        </p>
    </div>
    <div class="portlet box  ">
        <div class="portlet-title title-bg text-white fw-bold">
            <div class="caption">
                <i class="fa-solid fa-home"></i>Last Request
            </div>

        </div>
        <br />
        <div class="portlet-body">

            <table class="ui celled table" id="Index" width="100%">
                <thead>
                    <tr>

                        <th>
                            Id
                        </th>
                        <th>
                            Card Id
                        </th>
                        <th>
                            Phone
                        </th>
                        <th>
                            Time
                        </th>
                        <th>
                            Created Date
                        </th>
                        <th></th>
                        @*<th></th>
                            <th></th>
                            <th></th>*@
                    </tr>
                </thead>
                <tbody></tbody>

            </table>
        </div>
    </div>
</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

<script>
    $(function () {
        $("#Index").DataTable({
            "sAjaxSource": '/Employee/RequestList',
            "bServerSide": true,
            "processing": true,
            "bFilter": true,
            "bSort": false,
            "pageLength": 10,
            "bInfo": true,
            "lengthChange": false,

            "columns": [
                { "data": "Id", "name": "Id" },
                { "data": "CardId", "name": "Card Id" },
                /* { "data": "EmployeePersonalData.FullName", "name": "Name" },*/
                { "data": "Phone1", "name": "Phone" },

                { "data": "Time", "name": "Time" },

                {
                    "data": "CreatedDate",
                    "name": "Created Date",
                    "mRender": function (data) {
                        var value = new Date(parseFloat(data.replace(/(^.*\()|([+-].*$)/g, '')));
                        var date = value.getDate() + "/" + (value.getMonth() + 1) + "/" + value.getFullYear();
                        return date;
                    }
                },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        return '<a class="btn btn-primary fa fa-list" href="/Employee/DelieveryDetails/' + data + '"> Details </a>';
                    }
                },


            ]
        });
    })
</script>