    <script>
        $(document).ready(function () {
            // Get the section position (change the ID to your section)
            //var sectionTop = $('#section2').offset().top;
         
            // Listen for scroll events
            $(window).on('scroll', function () {
                // Check how far you've scrolled
                var scrollPosition = $(window).scrollTop();
         
                // If the scroll position is greater than or equal to the top of the section, change style
                if (scrollPosition >= 100) {
                    $('.nav-bar').css({
                        'position': 'fixed',  // New style
                        'background-color': 'white',
                        'box-shadow': '0 0 7px 3px #210d203d'
                    });
                } else {
                    // Revert to the original style when not in the section
                    $('.nav-bar').css({
                        'position': 'unset',  // New style
                        'background-color': 'transparent',
                        'box-shadow': 'none'

                    });
                }
            }); 
            $(function () {
                $(".date-input").datepicker();
            });
        });
        $(document).ready(function () {
            // Get the current path of the URL
            var currentPath = window.location.pathname; 
            // Check if the URL matches 'Home/Services'
            if (currentPath.includes('Home/Search')) { 
                $('#medicalNetworkCore').addClass('active');
            } else if (currentPath.includes('Home/CompanyProfile')) {
                $('#profile').addClass('active');
            } else if (currentPath.includes('Home/Clients')) {
                $('#ourClients').addClass('active');
            } else if (currentPath.includes('Home/Services')) {
                $('#dMSServices').addClass('active');
            } else if (currentPath.includes('Home/Department')) {
                $('#benefits').addClass('active');
            } else if (currentPath.includes('Home/ContactUs')) {
                $('#contactUs').addClass('active');
            }
        });
        $(document).ready(function () {
            function moveSelector() {
                var screenWidth = $(window).width();

                if (screenWidth <= 991) {
                    // Move selector to small-container for medium/small screens
                    $('#loginBtn li').appendTo('#navbarUL');
                    $('#loginUL').hide();

                } else {
                    // Move selector back to large-container for large screens
                    $('#loginUL').show();
                    $('#loginBtn li').appendTo('#loginBtn');
               

                }
            }

            // Call the function on page load
            moveSelector();

            // Call the function whenever the window is resized
            $(window).resize(function () {
                moveSelector();
            });

            checkEvent();
        });

