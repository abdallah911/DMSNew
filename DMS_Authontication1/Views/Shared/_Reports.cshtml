    <script src="~/assets/ReportDesign/JS/select2.min.js"></script>
    <script src="~/assets/ReportDesign/JS/jquery.min.js"></script>
    <script src="~/assets/ReportDesign/JS/jquery-3.6.0.js"></script>
    <script src="~/assets/ReportDesign/JS/jquery-ui.js"></script>
    <script src="~/assets/ReportDesign/JS/main-reports.js"></script>

