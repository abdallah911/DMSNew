@using Microsoft.AspNet.Identity
<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reports</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/assets/ReportDesign/CSS/all.min.css" />
    <link rel="stylesheet" href="~/assets/ReportDesign/CSS/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/ReportDesign/CSS/jquery-ui.min.css" />
    <link rel="stylesheet" href="~/assets/ReportDesign/CSS/main-reports.css" />
</head>
<body>
    <!-- Main Menu -->
    <div class="page-container  ">
        <div class="content-container flex-grow-1 ">
            <nav class="navbar navbar-expand-md navbar-light bg-light">
                <div class="container d-flex justify-content-between">
                    <a class="navbar-brand" href="#">
                        <img src="~/assets/ReportDesign/Images/logo D M S 4-04.png" alt="sios-logo" />
                    </a>

                    <div class="sios-hr-parent d-flex align-items-center">
                        <div class="sios-hr-btn dropdown">
                            <button type="button"
                                    class="btn  dropdown-toggle"
                                    data-bs-toggle="dropdown">
                                @*Hello User*@
                                Hello  @User.Identity.GetUserName() !
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Profile</a></li>
                                <li><a class="dropdown-item" href="#">Manager Account</a></li>
                                <li><a class="dropdown-item" href="#">Logout</a></li>
                            </ul>
                        </div>
                        <div class="not-drop  text-center ">
                            <button type="button"
                                    class="bell-dropdown btn dropdown-toggle"
                                    data-bs-toggle="dropdown">
                                <i class="not-icon fa-regular fa-bell fa-2xl ms-2 ms-md-3"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Link 1</a></li>
                                <li><a class="dropdown-item" href="#">Link 2</a></li>
                                <li><a class="dropdown-item" href="#">Link 3</a></li>
                            </ul>

                            <div class="rounded-circle  bell-num"><p>2</p></div>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- end menu -->
            <!-- start sidebar -->

            <div class="sidebar-parent col-4 position-fixed z-2">
                <div class="sideBar   col-8">
                    <div class="operation-btns">
                        <a href="/NewReports/OperationReport">
                            <button>Operation</button>
                        </a>
                        <br />
                        <a href="/NewReports/ApprovalReports">
                            <button class="active">Approval</button>
                        </a>
                        <a href="/NewReports/ReportsPrinting">
                            <button>Printing</button>
                        </a>
                        <br />
                        <a href="/NewReports/ConsumptionReport">
                            <button>Consumption</button>
                        </a>
                        <a href="/NewReports/ReportsLoseRatio">
                            <button>Loss Ratio</button>
                        </a>
                        <a href="/NewReports/ReportsCustomerServices">
                            <button>Customer Services</button>
                        </a>
                        <a href="/NewReports/ReportsPharmacy">
                            <button>Pharmacy</button>
                        </a>
                    </div>
                </div>
            </div>
            @RenderBody()
        </div>
        <!-- Start Footer -->
        <footer>
            <div class="footer pb-3">
                <div class="container-fluid pt-5">
                    <div class="row m-auto d-flex justify-content-center">
                        <div class="col-md-3 me-4">
                            <div class="footerP1">
                                <h1 class="mb-1">
                                    <img class="logo-white"
                                         src="~/assets/ReportDesign/Images/logo-dms-white2.png"
                                         alt="" />
                                </h1>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="footerP2">
                                <h5>Address</h5>
                                <div class="line ms-0 mb-1"></div>
                                <h6 class="mt-3">
                                    <p>12 Abdelazim Awadallah St., Heliopolis, Cairo</p>
                                </h6>
                                <i class="fa-brands fa-facebook fs-4 ms-1 me-3"></i>
                                <i class="fa-brands fa-instagram fs-4 me-3"></i>
                                <i class="fa-brands fa-linkedin fs-4"></i>
                            </div>
                        </div>

                        <div class="col-md-4 ms-lg-4">
                            <div class="footerP3">
                                <h5>Contact</h5>
                                <div class="line ms-0"></div>
                                <p><i class="fa-regular fa-envelope"></i> DMS@gmail.com</p>
                                <p>
                                    <i class="fa-solid fa-phone"></i> 01032274222 – 01026006177
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- End Footer -->
    </div>
