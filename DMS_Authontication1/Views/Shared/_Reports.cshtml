<style>
    .dms-container {
        min-height: calc(100vh - 279.1px);
    }
    .dms-container .btn {
        background: white;
        border: 2px solid white;
        color: #337ab7;
    }
    
    .dms-container .btn:hover {
        box-shadow: inset 0 0 15px 8px #0000002b !important;
        color: white !important;
    }
  
    .dms-container .btn:focus {
        background: white;
        color: #337ab7;
        border: 2px solid #337ab7;
    }
     
    /*===========Footer==================*/
    footer div.footer {
        background: white;
        padding: 20px;
    }

    .footer h5 {
        font-weight: bolder !important;
    }

    .footerP2 {
        position: relative;
        margin-left: 50px;
    }

        .footerP2::before {
            content: "";
            position: absolute;
            width: 3px;
            height: 90px;
            margin-right: 20px;
            border-radius: 50% !important;
            top: 10%;
            background-color: #afafaf;
            left: -50px;
        }

    .footerP3 {
        position: relative;
        margin-left: 50px;
    }

        .footerP3::before {
            content: "";
            position: absolute;
            width: 3px;
            height: 90px;
            margin-right: 20px;
            border-radius: 50% !important;
            top: 10%;
            background-color: #afafaf;
            left: -50px;
        }

    .footerP1 p {
        letter-spacing: 1px;
    }

    .line {
        background-color: #72369a;
        height: 3px;
        width: 95px;
        margin-left: 0;
        margin-bottom: 15px;
        border-radius: 10px;
    }

    footer h2 {
        color: #4f4f4f;
    }

    footer p {
        color: #72369a;
    }

    .logo-white {
        width: 140px;
        margin-top: 30px;
        background-image: url(../../../HomeTemplete/img/DMS_Logo.png);
        background-size: contain;
        margin-right: 3rem;
        opacity: 0.8;
        background-repeat: no-repeat;
        transition: all 0.2s ease-in-out;
    }

        .logo-white:hover {
            opacity: 1;
        }

    .footer-contacts-icon {
        background: #9b9b9b;
        -webkit-border-radius: 100%;
        -moz-border-radius: 100%;
        -ms-border-radius: 100%;
        border-radius: 100%;
        height: 20px;
        width: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .footer-contacts-icon i {
            line-height: 58px;
            color: #fff;
            font-size: 10px;
        }

    .footer-contacts-text li {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

        .footer-contacts-text li h6 {
            margin-bottom: 0;
            font-weight: bold;
            color: #72369a;
        }

    .footer-contacts-text h6 {
        white-space: normal;
    }
