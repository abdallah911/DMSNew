        $(document).ready(function () {
            // Get current URL path
            var currentPath = window.location.pathname;

            // Check if the URL matches the desired path
            if (currentPath === "/NewReports/OperationReport") {
                $(".sidebar-item").removeClass("active"); // Remove active class from all buttons
                $("#reportsOperation").addClass("active"); // Add active class to the specific button
                console.log("its work")
            } else if (currentPath === "/NewReports/ApprovalReports") {
                $(".sidebar-item").removeClass("active");
                $("#reportsApproval").addClass("active");
            } else if (currentPath === "/NewReports/ReportsPrinting") {
                $(".sidebar-item").removeClass("active");
                $("#reportsPrinting").addClass("active");
            } else if (currentPath === "/NewReports/ConsumptionReport") {
