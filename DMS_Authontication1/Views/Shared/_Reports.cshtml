    <script>
        var notification = 0;
        $(document).ready(function () {
            // Declare a proxy to reference the hub.
            var notifications = $.connection.notificationHub;
            // Create a function that the hub can call to broadcast messages.
            notifications.client.updateMessages = function () {
                getAllMessages()
            };
            // Start the connection.
            $.connection.hub.start().done(function () {
                console.log("connection started")
                //notifications.onconn();
                getAllMessages();
            }).fail(function (e) {
                console.log("Could not Connect!");
                alert(e);
            });

            $("#btnClaim").click(function () {
                window.location.replace('/Pharmacy/index?id=undefined');
            });
            $(".collaps").click(function () {
                //alert("The paragraph was clicked.");
                if ($("#side-menu").hasClass("activeblock")) {
                    console.log("Inside Ifff");
                    $("#side-menu").removeClass("activeblock");
                    $(".content").removeClass("fullWidth");
                    $(".collaps i").addClass('fa-times');
                    $(".collaps i").removeClass("fa-bars");
                }
                else {
                    console.log("Inside ELSE Ifff");
                    $("#side-menu").addClass("activeblock");
                    $(".content").addClass("fullWidth");
                    $(".collaps i").removeClass('fa-times');
                    $(".collaps i").addClass("fa-bars");
                }
            });
            $(".burger").click(function () {
                if ($(window).width() <= 768) {
                    console.log("Inside  Ifff WIDTH");
                    $("#side-menu").removeClass("activeblock");
                    $(".content").removeClass("fullWidth");
                }
            });
        });

        function getAllMessages() {
            $.ajax({
                url: '/Home/GetNotifications',
                //contentType: 'application/html ; charset:utf-8',
                //type: 'GET',
                //dataType: 'html',
                success: function (result) {
                    //debugger;
                    $('#notification').text(result.length);
                    if (result.length > 0) {
                        $(".test1").css("background-color", " rgb(245, 7, 7)");
                        $(".test1").css("animation", " flash 1s linear infinite");
                        $(".test1 i").css("color", "");
                    }
                    else {
                        $(".test1").css("background-color", "");
                        $(".test1").css("animation", "");
                        $(".test1 i").css("color", "red");

                    }
                    $('#divNotificationValues').empty();
                    $.each(result, function (key, value) {
                        $('#divNotificationValues').append('<a href="' + value.DetailsURL + '?NotificationId=' + value.Id + '">' + value.TypeNmae + '-' + value.Details + '</a>');
                    });
                }
            });
        }

