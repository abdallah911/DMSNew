        input,
        select,
        textarea {
            border: 2px solid #c2cad8 !important;
            border-radius: 4px; 
        }

        .forLabel > span:not(.select2-container), .select {
            padding-top: 0;
        }

        .forLabel {
            height: 40px;
            position: relative;
        }

            .forLabel input,
            .forLabel select,
            .forLabel textarea {
                height: 100%;
                width: 100%;
            }

            .forLabel > span:not(.select2-container), .select {
                color: #337ab7;
            }

        .padding-top span.select2-selection.select2-selection--single {
            padding: 14px 12px;
        }

        .select2-container--default .select2-selection--multiple {
            /*border: 2px solid #337ab7;*/
            /*padding-top:16px;*/
        }

            .select2-container--default .select2-selection--multiple .select2-selection__rendered {
                overflow: auto;
                white-space: nowrap;
                flex-wrap: nowrap;
                display: flex;
                align-items: center;
            }

        .select2-no-overflow .select2-container--default .select2-selection--multiple .select2-selection__rendered {
            overflow: hidden;
        }

        input.select2-search__field {
            border: none !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #444;
            line-height: 32px;
            padding-left: 20px;
        }

        .nav-pills .nav-link:focus {
            text-decoration: none;
        }

        .nav-pills .nav-link.active {
            color: #fff;
            -moz-transition: all 0.3s ease;
            -o-transition: all 0.3s ease;
            -webkit-transition: all 0.3s ease;
            -ms-transition: all 0.3s ease;
            transition: all 0.3s ease;
            border: 1px solid transparent;
            background: #337ab7;
        }

        .nav-pills .nav-link {
            padding: 5px 30px !important;
            border-radius: 0;
            margin-bottom: 0;
            color: #000000;
            font-size: 22px;
            font-weight: 600;
            position: relative;
            display: inline-block;
            border: 1px solid transparent;
            background: rgba(0, 0, 0, 0.05);
            -webkit-border-radius: 0;
            -moz-border-radius: 0;
            -ms-border-radius: 0;
            border-radius: 0;
            white-space: nowrap;
        }

            .nav-pills .nav-link:hover {
                box-shadow: inset 0 0 26px 5px #00000012;
                background: #efefefb5;
                text-decoration: none;
            }

            .nav-pills .nav-link.active:hover {
                background: #337ab7;
            }

        .market {
            padding: 20px;
            font-size: 20px !important;
            width: 50px;
            text-align: center;
            text-decoration: none;
            margin: 5px 2px;
        }

        .dms-container .title-bg .btn {
            background: white;
            border: 2px solid white;
            color: #337ab7;
        }

            .dms-container .title-bg .btn:hover {
                box-shadow: inset 0 0 15px 8px #0000002b !important;
                color: white !important;
            }

            .dms-container .title-bg .btn:focus {
                background: white;
                color: #337ab7;
                border: 2px solid #337ab7;
            }

        .market:hover {
            opacity: 0.7;
        }

        .fa-facebook {
            background: #3B5998;
            color: white;
        }

        .fa-linkedin {
            background: #007bb5;
            color: white;
        }

        .dropbtn {
            background: #09b4d0;
            color: black;
            padding: 12px;
            font-size: 15px;
            border: none;
            cursor: pointer;
        }

        .dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: fixed;
            background-color: #f9f9f9;
            min-width: 160px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.4);
            z-index: 1;
        }

            .dropdown-content a {
                color: black;
                padding: 12px 16px;
                text-decoration: none;
                display: block;
            }

                .dropdown-content a:hover {
                    background-color: #9ECBF3
                }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        .dropdown:hover .dropbtn {
            background-color: #09b4d0;
            opacity: 0.5;
            filter: alpha(opacity=50);
        }
    </style>
