<body>

    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
    {
        @Html.AntiForgeryToken()
    }
    <!-- Main Menu -->
    <nav class="navbar navbar-expand-md navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="~/ControlPanel">
                <img src="~/assets/NewDesignBack/images/logo D M S 4-04.png" alt="sios-logo" />
            </a>
            <button class="menu-icon navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNavAltMarkup"
                    sios-aria-controls="navbarNavAltMarkup"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="fa-solid fa-bars fa-2xl"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                <div class="nav-links navbar-nav">
                    @{
                        if ((User.IsInRole("Admin") || User.IsInRole("Proposal_Admin") || User.IsInRole("Pharmacy") || User.IsInRole("AdminHelth") || User.IsInRole("Pharmacy_Admin")) && User.Identity.IsAuthenticated)
                        {

                            @Html.ActionLink("Proposal", "Index", "ProposalMain", null, new { @class = "sios-nav-link nav-link active ", @id = "ProposalMain" })

                            @Html.ActionLink("Pricing", "PricingIndex", "ProposalMain", null, new { @class = "sios-nav-link nav-link active ", @id = "ProposalMain" })

                            @Html.ActionLink("Broker", "Index", "Broker", null, new { @class = "sios-nav-link nav-link active ", @id = "Broker" })
                            
                            @Html.ActionLink("Renewal", "Show", "ProposalRenewals", null, new { @class = "sios-nav-link nav-link active ", @id = "Renewal" })
                        }
                    }
                </div>
                <div class="sios-hr-parent d-flex align-items-center">
                    <div class="sios-hr-btn dropdown">
                        <button type="button"
                                class="btn dropdown-toggle"
                                data-bs-toggle="dropdown">
                            Hello @User.Identity.GetUserName()
                        </button>
                        <ul class="dropdown-menu">
                            <li>@Html.ActionLink("Profile", "Main", "ControlPanel", null, new { @class = "dropdown-item" })</li>
                            <li>@Html.ActionLink("Manage Account", "Index", "Manage", null, new { @class = "dropdown-item" })</li>
                            <li><a class="dropdown-item" href="javascript:document.getElementById('logoutForm').submit()">Logout</a></li>
                        </ul>
                    </div>
                    <ul class="ps-0 Admin-main-ul mb-0">
                        <li class="nav-item dropdown" style="list-style-type: none">

                            <!--Start no Notifications-->
                             <a class="nav-link"
               href="#"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false" id="White-Ring" style="display:none;">
                <i class="fas fa-bell fs-4"></i>
            </a> 
                            <!--End no Notifications-->
                            <!-- Start got Notified -->

                            <a class="nav-link"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false" id="red-Ring" style="display:none;">
                                <i class="fas fa-bell bellActive fs-4"></i>
                            </a>
                            <div class="notific" id="notification">
                                0
                            </div>

                            <!-- End got Notified -->

                            <div class="dropdown-menu dropdown-menu-end"
                                 aria-labelledby="bell-dropdown" id="divNotificationValues">
                                @*<a class="dropdown-item" href="#">{{CardIDDDD CardIDDDD - 1000-1-175-1}}</a>
                                <hr class="dropdown-divider" />
                                <a class="dropdown-item" href="#">{{CardID}}</a>*@
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
    <!-- end menu -->
    @* container *@
    @{

        @RenderBody()
        <!-- .site-footer -->
        <footer style="margin-top: auto">
            <div class="footer pb-3">
                <div class="container-fluid pt-5">
                    <div class="row m-auto d-flex justify-content-center">
                        <div class="col-md-3 me-4">
                            <div class="footerP1">
                                <h1 class="mb-1">
                                    <img class="logo-white"
                                         src="~/assets/NewDesignBack/Images/logo-dms-white2.png"
                                         alt="" />
                                </h1>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="footerP2">
                                <h5>Address</h5>
                                <div class="line ms-0 mb-1"></div>
                                <h6 class="mt-3">
                                    <p>12 Abdelazim Awadallah St., Heliopolis, Cairo</p>
                                </h6>
                                <i class="fa-brands fa-facebook fs-4 ms-1 me-3"></i>
                                <i class="fa-brands fa-instagram fs-4 me-3"></i>
                                <i class="fa-brands fa-linkedin fs-4"></i>
                            </div>
                        </div>

                        <div class="col-md-4 ms-lg-4">
                            <div class="footerP3">
                                <h5>Contact</h5>
                                <div class="line ms-0"></div>
                                <p><i class="fa-regular fa-envelope"></i> DMS@gmail.com</p>
                                <p>
                                    <i class="fa-solid fa-phone"></i> 01032274222 –
                                    01026006177
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    }
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="~/assets/admindashdoardmenu/sidebarmenu.js"></script>


    <script src="~/ProposalAssets/JS/jquery.min.js"></script>
    <script src="~/ProposalAssets/JS/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="~/ProposalAssets/JS/jquery-ui.js"></script>
    

    <script src="~/assets/admindashdoardmenu/CustomAfterSales/moment.min.js"></script>
    <script src="~/Scripts/DMS/ProposalRenewals/select2.min.js"></script>
    <script src="~/ProposalAssets/JS/main.js"></script>
    <script src="~/assets/admindashdoardmenu/CustomAfterSales/bootstrap-datetimepicker.min.js"></script>
    <script src="~/assets/HomeTemplete/Scripts/jquery.signalR-2.4.1.js"></script>
    <script src="~/signalr/hubs"></script>
    <script>
        var notification = 0;
        $(document).ready(function () {
            // Declare a proxy to reference the hub.
            var notifications = $.connection.notificationHub;
            // Create a function that the hub can call to broadcast messages.
            notifications.client.updateMessages = function () {
                getAllMessages()
            };
            // Start the connection.
            $.connection.hub.start().done(function () {
                console.log("connection started")
                //notifications.onconn();
                getAllMessages();
            }).fail(function (e) {
                console.log("Could not Connect!");
                alert(e);
            });

            $("#btnClaim").click(function () {
                window.location.replace('/Pharmacy/index?id=undefined');
            });
            $(".collaps").click(function () {
                //alert("The paragraph was clicked.");
                if ($("#side-menu").hasClass("activeblock")) {
                    console.log("Inside Ifff");
                    $("#side-menu").removeClass("activeblock");
                    $(".content").removeClass("fullWidth");
                    $(".collaps i").addClass('fa-times');
                    $(".collaps i").removeClass("fa-bars");
                }
                else {
                    console.log("Inside ELSE Ifff");
                    $("#side-menu").addClass("activeblock");
                    $(".content").addClass("fullWidth");
                    $(".collaps i").removeClass('fa-times');
                    $(".collaps i").addClass("fa-bars");
                }
            });
            $(".burger").click(function () {
                if ($(window).width() <= 768) {
                    console.log("Inside  Ifff WIDTH");
                    $("#side-menu").removeClass("activeblock");
                    $(".content").removeClass("fullWidth");
                }
            });
        });

        function getAllMessages() {
            $.ajax({
                url: '/Home/GetProposalNotifications',
                success: function (result) {
                    //debugger;
                    if (result.length === 0) {
                        // Result is empty, show the specific HTML element
                        $('#White-Ring').show();
                        $('#red-Ring').hide();

                    } else {
                        $('#White-Ring').hide();
                        $('#red-Ring').show();
                        $('#emptyResultMessage').show();

                        $('#notification').text(result.length);

                        $('#divNotificationValues').empty();
                        $.each(result, function (key, value) {
                            $('#divNotificationValues').append('<li><a class="dropdown-item" href="/ProposalMain/PricingPage1?proposalMainId=' + value.ProposalMainId + '">' + value.Title + '</a></li>');
                        });
                    }
                }
            });
        }
    </script>
    @RenderSection("Scripts", required: false)

</body>

</html>
