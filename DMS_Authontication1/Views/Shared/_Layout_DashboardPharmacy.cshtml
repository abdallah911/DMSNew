                <div class="d-flex flex-column mx-auto flex-lg-row mb-3 mb-md-0 ps-4 ">
                    <ul class="ps-0 pharm-main-ul nav navbar-nav nav-admin-cus" style="color: #000">
                        <li><a href="/Pharmacy/Pharmacy">Pharmacy</a></li>
                        <li><a href="/Pharmacy">Claims</a></li>
                        <li><a href="/Pharmacy/CompaniesChronicDelivery">Chronic Delivery</a></li> 
