<div class="sios-container mb-4">
    <div class="panel panel-info" id="CardDetails">
        <div class="row bg-overlay  editeRquest fw-bold my-4 ">
            <div class=" m-3 fs-3 text-white ">
                <h2 class="panel-heading"  >Loss Ratio Details</h2>
            </div>
        </div> 
        <div class="panel-body">
            <div class="container mx-auto row">
                <div class="row row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 row-gap-2 form-group">

                    <div class="forLabel admin-form-control border-0 px-2 ">
                     
                        @Html.DropDownList("CompName", ViewBag.company as SelectList, "Select Company", new { @class = " w-100 h-100   admin-form-control form-control", @id = "CompName" })
                        <span class="ps-3">   @Html.LabelFor(model => model.CompId, htmlAttributes: new { @class = "control-label" })</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 ">
                       
                        <select id="ContractNo" class=" w-100 h-100   admin-form-control form-control " placeholder="ContractNo" readonly="readonly"></select>
                        <span class="ps-3"> @Html.LabelFor(model => model.ContractNo, htmlAttributes: new { @class = "control-label" })</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 " data-step="4" data-intro="click Search">
                        
                        <button id="SearchRelation" style=" width: 80px;" type="button" class="btn fw-bold text-white rounded-3 btn-primary" >
                            <i class="glyphicon glyphicon-search"></i> Search
                        </button>
                    </div>


                    <div class="forLabel admin-form-control border-0 px-2 ">
                       
                        @Html.EditorFor(model => model.ServiceDate, new { htmlAttributes = new { @class = " w-100 h-100   admin-form-control form-control", @ReadOnly = "true" } })
                        <span class="ps-3">  @Html.LabelFor(model => model.ServiceDate, htmlAttributes: new { @class = "control-label" })</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 ">
                        
                        @Html.EditorFor(model => model.ClaimCreatedDate, new { htmlAttributes = new { @class = " w-100 h-100   admin-form-control form-control", @ReadOnly = "true" } })
                        <span class="ps-3"> @Html.LabelFor(model => model.ClaimCreatedDate, htmlAttributes: new { @class = "control-label" })</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 ">
                       
                        @Html.EditorFor(model => model.ReviewDate, new { htmlAttributes = new { @class = " w-100 h-100   admin-form-control form-control", @ReadOnly = "true" } })
                        <span class="ps-3">  @Html.LabelFor(model => model.ReviewDate, htmlAttributes: new { @class = "control-label" }) </span>
                    </div>

                    <div class="forLabel admin-form-control border-0 px-2 ">
                     
                        @Html.EditorFor(model => model.LossRatio, new { htmlAttributes = new { @class = " w-100 h-100   admin-form-control form-control" } })
                        <span class="ps-3">    @Html.LabelFor(model => model.LossRatio, htmlAttributes: new { @class = "control-label" })</span>
                    </div>

                    <div class="forLabel admin-form-control border-0 px-2 ">
                     
                        @Html.EditorFor(model => model.PoolPercent, new { htmlAttributes = new { @class = " w-100 h-100   admin-form-control form-control" } })
                        <span class="ps-3">    @Html.LabelFor(model => model.PoolPercent, htmlAttributes: new { @class = "control-label" })</span>
                    </div>

                    <div class="forLabel admin-form-control border-0 px-2 "> 
                        @Html.EditorFor(model => model.PoolValue, new { htmlAttributes = new { @class = " w-100 h-100   admin-form-control form-control" } })
                        <span class="ps-3">   @Html.LabelFor(model => model.PoolValue, htmlAttributes: new { @class = "control-label" }) </span>
                    </div>

                    <div class=" d-flex gap-2 align-items-center border-0 px-2   px-2 ">
                        @Html.LabelFor(model => model.PoolState, htmlAttributes: new { @class = "sios-color fw-bold control-label" })
                        @Html.CheckBoxFor(model => model.PoolState, new { @class = " form-check  cus-rem-input", @style="width: 20px;" })
                        
                    </div>

                </div>
            </div>
        </div>
    </div>


    <div class="panel panel-info" id="CardInformationDetails" hidden="hidden">
        <h2 class="panel-heading" style="margin:1px;">Card Information</h2>
        <div class="row" style=" text-align:left">
            <div class="col-md-12">
                <input id="ShowConsumption" type="button" value="Show Consumption" onclick="ShowAllConsmptionDetails()" class="btn btn-primary" />
                <input id="ShowApproval" type="button" value="Approval" class="btn btn-success" onclick="ShowApprovalConsmptionDetails()" />
                <input id="ShowClaims" type="button" value="Claims" class="btn btn-primary" onclick="ShowClaimsConsmptionDetails()" />
                <input id="ShowIndemnity" type="button" value="Indemnity" class="btn btn-success  fa fa-search" onclick="ShowIndemnityConsmptionDetails()" />
                <input id="ShowMonthly" type="button" value="Monthly treatment" class="btn btn-primary fa fa-file-pdf-o" onclick="ShowMonthlyConsmptionDetails()" />
                <input id="ShowLive" type="button" value="Online Live" class="btn btn-success fa-file-excel-o " onclick="ShowLiveConsmptionDetails()" />
                <input id="ShowMedicalNetwork" type="button" value="Medical Network" class="btn btn-primary fa fa-file-pdf-o" onclick="ShowMedicalNetworkScreen()" />
                <input id="ShowCardDesgin" type="button" value="Card Desgin" class="btn btn-success fa-file-excel-o " onclick="ShowCardDesignPrint()" />
            </div>
        </div>

    </div>
</div>

<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/LossRatio.js?V=3.2"></script>