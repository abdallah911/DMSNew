@model DMS_Authontication1.ViewModel.Enum_RequestsViewModel

@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "CreateRequest";
    Layout = "~/Views/Shared/_Layout_DashboardHomePage.cshtml";

}
<style>
    .forLabel input:valid ~ span, .forLabel select:valid ~ span:last-of-type, .forLabel textarea:valid ~ span, .forLabel input:focus ~ span, .forLabel select:focus ~ span, .forLabel textarea:focus ~ span,
    .forLabel .admin-form-control[readonly="readonly"] ~ span, .forLabel .admin-form-control[readonly="true"] ~ span, .forLabel .admin-form-control[disabled] ~ span {
        transform: translateY(-10px) !important;
    }
    select {
        padding: 7px;
    }
</style>
<div class="sios-container">

    <div class="portlet box   ">
        <div class="row bg-overlay portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa-solid fa-home me-1"></i>Create New Request
            </div>
        </div>
        <div class="portlet-body">
            <div class="row ">
                <div class="col-md-12">
                    @using (Html.BeginForm("CreateRequest", "MedicalApproval", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
                    {

                        <div class="form-wizard">
                            <div class="form-body">
                                <div class="tab-content">
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    @Html.HiddenFor(model => model.ID)
                                    @Html.HiddenFor(model => model.CompName)
                                    @*@Html.HiddenFor(model => model.TYPE)*@
                                    <div class="row container mx-auto my-4" style="white-space:nowrap;">
                                        <div class="col-md-6 d-flex flex-column gap-2">

                                            <div class="forLabel px-2 border-0 form-group">

                                                @Html.EditorFor(model => model.CompName, new { htmlAttributes = new { @class = "border-2 admin-form-control w-100", @readonly = "readonly" } })
                                                @Html.ValidationMessageFor(model => model.CompName, "", new { @class = "text-danger" })
                                                <span class="start-0" style="transform:translateY(-6px);">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayNameFor(model => model.CompName) :
                                                        <span class="required"> * </span>
                                                    </label>
                                                </span>

                                            </div>

                                            <div class="forLabel px-2 border-0 form-group">

                                                @Html.EditorFor(model => model.CARD_ID, new { htmlAttributes = new { @class = "border-2 admin-form-control w-100", @readonly = "readonly", id = "CardId" } })
                                                @Html.ValidationMessageFor(model => model.CARD_ID, "", new { @class = "text-danger" })
                                                <span class="start-0" style="transform:translateY(-6px);">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayNameFor(model => model.CARD_ID) :
                                                        <span class="required"> * </span>
                                                    </label>
                                                </span>

                                            </div>

                                            <div class="forLabel px-2 border-0 form-group">

                                                <select name="TYPE" id="TYPE" class="border-2 admin-form-control w-100">
                                                    @*<option value="Medications outpatient">Medications outpatient</option>*@
                                                    <option value="Inpatient">Inpatient</option>
                                                    <option value="Radio">Radio</option>
                                                    <option value="Physiotherapy ">Physiotherapy </option>
                                                    <option value="Laboratory">Laboratory</option>
                                                    @*<option value="Outpatient services">Outpatient services</option>*@
                                                    <option value="Dental services outpatient">Dental services outpatient</option>
                                                    <option value="Maternity">Maternity</option>
                                                    <option value="Optical">Optical</option>
                                                </select>
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayNameFor(model => model.TYPE) :
                                                    </label>
                                                </span>

                                            </div>
                                            <div class="forLabel px-2 border-0 form-group">

                                                @Html.DropDownListFor(m => m.TYP_ANAME, ViewBag.provider as SelectList, "Select Provider Type", new { @class = "border-2 admin-form-control w-100" })
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayNameFor(model => model.TYP_ANAME) :
                                                    </label>
                                                </span>

                                            </div>
                                            <div class="forLabel px-2 border-0 form-group">

                                                @Html.DropDownListFor(model => model.PR_ENAME, new SelectList(""), " Select Provider Name", new
                                           {
                                               @class = "border-2 admin-form-control w-100"
                                           })
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayNameFor(model => model.PR_ENAME) :
                                                    </label>
                                                </span>

                                            </div>

                                        </div>

                                        <div class="col-md-6 d-flex flex-column gap-2 ">

                                            <div class="forLabel px-2 border-0 form-group">

                                                @Html.EditorFor(model => model.NOTES, new { htmlAttributes = new { @class = "border-2 admin-form-control w-100", required = "true" } })
                                                @*<input type="text" class="border-2 sios-form-control w-100 form-control" id="NOTES" name="NOTES" />*@
                                                @Html.ValidationMessageFor(model => model.NOTES, "", new { @class = "text-danger" })
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayNameFor(model => model.NOTES) :
                                                    </label>
                                                </span>

                                            </div>

                                            <div class="forLabel px-2 border-0 form-group">

                                                @Html.EditorFor(model => model.MAIL_SEND, new { htmlAttributes = new { @class = "border-2 admin-form-control w-100", required = "true" } })
                                                @*<input type="text" class="border-2 sios-form-control w-100 form-control" id="MAIL_SEND" name="MAIL_SEND" />*@
                                                @Html.ValidationMessageFor(model => model.MAIL_SEND, "", new { @class = "text-danger" })
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayName("Contact Email :")
                                                        <span class="required"> * </span>
                                                    </label>
                                                </span>

                                            </div>

                                            <div class="px-2">
                                                <div class=" admin-form-control  d-flex align-content-center px-2 border-2 form-group">
                                                    <span class="w-25 d-flex align-items-center sios-color fw-bold" style=" font-size: 10px;transform: unset;"><label class="control-label ">@Html.DisplayName("Upload Files"):<span class="required"> * </span></label></span>
                                                    <input name="ImageFile" id="ImageFile" type="file" style="padding: 5px; height: 90%; margin: auto;" class="admin-form-control bg-dark-subtle border-0 w-75" multiple required />
                                                    @Html.ValidationMessageFor(model => model.ImageFile, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="container text-center text-sm-end px-4 mt-3 mb-4">
                                <input id="new" type="button" value="Reset" onclick="NewRequest();" class="btn me-2" />
                                @*<input id="submit" type="submit" value="Save" class="btn " />*@
                                <input id="submit" type="button" value="Save" class="btn" onclick="Save()"/>
                            </div>

                        </div>
                    }
                </div>
            </div>

        </div>

    </div>
</div>
<input type="text" id="imName" hidden="hidden" />

<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
@*<script src="~/Scripts/DMS/HR/MedicalApprovalCreate.js?V=1"></script>*@

<script>
    function Save() {
        alert("تم إستلام طلب سيادتكم وإرساله للقسم المختص وسيتم الرد عليكم فور الإنتهاء من دراسة طلب الموافقة");
        var cardId = encodeURIComponent($("#CardId").val());
        window.location.href = '@Url.Action("NetworkMedical", "NetworkMedical", new { cardId = "__REPLACE__" })'.replace("__REPLACE__", encodeURIComponent(cardId));
    }
</script>