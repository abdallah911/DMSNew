        <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
        <script src="~/assets/NewDesign/js/video.min.js"></script>
        <script>

            $(document).ready(function () {
                $(".select2").select2();



                $("#Country_select").change(function () {

                    // Show loading image
                    $("#loading").show();

                    $.get("/NetworkMedical/GetRegion",
                        { id: $("#Country_select").val() },
                        function (data) {
                            $("#Region_select").empty();
                            $("#Region_select").append("<option value='0'>أختر المنطقة</option>");
                            $.each(data, function (index, row) {
                                $("#Region_select").append("<option value='" + row.Value + "'>" + row.Text + "</option>");
                            });

                            // Hide loading image after data is loaded
                            $("#loading").hide();
                        }
                    ).fail(function () {
                        // In case of failure, hide the loading image
                        $("#loading").hide();
                        alert("Failed to load regions. Please try again.");
                    });
                });

            });
            function SearchProvider() {
                debugger;
                if ($("#txtCardId").val() != "") {
                    var cardNum = $("#txtCardId").val();
                    var arra = cardNum.split("-");
                    // chick card id is correct or not
                    if (arra.length == 4 && arra[3] != "") {

                        compname = arra[0];
                        if ($("#provider_Type").val() == "") {
                            alert("Please select Provider ...");
                        }
                        if ($("#Country_select").val() == "") {
                            alert("Please select Country ...");
                        }
                        else {

                            $("#loading").show();

                            $.ajax({
                                url: '/NetworkMedical/GetProviders/',
                                data: {
                                    cardId: cardNum, compId: compname, country: $("#Country_select").val(),
                                    region: $("#Region_select").val(), providerId: $("#provider_Type").val()
                                },
                                dataType: 'Json',
                                success: function (r) {
                                    $('#ProviderList').dataTable().fnDestroy();
                                    if (r.msg == "ok") {
                                        var setData = $("#ProviderList Tbody");
                                        setData.empty();
                                        for (var i = 0; i < r.providerslist.length; i++) {
                                            var data = "<tr>" +
                                                "<td>" + r.providerslist[i].PR_ANAME + "</td>";
                                            if (r.providerslist[i].ADDRESS1 == null)
                                                data += "<td>--</td>";
                                            else
                                                data += "<td>" + r.providerslist[i].ADDRESS1 + "</td>";
                                            if (r.providerslist[i].ADDRESS2 == null)
                                                data += "<td>--</td>";
                                            else
                                                data += "<td>" + r.providerslist[i].ADDRESS2 + "</td>";
                                            if (r.providerslist[i].TEL1 == null)
                                                data += "<td>--</td>";
                                            else
                                                data += "<td>" + r.providerslist[i].TEL1 + "</td>";
                                            if (r.providerslist[i].TEL2 == null)
                                                data += "<td>--</td>";
                                            else
                                                data += "<td>" + r.providerslist[i].TEL2 + "</td>";
                                            if (r.providerslist[i].PR_DESC == null)
                                                data += "<td>--</td>";
                                            else
                                                data += "<td>" + r.providerslist[i].PR_DESC + "</td>" +
                                                    "</tr>";
                                            setData.append(data);
                                        }
                                        $('#ProviderList').DataTable();
                                        $('#list_div').show();
                                    }
                                    else {
                                        alert(r.msg);
                                    }

                                },
                                error: function () {
                                    alert("Invalid Card ID ");
                                },
                                complete: function () {
                                    $("#loading").hide();
                                }
                            });
                        }
                    }
                    else {
                        alert("Please enter correct card ... ");
                    }
                }
            }


            function ShowApprovalDetails() {
                debugger;
                $('#ApprovalsScreen').hide();
                $('#ChronicScreen').hide();

                //$('#ApprovalsScreen').show();
                $('#ApprovalsScreen').removeAttr('hidden').show();

                if ($('#txtCardId').val() != "")
                    getApprovalData($('#txtCardId').val());
            }
            function ShowChronicDetails() {

                $('#ApprovalsScreen').hide();
                $('#ChronicScreen').hide();


                //$('#ChronicScreen').show();
                $('#ChronicScreen').removeAttr('hidden').show();

                if ($('#txtCardId').val() != "")
                    getChronicData($('#txtCardId').val());
            }

            function getApprovalData(crd) {

                var table = $('#ApprovalsDetails').DataTable();
                table.clear().draw();
                table.destroy();

                /*if (crd != "" && crd == "10000-VIP-100159-1") {*/
                    $("#loading").css("display", "flex");
                    $.ajax({
                        type: "POST",
                        url: '/NetworkMedical/getAprovalData',
                        data: { CardId: crd, startDate: $('#startDate').val(), endDate: $('#endDate').val()  },
                        success: function (apprs) {

                            if (apprs.approval.length > 0) {

                                $('#ApprovalsDetails').dataTable().fnDestroy();

                                var setData = $("#ApprovalsDetails Tbody");
                                setData.empty();

                                for (var i = 0; i < apprs.approval.length; i++) {

                                    var data = "<tr >" +

                                        "<td>" + apprs.approval[i].ApprovalNo + "</td>" +
                                        "<td>" + apprs.approval[i].ApprovalType + "</td>" +
                                        "<td>" + apprs.approval[i].Reply + "</td>" +
                                        "<td>" + apprs.approval[i].ApprovalAmount + "</td>" +
                                        "<td>" + apprs.approval[i].MedicalReply + "</td>" +
                                        "<td>" + apprs.approval[i].CreatedBy + "</td>" +
                                        "<td>" + apprs.approval[i].CreatedDate + "</td>" +
                                        "<td>" + apprs.approval[i].CreatedDate1 + "</td>" +
                                        "<td >" + "<Button  class='btn btn-Primary ' onclick='PrintApproval(\"" + apprs.approval[i].ApprovalNo + "\");'>Print</Button>" + "</td>" +
                                        "</tr>";
                                    setData.append(data);
                                }

                                $("#ApprovalsDetails").DataTable({
                                    "ordering": true,
                                    "order": [[7, "desc"]],
                                    "columnDefs": [
                                        {
                                            targets: [7],  // Column index to hide (8th column, index 7)
                                            "visible": false  // Hide the column
                                        }
                                    ]
                                });
                            }
                        },
                        complete: function () {
                            $("#loading").hide();

                        }
                    });
                /*}*/
            }
            function getChronicData(crd) {

                var table = $('#ChronicDetails').DataTable();
                table.clear().draw();
                table.destroy();

               /* if (crd != "" && crd == "10000-VIP-100159-1") {*/
                    $("#loading").css("display", "flex");
                    $.ajax({
                        type: "POST",
                        url: '/NetworkMedical/getChornicData',
                        data: { CardId: crd },
                        success: function (apprs) {

                            if (apprs.clmD.length > 0) {

                                $('#ChronicDetails').dataTable().fnDestroy();

                                var setData = $("#ChronicDetails Tbody");
                                setData.empty();

                                for (var i = 0; i < apprs.clmD.length; i++) {
                                    var data = "<tr >" +
                                        "<td>" + apprs.clmD[i].MED_CODE + "</td>" +
                                        "<td>" + apprs.clmD[i].MED_NAME + "</td>" +
                                        "<td>" + apprs.clmD[i].DOSE + "</td>" +
                                        "<td>" + apprs.clmD[i].MED_DURATION + "</td>" +
                                        "<td>" + apprs.clmD[i].UNIT_NO + "</td>" +
                                        "<td>" + apprs.clmD[i].DOSAGE_FORM + "</td>" +
                                        "<td>" + apprs.clmD[i].MONTH_DATE_STOP + "</td>" +
                                        "</tr>";
                                    setData.append(data);
                                }

                                $("#ChronicDetails").DataTable();
                            }
                        },
                        complete: function () {
                            $("#loading").hide();

                        }
                    });
                //}
            }
            function GoRequestApproval() {
                let cardId = encodeURIComponent($("#txtCardId").val());
                window.location.href = '@Url.Action("CreateRequestMedical", "NetworkMedical")' + '?cardId=' + cardId;
            }
            function GoRequestChronic() {
                let cardId = encodeURIComponent($("#txtCardId").val());
                window.location.href = '@Url.Action("CreateRequestChronic", "NetworkMedical")' + '?cardId=' + cardId;

            }
        </script>
