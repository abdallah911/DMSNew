@{
    ViewBag.Title = "ReportMed2";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";

}


<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

<div class="panel panel-info">

    <div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
        <img src='/Content/images/demo_wait.gif' width="64" height="64" />Loading...
    </div>

    <div class="sios-container pt-4 portlet box blue">
        <div class="row bg-overlay portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa-solid fa-home me-1"></i> Medicine Audit
            </div>
        </div>
        <div class="portlet-body">
            <div class="row px-md-5 px-3 ">
                <div class="col-md-12">
                    <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">

                        <div class="form-wizard">
                            <div class="form-body">
                                <div class="tab-content">
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class=" row row-cols-md-2 row-gap-2 container mx-auto">
                                        <div class=" d-flex flex-column  gap-2 my-4 no-wrap">

                                            @*Date of Registration*@
                                            <div class="d-flex align-items-center sios-form-control w-100 rounded form-group" style="padding: 0 10px !important;">
                                                <label class="col-4 hr-color control-label ">
                                                    Record Date
                                                </label>
                                                <div class="col-8   d-flex align-items-baseline  position-relative">
                                                    <input type="text" id="RegistrationReviewFrom" style="outline:none;box-shadow:none!important;" class="date-input border-0 w-100 h-100 p-2 bg-transparent text-center hr-color" name="end-date" required="" placeholder="From"><i class="fa-solid fa-calendar-days opacity-75 me-2 hr-color"></i>
                                                    <div style="width: 1px; height: 20px;  right: 49%;" class="line position-absolute top-50  translate-middle-y opacity-75  "></div>
                                                    <input type="text" id="RegistrationReviewTo" style="outline:none;box-shadow:none!important;" class="date-input outli border-0 w-100 h-100 p-2 bg-transparent text-center hr-color" name="end-date" required="" placeholder="to"><i class="fa-solid fa-calendar-days opacity-75 hr-color"></i>
                                                </div>
                                            </div>


                                            @* Company Number *@ 
                                            <div class="  forLabel admin-form-control   border-0 rounded   form-group">
                                                <select id="ProviderNo" name="ProviderNumber" class="admin-form-control w-100 h-100 rounded-3   js-data-example-ajax" style="width: 100%"></select>
                                                <span class="sios-color control-label sbold col-md-3"> Provider Number </span>
                                            </div> 
                                         
                                            <div class="  forLabel admin-form-control   border-0 rounded   form-group">
                                                <input id="BatchNo" class=" admin-form-control w-100 h-100 rounded-3   " style="width: 100%" />
                                                <span class="sios-color control-label sbold col-md-3"> Batch Number </span>
                                            </div> 
                                    
                                    
                                            @* Repot Type *@
                                         
                                            <div class="  forLabel admin-form-control   border-0 rounded   form-group">
                                                <select id="RepotTypeReview" class="admin-form-control w-100 h-100 rounded-3  ps-3">
                                                    <option value="1">Review Summary</option>
                                                    <option value="2">Review Details</option>
                                                </select>
                                                <span class="sios-color control-label sbold col-md-3">Repot Type *</span>
                                            </div> 


                                        </div>

                                        <div class=" d-flex flex-column justify-content-end gap-2 my-4 no-wrap">
                                        
                                            @* For Buttons *@ 
                                            <div class="d-flex gap-2  ">

                                                <div class=" " id="div_of_serv">
                                                    <button id="Consumption" type="button" class="btn fw-bold text-white rounded-3 " onclick="ClearAllReview()">
                                                        <i class="fa-regular fa-square-plus me-1"></i> New
                                                    </button>

                                                </div>

                                                <div class=" " id="div_of_serv">
                                                    <button id="Consumption" type="button" class="btn fw-bold text-white rounded-3 btn-primary" onclick="PrintReviewBatch()">
                                                        <span class="fa fa-save me-1"></span> Print
                                                    </button>
                                                </div>
                                            </div>
                                         
                                            @*Print Type*@ 
                                            <div class="col-md-8">
                                                <div class="d-flex align-items-center form-group gap-3 mt-3">
                                                    <label class="sios-color control-label fs-4 sios-color fw-bold">
                                                        Print Type :
                                                    </label>
                                                    <div class=" d-flex align-items-center mt-1 gap-2">
                                                        <div class="checkbox-inline">
                                                            <input style="transform: translateY(2px);" type="checkbox" id="pdf" name="pdf" value="pdf" data-name="pdf">
                                                            <label class="fw-bold" for="pdf">
                                                                PDF
                                                            </label>
                                                        </div>
                                                        <div class=" checkbox-inline">
                                                            <input style="transform: translateY(2px);" type="checkbox" id="excel" name="excel" value="excel" data-name="excel">
                                                            <label class="fw-bold" for="excel">
                                                                EXCEL
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div> 
                        </div>
                    </form>
                </div>
            </div>

        </div>

    </div>
</div>


<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/ReportMain/ReportMain.js?V=3.2"></script>