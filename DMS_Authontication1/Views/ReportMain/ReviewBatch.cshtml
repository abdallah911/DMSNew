@{
    ViewBag.Title = "ReportMed2";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";

}


<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

<div class="panel panel-info">

    <div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
        <img src='/Content/images/demo_wait.gif' width="64" height="64" />Loading...
    </div>

    <div class="sios-container portlet box blue">
        <div class="row bg-overlay my-4 portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa fa-gift me-3"></i> Medicine Audit
            </div>
        </div>
        <div class="portlet-body">
            <div class="row px-md-5 px-3 ">
                <div class="col-md-12">
                    <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">

                        <div class="form-wizard">
                            <div class="form-body">
                                <div class="tab-content">
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class="row row-gap-2">
                                        @*Date of Registration*@
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="sios-color control-label sbold mb-1 ms-2 col-md-3">
                                                    Record Date:
                                                    @*<span class="required"> * </span>*@
                                                </label> 
                                                <div class="row row-cols-2" style="padding: 0 10px;">
                                                    <div class="  forLabel admin-form-control   border-0 px-2    ">
                                                        <input id="RegistrationReviewFrom" type="text" class=" admin-form-control ps-3 w-100 h-100 rounded-3   " />
                                                        <span class="sios-color control-label sbold col-md-3"> From  </span>
                                                    </div>
                                                    <div class="  forLabel admin-form-control   border-0 px-2    ">
                                                        <input id="RegistrationReviewTo" type="text" class="admin-form-control ps-3 w-100 h-100 rounded-3   " />
                                                        <span class="sios-color control-label sbold col-md-2">TO</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                   

                                        @* Company Number *@

                                        <div class="col-md-8">
                                            <div class="  forLabel admin-form-control   border-0 px-2   form-group"> 
                                                <select id="ProviderNo" name="ProviderNumber" class="admin-form-control w-100 h-100 rounded-3   js-data-example-ajax" style="width: 100%"></select>
                                                <span class="sios-color control-label sbold col-md-3"> Provider Number </span>
                                            </div>  
                                        </div>
                                        
                                        <div class="col-md-8">
                                            <div class="  forLabel admin-form-control   border-0 px-2   form-group"> 
                                                <input id="BatchNo" class=" admin-form-control w-100 h-100 rounded-3   "  style="width: 100%"  />
                                                <span class="sios-color control-label sbold col-md-3"> Batch Number </span>
                                            </div>
                                        </div>
                                        
                                        
                                        @* Repot Type *@

                                        <div class="col-md-8">
                                            <div class="  forLabel admin-form-control   border-0 px-2   form-group"> 
                                                <select id="RepotTypeReview" class="admin-form-control w-100 h-100 rounded-3  ps-3">
                                                    <option value="1">Review Summary</option>
                                                    <option value="2">Review Details</option>
                                                </select> 
                                                <span class="sios-color control-label sbold col-md-3">Repot Type *</span>
                                            </div>
                                        </div>
                                        


                                        @*Print Type*@

                                        <div class="col-md-8">
                                            <div class="d-flex align-items-center form-group mt-3">
                                                <label class="sios-color control-label fs-4 sios-color sbold col-md-3">
                                                    Print Type :
                                                </label>
                                                <div class="col-md-4 d-flex align-items-center mt-1 gap-2">
                                                    <div class="checkbox-inline">
                                                        <input type="checkbox" id="pdf" name="pdf" value="pdf" data-name="pdf">
                                                        <label class="fw-bold" for="pdf">
                                                            PDF
                                                        </label>
                                                    </div> 
                                                    <div class=" checkbox-inline">
                                                        <input type="checkbox" id="excel" name="excel" value="excel" data-name="excel">
                                                        <label class="fw-bold"  for="excel">
                                                            EXCEL
                                                        </label>
                                                    </div>
                                                </div> 
                                            </div>
                                        </div>
                                        

                                        @* For Buttons *@

                                        <div class="d-flex gap-2 col-md-12" style="margin-left:30px;margin-right:30px;margin-top:80px;margin-bottom:80px;text-align:right;">

                                            <div class=" " id="div_of_serv">
                                                <button id="Consumption" type="button" class="btn fw-bold text-white rounded-3 " onclick="ClearAllReview()">
                                                    <span class="fa fa-save"></span> New
                                                </button>

                                            </div>

                                            <div class=" " id="div_of_serv">
                                                <button id="Consumption" type="button" class="btn fw-bold text-white rounded-3 btn-primary" onclick="PrintReviewBatch()">
                                                    <span class="fa fa-save"></span> Print
                                                </button>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>

    </div>
</div>


<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/ReportMain/ReportMain.js?V=3.2"></script>