@{
    ViewBag.Title = "ReportMed2";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";

}
 

<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

<div class="sios-container panel panel-info">

    <div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
        <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
    </div>

    <div class="portlet box blue">
        <div class="row bg-overlay editeRquest fw-bold my-4 portlet-title">
            <div class="m-3 fs-3 text-white  caption">
                <i class="fa fa-gift me-3"></i> Medicine Audit
            </div>
        </div>
        <div class="container portlet-body">
            <div class="row ">
                <div class="col-md-12">
                    <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">

                      <div class="form-wizard">
                          <div class="form-body">
                             <div class="tab-content">
                                 <div asp-validation-summary="All" class="text-danger"></div>

                                 <div class="row gap-3">
                                     @*Date of Registration*@
                                     
                           
                               <div class="mb-3">
                                   <span class="sios-color control-label sbold col-md-3">
                                       Record Date 
                                       <span class="required"> * </span>
                                   </span>
                               </div>
                               <div style="white-space:nowrap;" class=" ">
                                   <div class="row row-cols-2 col-md-8 form-group ">

                                       <div class=" forLabel admin-form-control border-0 px-2 "> 
                                           <input id="RegistrationFrom" type="text" class=" admin-form-control w-100 h-100 form-control " placeholder="From" />
                                           <span class=" control-label ">
                                               From

                                           </span>
                                       </div>
                                        
                                       <div class="forLabel admin-form-control border-0 px-2 ">
                                           <input id="RegistrationTo" type="text" class=" admin-form-control w-100 h-100 form-control " placeholder="To" />
                                           <span class=" control-label ">
                                               TO

                                           </span>
                                       </div>
                                       </div> 
                                        </div>
                                            @* Company Number *@
                                       
                                          <div class="forLabel admin-form-control border-0 px-2 form-group">
                                            @Html.DropDownList("CopmanyNumber", ViewBag.company as SelectList, "Select Company", new { @class = " admin-form-control w-100 h-100 form-control", id = "CompNo" })
                                            <span class="  control-label ">
                                                Company Number 
                                            </span>
                                          
                                        </div>
                                      
                              
                                         <div class="forLabel admin-form-control border-0 px-2 form-group">
                                             <select id="CardNo" class=" admin-form-control w-100 h-100  col-md-2 js-data-example-ajax" style="width: 100%">
                                                 <option value="">select Card</option>
                                             </select>
                                             <span class=" control-label  ">
                                                 Card Number

                                             </span>
                                         </div> 
                                     @* Repot Type *@  
                                     <div class="forLabel admin-form-control border-0 px-2 form-group"> 
                                        <select id="RepotType" class=" admin-form-control w-100 h-100 form-control">
                                            <option value="1">Report Audit Medicine Chronic Details</option>
                                            <option value="2">Report Audit Medicine Chronic Summary</option>

                                            <option value="3">Report Medicine Chronic</option>
                                        </select>
                                        <span class="  control-label  ">
                                            Repot Type
                                            <span class="required"> * </span>
                                        </span> 
                                     </div>
                                     
                                 
                                 
                                     @*Print Type*@
                                 
                                     <div class="  col-md-8">
                                         <div class=" d-flex gap-2 form-group">
                                             <span class="sios-color control-label sbold col-md-3">
                                                 Print Type 
                                             </span>
                                             <div class="col-md-2">
                                                 <div class="checkbox-inline">
                                                     <input type="checkbox" id="pdf" name="pdf" value="pdf" data-name="pdf">
                                                     <label for="pdf">
                                                         PDF
                                                     </label>
                                                 </div>
                                             </div>
                                 
                                             <div class="col-md-2">
                                                 <div class="checkbox-inline">
                                                     <input type="checkbox" id="excel" name="excel" value="excel" data-name="excel">
                                                     <label for="excel">
                                                         EXCEL
                                                     </label>
                                                 </div>
                                             </div>
                                             
                                         </div>
                                     </div>
                                     
                                 
                                     @* For Buttons *@
                                 
                                     <div class="d-flex gap-2 " style="margin-left:30px;margin-right:30px;margin-top:80px;margin-bottom:80px;text-align:right;">
                                 
                                         <div class=" " id="div_of_serv">
                                             <button id="Consumption" type="button" class="btn fw-bold text-white rounded-3 btn-warning" onclick="ClearAll2()">
                                                 <span class="fa fa-save"></span> New
                                             </button>
                                 
                                         </div>
                                 
                                         <div class=" " id="div_of_serv">
                                             <button id="Consumption" type="button" class="btn fw-bold text-white rounded-3 btn-primary" onclick="PrintReport2()">
                                                 <span class="fa fa-save"></span> Print
                                             </button>
                                 
                                         </div>
                                 
                                     </div>
                                 </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>

    </div>
</div>


<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/ReportMain/ReportMain.js?V=3.2"></script>