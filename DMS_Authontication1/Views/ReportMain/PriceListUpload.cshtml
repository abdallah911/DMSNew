@{
    ViewBag.Title = "ReportMed2";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";

}


<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

<div class="sios-container  editeRquest fw-bold pt-4">
    <div class="row bg-overlay">
        <div class="m-3 fs-3 text-white caption">
            <i class="fa-solid fa-home me-1"></i> Price List
        </div>
    </div>
    <div class="container portlet-body">
        <div class="row ">
            <div class="col-md-12">
                <form class="form-horizontal">

                    <div class="form-wizard">
                        <div class="form-body">
                            <div class="tab-content">
                                <div asp-validation-summary="All" class="text-danger"></div>

                                <div class=" row row-cols-md-2 row-gap-2 container mx-auto">
                                    <div class=" d-flex flex-column gap-2 my-4 no-wrap">

                                        <div class="forLabel w-100 admin-form-control border-0 form-group">
                                            <select id="TypeProvider" class=" admin-form-control w-100 h-100 form-control" required>
                                                <option value=""></option>
                                                <option value="3">Lab</option>
                                                <option value="4">Rays</option>
                                                <option value="6">Physical</option>
                                                <option value="7">Dental</option>
                                            </select>
                                            <span class="  control-label  ">
                                                Type Provider

                                            </span>
                                        </div>

                                        <div class="forLabel w-100 admin-form-control border-0 form-group">
                                            <select id="Provider" class="admin-form-control w-100 h-100 form-control" required></select>
                                            <span class="  control-label  ">
                                                Provider Name

                                            </span>
                                        </div>
                                        <div class="d-flex align-items-center sios-form-control w-100 rounded form-group" style="padding: 0 10px !important;height: 50px;">
                                            <label class="col-4 hr-color control-label ">
                                                Upload Excel
                                            </label>
                                            <div class="col-8 py-1 h-100 d-flex align-items-baseline  position-relative">
                                                <input class="admin-form-control  bg-dark-subtle border-1 w-100 h-100  rounded ps-2 py-2" type="file">
                                            </div>
                                        </div>
                                    </div>
                                        <div class=" d-flex flex-column justify-content-end gap-2 my-4 no-wrap">

                                            <div class="d-flex gap-2 ">
                                                <div class=" " id="div_of_serv">
                                                    <button id="Consumption" type="button" class="btn fw-bold text-white rounded-3 " onclick="ClearAll2()">
                                                        <i class="fa-regular fa-square-plus me-1"></i>New
                                                    </button>

                                                </div>

                                                <div class=" " id="div_of_serv">
                                                    <button id="Consumption" type="button" class="btn fw-bold text-white rounded-3  " onclick="PrintReport2()">
                                                        <span class="fa fa-save me-1"></span> Save
                                                    </button>

                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>


<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/ReportMain/ReportMain.js?V=3.2"></script>