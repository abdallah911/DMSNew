@model DMS_Authontication1.ViewModel.CustomerService.CustomerServiceViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}

<br />
<br />

<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

<div class="panel panel-info">
    
    <div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
        <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
    </div>

    <div class="portlet box blue">
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-gift"></i> Pharmacy Report
            </div>
        </div>
        <div class="portlet-body">
            <ul class="nav nav-tabs">
                <li class="active"><a href="#ReportTab" data-toggle="tab">Reports</a></li>
                <li><a href="#ChronicParmacyTab" data-toggle="tab">Chronic Parmacy</a></li>
            </ul>

            <div class="tab-content" style="padding-left:15px">
                <div id="ReportTab" class="tab-pane fade  in active">

                    <div class="form-horizontal">

                        <div class="form-wizard">
                            <div class="form-body">
                                <div class="tab-content">
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class="row">
                                        @*Date of Registration*@
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Record Date :
                                                    <span class="required"> * </span>
                                                </label>
                                                <div class="col-md-6">
                                                    <label class="control-label sbold col-md-3">
                                                        From

                                                    </label>
                                                    <div class="col-md-9">
                                                        <input id="RegistrationFrom" type="text" class="col-md-2 form-control " placeholder="From" />
                                                    </div>
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="control-label sbold col-md-2">
                                                TO

                                            </label>
                                            <div class="col-md-10">
                                                <input id="RegistrationTo" type="text" class="col-md-2 form-control " placeholder="To" />
                                            </div>
                                        </div>

                                        @* Company Number *@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Company Number :

                                                </label>
                                                <div class="col-md-6">
                                                    @Html.DropDownList("CopmanyNumber", ViewBag.company as SelectList, "Select Company", new { @class = "col-md-2 js-data-example-ajax", style = "width: 100%", id = "CompNo" })

                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Card Number :

                                                </label>
                                                <div class="col-md-6">
                                                    <select id="CardNo" class="col-md-2 js-data-example-ajax" style="width: 100%">
                                                        <option value="">select Card</option>
                                                    </select>

                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />
                                        @* User Name *@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    User Name:

                                                </label>
                                                <div class="col-md-6">
                                                    @Html.DropDownList("userName", ViewBag.users as SelectList, "Select User", new { @class = "col-md-2 js-data-example-ajax", style = "width: 100%", @id = "userName" })
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />

                                        @* Service provider number *@
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Manager :
                                                </label>
                                                <div class="col-md-6">
                                                    <select id="TypeManager" class="form-control">
                                                        <option value="All">All</option>
                                                        <option value="Daily">Daily</option>
                                                        <option value="Monthly">Monthly</option>
                                                        <option value="Pharmacy_Chronic">Pharmacy_Chronic</option>
                                                        <option value="Pharmacy_Doctor">Pharmacy_Doctor</option>


                                                    </select>
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Med Code:

                                                </label>
                                                <div class="col-md-6">
                                                    @*@Html.DropDownList("MedicationAll", ViewBag.medall as SelectList, "Select Medication", new { @class = "form-control", @id = "MedicienCode" })*@
                                                    <select id="AddMedicine" style="width:100%">
                                                        <option value="">select medicine</option>
                                                    </select>
                                                    @*   <select id="MedCode" class="col-md-2 form-control js-data-example-ajax" style="width: 100%"></select>*@
                                                    @*<input id="SerProvNumber" type="number" class="col-md-2 form-control " min="0" />*@

                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Type State:
                                                </label>
                                                <div class="col-md-6">
                                                    <select id="Type" class="form-control">
                                                        <option value="All">All</option>
                                                        <option value="New">New</option>/option>
                                                        <option value="Edit">Edit</option>
                                                    </select>
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />
                                        @* Repot Type *@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Repot Type :
                                                    <span class="required"> * </span>
                                                </label>
                                                <div class="col-md-6">
                                                    <select id="RepotType" class="form-control">
                                                        <option value="1">Report Edit Medicine Monthly</option>
                                                        <option value="2">Medication dispensing details</option>/option>
                                                        <option value="3">Online medication dispensing per card</option>
                                                        <option value="4">Repeat Dispensing Medicine</option>

                                                        @*<option value="903">Top 20 employees in terms of Usage (903)</option>
                                                <option value="904">Consumption per Provider with the highest according to values(904)</option>
                                                <option value="905">Consumption per Provider with the highest according to Usage (905)</option>
                                                <option value="907">Consumption per type of service provider according to Usage (907)</option>
                                                <option value="915">Consumption per Card (915)</option>
                                                <option value="916">Consumption per Card according to service Type (916)</option>*@
                                                    </select>
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />


                                        @*Print Type*@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Print Type :
                                                </label>
                                                <div class="col-md-2">
                                                    <div class="checkbox-inline">
                                                        <input type="checkbox" id="pdf" name="pdf" value="pdf" data-name="pdf">
                                                        <label for="pdf">
                                                            PDF
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-md-2">
                                                    <div class="checkbox-inline">
                                                        <input type="checkbox" id="excel" name="excel" value="excel" data-name="excel">
                                                        <label for="excel">
                                                            EXCEL
                                                        </label>
                                                    </div>
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />

                                        @* For Buttons *@

                                        <div class="col-md-12" style="margin-left:30px;margin-right:30px;margin-top:80px;margin-bottom:80px;text-align:right;">

                                            <div class="col-sm-4" id="div_of_serv">
                                                <button id="Consumption" type="button" class="btn btn-warning" onclick="ClearAll()">
                                                    <span class="fa fa-save"></span> New
                                                </button>

                                            </div>

                                            <div class="col-sm-4" id="div_of_serv">
                                                <button id="Consumption" type="button" class="btn btn-primary" onclick="PrintReport()">
                                                    <span class="fa fa-save"></span> Print
                                                </button>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        </form>
                    </div>
                </div>


                <div id="ChronicParmacyTab" class="tab-pane fade ">

                    <div class="form-horizontal">

                        <div class="form-wizard">
                            <div class="form-body">
                                <div class="tab-content">
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class="row">

                                        @* Company Number *@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Company Number:

                                                </label>
                                                <div class="col-md-6">
                                                    @Html.DropDownList("CopmanyNumber", ViewBag.company as SelectList, "Select Company", new { @class = "col-md-2 js-data-example-ajax", style = "width: 100%", id = "CopmanyNumber2" })
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />

                                        @* Month *@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Month:
                                                </label>
                                                <div class="col-md-6">
                                                    <input id="Date" type="text" class="col-md-2 js-data-example-ajax" style="width: 100%" placeholder="Select Month" />
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />

                                        @* Group *@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Group:
                                                </label>
                                                <div class="col-md-6">
                                                    <select id="ddlGroups" style="width:100%">
                                                        <option value="">Select Group</option>
                                                    </select>
                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />

                                        @* Card Id *@
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Card Number:
                                                </label>
                                                <div class="col-md-6">
                                                    <select id="CardNo2" class="col-md-2 js-data-example-ajax" style="width: 100%">
                                                        <option value="">select Card</option>
                                                    </select>

                                                </div>
                                                <br />
                                            </div>
                                        </div>
                                        <br />

                                        <div class="row" style=" text-align:center">
                                            <div class="col-md-12">
                                                <input id="New" type="button" value="New" onclick="ClearAll3();" class="btn btn-warning" />
                                                <input id="Print" type="button" value="Print" onclick="PrintReport3();" class="btn btn-primary fa fa-file-pdf-o" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        </form>
                    </div>
                </div>

            </div>

            </div>
        </div>


<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/ReportMain/ReportMain.js?V=3.2"></script>