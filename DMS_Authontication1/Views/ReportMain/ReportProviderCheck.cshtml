@{
    ViewBag.Title = "ReportProviderCheck";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";

}
 

<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

<div class=" sios-container panel panel-info">

    <div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
        <img src='/Content/images/demo_wait.gif' width="64" height="64" />  Loading...
    </div>

    <div class="portlet box blue">
        <div class="row bg-overlay my-4 editeRquest fw-bold portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa fa-gift me-3"></i> Report Provider Check
            </div>
        </div>
        <div class="container portlet-body">
            <div class="row ">
                <div class="col-md-12">
                    <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">

                        <div class="form-wizard">
                            <div class="form-body">
                                <div class="tab-content">
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class="row">

                                        @*Date of Registration*@
                                        <div class="row" id="RecordDateProviderScreen" >
                                            <div class="col-md-8">
                                                <div class="form-group">
                                                    <label class="control-label sios-color sbold col-md-3">
                                                        Check Date :
                                                        <span class="required"> * </span>
                                                    </label>
                                                    <div class="col-md-6">
                                                       
                                                        <div class="col-md-9">
                                                            <input id="RegistrationFromReportProviderCheck" type="text" class=" hr-form-control h-100 w-100 fw-bold p-3 pb-1 w-100 rounded  form-control " placeholder="From" />
                                                        </div>
                                                    </div>
                                                    
                                                </div>
                                            </div>
                                            <div class="col-md-4"> 
                                                <div class="col-md-10">
                                                    <input id="RegistrationToReportProviderCheck" type="text" class=" hr-form-control h-100 w-100 fw-bold p-3 pb-1 w-100 rounded  col-md-2 form-control " placeholder="To" />
                                                </div>
                                            </div>
                                        </div>
                                        

                                        @*Print Type*@
                                        <div class="col-md-8 mt-3">
                                            <div class=" d-flex align-items-center form-group">
                                                <label class="control-label fs-4 sios-color  sbold col-md-3">
                                                    Print Type :
                                                </label>
                                                <div class="col-md-2">
                                                    <div class="checkbox-inline">
                                                        <input type="checkbox" id="pdf" name="pdf" value="pdf" data-name="pdf">
                                                        <label for="pdf">
                                                            PDF
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-md-2">
                                                    <div class="checkbox-inline">
                                                        <input type="checkbox" id="excel" name="excel" value="excel" data-name="excel">
                                                        <label for="excel">
                                                            EXCEL
                                                        </label>
                                                    </div>
                                                </div>
                                                
                                            </div>
                                        </div>
                                        

                                        @* For Buttons *@
                                        <div class="d-flex gap-2 mt-3 mb-4">

                                            <div class=" " id="div_of_serv">
                                                <button id="NewReportProviderCheck" type="button" class="btn fw-bold text-white rounded-3  " onclick="ClearAllReportProviderCheck()">
                                                    <span class="  fa fa-save text-white me-1 "></span> New
                                                </button> 
                                            </div>

                                            <div class=" " id="div_of_serv">
                                                <button id="PrintProviderCheck" type="button" class="btn fw-bold text-white rounded-3 btn btn-primary" onclick="PrintReportProviderCheck()">
                                                    <span class=" fa fa-save text-white me-1"></span> Print
                                                </button>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>

    </div>
</div>


<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/ReportMain/ReportMain.js?V=3.2"></script>