@{
    ViewBag.Title = "Reports";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";

}


<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

<div class="sios-container panel panel-info">

    <div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
        <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
    </div>

    <div class=" portlet box blue">
        <div class="row bg-overlay editeRquest fw-bold my-4 portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa fa-gift me-3"></i> Reports
            </div>
        </div>
        <div class="portlet-body">
            <div class="row ">
                <div class="col-md-12">
                    <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">

                        <div class="container form-wizard">
                            <div class="form-body">
                                <div class="tab-content">
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class="row">

                                        @*Date of Registration*@
                                        <div class="row gap-2" id="RecordDateScreen" hidden="hidden">
                                            <div class="col-md-8">
                                                <div class="form-group">
                                                    <label class="  col-md-3">
                                                        Service Date :
                                                        <span class="required"> * </span>
                                                    </label>
                                                    <div class="col-md-6">
                                                        <label class="  col-md-3">
                                                            From

                                                        </label>
                                                        <div class="col-md-9">
                                                            <input id="RegistrationFromReports" type="text" class="col-md-2 form-control " placeholder="From" />
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="  col-md-2">
                                                    TO

                                                </label>
                                                <div class="col-md-10">
                                                    <input id="RegistrationToReports" type="text" class="col-md-2 form-control " placeholder="To" />
                                                </div>
                                            </div>
                                        </div>



                                        @* Company Number *@
                                        <div class="col-md-8 mb-3">
                                            <div class="form-group">
                                                <label class=" sios-color col-md-3">
                                                    Company Number :

                                                </label>
                                                <div class="col-md-6">
                                                    @Html.DropDownList("CopmanyNumberReports", ViewBag.company as SelectList, "Select Company", new { @class = "col-md-2 form-control", id = "CopmanyNumberReports" })

                                                </div>

                                            </div>
                                        </div>


                                        @* Card Number *@
                                        @*<div class="col-md-8">
                                                <div class="form-group">
                                                    <label class="  col-md-3">
                                                        Card Number :

                                                    </label>
                                                    <div class="col-md-6">
                                                        <select id="CardNoReports" class="col-md-2 js-data-example-ajax" style="width: 100%">
                                                            <option value="">select Card</option>
                                                        </select>

                                                    </div>

                                                </div>
                                            </div>
                                        *@

                                        @* Repot Type *@

                                        <div class="col-md-8 mb-3">
                                            <div class="form-group">
                                                <label class="sios-color  col-md-3">
                                                    Repot Type :
                                                    <span class="required"> * </span>
                                                </label>
                                                <div class="col-md-6">
                                                    <select id="RepotTypeReports" class=" hr-form-control h-100 w-100 rounded fw-bold p-3 pb-1 border-0 form-control">
                                                        <option value="1">Activation Report</option>
                                                        <option value="2">Start Employee Report</option>
                                                        <option value="3">Close Employee Report</option>
                                                        <option value="4">Active Medicine Chronic Report</option>
                                                        <option value="5">Claims Report</option>
                                                        @* <option value="6">Report Audit Medicine Chronic Summary</option>*@
                                                    </select>
                                                </div>

                                            </div>
                                        </div>



                                        @*Print Type*@

                                        <div class="col-md-8">
                                            <div class="d-flex align-items-center my2 form-group">
                                                <label class=" fs-4 sios-color col-md-3">
                                                    Print Type :
                                                </label>
                                                <div class="col-md-2">
                                                    <div class="checkbox-inline">
                                                        <input type="checkbox" id="pdf" name="pdf" value="pdf" data-name="pdf">
                                                        <label for="pdf">
                                                            PDF
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-md-2">
                                                    <div class="checkbox-inline">
                                                        <input type="checkbox" id="excel" name="excel" value="excel" data-name="excel">
                                                        <label for="excel">
                                                            EXCEL
                                                        </label>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>


                                        @* For Buttons *@

                                        <div class=" d-flex gap-2" style="margin-left:30px;margin-right:30px;margin-top:80px;margin-bottom:80px;text-align:right;">

                                            <div class=" " id="div_of_serv">
                                                <button id="NewReports" type="button" class="btn fw-bold text-white rounded-3 btn-warning" onclick="ClearAllReports()">
                                                    <span class="fa fa-save"></span> New
                                                </button>

                                            </div>

                                            <div class=" " id="div_of_serv">
                                                <button id="PrintReportsNew" type="button" class="btn fw-bold text-white rounded-3 btn-primary" onclick="PrintReports()">
                                                    <span class="fa fa-save"></span> Print
                                                </button>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>

    </div>
</div>


<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/ReportMain/ReportMain.js?V=3.2"></script>