@{
    ViewBag.Title = "ReportPrint";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";

}
 

<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>

<div class="sios-container panel panel-info">

    <div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
        <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
    </div>

    <div class="portlet box blue">
        <div class="row bg-overlay  editeRquest fw-bold  my-4 portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa fa-gift"></i> Print Card
            </div>
        </div>
        <div class="container portlet-body">
            <div class="row ">
                <div class="col-md-12">
                    <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">

                        <div class="form-wizard">
                            <div class="form-body">
                                <div class="tab-content">
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class="row container">

                                        @* Company Number *@

                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Company Number :

                                                </label>
                                                <div class="col-md-6">
                                                    @Html.DropDownList("CopmanyNumber", ViewBag.company as SelectList, "Select Company", new { @class = " hr-form-control h-100 w-100 fw-bold p-3 pb-1 w-100 rounded  form-control", id = "CompNoPrint" })

                                                </div>
                                                
                                            </div>
                                        </div>
                                        
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-3">
                                                    Contract Number :

                                                </label>
                                                <div class="col-md-6" >
                                                    <select id="ContractNo" class=" hr-form-control h-100 w-100 fw-bold p-3 pb-1 w-100 rounded  form-control" style="width: 100%">
                                                        <option value="">Select Contract</option>
                                                    </select>

                                                </div>
                                                
                                            </div>
                                        </div>
                                        
                                        <div class=" editeRquest    ">
                                            <div class="m-3  fs-3 text-white  form-group">
                                                <label class="control-label sios-color fw-bold sbold col-md-3">
                                                    Type Print :
                                                </label>

                                                @*<label>@Html.RadioButton("LargeRadio", "True")Large</label>
        <label>@Html.RadioButton("MediumRadio", "False")Medium</label>
        <label>@Html.RadioButton("SmallRadio", "False")Small</label>
        <label>@Html.RadioButton("MiniRadio", "False")Mini</label>*@

                                            <label class="control-label text-dark-emphasis col-md-2"><input class="me-2" data-val="true" id="Large" name="TypePrint" type="radio" value="Large">Large</label>
                                            <label class="control-label text-dark-emphasis col-md-2"><input class="me-2" data-val="true" id="Medium" name="TypePrint" type="radio" value="Medium">Medium</label>
                                            <label class="control-label text-dark-emphasis col-md-2"><input class="me-2" data-val="true" id="Small" name="TypePrint" type="radio" value="Small">Small</label>
                                            <label class="control-label text-dark-emphasis col-md-2"><input class="me-2" data-val="true" id="Mini" name="TypePrint" type="radio" value="Mini">Mini</label>

                                                
                                            </div>
                                        </div>

                                        @* For Buttons *@

                                        <div class="d-flex gap-2 " style="margin-left:30px;margin-right:30px;margin-top:80px;margin-bottom:80px;text-align:right;">

                                            <div class=" " id="div_of_serv">
                                                <button id="Consumption" type="button" class="btn fw-bold text-white rounded-3 btn-warning" onclick="ClearAllPrint()">
                                                    <span class="fa fa-save"></span> New
                                                </button>

                                            </div>

                                            <div class=" " id="div_of_serv">
                                                <button id="Consumption" type="button" class="btn fw-bold text-white rounded-3 btn-primary" onclick="PrintReportPrint()">
                                                    <span class="fa fa-save"></span> Print
                                                </button>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>

    </div>
</div>


<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/ReportMain/ReportMain.js?V=3.2"></script>