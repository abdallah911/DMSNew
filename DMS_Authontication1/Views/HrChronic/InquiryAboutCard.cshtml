@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Inquiries";
    Layout = "~/Views/Shared/_Layout_DashboardHR.cshtml";

    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            if (User.IsInRole("User"))
            {
                var obj = modellist.Where(x => x.ModuleName == "Customers Management" && x.PageId == 25 && (x.FullControl || x.EditPermission
                                              || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
                if (obj != null)
                {
                    edit = obj.EditPermission;
                    delete = obj.ActivationControl;
                    view = obj.Preview;
                    fullcontroll = obj.FullControl;
                    Create = obj.AddPermission;

                }
            }
            else
            {
                var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 16 && (x.FullControl || x.EditPermission
                                  || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
                if (obj != null)
                {
                    edit = obj.EditPermission;
                    delete = obj.ActivationControl;
                    view = obj.Preview;
                    fullcontroll = obj.FullControl;
                    Create = obj.AddPermission;

                }
            }
        }
    }
}
<div class="sios-container">
    <div class="">
        <p class="mx-4 my-0 py-3 d-flex gap-2">
            @if (fullcontroll || view)
            {
                @Html.ActionLink(" Search ", "InquiryAboutCard", null, htmlAttributes: new { @class = "btn action-btn active", @style = " text-transform: none" })
            }
            @if (fullcontroll || Create)
            {
                @Html.ActionLink(" Create Request", "CreateRequest", null, htmlAttributes: new { @class = "btn action-btn", @style = " text-transform: none" })
            }
        </p>
    </div>
    @if (fullcontroll || view)
    {
<div class="portlet box  green">
    <div class="row bg-overlay portlet-title">
        <div class="m-3 fs-3 text-white caption">
            <i class="fa-solid fa-home me-1"></i>Inquiries about an invoice
        </div>
    </div>
    <div class=" my-4 no-wrap portlet-body ">
        <div class="row ">
            <div class="col-md-12">
                <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data"> 
                    <div class="form-wizard">
                        <div class="form-body">
                            <div class="tab-content">
                                <div asp-validation-summary="All" class="text-danger"></div>
                                <input type="hidden" id="CompaName" value="@ViewBag.compnum" />
                                <div class="row container mx-auto ">
                                    @* Search Element and buttons *@
                                    <div class=" row row-cols-sm-2 row-gap-2 " style="white-space:nowrap">
                                        @if (User.IsInRole("HR_Admin"))
                                        {
                                            <div class="forLabel px-2 border-0 form-group">
                                                @Html.DropDownList("CompanyId", ViewBag.company as SelectList, "Select Company", new { @class = "border-2 sios-form-control w-100 form-control", @id = "CompanyId", @required = "True" })
                                                <span class="start-0"style=" transform: translateY(-6px); ">
                                                    <label class="control-label sbold col-md-5">
                                                        Copmany Number
                                                    </label>
                                                </span>
                                            </div>
                                            <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                                            <script>
                                                $(function () {
                                                    $("#CompanyId").select2();
                                                });
                                            </script>
                                        }
                                        else
                                        {
                                            <div class="forLabel px-2 border-0 form-group">
                                                <input id="CopmanyNumber" type="number" class="border-2 sios-form-control w-100 form-control " value="@ViewBag.compnum" min="0" readonly="readonly" />
                                                <span class="start-0"style=" transform: translateY(-6px); ">
                                                    <label class="control-label sbold col-md-5">
                                                        Copmany Number
                                                    </label>
                                                </span>
                                            </div>
                                        }
                                        <div class="forLabel px-2 border-0 form-group">

                                            @if (User.IsInRole("HR") || User.IsInRole("HR_Admin"))
                                            {
                                                <select id="CardNumber" class="js-data-example-ajax" style="width: 100%"></select>
                                            }
                                            else
                                            {
                                                @Html.DropDownList("CardNumber2", ViewBag.Cardslist as SelectList, new { @class = "border-2 sios-form-control w-100 form-control", @id = "CardNumber2", @required = "True" })
                                            }
                                            <span class="start-0">
                                                <label class="control-label sbold col-md-4">
                                                    Card Number 
                                                </label>
                                            </span>
                                        </div>

                                    </div>
                                    <div class=" text-center text-sm-end px-4 mt-3 mb-4">
                                        <button id="Search" type="button" class="btn me-2 " onclick="SearchEmployee()">
                                            <span class="glyphicon glyphicon-search"></span> Search
                                        </button>
                                        <button id="new" type="button" class="btn  " onclick="NewRequest()">
                                            <span class="fa fa-reply"></span> New
                                        </button>
                                    </div>

                                    @*Data Table for result employee data*@
                                    <div class="col-md-offset-1 " id="Employe_Data">
                                        <div class=" mx-auto my-4 table-responsive">

                                            <table class="table" id="EmployeeDataList">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            @Html.DisplayName("Card Number")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("First Name")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Second Name")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Third Name")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Provider Code")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Provider Name")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Group Name")
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody id="ProviderListBody"></tbody>
                                            </table>
                                        </div>
                                    </div>

                                    @*Data Table for result Medicine data*@
                                    <div class="col-md-offset-1  " id="listMedicine_div">
                                        <div class=" mx-auto my-4 table-responsive">

                                            <table class="table" id="MedicineDataList">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            @Html.DisplayName("Medicine Code")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Medicine Name")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Dosage From")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Unit Number")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Packet Size")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Dose Duration")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Total Duration")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Created Date")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Active Status")
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody id="ProviderListBody"></tbody>
                                            </table>
                                        </div>
                                    </div>

                                    @*Footer*@
                                    <div class="row row-cols-sm-2 row-cols-lg-3 row-gap-2"  id="details"> 
                                        <div class="forLabel px-2 border-0 form-group">

                                            <input id="ExchangeDate" type="text" class="border-2 sios-form-control w-100 form-control " readonly="readonly" />
                                            <span class="start-0">
                                                <label class="control-label sbold col-md-5">
                                                    Last Exchange Date
                                                </label>
                                            </span>

                                        </div>  
                                        <div class="forLabel px-2 border-0 form-group">

                                            <input id="PharmacyName" type="text" class="border-2 sios-form-control w-100 form-control " readonly="readonly" />
                                            <span class="start-0">
                                                <label class="control-label sbold col-md-5">
                                                    Pharmacy Name 
                                                </label>
                                            </span>

                                        </div>  
                                        <div class="forLabel px-2 border-0 form-group">

                                            <input id="BranchName" type="text" class="border-2 sios-form-control w-100 form-control " readonly="readonly" />
                                            <span class="start-0">
                                                <label class="control-label sbold col-md-4">
                                                    Branch Name  
                                                </label>
                                            </span>

                                        </div> 
                                    </div>


                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

    }
    </div>
    <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>

    <script>
    $(function () {
        $('#Employe_Data').hide();
        $('#listMedicine_div').hide();
        $('#details').hide();
        $('#EmployeeDataList').DataTable();
        $('#MedicineDataList').DataTable();
        $('#CompanyId').select2();
        $('#CardNumber').select2({
            placeholder: 'Search for a cards',
            minimumInputLength: 5,
            ajax: {
                url: '/EmployeeRequest/GetActiveEmployess/',
                delay: 250,
                dataType: 'json',
                data: function (params) {
                    var query = {
                        search: params.term,
                        page: params.page || 1
                    }
                    return query;
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;

                    return {
                        results: data,//.results,
                        pagination: {
                            more: (params.page * 10) < data.count_filtered
                        }
                    };
                }
                // Additional AJAX parameters go here; see the end of this chapter for the full code of this example

            }
        });
        $("#CompanyId").change(function () {// class levels
            var compNu = $("#CompanyId").val();
            $("#CardNumber").val(null).trigger('change');
            $("#CompaName").val(compNu);
        });
        $("#CompanyId").map(function () {// class levels
            var compNu = $("#CompanyId").val();
            $("#CompaName").val(compNu);
        });

    });

    function SearchEmployee() {
        $('#Employe_Data').hide();
        $('#listMedicine_div').hide();
        $('#details').hide();
        var cardNum = $("#CardNumber").val();
        var cardNum2 = $("#CardNumber2").val();
        var compname = $("#CompaName").val();
        // chick card id  is empty
        if (cardNum == "" || cardNum2 == "") {
            toastr.info("Please Enter Valid Card ID ...");
        }
        else {
            if (cardNum2 != undefined)
                cardNum = cardNum2;
            var arra = cardNum.split("-");

            // chick card id is correct or not
            if (arra.length == 4 && arra[3] != "") {
                debugger;
                // final chick if card id start with company id or not
                if (arra[0] == compname ||("@User.IsInRole("User")"=="True")) {

                    $.ajax({
                        url: '/HrChronic/GetEmployeeChronicData/',
                        data: {
                            cardId: cardNum, compId: compname
                        },
                        dataType: 'Json',
                        success: function (r) {
                            $('#EmployeeDataList').dataTable().fnDestroy();
                            $('#MedicineDataList').dataTable().fnDestroy();
                            if (r.msg == "ok") {
                                var setDataEmploye = $("#EmployeeDataList Tbody");
                                var setDataMedicine = $("#MedicineDataList Tbody");
                                setDataEmploye.empty();
                                setDataMedicine.empty();
                                var empdata = "<tr >" +
                                    "<td>" + r.employee.CardId + "</td>" +
                                    "<td>" + r.employee.EmployeeFN + "</td>" +
                                    "<td>" + r.employee.EmployeeSN + "</td>" +
                                    "<td>" + r.employee.EmployeeTN + "</td>" +
                                    "<td>" + r.employee.ProviderCode + "</td>" +
                                    "<td>" + r.employee.ProviderName + "</td>" +
                                    "<td>" + r.employee.GroupName + "</td>" +
                                    "</tr>";
                                setDataEmploye.append(empdata);
                                $('#EmployeeDataList').DataTable();
                                for (var i = 0; i < r.roshDetails.length; i++) {
                                    var dataMed = "<tr >" +
                                        "<td>" + r.roshDetails[i].MedicienCode + "</td>";
                                    dataMed += "<td>" + r.roshDetails[i].MedicienName + "</td>";
                                    dataMed += "<td>" + r.roshDetails[i].DOSAGE_FORM + "</td>";
                                    dataMed += "<td>" + r.roshDetails[i].UNIT_NO + "</td>";
                                    dataMed += "<td>" + r.roshDetails[i].PACK_SIZE + "</td>";
                                    dataMed += "<td>" + r.roshDetails[i].Duration + "</td>";
                                    dataMed += "<td>" + r.roshDetails[i].TotalDuration + "</td>";
                                    dataMed += "<td>" + r.roshDetails[i].MedicineCreatedDate + "</td>";
                                    if (r.roshDetails[i].ACTIVE == "N")
                                        dataMed += "<td> DisActive </td>";
                                    else
                                        dataMed += "<td> Active </td>";
                                    dataMed += "</tr>";
                                    setDataMedicine.append(dataMed);
                                }
                                $('#MedicineDataList').DataTable();
                                $('#Employe_Data').show();
                                $('#listMedicine_div').show();

                                $("#ExchangeDate").val(r.employee.CreatedDate);
                                $("#PharmacyName").val(r.employee.PharmacyName);
                                $("#BranchName").val(r.employee.UserName);
                                $('#details').show();

                            }
                            else {
                                toastr.info(r.msg);
                            }

                        },
                        error: function () {
                            toastr.info("Invalid Card ID ");
                        }
                    });

                }
                else {
                    toastr.info("Please enter correct card that belongs to your company only start with : " + compname);
                }

            }
            else {
                toastr.info("Please enter correct card ... ");
            }
        }



    }

    function NewRequest() {
        window.location = '/HrChronic/InquiryAboutCard';

    }

    </script>
