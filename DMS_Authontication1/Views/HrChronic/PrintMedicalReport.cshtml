        //var special = $('#Speciality').select2("data").text();
        //var ProviderName = $("#PR_ENAME").text();
        //var special = $("#Speciality").text();
        // chick card id  is empty
        if ($('#Speciality').val() == 0 || $('#Speciality').val()=='') {
            special = "";
        }
        if ($('#PR_ENAME').val() == 0 || $('#PR_ENAME').val()=='') {
            ProviderName = "";
        }

        if (cardNum == "" || cardNum2 == "") {
            toastr.info("Please Enter Valid Card ID ...");
        }
        else {
            if (cardNum2 != undefined) {
                cardNum = cardNum2;
            }
            var arra = cardNum.split("-");

            // chick card id is correct or not
            if (arra.length == 4 && arra[3] != "") {
                debugger;
                // final chick if card id start with company id or not
                if (arra[0] == compname ||("@User.IsInRole("User")"=="True")) {
                    window.open('/HrChronic/PrintMedical?CardId=' + cardNum + '&&CompId=' + compname + '&&ProviderName=' + ProviderName + '&&Specialist=' + special);
                    //$.ajax({
                    //    url: '/HrChronic/PrintMedical/',
                    //    data: {
                    //        CardId: cardNum, CompId: compname, ProviderName: ProviderName, Specialist: special
                    //    },
                    //    dataType: 'Json',
                    //    success: function (r) {

                    //    },
                    //    error: function () {
                    //        toastr.info("Invalid Card ID ");
                    //    }
                    //});

                }
                else {
                    toastr.info("Please enter correct card that belongs to your company only start with : " + compname);
                }

            }
            else {
                toastr.info("Please enter correct card ... ");
            }
        }



    }

    function NewRequest() {
        window.location = '/HrChronic/PrintMedicalReport';

    }

</script>
