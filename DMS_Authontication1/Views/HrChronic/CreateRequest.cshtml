@model DMS_Authontication1.ViewModel.Enum_RequestsViewModel
@{
    ViewBag.Title = "CreateRequest";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}
<br />
<div style="margin-top:40px">
    <p>
        @Html.ActionLink(" Search", "InquiryAboutCard", null, htmlAttributes: new { @class = "btn btn-info fa fa-search  ", @style = " text-transform: none" })
        @Html.ActionLink(" Create Request ", "CreateRequest", null, htmlAttributes: new { @class = "btn btn-secondary-outline  fa fa-plus ", @style = " text-transform: none" })
        @*@Html.ActionLink(" Consumption", "Consumption", null, htmlAttributes: new { @class = "btn btn-info ", @style = " text-transform: none" })*@
    </p>
</div>
<div class="portlet box  green">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-gift"></i>Create New Request
        </div>
    </div>
    <div class="portlet-body">
        <div class="row ">
            <div class="col-md-12">
                @using (Html.BeginForm("CreateRequest", "HrChronic", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
                {

                    <div class="form-wizard">
                        <div class="form-body">
                            <div class="tab-content">
                                <div asp-validation-summary="All" class="text-danger"></div>

                                @Html.HiddenFor(model => model.ID)
                                <div class="row">
                                    <div class="col-md-6">
                                        @Html.HiddenFor(model => model.CompName)
                                        @Html.HiddenFor(model => model.CARD_ID)
                                        @if (User.IsInRole("HR_Admin"))
                                        {
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-4">
                                                    @Html.DisplayNameFor(model => model.CompName) :
                                                    <span class="required"> * </span>
                                                </label>
                                                <div class="col-md-8">
                                                    @Html.DropDownList("CompanyId", ViewBag.company as SelectList, "Select Company", new { @class = "form-control", @id = "CompanyId", @required = "True" })
                                                </div>
                                            </div>
                                            <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                                            <script>
                                                $(function () {
                                                    $("#CompanyId").select2();
                                                });
                                            </script>
                                        }
                                        else
                                        {
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-4">
                                                    @Html.DisplayNameFor(model => model.CompName) :
                                                    <span class="required"> * </span>
                                                </label>
                                                <div class="col-md-8">
                                                    <input type="text" id="companyName" value="@ViewBag.compnum" class="form-control" disabled />
                                                    @Html.ValidationMessageFor(model => model.CompName, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        }
                                        @if (User.IsInRole("HR") || User.IsInRole("HR_Admin"))
                                        {
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-4">
                                                    @Html.DisplayNameFor(model => model.CARD_ID) :
                                                </label>
                                                <div class="col-md-8">
                                                    <select id="CardId" class="form-control js-data-example-ajax" style="width: 100%"></select>

                                                    @*@Html.DropDownList("CardId", null, null, new { @class = "form-control", id = "CardId" })*@
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="form-group">
                                                <label class="control-label sbold col-md-4">
                                                    @Html.DisplayNameFor(model => model.CARD_ID) :
                                                </label>
                                                <div class="col-md-8">
                                                    @Html.DropDownList("CardId2", ViewBag.address as SelectList, "Select Card id", new { @class = "form-control", id = "CardId2" })
                                                </div>
                                            </div>
                                        }
                                        <div class="form-group">
                                            <label class="control-label sbold col-md-4">
                                                @Html.DisplayNameFor(model => model.TYPE) :
                                            </label>
                                            <div class="col-md-8">
                                                <select name="TYPE" id="TYPE" class="form-control">
                                                    <option value="Chronic">Chronic</option>
                                                    <option value="Non-Chronic">Non-Chronic</option>
                                                </select>
                                            </div>
                                        </div>


                                    </div>

                                    <div class="col-md-6">

                                        <div class="form-group">
                                            <label class="control-label sbold col-md-4">
                                                @Html.DisplayNameFor(model => model.NOTES) :
                                            </label>
                                            <div class="col-md-8">
                                                @Html.EditorFor(model => model.NOTES, new { htmlAttributes = new { @class = "form-control" } })
                                                @*<input type="text" class="form-control" id="NOTES" name="NOTES" />*@
                                                @Html.ValidationMessageFor(model => model.NOTES, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label sbold col-md-4">
                                                @Html.DisplayName("Contact Email :")
                                                <span class="required"> * </span>
                                            </label>
                                            <div class="col-md-8">
                                                @Html.EditorFor(model => model.MAIL_SEND, new { htmlAttributes = new { @class = "form-control" } })
                                                @*<input type="text" class="form-control" id="MAIL_SEND" name="MAIL_SEND" />*@
                                                @Html.ValidationMessageFor(model => model.MAIL_SEND, "", new { @class = "text-danger" })
                                            </div>
                                        </div>


                                        <div class="form-group">
                                            <label class="control-label sbold col-md-4">
                                                @Html.DisplayName("Upload Files") :
                                                <span class="required"> * </span>
                                            </label>
                                            <div class="col-md-8">
                                                <input name="ImageFile" id="ImageFile" type="file" class="col-md-2 form-control " multiple required />
                                                @Html.ValidationMessageFor(model => model.ImageFile, "", new { @class = "text-danger" })
                                            </div>
                                        </div>


                                    </div>
                                </div>
                            </div>
                        </div>


                        <div style=" text-align:right">
                            <input id="new" type="button" value="Reset" onclick="NewRequest();" class="btn btn-secondary-outline fa fa-refresh" />
                            <input id="submit" type="submit" value="Save" class="btn btn-success" />

                        </div>

                    </div>
                }
            </div>
        </div>

    </div>

</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script>


    var sel;
    var SelectedProviderEname = "";
    $(document).ready(function () {
        var type = $("#TYPE").val();
        if (type != '') {
            $("#TYPE").val(type).change();
        }
        $('#CardId').select2({
            placeholder: 'Search for a cards',
            minimumInputLength: 5,
            ajax: {
                url: '/EmployeeRequest/GetActiveEmployess/',
                delay: 250,
                dataType: 'json',
                data: function (params) {
                    var query = {
                        search: params.term,
                        page: params.page || 1
                    }
                    return query;
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;

                    return {
                        results: data,//.results,
                        pagination: {
                            more: (params.page * 10) < data.count_filtered
                        }
                    };
                }
                // Additional AJAX parameters go here; see the end of this chapter for the full code of this example

            }
        });
        $("#CardId2").select2();

        $("#CardId").change(function () {// class levels
            var CardId = $("#CardId").val();
            $("#CARD_ID").val(CardId);
        });
        $("#CardId").map(function () {// class levels
            var compNu = $("#CardId").val();
            $("#CARD_ID").val(compNu);
        });
        $("#CardId2").change(function () {// class levels
            var CardId = $("#CardId2").val();
            $("#CARD_ID").val(CardId);
        });
        $("#CardId2").map(function () {// class levels
            var CardId = $("#CardId2").val();
            $("#CARD_ID").val(CardId);
        });
        $("#CompanyId").change(function () {// class levels
            var compNu = $("#CompanyId").val();
            $("#CardId").val(null).trigger('change');
            $("#CompName").val(compNu);
        });
        $("#CompanyId").map(function () {// class levels
            var compNu = $("#CompanyId").val();
            $("#CompName").val(compNu);
        });

    });

    function DownloadImage() {
        window.open('/MedicalApproval/Download/' + $('#RequestCode').html());
    }
    /// Save Request
    function SaveRequest() {
        if ($('#CompName').val() == "") {
            alert("You shoud enter valid company name ..");
        }
        else if ($("#IMAGE").val() == "") {
            alert("You shoud enter IMAGE ..");
        }
        else if ($("#CARD_ID").val() == "") {
            alert("You shoud enter CARD_ID ..");
        }
        else if ($('#TYPE').val() == "") {
            alert("You shoud enter TYPE  ...");
        }

        else {

            var imagname = "";
            if ($('#IMAGE').val() != "") {

                var datag = new FormData();//()
                var files = $("#IMAGE").get(0).files;
                imagname = files[0].name;
                datag.append("File", files[0]);

                //Saving Image
                $.ajax({
                    url: '/MedicalApproval/SaveImage/',
                    type: "POST",
                    processData: false,
                    contentType: false,
                    data: datag,
                    success: function (response) {
                    },
                    error: function (er) {
                        alert("Upload Image");
                    }

                });
            }
            data = {
                CompName: $('#CompName').val(),
                CARD_ID: $('#CARD_ID').val(),
                TYPE: $('#TYPE').val(),
                NOTES: $('#NOTES').val(),
                TYP_ANAME: "Medication",
                PR_ENAME: "Chronic-Non",
                APPROVAL_IMAGE: imagname,

            };
            $.ajax({
                type: "POST",
                url: '/HrChronic/SaveRequest',
                data: data,
                success: function (ret) {
                    if (ret.msg == "ok") {
                        $("#save").attr("disabled", "disabled");
                        bootbox.alert("Request code : " + ret.respcode);
                        $("#RequestCode").html(ret.respcode);
                    }
                    else {
                        alert(ret.msg);
                    }

                },
                error: function (err) {
                    bootbox.alert("Error DATA !");
                }
            });
        }

    }

