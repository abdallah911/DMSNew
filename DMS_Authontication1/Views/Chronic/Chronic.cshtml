@model IEnumerable<DMS_TEST.ViewModel.ChronicViewModel>
@{
    ViewBag.Title = "Chronic";
}
@if (ViewBag.Message == "Can despense your medicine at your specific pharmacy")
{
    <script>
        alert("Can despense your medicine at your specific pharmacy");
        window.location.replace("/Pharmacy/Pharmacy");
    </script>
}
@if (ViewBag.Message == "No Mediciens")
{
    <script>
        alert("No Medicine to despens");
        window.location.replace("/Pharmacy/Pharmacy");
    </script>
}
@if (ViewBag.Message == "No Roshita")
{
    <script>
        alert("No chronic data");
        window.location.replace("/Pharmacy/Pharmacy");
    </script>
}

@if (ViewBag.Message == "This Card doesn't have chronic medicines")
{
    <script>
        alert("This Card doesn't have chronic medicines");
        window.location.replace("/Pharmacy/Pharmacy");
    </script>
}
@if (ViewBag.Message == "Company is not existed")
{
    <script>
        alert("Company is not existed");
        window.location.replace("/Pharmacy/Pharmacy");
    </script>
}
@if (ViewBag.Message == "Expired Card")
{
    <script>
        alert("Expired Card");
        window.location.replace("/Pharmacy/Pharmacy");
    </script>
}
@if (ViewBag.Message == "Card is not existed")
{
    <script>
        alert("Card is not existed");
        window.location.replace("/Pharmacy/Pharmacy");
    </script>
}
@if (ViewBag.Message == "Expired Company")
{
    <script>
        alert("Expired Company");
        window.location.replace("/Pharmacy/Pharmacy");
    </script>
}
