<style>
    #PrescriptionDate[readonly] {
        background-color: white;
        cursor: pointer !important;
    }

    .btn span.glyphicon {
        opacity: 0;
    }

    .btn.active span.glyphicon {
        opacity: 1;
    }
</style>
<div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
    <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
</div>
<div class="portlet box  green">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-gift"></i>Chronic
        </div>
        <div class="actions">
            <div class=" btn-group" data-toggle="buttons">
                <label id="Approval" class="btn" style="background: forestgreen;">
                    <input id="HasApproval" type="checkbox" autocomplete="off">
                    <span class="glyphicon glyphicon-ok"></span> Has Approval
                </label>
            </div>
    </div>
    </div>
    @*<h2 class="portlet-title" style="margin:1px;">Chronic</h2>*@
 

    <div class="portlet-body">
        <div class="table-responsive">
            <table class="table" id="First">
                <thead>
                    <tr>
                        <th><button id="AddAll" class="btn btn-primary">All</button></th>
                        <th>
                            @Html.DisplayNameFor(model => model.Id)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.MED_CODE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.MED_NAME)
                        </th>
                        @*<th>
                                @Html.DisplayNameFor(model => model.DOSAGE_FORM)
                            </th>*@
                        <th>
                            @Html.DisplayNameFor(model => model.DOSAGE_FORM)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.PACK_PRICE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.PACK_SIZE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.UNIT_NO)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.UNIT_PRICE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.DOSE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.MED_DURATION)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.NO_OF_UINT)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.TOTAL_AMT)
                        </th>

                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        if (item.NO_OF_UINT != 0)
                        {
                            <tr>
                                <td>
                                    <button id="Add" onclick="Add(this);" class="btn btn-primary">Dispense</button>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Id)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MED_CODE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MED_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DOSAGE_FORM)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Des_PACK_PRICE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PACK_SIZE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.UNIT_NO)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.UNIT_PRICE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DOSE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MED_DURATION)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.NO_OF_UINT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.TOTAL_AMT)
                                </td>


                            </tr>
                        }
                        else
                        {
                            continue;
                        }
                    }
                </tbody>

            </table>
        </div>
        @*Calc top*@
        <div id="Calc_top">
            <div id="CalcTop" class="inline">
                <div class="col-md-2 form-group">
                    <label class="control-label" for="Total">Total</label>
                    <input type="text" class="form-control" id="Total" readonly />
                </div>

                <div class="col-md-2 form-group">
                    <label class="control-label" for="OverInsurance">Over Insurance</label>
                    <input type="text" class="form-control" id="OverInsurance" readonly />
                </div>

                <div class="col-md-2 form-group">
                    <label for="CoPayment">Co Payment</label>
                    <input type="text" class="form-control" id="CoPayment" readonly />
                </div>
                <div class="col-md-2 form-group">
                    <label for="Credit">Credit</label>
                    <input type="text" class="form-control" id="Credit" readonly />
                </div>
                <div class="col-md-2 form-group">
                    <label for="Cash">Cash</label>
                    <input type="text" class="form-control" id="Cash" readonly />
                </div>
            </div>
        </div>
        <br /><br /><br />
        <br /> <div class="panel panel-info"><h2 class="panel-heading" style="margin:1px;"></h2> </div>

        @*secand grid*@
        <div class="table-responsive">
            <table class="table" id="Secand">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Id)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.MED_CODE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.MED_NAME)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.DOSAGE_FORM)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.PACK_PRICE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.PACK_SIZE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.UNIT_NO)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.UNIT_PRICE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.DOSE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.MED_DURATION)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.NO_OF_UINT)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.TOTAL_AMT)
                        </th>

                        <th>
                            <button id="RemoveAll" class="btn btn-danger">All</button>

                        </th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        @Html.Partial("_Edit")
        @*Calc down*@
        <div id="calc_down">
            <div id="CalcTop" class="inline">
                <div class="col-md-2 form-group">
                    <label class="control-label" for="Total2">Total</label>
                    <input type="text" class="form-control" id="Total2" readonly />
                </div>

                <div class="col-md-2 form-group">
                    <label class="control-label" for="OverInsurance2">Over Insurance</label>
                    <input type="text" class="form-control" id="OverInsurance2" readonly />
                </div>

                <div class="col-md-2 form-group">
                    <label for="CoPayment2">Co Payment</label>
                    <input type="text" class="form-control" id="CoPayment2" readonly />
                </div>
                <div class="col-md-2 form-group">
                    <label for="Credit2">Credit</label>
                    <input type="text" class="form-control" id="Credit2" readonly />
                </div>
                <div class="col-md-2 form-group">
                    <label for="Cash2">Cash</label>
                    <input type="text" class="form-control" id="Cash2" readonly />
                </div>
            </div>

        </div>
        <br /><br /><br />
        <!--Save-->
        <div style="padding:10px 0; text-align:right">

            <input id="Save" type="button" value="Save" class="btn btn-success" style="padding:10px 20px" />
        </div>
    </div>
</div>

@*AJAX*@
<script type="text/javascript" src="http://ajax.cdnjs.com/ajax/libs/json2/20110223/json2.js"></script>

