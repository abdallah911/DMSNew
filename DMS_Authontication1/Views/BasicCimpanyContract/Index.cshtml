<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Initialize select2 and DataTables
        $('.select2').select2();
        $('#table').DataTable();
        $('.table').DataTable();

        // Handle Independent input change
        $('input[name="Independent"]').on('change', function () {
            if ($('#noRadio').is(':checked')) {
                $('.compName-field').show();
                $('.compName').select2();
            } else {
                $('.compName-field').hide();
            }
        });

        // Handle formerclient input change
        $('input[name="formerclient"]').on('change', function () {
            if ($('#yesRadio2').is(':checked')) {
                $('#clientCompName').hide();
                $('#formerClientCompName').show();
            } else if ($('#noRadio2').is(':checked')) {
                $('#formerClientCompName').hide();
                $('#clientCompName').show();
            } else {
                $('#formerClientCompName').hide();
                $('#clientCompName').hide();
            }
        });

        // Handle insurance checkbox change
        $('#insurance').on('change', function () {
            if ($(this).is(':checked')) {
                $('#formerClient').css('display', 'flex');
            } else {
                $('#formerClientCompName').hide();
                $('#clientCompName').hide();
                $('#formerClient').hide();
            }
        });

        // Handle annualInstallment checkbox change
        $('#annualInstallment').on('change', function () {
            if ($(this).is(':checked')) {
                $('.annual-installment').show();
            } else {
                $('.annual-installment').hide();
            }
        });

        // Handle discountCard checkbox change
        $('#discountCard').on('change', function () {
            if ($(this).is(':checked')) {
                $('.discount-card').css('display', 'flex');
            } else {
                $('.discount-card').hide();
            }
        });

        // Handle recollectionType checkbox change
        $('#recollectionType').on('change', function () {
            if ($(this).is(':checked')) {
                $('.recollection-type').show();
            } else {
                $('.recollection-type').hide();
            }
        });

        // Handle checkType checkbox change
        $('#checkType').on('change', function () {
            if ($(this).is(':checked')) {
                $('.check-type').css('display', 'flex');
            } else {
                $('.check-type').hide();
            }
        });

        // Handle addDelIdentity dropdown change
        $('#addDelIdentity select').on('change', function () {
            if ($(this).find('option:selected').attr('name') === 'separateInvoice') {
                $('.add-del-dentity').show();
                $('#addDelIdentity').css('width', '50%');
            } else {
                $('#addDelIdentity').css('width', '100%');
                $('.add-del-dentity').hide();
            }
        });

        // Handle check-type dropdown change
        $('.check-type select').on('change', function () {
            if ($(this).find('option:selected').attr('name') === 'eachPeriod') {
                $('.check-type-input').show();
            } else {
                $('.check-type-input').hide();
            }
        });
    });
</script>
 