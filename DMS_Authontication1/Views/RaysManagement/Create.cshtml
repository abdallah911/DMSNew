@model DMS_Authontication1.Models.Serv_Ray

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}

<link href="~/assets/HomeTemplete/Content/css/select2.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs.css" rel="stylesheet" />
<link href="~/assets/HomeTemplete/css/introjs-modern.css" rel="stylesheet" />

<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>
<section class="container-fluid mt-4">
    <!--  New request -->
    <div class="row bg-overlay">
        <div style="position: relative"
             class="editeRquest fw-bold text-light">
            <div class="m-3 fs-3">
                <i class="fa fa-home me-3"></i>
                Create Ray
            </div>
            <div style=" position: absolute;right: 1%;top: 50%;transform: translateY(-50%);">
                <a href="/RaysManagement"
                   class="px-2 text-light border-0 mx-2 rounded-2"
                   style="
                  background: #83439b;
                  text-decoration: none;
                  cursor: pointer;
                  padding: 7.2px;">
                    <i class="fas fa-list"></i>
                    Rays List
                </a>
            </div>
        </div>
    </div>
</section>
<section class="print-claim-section mt-5">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="container">
            <div class="row mt-3">
                <div class="row row-cols-sm-3 m-auto m-sm-0">
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 mt-4 w-100">
                            <div class="row col-12 col-md-2 my-auto">
                                @Html.LabelFor(m => m.LAB_CODE, new { @class = "fw-bold" })
                            </div>
                            <div class="row col-12 col-md-6">
                                @Html.DropDownList("LAB_CODE", ViewBag.provider as SelectList, "--Select--", new { @class = "chronic-form-control", @style = "color: #000; font-size: 16px" })

                            </div>
                        </div>
                    }
                    <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 w-100 mt-4">
                        <div class="row col-12 col-md-2 my-auto">
                            @Html.LabelFor(m => m.SERV_CODE, new { @class = "fw-bold" })
                        </div>
                        <div class="row col-12 col-md-6">
                            @Html.EditorFor(model => model.SERV_CODE, new { htmlAttributes = new { @class = "chronic-form-control", @style = "font-size: 16px" } })
                            @Html.ValidationMessageFor(model => model.SERV_CODE, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 w-100 mt-4">
                            <div class="row col-12 col-md-2 my-auto">
                                @Html.LabelFor(m => m.DMS_CODE, new { @class = "fw-bold" })
                            </div>
                            <div class="row col-12 col-md-6">
                                @Html.EditorFor(model => model.DMS_CODE, new { htmlAttributes = new { @class = "chronic-form-control", @style = "font-size: 16px", @onfocusout = "OnChangeEvent();", @Value = "0" } })
                                @Html.ValidationMessageFor(model => model.DMS_CODE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    }
                    <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 w-100 mt-4">
                        <div class="row col-12 col-md-2 my-auto">
                            @Html.LabelFor(m => m.SERV_ANAME, new { @class = "fw-bold" })
                        </div>
                        <div class="row col-12 col-md-6">
                            @Html.EditorFor(model => model.SERV_ANAME, new { htmlAttributes = new { @class = "chronic-form-control", @style = "font-size: 16px" } })
                            @Html.ValidationMessageFor(model => model.SERV_ANAME, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 w-100 mt-4">
                        <div class="row col-12 col-md-2 my-auto">
                            @Html.LabelFor(m => m.SERV_AMOUNT, new { @class = "fw-bold" })
                        </div>
                        <div class="row col-12 col-md-6">
                            @Html.EditorFor(model => model.SERV_AMOUNT, new { htmlAttributes = new { @class = "chronic-form-control", @style = "font-size: 16px" } })
                            @Html.ValidationMessageFor(model => model.SERV_AMOUNT, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 mt-4 w-100">
                        <div class="row col-12 col-md-2 my-auto">
                            @Html.LabelFor(m => m.GRUOP_ID, new { @class = "fw-bold" })
                        </div>
                        <div class="row col-12 col-md-6">
                            @Html.DropDownList("GRUOP_ID", ViewBag.Groups as SelectList, "--Select--", new
                       {
                           @class = "chronic-form-control",
                           @style = "color: #000; font-size: 16px"
                       })
                        </div>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="forLabel d-flex justify-content-start flex-column flex-md-row gap-md-5 mt-4 w-100">
                            <div class="row col-12 col-md-2 my-auto">
                                @Html.LabelFor(m => m.GRUOP_TYPE, new { @class = "fw-bold" })
                            </div>
                            <div class="row col-12 col-md-6">
                                @Html.DropDownList("GRUOP_TYPE", ViewBag.GroupType as SelectList, "--Select--", new { @class = "chronic-form-control", @style = "color: #000; font-size: 16px" })

                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="print-claims-btns d-flex mt-5 justify-content-end">
                <input id="Back" type="button" value="Back" onclick="window.location.replace('/RaysManagement/index');" class="btn claims-search-btn ms-2 rounded-3; fs-5" style="text-decoration: none; background-color: #717382" />
                <input id="New" type="reset" value="Reset" class="btn claims-search-btn ms-2 rounded-3; fs-5" style="background-color: #717382" />
                <input id="submit1" type="submit" value="Create" class="btn claims-search-btn ms-2 rounded-3; fs-5" style="background-color: #717382" />

            </div>
        </div>
    }
</section>


@if (ViewBag.exsit == "exsit")
{
    <script type="text/javascript">
        alert("كود الخدمة مسجل من قبل");
    </script>

}
<script>
    $("#LAB_CODE").select2();
    $("#GRUOP_ID").select2();
    if ($("#DMS_CODE").val() == "")
        $("#DMS_CODE").val("0");
    function OnChangeEvent() {
        debugger;

        if ($("#DMS_CODE").val() == "")
            $("#DMS_CODE").val("0");

    }
</script>