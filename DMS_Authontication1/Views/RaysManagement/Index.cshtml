@model IEnumerable<DMS_Authontication1.Models.Serv_Ray>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}

<section class="container-fluid mt-4">
    <!--  New request -->
    <div class="row bg-overlay">
        <div style="position: relative"
             class="editeRquest fw-bold text-light">
            <div class="m-3 fs-3">
                <i class="fa-solid fa-home me-1"></i>
                Rays List
            </div>
            <div style=" position: absolute;right: 1%;top: 50%;transform: translateY(-50%);">
                <a href="/RaysManagement/create"
                   class="btn fw-bold text-white rounded-3"
                   style="
                 
                  text-decoration: none;
                  cursor: pointer;
                  padding: 7.2px;">
                    <i class="fas fa-plus"></i>
                    Create Ray
                </a>
            </div>
        </div>
    </div>
</section>

<div class="sios-bg w-100 m-auto px-4 my-4 pb-5">
    <div class="table-responsive">
        <table id="Index" class="table table-striped mt-3 text-center">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.LAB_CODE)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SERV_CODE)
                    </th>

                    <th>
                        @Html.DisplayNameFor(model => model.SERV_ANAME)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SERV_AMOUNT)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.GRUOP_NAME)
                    </th>

                    <th>
                        @Html.DisplayNameFor(model => model.GRUOP_TYPE)
                    </th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
<script src="~/assets/NewDesignBackAdmin/JS/jquery.min.js"></script>
<script>

    $(function () {
        $("#Index").DataTable({
            "sAjaxSource": '/RaysManagement/RayList',
            "bServerSide": true,
            "processing": true,
            "bFilter": true,
            "bSort": false,
            "pageLength": 10,
            "bInfo": true,
            "columns": [
                { "data": "LAB_CODE", "name": "LAB_CODE" },
                { "data": "SERV_CODE", "name": "SERV_CODE" },
                { "data": "SERV_ANAME", "name": "SERV_ANAME" },
                { "data": "SERV_AMOUNT", "name": "SERV_AMOUNT" },
                { "data": "GRUOP_NAME", "name": "GRUOP_NAME" },
                { "data": "GRUOP_TYPE", "name": "GRUOP_TYPE" },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        return '<a class="btn py-1 px-3 rounded-1 text-light border-0"  href="/RaysManagement/Edit/?id=' + data + '">Edit</a>';
                    }
                },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        return '<a class="btn py-1 px-3 rounded-1 text-light border-0"  href="/RaysManagement/Delete/?id=' + data + '"> Delete</a>'
                    }
                }

            ]

        });
        $("#Index").DataTable();

    });
</script>

