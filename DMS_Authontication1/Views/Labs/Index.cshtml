@model IEnumerable<DMS_Authontication1.Models.Roshita>
@using Microsoft.AspNet.Identity;
@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    if (User.IsInRole("Admin"))
    {

        var modellist = new List<ModulesPagesViewModel>();
        var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
        if (claim != null)
        {
            modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
            if (modellist != null)
            {
                var obj = modellist.Where(x => x.ModuleName == "Pharmacies Management" && x.PageId == 4 && (x.FullControl || x.EditPermission
                                              || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
                if (obj != null)
                {
                    edit = obj.EditPermission;
                    delete = obj.ActivationControl;
                    view = obj.Preview;
                    fullcontroll = obj.FullControl;

                }
            }
        }

    }
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<div class="sios-container">
    @if (!User.IsInRole("Admin"))
    {

        <div class="sios-overlay container-fluid mt-4">
            <div class="container">
                <i class="fa-solid fa-house"></i>
                <h3>Print Claims</h3>
            </div>
        </div>

        <section class="print-claim-section">
            <form name="formValidation"
                  id="formValidation"
                  action="Pharmacy_claims.html">
                <div class="container">
                    <div class="row">
                        <div class="row row-gap-2 row-cols-sm-3 m-auto m-sm-0">
                            <div class="forLabel">
                                <input class="admin-form-control  " type="date" name="From" id="From" required="required" />
                                <span style="left:3px" for="From">From</span>
                            </div>
                            <div class="forLabel">
                                <input class="admin-form-control  " type="date" name="To" id="To" required="required" />
                                <span style="left:3px" for="To">To</span>
                            </div>
                            <div class="forLabel">
                                <input class="admin-form-control  " type="Number" name="LabsApprovalNo" id="LabsApprovalNo" required="required" />
                                <span style="left:3px" for="LabsApprovalNo">ApprovalNo.</span>
                            </div>
                            <div class="forLabel">
                                <input class="admin-form-control  " type="text" id="LabsCardId" name="LabsCardId" required="required" />
                                <span style="left:3px" for="LabsCardId">Card ID</span>
                            </div>
                            @if (User.IsInRole("Lab_Admin"))
                            {
                                <div class="forLabel">
                                    @Html.DropDownList("ddlUsers", null, "All", htmlAttributes: new { @class = "admin-form-control  ", @id = "ddlUsers" })

                                    <span style="left:3px" for="Select Group">Select User</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </form>
        </section>
    }
    @if (User.IsInRole("Admin") && (edit || delete || view || fullcontroll))
    {
        <input id="edit" value="@edit.ToString()" hidden />
        <input id="delete" value="@delete.ToString()" hidden />
        <input id="view" value="@view.ToString()" hidden />
        <input id="fullcontroll" value="@fullcontroll.ToString()" hidden />
        <div class="sios-overlay container-fluid mt-4">
            <div class="m-3 fs-3 d-flex gap-1 text-white">
                <i class="fa-solid fa-house"></i>
                <h3>Admin Search</h3>
            </div>
        </div>

        <section class="print-claim-section">
            <form name="formValidation"
                  id="formValidation"
                  action="Pharmacy_claims.html">
                <div class="container">
                    <div class="row">
                        <div class="row row-gap-2 row-cols-sm-3 m-auto m-sm-0">
                            <div class="forLabel">
                                <input class="admin-form-control  " type="text" name="AdminFrom" id="AdminFrom" required="required" />
                                <span style="left:3px" for="From">From</span>
                            </div>
                            <div class="forLabel">
                                <input class="admin-form-control  " type="text" name="AdminTo" id="AdminTo" required="required" />
                                <span style="left:3px" for="To">To</span>
                            </div>
                            <div class="forLabel">
                                <input class="admin-form-control  " type="text" name="Provider" id="Provider" required="required" />
                                <span style="left:3px" for="provider">Provider</span>
                            </div>
                            <div class="forLabel">
                                <input class="admin-form-control  " type="text" name="Company" id="Company" required="required" />
                                <span style="left:3px" for="company">Company</span>
                            </div>
                            <div class="forLabel">
                                <input class="admin-form-control  " type="Number" name="ApprovalNo" id="ApprovalNo" required="required" />
                                <span style="left:3px" for="ApprovalNo">ApprovalNo.</span>
                            </div>
                            <div class="forLabel">
                                <input class="admin-form-control  " type="text" name="Branch" id="Branch" required="required" />
                                <span style="left:3px" for="branch">Branch</span>
                            </div>
                            <div class="forLabel">
                                <input class="admin-form-control  " type="text" name="CardId" id="CardId" required="required" />
                                <span style="left:3px" for="CardID">Card ID</span>
                            </div>
                        </div>
                    </div>
                    <div class="print-claims-btns d-flex gap-2 mt-3 ">
                        <input id="resetSearch" type="button" value="Reset" onclick="ClearSearchData();" class="btn fw-bold text-white rounded-3" />
                        <input id="adminSearch" type="button" value="Search" class="btn fw-bold text-white rounded-3 " />

                    </div>
                </div>
            </form>
        </section>
    }
    <div class="portlet box  green">
        <div class="sios-overlay container-fluid mt-4 portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa fa-gift me-3"></i>Claims
            </div>

        </div>
        <div class="sios-bg container-fluid my-4">
            <div class="table-responsive mx-lg-5 portlet-body">

                <table class="table table-striped mt-3 text-center ui celled table" id="Index" width="100%">
                    <thead>
                        <tr>

                            <th>
                                Approval No
                            </th>
                            <th>
                                Card Id
                            </th>
                            <th>
                                Company Percent
                            </th>
                            <th>
                                Total Value
                            </th>
                            <th>
                                Manager
                            </th>

                            <th>
                                CreatedBy
                            </th>

                            <th>
                                CreatedDate
                            </th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>

                </table>
            </div>
        </div>
    </div>
    @if (User.IsInRole("Admin") && fullcontroll)
    {
        <div class="portlet box  green">
            <div class="sios-overlay container-fluid my-4 portlet-title">
                <div class="m-3 fs-3 text-white caption">
                    <i class="fa fa-gift me-3"></i>Admin Count
                </div>
            </div>
            <div class="sios-bg container-fluid my-4">
                <div class="table-responsive mx-lg-5 portlet-body">
                    <table class="table table-striped mt-3 text-center ui celled table" id="Counts" width="100%">
                        <thead>
                            <tr>
                                <th>
                                    Count
                                </th>
                                <th>
                                    Total Value
                                </th>
                                <th>
                                    Company Payment
                                </th>
                                <th>
                                    Person Payment
                                </th>
                                <th>
                                    Cash
                                </th>

                                <th>
                                    Over Insurance
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    0
                                </td>
                                <td>
                                    0
                                </td>
                                <td>
                                    0
                                </td>
                                <td>
                                    0
                                </td>
                                <td>
                                    0
                                </td>
                                <td>
                                    0
                                </td>

                            </tr>
                        </tbody>

                    </table>
                </div>
            </div>
        </div>

    }
</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/Labs/LabIndex.js?V=1.3"></script>

