@model IEnumerable<DMS_Authontication1.Models.Roshita>
@using Microsoft.AspNet.Identity;
@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    if (User.IsInRole("Admin"))
    {

        var modellist = new List<ModulesPagesViewModel>();
        var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
        if (claim != null)
        {
            modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
            if (modellist != null)
            {
                var obj = modellist.Where(x => x.ModuleName == "Pharmacies Management" && x.PageId == 4 && (x.FullControl || x.EditPermission
                                              || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
                if (obj != null)
                {
                    edit = obj.EditPermission;
                    delete = obj.ActivationControl;
                    view = obj.Preview;
                    fullcontroll = obj.FullControl;

                }
            }
        }

    }
    ViewBag.Title = "Index";
}
<div class="dms-container">
    @if (!User.IsInRole("Admin"))
    {
        <div class="portlet box ">
            <div class="portlet-title  title-bg text-white fw-bold">
                <div class="caption">
                    <i class="fa-solid fa-home"></i>Print Claims
                </div>
            </div>
            <div class="portlet-body">
                <div class="row">
                    <div class="col-md-2">
                        <input id="From" type="text" class="col-md-2 form-control " placeholder="From" />
                    </div>
                    <div class="col-md-2">
                        <input id="To" type="text" class="col-md-2 form-control " placeholder="To" />
                    </div>
                    <div class="col-md-2">
                        <input id="LabsApprovalNo" type="text" class="col-md-2 form-control " placeholder="ApprovalNo" />
                    </div>
                    <div class="col-md-2">
                        <input id="LabsCardId" type="text" class="col-md-2 form-control " placeholder="Card ID" />
                    </div>
                    <div class="col-md-2">
                        @Html.DropDownList("comphoder", null, htmlAttributes: new { @class = "form-control", @id = "comphoder" })
                    </div>
                    @if (User.IsInRole("Lab_Admin"))
                    {
                        <div class="col-md-2">
                            @Html.DropDownList("ddlUsers", null, "All", htmlAttributes: new { @class = "form-control", @id = "ddlUsers" })
                        </div>
                    }
                </div>
                <br />
                <div class="row" style=" text-align:right">
                    <div class="col-md-12">
                        <input id="LabsResetSearch" type="button" value="Reset" onclick="ClearLabsSearchData();" class="btn btn-warning" />
                        <input id="Print" type="button" value="Print" class="btn btn-primary fa fa-file-pdf-o" />
                        <input id="LabsAdminSearch" type="button" value="Search" class="btn btn-default  fa fa-search" />

                    </div>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole("Admin") && (edit || delete || view || fullcontroll))
    {
        <div class="portlet box   ">
            <div class="portlet-title title-bg">
                <div class="caption">
                    <i class="fa fa-"></i>Admin Search
                </div>
            </div>
            <div class="portlet-body">
                <input id="edit" value="@edit.ToString()" hidden />
                <input id="delete" value="@delete.ToString()" hidden />
                <input id="view" value="@view.ToString()" hidden />
                <input id="fullcontroll" value="@fullcontroll.ToString()" hidden />

                <div class="row" style="padding-bottom: 15px;">
                    <div class="col-md-2">
                        <input id="AdminFrom" type="text" class="col-md-2 form-control " placeholder="From" />
                    </div>
                    <div class="col-md-2">
                        <input id="Provider" type="text" class="col-md-2 form-control " placeholder="Provider" />
                    </div>
                    <div class="col-md-2">
                        <input id="Company" type="text" class="col-md-2 form-control " placeholder="Company" />
                    </div>
                    <div class="col-md-2">
                        <input id="ApprovalNo" type="text" class="col-md-2 form-control " placeholder="ApprovalNo" />
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-2">
                        <input id="AdminTo" type="text" class="col-md-2 form-control " placeholder="To" />
                    </div>
                    <div class="col-md-2">
                        <input id="Branch" type="text" class="col-md-2 form-control " placeholder="Branch" />
                    </div>
                    <div class="col-md-2">
                        <input id="CardId" type="text" class="col-md-2 form-control " placeholder="Card ID" />
                    </div>
                    <div class="col-md-2">
                        @Html.DropDownList("comphoder", null, htmlAttributes: new { @class = "form-control", @id = "comphoder" })
                    </div>
                </div>
                <div style=" text-align:right">
                    <input id="resetSearch" type="button" value="Reset" onclick="ClearSearchData();" class="btn btn-warning" />
                    <input id="adminSearch" type="button" value="Search" class="btn btn-primary fa fa-search" />
                </div>
            </div>
        </div>
    }
    <div class="portlet box  ">
        <div class="portlet-title title-bg text-white fw-bold">
            <div class="caption">
                <i class="fa-solid fa- "></i>Claims
            </div>

        </div>
        <div class="portlet-body">

            <table class="ui celled table" id="Index" width="100%">
                <thead>
                    <tr>

                        <th>
                            Approval No
                        </th>
                        <th>
                            Card Id
                        </th>
                        <th>
                            Company Percent
                        </th>
                        <th>
                            Total Value
                        </th>
                        <th>
                            Manager
                        </th>

                        <th>
                            CreatedBy
                        </th>

                        <th>
                            CreatedDate
                        </th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>

            </table>
        </div>
    </div>
    @if (User.IsInRole("Admin") && fullcontroll)
    {
        <div class="portlet box   ">
            <div class="portlet-title title-bg">
                <div class="caption">
                    <i class="fa fa-"></i>Admin Count
                </div>
            </div>
            <div class="portlet-body">
                <table class="ui celled table" id="Counts" width="100%">
                    <thead>
                        <tr>
                            <th>
                                Count
                            </th>
                            <th>
                                Total Value
                            </th>
                            <th>
                                Company Payment
                            </th>
                            <th>
                                Person Payment
                            </th>
                            <th>
                                Cash
                            </th>

                            <th>
                                Over Insurance
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                0
                            </td>
                            <td>
                                0
                            </td>
                            <td>
                                0
                            </td>
                            <td>
                                0
                            </td>
                            <td>
                                0
                            </td>
                            <td>
                                0
                            </td>

                        </tr>
                    </tbody>

                </table>
            </div>

        </div>

    }
</div>
<br />
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/Labs/LabIndex.js?V=1.3"></script>
