@model IEnumerable<DMS_TEST.ViewModel.Roshita_RoshitaDetails>
    @{
    ViewBag.Title = "Pending";
    }
    <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
    @Html.Partial("_Approvals")
    <div class="container">
        <div class="panel panel-info">
            <h2 class="panel-heading" style="margin:1px;">Pending</h2>
            <div class="panel-body">
                <div class="input-group col-md-3">
                    <span class="input-group-addon"><i class="glyphicon glyphicon-search"></i></span>
                    <input id="txtSearchApproval" class="form-control" placeholder="Click To Search">
                </div>
                <table class="table" id="Index">
                    <thead>
                        <tr>
                            <th scope="col">Approval Id</th>
                            <th scope="col">Id</th>
                            <th scope="col" align="center">Name</th>
                            <th scope="col">Amount</th>
                            <th scope="col">Medical Reply</th>
                            <th scope="col">IsDealed</th>
                            <th></th>
                        </tr>

                    </thead>
                    <tbody></tbody>
                </table>
                <div class="row">

                    <div class="col-md-3">
                        <label class="control-label">Total Amount</label>
                        <input id="TotalAmount" disabled class="form-control col-md-3" />
                    </div>

                    @*<div class="col-md-3">
                        <label class="control-label">Cash</label>
                        <input id="Cash" disabled class="form-control col-md-3" />
                    </div>*@


                </div>
                <br />
                @*<div class="panel-footer" style="text-align:right;">
                    <a id="Print" href="#" class="btn btn-success glyphicon glyphicon-print " disabled> Print</a>


                </div>*@
            </div>
        </div>
    </div>
    <script>
    var url = window.location.href;
    var CardId = url.substring(url.lastIndexOf('=') + 1);
    var CompanyPayment;
    var AnuualLimit;
    $(function () {
        $('#txtSearchApproval').click(function () {
            $('#TotalAmount').val('0');
            $('#Cash').val('0')
            $.ajax({
                url: '/Pharmacy/approvals/',
                data: { id: CardId },
                dataType: 'json',
                success: function (r) {
                    var setData = $("#Approvals Tbody");
                    setData.empty();

                    for (var i = 0; i < r.length; i++) {
                        if (r[i].CreatedDate != null) {
                            var MyDate_String_Value = r[i].CreatedDate;
                            var value = new Date
                                (
                                parseInt(MyDate_String_Value.replace(/(^.*\()|([+-].*$)/g, ''))
                                );
                            var dat = value.getDate() + "/" + (value.getMonth() + 1) + "/" + value.getFullYear();
                        }
                        else {
                            dat = null;

                        }
                        var data = "<tr >" +
                            "<td >" + "<Button  class='btn btn-Primary glyphicon glyphicon-ok' onclick='Select(this);'></Button>" + "</td>" +
                            "<td>" + r[i].Id + "</td>" +
                            "<td>" + dat + "</td>"

                        "</tr>"
                        setData.append(data);

                    }
                    $('#Approvals').DataTable();
                    $('#ApprovalsModal').modal();
                },
                error: function (r) {
                    alert(':(')
                }

            });

        });
        $.ajax({
            type: "POST",
            dataType: "json",
            url: '/Labs/CellingAmount',
            data: {
                id: CardId,
                ServiceCode: '11206'
            },
            success: function (r) {
                if (r.Validation == false) {
                   // toastr.info("Exceeded his annual contract limit");
                    toastr.info(r.Message);
                    window.location.replace("/Labs/Lab");
                } else {
                    CompanyPayment = r.CeilingPert;
                    AnuualLimit = r.Limit;
                    //   $("#no_data_yet").val(100 - $("#ddEmp_CEILING_PERT").val());

                }
            },
            error: function (err) {
                alert("No Company Annual Amount");
                location.reload();
            }
        });
        $('#Print').click(function () {

            var PentingPrintViewModels = new Array();
            $('#Index TBODY TR').each(function () {
                var row = $(this);
                if (row.find("TD").eq(5).html() == "true" && row.find("TD").eq(6).html().search("disabled") == -1) {
                    var PentingPrintViewModel = {};
                    PentingPrintViewModel.Id = parseFloat(row.find("TD").eq(1).html());
                    PentingPrintViewModel.Amount = $('#TotalAmount').val();
                    PentingPrintViewModel.Cash = $('#Cash').val();
                    PentingPrintViewModels.push(PentingPrintViewModel);
                }
            });

            var params = JSON.stringify(PentingPrintViewModels);
            window.open('/Pharmacy/PendingReport?id=' + params);
        });
    });
    function SelectDealed(button) {
        var row = $(button).closest("TR");
        var ApprovalId = $("TD", row).eq(1).html();
        ApprovalId = parseInt(ApprovalId);
        //debugger;
        $.ajax({
            type: 'POST',
            url: '/Pharmacy/ChangeStatus2',
            dataType: 'Json',
            data: {
                ApprovalId: ApprovalId,
                status: $(button).val()
            },
            dataType: 'Json',
            success: function (r) {
                if ($(button).val() != "N" && r != -2) {
                    $("TD", row).eq(5).html($(button).val());
                    // $("#ChangeStatus").prop('disabled', 'disabled');

                    //if ($(button).val() == "false") {
                    //    $("TD", row).eq(4).html('Accepted');
                    //}
                    toastr.success("Saved");
                    Calculation();

                } else if (r == -2) { toastr.info("Dispensed before"); }

            },
            error: function () {
                alert("Error Retrieve");
            }
        });


    }
    function Calculation() {
        var sum = 0;
        var Cash = 0;
        // debugger;
        $('#Index TBODY TR').each(function () {
            var row = $(this);
            if (row.find("TD").eq(5).html() == "true" && row.find("TD").eq(6).html().search("disabled") == -1) {
                if (row.find("TD").eq(4).html() == "Accepted") {
                    sum += parseFloat(row.find("TD").eq(3).html());
                }
                else if (row.find("TD").eq(4).html() == "Rejected") {
                    Cash += parseFloat(row.find("TD").eq(3).html());
                }
            }
        });
        var person = parseFloat(100 - CompanyPayment);//percentage
        Cash += parseFloat(sum * (person / 100));
        if (Cash > 0 || sum > 0)
            $('#Print').attr("disabled", false);
        else {
            $('#Print').attr("disabled", true);
        }
        $('#TotalAmount').val(sum);
        $('#Cash').val(Cash);
    }
    </script>
