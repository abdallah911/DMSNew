@model IEnumerable<DMS_TEST.ViewModel.DoctorContainerViewModel>

@{
    ViewBag.Title = "Details";
}
<div style="padding-left: 93px;">
    <h2>Details</h2>

    <p>
        <a id="Backbutton" href="/Labs/index" ><i class=" btn btn-primary glyphicon glyphicon-arrow-left">  Back</i> </a>
    </p>
    <table class="table">
        <tr>
            @*<th>
                    @Html.DisplayNameFor(model => model.Roshita.CardId)
                </th>*@
            <th>
                Test Code
            </th>
            <th>
                Test Name
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentGroup)
            </th>
            @*<th></th>*@
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                @*<td>
                        @Html.DisplayFor(modelItem => item.Roshita.CardId)
                    </td>*@
                <td>
                    @Html.DisplayFor(modelItem => item.MedicienCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MedicienName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Amount)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PaymentGroup)
                </td>
                @*<td>
                    <a id="Edit" class="btn btn-warning">Edit</a>|
                        @Html.ActionLink("Delete", "MedDelete", new { id=item.Id }, htmlAttributes: new { @class = "btn btn-danger", @id = "Delete" })
                    </td>*@
            </tr>
        }

    </table>
</div>

