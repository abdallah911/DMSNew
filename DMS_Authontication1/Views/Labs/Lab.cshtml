<!--Dynamic table-->
<div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;z-index:100000;">
    <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
</div>
<!--Card Id Row-->
<div class="portlet box   ">
    <div class="portlet-title title-bg">
        <div class="caption">
            <i class="fa fa-gift"></i>labratory
        </div>
        <div class="actions">
            <a id="Pending" href="javascript:;" class="btn bg-white dms-color btn-sm" disabled>
                <i class="fa fa-pencil"></i> Pending
            </a>
        </div>
    </div>
    <div hidden>
        <input id="IsFamily" name="IsFamily" value="" />
        <input id="IsPool" name="IsPool" value="" />
    </div>
    <br />
    <div class="portlet-body">
        <div class="row">
            <div class="form-group row row-cols-sm-3">
                <div class=" " data-step="1" data-hint='Step one!' data-intro="Enter Card ID">
                    <input id="txtSearchCard" type="text" placeholder="search for card..." class="form-control" />
                </div>
                <div class=" " data-step="2" data-intro="click Search">
                    <button id="Search" type="button" class="btn btn-primary">
                        <span class="glyphicon glyphicon-search"></span> Search
                    </button>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <div class=" ">
                        @Html.DropDownList("ddlUsers", null, htmlAttributes: new { @class = "form-control", @id = "ddlUsers" })
                    </div>
                }
            </div>
        </div><br />
        @Html.Partial("_Cards")
        <div class="panel panel-info d-flex flex-column">

            <h2 class="panel-heading" style="margin:1px;">Card ID</h2>
            <div class="panel-body">
                <div class="row">
                    <div class="row row-cols-sm-2 row-cols-md-3 row-cols-lg-4 d-flex row-gap-2 mx-auto mb-2 form-group">


                        @*<div class="forLabel">
                    @Html.LabelFor(model => model.contractComp.C_ANAME, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.contractComp.C_ANAME, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                </div>*@
                        <div class="forLabel">
                            @Html.EditorFor(model => model.compEmp.EMP_ANAME, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                            <span>
                                @Html.LabelFor(model => model.compEmp.EMP_ANAME, htmlAttributes: new { @class = "control-label" })
                            </span>
                        </div>
                        <div class="forLabel">
                            @Html.EditorFor(model => model.compEmp.INS_END_DATE, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                            <span>@Html.LabelFor(model => model.compEmp.INS_END_DATE, htmlAttributes: new { @class = "control-label" })
                            </span>
                        </div>

                        <div class="forLabel" data-step="4" data-intro="Enter speciality ">
                            @Html.DropDownList("ddlSpeciality", null, htmlAttributes: new { @class = "form-control", @id = "ddlSpeciality" })
                            <span>@Html.LabelFor(model => model.speciality.special_Aname, htmlAttributes: new { @class = "control-label" })
                            </span>
                        </div>
                        <div class="forLabel" data-step="5" data-intro="Select Diagnoises">
                            <select id="ddlDiagnoises"required style="width:100%" multiple></select>
                            <span>@Html.Label("Diagnoise", new { @class = "control-label" })
                            </span>
                        </div>
                        @*<div class="forLabel" data-step="6" data-intro="Comment optional">

                    @Html.Label("Comment", htmlAttributes: new { @class = "control-label" })
                    <div class="form-group shadow-textarea">
                        <textarea id="Comments" style="height: 31px;" type="text" class="form-control" name="Comments" placeholder="" value=""></textarea>
                    </div>
                </div>*@


                    </div>
                </div>

                <div class="row row-cols-sm-2 row-cols-md-3 row-cols-lg-4 d-flex row-gap-2 mx-auto mb-2 form-group">

                    <div class="forLabel">
                        @Html.EditorFor(model => model.Co_insurance.INSURANCE_DAY_LAB, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                    <span>
                            @Html.LabelFor(model => model.Co_insurance.INSURANCE_DAY_LAB, htmlAttributes: new { @class = "control-label" })
                    </span>
                    </div>
                    @*<div class="forLabel">
                @Html.LabelFor(model => model.Co_insurance.INSURANCE_MONTH_LAB, htmlAttributes: new { @class = "control-label" })
                @Html.EditorFor(model => model.Co_insurance.INSURANCE_MONTH_LAB, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
            </div>*@

                    <div class="forLabel">
                         @Html.EditorFor(model => model.ddEmp.CEILING_PERT, new { htmlAttributes = new { @class = "form-control", @ReadOnly = "true" } })
                        <span>@Html.LabelFor(model => model.ddEmp.CEILING_PERT, htmlAttributes: new { @class = "control-label" })
                       </span>
                    </div>
                    <div class="forLabel" data-step="3" data-intro="Enter Preception Date">
                       @Html.Editor("PrescriptionDate", new { htmlAttributes = new { @class = "form-control",required="true", @title = "لابد ان يكون ف اخر 14 ايام " } })
                        <span> @Html.Label("Prescription Date", htmlAttributes: new { @class = "control-label", @title = "لابد ان يكون ف اخر 14 ايام " })
                        </span>
                    </div>

                    <div class="forLabel" data-step="3" data-intro="Enter Phone with 11 Number " id="phone">
                        @Html.Editor("PhoneNumber", new { htmlAttributes = new { @class = "form-control", @id = "PhoneNumber", required = "required", @onkeypress = "return /[0-9]/i.test(event.key)" } })
                        <span>
                            @Html.Label("Phone Number", htmlAttributes: new { @class = "control-label" })
                        </span>
                    </div>
                    <div class="forLabel" data-step="4" data-intro="Enter Clame Number">
                        @Html.Editor("ClaimNumber", new { htmlAttributes = new { @class = "form-control", @id = "ClaimNumber", @required = "required", @onkeypress = "return /[0-9]/i.test(event.key)" } })
                        <span>
                            @Html.Label("Claim Number", htmlAttributes: new { @class = "control-label" })
                        </span>
                    </div>
                    <div class="forLabel">
                        @Html.EditorFor(model => model.compEmp.CompHolderName, new { htmlAttributes = new { @style = "border-color:red", @class = "fw-bold form-control", @ReadOnly = "true" } })
                        <span>@Html.LabelFor(model => model.compEmp.CompHolderName, htmlAttributes: new { @class = "control-label" })
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel panel-info d-flex flex-column">

            <h2 class="panel-heading" style="margin:1px;">Chemical Analysis</h2>
            <div class="panel-body">
                <!--Search Medicine-->
                <div class="row">
                    <div class="col-sm-12" data-step="7" data-intro="Select Test to Despense">
                        <select id="AddLab" multiple="multiple" style="width:100%">
                            <option value="0">Select Test</option>
                        </select>
                    </div>
                </div>
                <!--Dynamic table-->
                <div id="wait" style="display:none;width:69px;height:89px;position:absolute;top:50%;left:50%;padding:2px;">
                    <img src='/Content/images/demo_wait.gif' width="64" height="64" /><br>Loading...
                </div>
                <div class="container-fluid">
                    <div class="master">
                        <div class="table-responsive">
                            <table class="table" id="Lab">
                                <thead>
                                    <tr>
                                        <th class="col-md-3">Lab Code</th>
                                        <th class="col-md-3">Lab Name</th>
                                        <th class="col-md-3">Amount</th>
                                        <th class="col-md-3">Group</th>
                                        @*<th scope="col">&nbsp;</th>*@
                                    </tr>
                                </thead>
                                <tbody></tbody>

                            </table>
                        </div>
                        <!--Caculation-->

                        <div class="row row-cols-sm-2 row-cols-lg-3 d-flex row-gap-2 mx-auto mt-3 ">
                            <div class="forLabel">
                                <input id="txtTotalInvoice" type="text" class="form-control" ReadOnly="readonly" />
                                <span>
                                    <label class="control-label">Total</label>
                                </span>
                            </div>
                            <div class="forLabel">
                                <input id="txtTotalCopayment" type="text" class="form-control" ReadOnly="readonly" />
                                <span>
                                    <label class="control-label">Person Payments</label>
                                </span>
                            </div>
                            <div class="forLabel">
                                <input id="txtValueCredit" type="text" class="form-control" ReadOnly="readonly" />
                                <span>
                                    <label class="control-label">Value Credit</label>
                                </span>
                            </div>
                            <div class="forLabel">
                                <input id="txtOverInsurance" type="text" class="form-control" ReadOnly="readonly" />
                                <span>
                                    <label class="control-label">Over Insurance</label>
                                </span>
                            </div>
                            <div class="forLabel">
                                <input id="txtCash" type="text" class="form-control" ReadOnly="readonly" />
                                <span>
                                    <label class="control-label">Cash</label>
                                </span>
                            </div>
                            <div class="forLabel">
                                <input id="txtValueCash" type="text" class="form-control" ReadOnly="readonly" />
                                <span>
                                    <label class="control-label">Total cash</label>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="panel-footer d-flex justify-content-between my-3 px-3" style="text-align:right;">
                <div class="d-flex gap-2">
                    <input data-step="10" data-intro="Help" id="Help" type="button" value="Help" class="btn btn-info" />
                    <a data-step="11" class="btn btn-primary" href="@Url.Action("GetFile","Pharmacy",new { fileName = "Pharmacy" })" download="PharmacyManual.pdf"><i class="fa fa-download"></i> Manual</a>
                </div>
                @*<input data-step="11" data-intro="Help" style="float: left;" id="Manual" type="button" value="Manual" class="btn btn-info" />*@
                <div class="d-flex gap-2">
                    <input data-step="11" data-intro="Reset Medicine" id="reset" type="button" value="Reset" onclick="ClearMedicineData();" class="btn btn-warning" />
                    <input data-step="12" data-intro="Save Preception" id="submit" type="button" value="Dispense" class="btn btn-success" />
                </div>
            </div>
        </div>

    </div>
</div>


@*scripts*@
<script src="~/assets/HomeTemplete/js/intro.js"></script>

<script src="~/Scripts/DMS/Labs/Lab.js?V=4.7"></script>
