<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script>
    $(function () {
     
        $("#Employees").DataTable({
            "sAjaxSource": '/CompEmployees/EmployeesList',
            "bServerSide": true,
            "processing": true,
            "bFilter": true,
            "bSort": false,
            "pageLength": 10,
            "bInfo": true,
            "columns": [
                { "data": "CARD_ID" },
                { "data": "EMP_ENAME" },
                { "data": "CONTRACT_NO" },
                { "data": "EMP_ID" },
                { "data": "TEL1" },
                { "data": "TEL2" },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        //return '<a href="/CompEmployees/Edit/' + data + '">Edit</a>';
                        return '<a class="btn btn-warning" style = " text-transform: none" href="/CompEmployees/Edit/' + data + '">Edit</a>';

                    }
                },
                {
                    "data": "Id",
                    "mRender": function (data) {
                        //data = data.toString().slice(8);//remove date
                        //return '<a href="/Pharmacy/Delete/' + data + '">Delete</a>';
                        return '<button type="button" class="btn btn-info" data-id=' + data + ' onclick="SMSCode(this);"> SMS Code</button>';

                    }
                }
                //, {
                //    "data": "Id",
                //    "mRender": function (data) {
                //        //return '<a href="/CompEmployees/Details/' + data + '">Details</a>';
                //        return '<a class="btn btn-info" style = " text-transform: none" href="/CompEmployees/Details/' + data + '">Details</a>';

                //    }
                //}
                //, {
                //    "data": "Id",
                //    "mRender": function (data) {
                //        return '<a href="/CompEmployees/Delete/' + data + '">Delete</a>';
                //    }
                //}


            ]
        });
    });
    function SMSCode(button) {
        var id = $(button).data('id');
        bootbox.confirm("Are you sure to Resend Verficstion Code ?", function (result) {
            if (result) {
                $.ajax({
                    type: "POST",
                    dataType: "json",
                    url: '/CompEmployees/SMSCode',
                    data: { id: id },
                    success: function (returndata) {
                        if (returndata.ok) {
                            bootbox.alert("Send successfully, verfication code is " + returndata.returndata)
                        } else {
                            bootbox.alert(returndata.returndata)

                        }
                    }
                });
            }
        });
    }


</script>
