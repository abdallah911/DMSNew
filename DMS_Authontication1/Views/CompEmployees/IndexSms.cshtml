@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";

}
<style>
    tr {
        text-align: center;
    }
</style>

<!-- start section -->
<div class="sios-overlay container-fluid mt-4">
    <div class="container">
        <i class="fa-solid fa-house"></i>
        <h3>Admin Search</h3>
    </div>
</div>

<section class="sios-container print-claim-section mt-5">
    <form name="formValidation" id="formValidation" action="">
        <div class="container">
            <div class="row mt-3">
                <div class="row row-cols-sm-3 m-auto m-sm-0">
                    <div class="forLabel">
                        <input class="chronic-form-control mb-3 ps-3" type="text" name="CardId" id="CardId" required="required" />
                        <span for="CardId">Card ID</span>
                    </div>
                    <div class="forLabel">
                        <input class="chronic-form-control mb-3 ps-3" type="text" name="Company" id="Company" required="required" />
                        <span for="company">Company</span>
                    </div>
                </div>
            </div>
            <div class="print-claims-btns d-flex gap-2 mt-5 justify-content-end">
                <input id="resetSearch" type="button" value="Reset" onclick="ClearSearchData();" class="btn fw-bold text-white rounded-3"   />
                <input id="SendAllSms"  type="button" value="Send All Sms" onclick="SendAll();" class="btn d-none fw-bold text-white rounded-3"  disabled />
                <input id="adminSearch" type="button" value="Search" class="btn fw-bold text-white rounded-3"  />

            </div>
        </div>
    </form>
</section>
<div style="display: flex; flex-direction: column">
    <section style="display: flex;flex-direction: column;flex-grow: 1;">
        <div class="sios-overlay container-fluid mt-4">
            <div class="container">
                <i class="fa-solid fa-house"></i>
                <h3 class="">Employees</h3>
            </div>
        </div>
        <div class="cs-bg claims-section mb-2 container-fluid">
            <div class="table-responsive">
                <table id="Employees" class="table table-striped mt-3 text-center">
                    <thead>
                        <tr>
                            <th>Card ID</th>
                            <th>Name</th>
                            <th>Contract</th>
                            <th>National ID</th>
                            <th>Phone Number</th>
                            <th>Sms Code</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
      
        </div>

    </section>
</div>

<script src="~/assets/NewDesignBackAdmin/JS/jquery.min.js"></script>
<script>
    $(function () {
        $("#SendAllSms").attr("disabled", "disabled");
        $('#adminSearch').click(function () {
            if (($("#Company").val() != '' || $("#Company").val() != undefined) && ($("#CardId").val() == '' || $("#CardId").val() == undefined))
                $("#SendAllSms").attr("disabled", false);
            $('#Employees').dataTable().fnDestroy();
            $("#Employees").DataTable({
                "sAjaxSource": '/CompEmployees/EmployeesListSms?CardId=' + $("#CardId").val() + '&&Company=' + $("#Company").val(),
                "bServerSide": true,
                "processing": true,
                "bFilter": true,
                "bSort": false,
                "pageLength": 10,
                "bInfo": true,
                "columns": [
                    { "data": "CARD_ID" },
                    { "data": "EMP_ENAME" },
                    { "data": "CONTRACT_NO" },
                    { "data": "EMP_ID" },
                    { "data": "TEL1" },
                    { "data": "Code" },
                    {
                        "data": "Id",
                        "mRender": function (data) {
                            return '<a class="text-light btn" style="background-color: #717382" style = " text-transform: none" href="/CompEmployees/Edit/' + data + '">Edit</a>';

                        }
                    },
                    {
                        "data": "Id",
                        "mRender": function (data) {
                            return '<button type="button" class="text-light btn" style="background-color: #717382" data-id=' + data + ' onclick="SMSCode(this);"> SMS Code</button>';

                        }
                    }


                ]
            });
        });
    });
    function SMSCode(button) {
        debugger;
        var row = $(button).closest("TR");
        var Code = $("TD", row).eq(5).html();
        var id = $(button).data('id');
        if (Code != "" && Code != undefined) {
            toastr.error("يوجد كود مفعل يجب استخدامه " + Code);
        }
        else {
            bootbox.confirm("Are you sure to Resend Verficstion Code ?", function (result) {
                if (result) {
                    $.ajax({
                        type: "POST",
                        dataType: "json",
                        url: '/CompEmployees/SMSCode',
                        data: { id: id },
                        success: function (returndata) {
                            if (returndata.ok) {
                                bootbox.alert("Send successfully, verfication code is " + returndata.returndata)
                            } else {
                                bootbox.alert(returndata.returndata)

                            }
                        }
                    });
                }
            });
        }
    }
    function SendAll() {
        if (($("#Company").val() != '' && $("#Company").val() != undefined) && ($("#CardId").val() == '' || $("#CardId").val() == undefined)) {
            $.ajax({
                type: "POST",
                dataType: "json",
                url: '/CompEmployees/SMSCodeForAll',
                data: { CopmId: $("#Company").val() },
                success: function (returndata) {
                    if (returndata.ok) {
                        bootbox.alert("Send successfully ")
                    } else {
                        bootbox.alert(returndata.returndata)

                    }
                },
                error: function (ex) {
                    bootbox.alert('Failed to send code for company ');
                }

            });
        }
        else {
            bootbox.alert(" Please enter company id only ");
        }
    }

    function ClearSearchData() {
        $("#Company").val("");
        $("#CardId").val("");
    }


</script>