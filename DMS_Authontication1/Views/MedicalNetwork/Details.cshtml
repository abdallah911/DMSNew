            <p>
                <div class="portlet-body">

                    <div class="panel panel-info">
                        <div class="row bg-overlay my-4">
                            <div class="m-3 fs-3 text-white  ">
                                <h2 class="panel-heading "  >Update Status</h2>
                            </div>
                        </div>
                                <div class="px-5  panel-body ">
                                    <div class="row">
                                        <div class=" d-flex align-items-center form-group">
                                            <input type="text" id="id" value="@Model.ID" hidden />
                                            <div class="col-lg-3">
                                                <h4>@Html.Label("Update Status :", htmlAttributes: new { @class = "sios-color control-label" })</h4>

                                            </div>
                                            <div class="col-lg-3" data-step="7" data-intro="Select speciality">
                                                <select id='ChangeStatus' class='form-control' onchange='UpdateStuts();'>
                                                    <option value='N'> Select Action</option>
                                                    <option value='Accept'>Accept</option>
                                                    <option value='Reject'>Reject</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!--Save-->
                                <div class="panel-footer px-5" style="text-align:right;">
                                    @Html.ActionLink(" Back to List", "Index", null, htmlAttributes: new { @class = "btn fw-bold text-white rounded-3 btn-primary fa fa-backward", @style = " text-transform: none" })
                                    @*<input data-step="12" data-intro="Update Status" id="submit" type="button" value="Update" class="btn btn-success fa fa-check" />*@
                                </div>

                            </div>
                        </div>
</p>
            <script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
            <script src="~/assets/HomeTemplete/js/intro.js"></script>
            <script>
                function UpdateStuts() {
                    var id = $("#id").val();
                    if ($("#ChangeStatus").val() != "N") {
                        $.ajax({
                            type: 'POST',
                            url: '/MedicalNetwork/ChangeStatus',
                            dataType: 'Json',
                            data: {
                                Id: id,
                                status: $("#ChangeStatus").val()
                            },
                            dataType: 'Json',
                            success: function (r) {
                                toastr.success("Save Success");
                            },
                            error: function () {
                                toastr.error("Error Save Data");
                            }
                        });
                    }
                    else {
                        toastr.error("Please Select Status ");
                    }

                }
            </script>
