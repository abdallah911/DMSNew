                </dd>
            </dr>
            <dr class="sios-table-dr  row">
                <dt class="sios-table-dt col ">
                    @Html.DisplayNameFor(model => model.ProviderTypeName)
                </dt>

                <dd class="sios-table-dd col">
                    @Html.DisplayFor(model => model.ProviderTypeName)
                </dd>
            </dr>

            <dr class="sios-table-dr  row">
                <dt class="sios-table-dt col ">
                    @Html.DisplayNameFor(model => model.CreatedDate)
