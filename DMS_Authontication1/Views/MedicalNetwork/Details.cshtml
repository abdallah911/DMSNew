                </dd>
            </dr>
            <dr class="sios-table-dr  row">
                <dt class="sios-table-dt col ">
                    @Html.DisplayNameFor(model => model.ResponsableFor)
                </dt>
                <dd class="sios-table-dd col">
                    @Html.DisplayFor(model => model.ResponsableFor)
                </dd>
            </dr>
            <dr class="sios-table-dr  row">
                <dt class="sios-table-dt col ">
                    @Html.DisplayNameFor(model => model.Country)
                </dt>

                <dd class="sios-table-dd col">
                    @Html.DisplayFor(model => model.Country)
                </dd>
            </dr>

            <dr class="sios-table-dr  row">
                <dt class="sios-table-dt col ">
                    @Html.DisplayNameFor(model => model.Region)
                </dt>

                <dd class="sios-table-dd col">
                    @Html.DisplayFor(model => model.Region)
                </dd>
            </dr>

            <dr class="sios-table-dr  row">
                <dt class="sios-table-dt col ">
                    @Html.DisplayNameFor(model => model.PhoneNumber)
                </dt>

                <dd class="sios-table-dd col">
                    @Html.DisplayFor(model => model.PhoneNumber)
                </dd>
            </dr>
            <dr class="sios-table-dr  row">
                <dt class="sios-table-dt col ">
                    @Html.DisplayNameFor(model => model.NumberOfPeople)
                </dt>

                <dd class="sios-table-dd col">
