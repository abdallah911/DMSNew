@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Search";
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";

    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {

            var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 14 && (x.FullControl || x.EditPermission
                                          || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
            if (obj != null)
            {
                edit = obj.EditPermission;
                delete = obj.ActivationControl;
                view = obj.Preview;
                fullcontroll = obj.FullControl;
                Create = obj.AddPermission;

            }
        }
    }
}
@*<h2>Index</h2>*@
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>
<input type="text" id="compname" value="@ViewBag.CompName" hidden="hidden" />
<br />
<div style="margin-top:40px">
    <p>
        @if (fullcontroll || view)
        {
            @Html.ActionLink(" Search", "Search", null, htmlAttributes: new { @class = "btn btn-secondary-outline fa fa-search ", @style = " text-transform: none" })
        }
        @if (fullcontroll || Create)
        {
            @Html.ActionLink(" Create Request ", "CreateRequest", null, htmlAttributes: new { @class = "btn btn-info fa fa-plus ", @style = " text-transform: none" })
        }
    </p>
</div>
@if (fullcontroll || view)
{
    <div class="portlet box  green">
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-gift"></i>Inquiries about an invoice
            </div>
        </div>
        <div class="portlet-body">
            <div class="row ">

                @*Date of company *@
                @if (User.IsInRole("HR_Admin"))
                {
                    <div class="col-md-4">

                        <div class="form-group" id="Company_Number">
                            <div class="col-sm-6">

                                @Html.Label("Company Number", htmlAttributes: new { @class = "control-label" })
                            </div>
                            <div class=" col-md-6">
                                @Html.DropDownList("CompanyNumber", ViewBag.company as SelectList, new { @class = "form-control", id = "CompanyNumber" })

                            </div>
                        </div>

                    </div>
                    <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                    <script>
                        $(document).ready(function () {
                            $("#CompanyNumber").select2();
                        });
                    </script>
                }
                else
                {
                    <input id="compname" type="text" value="@ViewBag.CompName" hidden="hidden" />

                }

                <br />

                <div class="col-md-12">
                    <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">
                        <!-- BEGIN PAGE HEADER-->
                        <!-- BEGIN THEME PANEL -->
                        <div class="form-wizard">
                            <div class="form-body">
                                <div class="tab-content">
                                    <div asp-validation-summary="All" class="text-danger"></div>
                                    <div class="row">
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <div class="col-md-10">
                                                    <div class="checkbox-inline">
                                                        <input type="radio" id="type_rad" name="Search_Type" value="Class" data-name="class">
                                                        @Html.Label("Class")
                                                    </div>
                                                </div>
                                            </div>
                                            @if (ViewBag.compclasseslist == null)
                                            {
                                                <div class="form-group" id="class_levels" hidden>
                                                    <div class=" col-md-10">
                                                        <select class="form-control" id="class_selectList">
                                                        </select>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="form-group" id="class_levels" hidden>
                                                    <div class=" col-md-10">
                                                        @Html.DropDownList("class_levels", ViewBag.compclasseslist as SelectList, new { @class = "form-control", id = "class_selectList" })
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        @*Date of Card *@
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <div class=" col-md-10">
                                                    <div class="checkbox-inline">
                                                        <input type="radio" id="type_rad" name="Search_Type" value="Card" data-name="card">
                                                        @Html.Label("Card ID")
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group" id="card_div" hidden>
                                                @if (User.IsInRole("HR") || User.IsInRole("HR_Admin"))
                                                {
                                                    <div class="col-md-12">
                                                        <select id="txtSearchCard" class="js-data-example-ajax" style="width: 100%"></select>
                                                    </div>
                                                    <br />
                                                }
                                                else
                                                {
                                                    <div class=" col-md-12">
                                                        <input id="txtSearchCard" type="text" placeholder="search for card..." class="form-control" />
                                                    </div>
                                                    <br />
                                                }

                                            </div>

                                        </div>

                                        <div class="portlet box  green  col-md-6">
                                            <div class="portlet-title">
                                                <div class="caption">
                                                    <i class="fa fa-search"></i>Search
                                                </div>
                                            </div>
                                            <br />
                                            <div class="portlet-body">
                                                <div class="row " style="margin-left:30px;margin-right:30px">
                                                    <div class="form-group">

                                                        <div class="col-sm-4">
                                                            @Html.Label("Provider Type", htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-sm-8">
                                                            @Html.DropDownList("Provider_Type", ViewBag.provider as SelectList, "Select Provider", new { @class = "form-control", id = "provider_Type" })
                                                        </div>

                                                        <div class="col-sm-12" id="SpecialistDiv" style="margin-top:25px" hidden>
                                                            <div class="col-sm-4">
                                                                @Html.Label("Specialist", htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class=" col-sm-8">
                                                                @Html.DropDownList("Specialist", new SelectList(""), new { @class = "form-control", id = "SpecialistId" })
                                                            </div>
                                                        </div>

                                                        <div class="col-sm-12" style="margin-top:25px">
                                                            <div class="col-sm-4">
                                                                @Html.Label("Governorate", htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-sm-8">
                                                                @Html.DropDownList("Country", ViewBag.address as SelectList, "Select Governorate", new { @class = "form-control", id = "Country_select" })
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-12" style="margin-top:25px">
                                                            <div class="col-sm-4">
                                                                @Html.Label("Region", htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class=" col-sm-8">
                                                                @Html.DropDownList("Region", new SelectList(""), new { @class = "form-control", id = "Region_select" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <div class="col-sm-6">
                                                <button id="Search" type="button" class="btn btn-success" onclick="SearchProvider()">
                                                    <span class="glyphicon glyphicon-search"></span> Search
                                                </button>
                                            </div>
                                            <div class="col-sm-6" id="div_of_serv">
                                                <button id="new" type="button" class="btn btn-secondary-outline" onclick="NewRequest()">
                                                    <span class="fa fa-reply"></span> New
                                                </button>

                                            </div>
                                        </div>

                                        @*Date of Service*@

                                        <div class="col-md-offset-1 col-md-10" style="margin-top:80px;margin-bottom:100px" id="list_div">

                                            <table class="table" id="ProviderList">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            @Html.DisplayName("PRENAME")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("ADDRESS 1")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("ADDRESS 2")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("TEL 1")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("TEL 2")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Specialist")
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody id="ProviderListBody"></tbody>
                                            </table>
                                        </div>
                                        <br />

                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>

    </div>
}
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script>
    var input = document.getElementById("txtSearchCard");
    input.addEventListener("keyup", function (event) {
        event.preventDefault();
        if (event.keyCode === 13) {

            $('#Search').click();
        }
    });
    var searchtype = "unselect";
    $(document).ready(function () {
        $('#list_div').hide();
        $("#Country_select").select2();
        $("#Region_select").select2();
        $("#provider_Type").select2();
        $('#txtSearchCard').select2({
            placeholder: 'Search for a cards',
            minimumInputLength: 5,
            ajax: {
                url: '/EmployeeRequest/GetActiveEmployess/',
                delay: 250,
                dataType: 'json',
                data: function (params) {
                    var query = {
                        search: params.term,
                        page: params.page || 1
                    }
                    return query;
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;

                    return {
                        results: data,//.results,
                        pagination: {
                            more: (params.page * 10) < data.count_filtered
                        }
                    };
                }
                // Additional AJAX parameters go here; see the end of this chapter for the full code of this example

            }
        });
        $("#Country_select").change(function () {//address
            $.get("/MedicalNetwork/GetStateList",
                { id: $("#Country_select").val() }, function (data) {
                    $("#Region_select").empty();
                    $.each(data, function (index, row) {
                        $("#Region_select").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                    });
                });
        });
        $("#CompanyNumber").change(function () {// class levels
            var compNu = $("#CompanyNumber").val();
            $("#compname").val(compNu);
            $("#txtSearchCard").val(null).trigger('change');
            $.get("/MedicalNetwork/GetClassList",
                { compId: compNu }, function (data) {
                    $("#class_selectList").empty();
                    $.each(data, function (index, row) {
                        $("#class_selectList").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                    });
                });
        });
        $("#CompanyNumber").map(function () {// class levels
            var compNu = $("#CompanyNumber").val();
            $("#compname").val(compNu);
            $.get("/MedicalNetwork/GetClassList",
                { compId: compNu }, function (data) {
                    $("#class_selectList").empty();
                    $.each(data, function (index, row) {
                        $("#class_selectList").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                    });
                });
        });
        $("#provider_Type").change(function () {// class levels
            $('#SpecialistDiv').hide();
            $("#SpecialistId").empty();
            var type = $("#provider_Type").val();
            if (type == "5") {
                $('#SpecialistDiv').show();
                $("#SpecialistId").select2();
                $("#SpecialistId").val(null).trigger('change');
                $.get("/MedicalNetwork/GetSpecialistList",
                    function (data) {
                        $("#SpecialistId").empty();
                        $("#SpecialistId").append("<option value=''>Select Specialist</option>")
                        $.each(data, function (index, row) {
                            $("#SpecialistId").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                        });
                    });
            }

        });
        $("#provider_Type").map(function () {// class levels
            $("#SpecialistId").select2();
            $('#SpecialistDiv').hide();
            $("#SpecialistId").empty();
            var type = $("#provider_Type").val();
            if (type == "5") {
                $('#SpecialistDiv').show();
                $("#SpecialistId").val(null).trigger('change');
                $.get("/MedicalNetwork/GetSpecialistList",
                    function (data) {
                        $("#SpecialistId").empty();
                        $.each(data, function (index, row) {
                            $("#SpecialistId").append("<option value='" + row.Value + "'>" + row.Text + "</option>")
                        });
                    });
            }
        });
        $('input:radio[name="Search_Type"]').change(
            function () {
                if ($(this).is(':checked')) {
                    // append goes here
                    if ($(this).val() == 'Class') {
                        $("#class_levels").show();
                        $("#card_div").hide();
                        searchtype = "Class";
                    }
                    else if ($(this).val() == 'Card') {
                        $("#card_div").show();
                        $("#class_levels").hide();
                        searchtype = "Card";

                    }
                }
            })

    });

    //New Request
    function NewRequest() {
        window.location = '/MedicalNetwork/Search';
    }
    // Search Provider
    function SearchProvider() {
        $('#list_div').hide();
        //var typeprovider = $("#provider_Type").val();
        var specialistid = $("#SpecialistId").val();
        var compname = $("#compname").val();
        if (searchtype == "Class") {
            if ($("#provider_Type").val() == "") {
                alert("Please select Provider ...");
            }
            if ($("#Country_select").val() == "") {
                alert("Please select Country ...");
            }
            else {
                var classlevelSelect = $("#class_selectList").val();
                $.ajax({
                    url: '/MedicalNetwork/GetProvidersByClass/',
                    data: {
                        classLevel: classlevelSelect, compId: compname, country: $("#Country_select").val(),
                        region: $("#Region_select").val(), providerId: $("#provider_Type").val(), specialistid: $("#SpecialistId").val()
                    },
                    dataType: 'Json',
                    success: function (r) {
                        $('#ProviderList').dataTable().fnDestroy();
                        //$('#ProviderList').empty();
                        if (r.msg == "ok") {
                            var setData = $("#ProviderList Tbody");
                            setData.empty();
                            for (var i = 0; i < r.providerslist.length; i++) {
                                var data = "<tr >" +
                                    "<td>" + r.providerslist[i].PR_ANAME + "</td>";
                                if (r.providerslist[i].ADDRESS1 == null)
                                    data += "<td>--</td>";
                                else
                                    data += "<td>" + r.providerslist[i].ADDRESS1 + "</td>";
                                if (r.providerslist[i].ADDRESS2 == null)
                                    data += "<td>--</td>";
                                else
                                    data += "<td>" + r.providerslist[i].ADDRESS2 + "</td>";
                                if (r.providerslist[i].TEL1 == null)
                                    data += "<td>--</td>";
                                else
                                    data += "<td>" + r.providerslist[i].TEL1 + "</td>";
                                if (r.providerslist[i].TEL2 == null)
                                    data += "<td>--</td>";
                                else
                                    data += "<td>" + r.providerslist[i].TEL2 + "</td>";
                                if (r.providerslist[i].PR_DESC == null)
                                    data += "<td>--</td>";
                                else
                                    data += "<td>" + r.providerslist[i].PR_DESC + "</td>" +
                                        "</tr>";
                                setData.append(data);
                            }
                            $('#ProviderList').DataTable();
                            $('#list_div').show();
                        }
                        else {
                            alert(r.msg);
                        }

                    },
                    error: function () {
                        alert("Invalid Request ");
                    }
                });
            }
        }
        else if (searchtype == "Card") {
            var cardNum = $("#txtSearchCard").val();

            // chick card id  is empty
            if (cardNum == "") {
                alert("Please Enter Valid Card ID ...");
            }
            else {

                var arra = cardNum.split("-");

                // chick card id is correct or not
                if (arra.length == 4 && arra[3] != "") {

                    // final chick if card id start with company id or not
                    if (arra[0] == compname) {
                        if ($("#provider_Type").val() == "") {
                            alert("Please select Provider ...");
                        }
                        if ($("#Country_select").val() == "") {
                            alert("Please select Country ...");
                        }
                        else {

                            $.ajax({
                                url: '/MedicalNetwork/GetProviders/',
                                data: {
                                    cardId: cardNum, compId: compname, country: $("#Country_select").val(),
                                    region: $("#Region_select").val(), providerId: $("#provider_Type").val(), specialistid: $("#SpecialistId").val()
                                },
                                dataType: 'Json',
                                success: function (r) {
                                    $('#ProviderList').dataTable().fnDestroy();
                                    if (r.msg == "ok") {
                                        var setData = $("#ProviderList Tbody");
                                        setData.empty();
                                        for (var i = 0; i < r.providerslist.length; i++) {
                                            var data = "<tr >" +
                                                "<td>" + r.providerslist[i].PR_ANAME + "</td>";
                                            if (r.providerslist[i].ADDRESS1 == null)
                                                data += "<td>--</td>";
                                            else
                                                data += "<td>" + r.providerslist[i].ADDRESS1 + "</td>";
                                            if (r.providerslist[i].ADDRESS2 == null)
                                                data += "<td>--</td>";
                                            else
                                                data += "<td>" + r.providerslist[i].ADDRESS2 + "</td>";
                                            if (r.providerslist[i].TEL1 == null)
                                                data += "<td>--</td>";
                                            else
                                                data += "<td>" + r.providerslist[i].TEL1 + "</td>";
                                            if (r.providerslist[i].TEL2 == null)
                                                data += "<td>--</td>";
                                            else
                                                data += "<td>" + r.providerslist[i].TEL2 + "</td>" +
                                                    "</tr>";
                                            setData.append(data);
                                        }
                                        $('#ProviderList').DataTable();
                                        $('#list_div').show();
                                    }
                                    else {
                                        alert(r.msg);
                                    }

                                },
                                error: function () {
                                    alert("Invalid Card ID ");
                                }
                            });
                        }

                    }
                    else {
                        alert("Please enter correct card that belongs to your company only start with : " + compname);
                    }

                }
                else {
                    alert("Please enter correct card ... ");
                }
            }
        }
        else {
            alert("You shoud select 'Class' or ' Card ID'  ...");
        }

    }
</script>
