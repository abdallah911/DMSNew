@model DMS_Authontication1.ViewModel.RequestAddProvidersVM
@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "CreateRequest";
    Layout = "~/Views/Shared/_Layout_DashboardHR.cshtml";
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var Create = false;
    var modellist = new List<ModulesPagesViewModel>();
    var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
    if (claim != null)
    {
        modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
        if (modellist != null)
        {
            if (User.IsInRole("User"))
            {
                var obj = modellist.Where(x => x.ModuleName == "Customers Management" && x.PageId == 23 && (x.FullControl || x.EditPermission
                                              || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
                if (obj != null)
                {
                    edit = obj.EditPermission;
                    delete = obj.ActivationControl;
                    view = obj.Preview;
                    fullcontroll = obj.FullControl;
                    Create = obj.AddPermission;

                }
            }
            else
            {
                var obj = modellist.Where(x => x.ModuleName == "Company Human Resourses Management" && x.PageId == 14 && (x.FullControl || x.EditPermission
                                  || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
                if (obj != null)
                {
                    edit = obj.EditPermission;
                    delete = obj.ActivationControl;
                    view = obj.Preview;
                    fullcontroll = obj.FullControl;
                    Create = obj.AddPermission;

                }
            }
        }
    }


}
<div class="sios-container">
    <div class="">
        <p class="mx-4 my-0 py-3 d-flex gap-2">
            @if (User.IsInRole("User"))
            {
                if (fullcontroll || view)
                {
                    @Html.ActionLink(" Search", "MedicalNetwork", "Employee", null, htmlAttributes: new { @class = "btn  ", @style = " text-transform: none" })
                }
            }
            else
            {
                if (fullcontroll || view)
                {
                    @Html.ActionLink(" Search", "Search", null, htmlAttributes: new { @class = "btn action-btn ", @style = " text-transform: none" })
                }
            }
            @if (fullcontroll || Create)
            {
                @Html.ActionLink(" Create Request ", "CreateRequest", null, htmlAttributes: new { @class = "btn action-btn active ", @style = " text-transform: none" })
            }
        </p>
    </div>
    <div class="portlet box  green">
        <div class="row bg-overlay portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa-solid fa-home me-1"></i>Create New Request
            </div>
        </div>
        <div class="portlet-body">
            @if (Model == null)
            {
                <input id="RegionId1" value="0" hidden />
            }
            else
            {
                <input id="RegionId1" value="@Model.Region" hidden />
            }
            <div class="row " style="white-space: nowrap;">
                <div class="col-md-12">
                    <form class="form-horizontal" action="/add/Employees/New" method="POST" enctype="multipart/form-data">
                        <!-- BEGIN PAGE HEADER-->
                        <!-- BEGIN THEME PANEL -->

                        <div class="form-wizard">
                            <div class="form-body">
                                <div class="tab-content">
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class="row container mx-auto my-4">
                                        @*Date of Registration*@
                                        <div class="col-md-12" style="margin-bottom:50px">
                                            <div class="d-flex align-items-center justify-content-evenly fw-bold fs-4 px-2 border-0 form-group" style="color:var(--color-secondary)">
                                                <label class="control-label sbold col-md-2">
                                                    Request Code  :
                                                </label>
                                                <label class="d-flex  sbold col-md-4 pt-2" id="RequestCode">
                                                    ********
                                                </label>
                                                <span class="start-0"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-6 d-flex flex-column gap-2">

                                            <div class="forLabel px-2 border-0 form-group">

                                                @if (User.IsInRole("HR_Admin"))
                                                {
                                                    @Html.DropDownListFor(model => model.CompName, ViewBag.company as SelectList, new { @class = "border-2 sios-form-control w-100 form-control", id = "CompName" })


                                                    <script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
                                                    <script>
                                                        $(document).ready(function () {
                                                            $('#CompName').select2();
                                                        });
                                                    </script>
                                                }
                                                else
                                                {
                                                    @Html.EditorFor(model => model.CompName, new { htmlAttributes = new { @class = "border-2 sios-form-control w-100 form-control", @disabled = "disabled" } })
                                                    @*<input type="text" class="border-2 sios-form-control w-100 form-control" asp-for="FirstName" />*@
                                                    @Html.ValidationMessageFor(model => model.CompName, "", new { @class = "text-danger" })
                                                }
                                                <span class="start-0" style="transform:translateY(-6px);">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayNameFor(model => model.CompName) :
                                                        <span class="required"> * </span>
                                                    </label>
                                                </span>

                                            </div>

                                            <div class="forLabel px-2 border-0 form-group">


                                                @Html.DropDownList("Country", ViewBag.address as SelectList, "Select Governorate", new { @class = "border-2 sios-form-control w-100 form-control", id = "Country_select" })
                                                @*@Html.DropDownListFor(model => model.Country, ViewBag.address as SelectList, "Select Country", new { @class = "border-2 sios-form-control w-100 form-control", id = "Country" })*@
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayName("Governorate") :
                                                    </label>
                                                </span>

                                            </div>

                                            <div class="forLabel px-2 border-0 form-group">


                                                @Html.DropDownList("Region", new SelectList(""), "Select Region", new { @class = "border-2 sios-form-control w-100 form-control", id = "Region_select" })
                                                @*@Html.DropDownListFor(model => model.Region, new SelectList(""), "Select Region", new { @class = "border-2 sios-form-control w-100 form-control", id = "Region" })*@
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayNameFor(model => model.Region) :
                                                    </label>
                                                </span>

                                            </div>

                                            <div class="forLabel px-2 border-0 form-group">

                                                @Html.DropDownListFor(m => m.ProviderType, ViewBag.provider as SelectList, "Select Provider", new { @class = "border-2 sios-form-control w-100 form-control" })
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayNameFor(model => model.ProviderType) :
                                                    </label>
                                                </span>

                                            </div>



                                            <div class="forLabel px-2 border-0 form-group">

                                                <input type="number" class="border-2 sios-form-control w-100 form-control" id="NumberOfPeople" min="0" step="1" onkeypress="return /[0-9]/i.test(event.key)" />
                                                @Html.ValidationMessageFor(model => model.NumberOfPeople, "", new { @class = "text-danger" })
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-5">
                                                        @Html.DisplayNameFor(model => model.NumberOfPeople) :
                                                        <span class="required"> * </span>
                                                    </label>
                                                </span>

                                            </div>


                                        </div>

                                        <div class="col-md-6 d-flex flex-column gap-2">

                                            <div class="forLabel px-2 border-0 form-group">

                                                <input type="text" class="border-2 sios-form-control w-100 form-control" value="" id="ServName" required />
                                                @Html.ValidationMessageFor(model => model.ServName, "", new { @class = "text-danger" })
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayNameFor(model => model.ServName) :
                                                        <span class="required"> * </span>
                                                    </label>
                                                </span>

                                            </div>

                                            <div class="forLabel px-2 border-0 form-group">

                                                <input type="text" class="border-2 sios-form-control w-100 form-control" id="ServAddress" required />
                                                @Html.ValidationMessageFor(model => model.ServAddress, "", new { @class = "text-danger" })
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayNameFor(model => model.ServAddress) :
                                                        <span class="required"> * </span>
                                                    </label>
                                                </span>

                                            </div>
                                            <div class="forLabel px-2 border-0 form-group">

                                                <input type="text" class="border-2 sios-form-control w-100 form-control" value="" id="ResponsableFor" required />
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-4">
                                                        @Html.DisplayNameFor(model => model.ResponsableFor) :

                                                    </label>
                                                </span>

                                            </div>

                                            <div class="forLabel px-2 border-0 form-group">

                                                <input type="text" class="border-2 sios-form-control w-100 form-control" id="PhoneNumber" value="" onkeypress="return /[0-9]/i.test(event.key)" required />
                                                @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
                                                <span class="start-0"><label class="control-label sbold col-md-4">@Html.DisplayNameFor(model => model.PhoneNumber) :<span class="required"> * </span></label></span>


                                            </div>



                                        </div>
                                        <div class="row  mx-2 align-items-baseline mt-3">
                                            <div class="col-sm-7 forLabel px-0 rounded border-0 form-group" style="background: #aa98ae;">
                                                <textarea type="text" class="border-2 sios-form-control w-100 form-control" id="responsestatus" value="" disabled="disabled"></textarea>
                                                <span class="start-0">
                                                    <label class="control-label sbold col-md-3">
                                                        Response Status  :
                                                    </label>
                                                </span>
                                            </div>
                                            <div class="col-sm-5 ">
                                                <div class="position-relative rounded-3">
                                                    <input id="txtSearchRequest" type="text" placeholder="search for Request ID..." class="border-2 sios-form-control w-100 form-control rounded-3 py-2" style="padding:10px 10px 10px 80px  !important;">
                                                    <div class="position-absolute start-0 top-0" style="height:40px">
                                                        <button id="Search" type="button" class="btn h-100 btn-success" onclick="SearchRequest()">
                                                            <span class="glyphicon glyphicon-search"></span> Search
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="row ">

                                                    <div class="d-flex gap-2 mt-4 justify-content-center form-group">
                                                        <div class="" id="div_of_serv">
                                                            <button id="new" type="button" class="btn btn-secondary-outline" onclick="NewRequest()">
                                                                <span class="fa fa-reply"></span> New
                                                            </button>

                                                        </div>
                                                        <div class="">
                                                            <button id="edit" type="button" class="btn btn-success" onclick="EditRequest()" disabled="disabled">
                                                                <span class="fa fa-edit"></span> Edit
                                                            </button>
                                                        </div>
                                                        <div class="" id="div_of_serv">
                                                            <button id="save" type="button" class="btn btn-primary" onclick="SaveRequest()">
                                                                <span class="fa fa-save"></span> Save
                                                            </button>

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>

    </div>

</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script>


    $(function () {
        debugger;
        $("#Country_select").select2();
        $("#Region_select").select2();
        $("#ProviderType").select2();

        $("#Country_select").change(function () {//address
            $.get("/Account/GetStateList",
                { id: $("#Country_select").val() }, function (data) {
                    $("#Region_select").empty();
                    $.each(data, function (index, row) {
                        $("#Region_select").append("<option value='" + row.Text + "'>" + row.Value + "</option>")
                    });
                });
        });
    });

    /// Save Request
    function SaveRequest() {
        if ($('#CompName').val() == "") {
            alert("You shoud enter valid company name ..");
        }
        else if ($("#NumberOfPeople").val() == "") {
            alert("You shoud enter number of people ..");
        }
        else if ($('#ServName').val() == "") {
            alert("You shoud enter provider name ...");
        }
        else if ($("#ServAddress").val() == "") {
            alert("You shoud enter Provider address ...");
        }
        else if ($("#PhoneNumber").val() == "" || $("#PhoneNumber").val().length != 11) {
            alert("You shoud enter valid phone number");
        }
        else {
            var data = {
                CompName: $('#CompName').val(),
                Country: $('#Country_select').val(),
                Region: $('#Region_select').val(),
                ProviderType: $('#ProviderType').val(),
                NumberOfPeople: $("#NumberOfPeople").val(),
                ServName: $('#ServName').val(),
                ServAddress: $("#ServAddress").val(),
                ResponsableFor: $("#ResponsableFor").val(),
                PhoneNumber: $("#PhoneNumber").val(),

            };
            $.ajax({
                type: "POST",
                url: '/MedicalNetwork/SaveRequest',
                data: (data),
                success: function (ret) {
                    if (ret.msg == "ok") {
                        $("#save").attr("disabled", "disabled");
                        bootbox.alert("Saved Datat Success ...");
                        $("#RequestCode").html(ret.respcode);
                    }
                    else {
                        alert(ret.msg);
                    }

                },
                error: function (err) {
                    bootbox.alert("Error DATA !");
                }
            });
        }

    }

    // New Request
    function NewRequest() {
        window.location = '/MedicalNetwork/CreateRequest';
        //$('#CompName').val();
        //$("#save").attr("disabled", false);
        //$('#Country').val("");
        //$('#Region').empty();
        //$('#ProviderType').val("");
        //$("#NumberOfPeople").val("");
        //$('#ServName').val("");
        //$("#ServAddress").val("");
        //$("#ResponsableFor").val("");
        //$("#PhoneNumber").val("");
    }

    // Search Request
    function SearchRequest() {
        if ($('#txtSearchRequest').val() == "") {
            alert("Please insert valid Request Code ...")

        }
        else {
            var data = {
                searchId: $('#txtSearchRequest').val(),
            };
            $.ajax({
                type: "POST",
                url: '/MedicalNetwork/SearchRequest',
                data: (data),
                success: function (dat) {
                    if (dat.msg == "ok") {
                        $("#save").attr("disabled", "disabled");
                        $("#edit").attr("disabled", false);
                        sel = dat.modelreturn.Region;
                        $("#RequestCode").html(dat.modelreturn.ID);

                        $('#Country_select').val(dat.modelreturn.Country).select2();
                        $("#Country_select").map(function () {//address
                            $.get("/Account/GetStateList",
                                { id: $("#Country_select").val() }, function (data) {
                                    $("#Region_select").empty();
                                    $.each(data, function (index, row) {
                                        $("#Region_select").append("<option value='" + row.Text + "'>" + row.Value + "</option>")
                                    });
                                    //$("#RegionId1").val(dat.modelreturn.Region);
                                    //var Regionselect = $("#RegionId1").val();
                                    //$("#Region_select").val(Regionselect).select2();
                                    $('#Region_select').val(dat.modelreturn.Region).select2();
                                });
                        });

                        $('#ProviderType').val(dat.modelreturn.ProviderType).change();
                        $("#NumberOfPeople").val(dat.modelreturn.NumberOfPeople);
                        $('#ServName').val(dat.modelreturn.ServName);
                        $("#ServAddress").val(dat.modelreturn.ServAddress);
                        $("#ResponsableFor").val(dat.modelreturn.ResponsableFor);
                        $("#PhoneNumber").val(dat.modelreturn.PhoneNumber);
                        $("#responsestatus").val(dat.modelreturn.RespobeStatus);
                        if (dat.modelreturn.Status != "W") {
                            $("#edit").attr("disabled", "disabled");
                        }
                        $('#CompName').val(dat.modelreturn.CompName).select2();
                    }
                    else {
                        alert(dat.msg);
                    }

                },
                error: function (err) {
                    bootbox.alert("Error Data !");
                }
            });
        }
    }

    // Edit Request
    function EditRequest() {
        if ($('#CompName').val() == "") {
            alert("You shoud enter valid company name ..");
        }
        else if ($("#NumberOfPeople").val() == "") {
            alert("You shoud enter number of people ..");
        }
        else if ($('#ServName').val() == "") {
            alert("You shoud enter provider name ...");
        }
        else if ($("#ServAddress").val() == "") {
            alert("You shoud enter Provider address ...");
        }
        else if ($("#PhoneNumber").val() == "" || $("#PhoneNumber").val().length != 11) {
            alert("You shoud enter valid phone number");
        }
        else {
            var data = {
                ReqestID: $("#RequestCode").html(),
                CompName: $('#CompName').val(),
                Country: $('#Country_select').val(),
                Region: $('#Region_select').val(),
                ProviderType: $('#ProviderType').val(),
                NumberOfPeople: $("#NumberOfPeople").val(),
                ServName: $('#ServName').val(),
                ServAddress: $("#ServAddress").val(),
                ResponsableFor: $("#ResponsableFor").val(),
                PhoneNumber: $("#PhoneNumber").val(),

            };
            $.ajax({
                type: "POST",
                url: '/MedicalNetwork/EditRequest',
                data: (data),
                success: function (ret) {
                    if (ret.msg == "ok") {
                        $("#save").attr("disabled", "disabled");
                        bootbox.alert("Edit Datat Success ...");
                        $("#RequestCode").html(ret.respcode);
                    }
                    else {
                        alert(ret.msg);
                    }

                },
                error: function (err) {
                    bootbox.alert("Error DATA !");
                }
            });
        }
    }
</script>
