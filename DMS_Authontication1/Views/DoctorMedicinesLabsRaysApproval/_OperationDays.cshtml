@model IEnumerable<DMS_TEST.ViewModel.Container1>

<div class="modal fade " id="OperationDaysModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog  modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h3 class="modal-title">Operation Days</h3>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    @*@Html.Label("Operation Days", new { @class = "col-md-2 control-label" })*@
                    <div>
                        @Html.TextBox("OperationDaysTxt",null, new { @class = "form-control" })
                    </div>
                </div>

            </div>
            <div class="modal-footer">

                <button id="Close" type="button" class="btn btn-secondary glyphicon glyphicon-ok" data-dismiss="modal"> Ok</button>

            </div>
        </div>
    </div>
</div>
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<link href="~/assets/HomeTemplete/Content/toastr.min.css" rel="stylesheet" />
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script>
    
    var OperationDaysTxt="";
    $(function () {
        $('#OperationDaysModal .modal-footer #Close').click(function () {
            OperationDaysTxt = $('#OperationDaysTxt').val();
            var serviceItem = {};
            serviceItem.ServiceCode = "11101";
            serviceItem.ServiceName = "الاقامة";
            serviceItem.Details = OperationDaysTxt;
            serviceItem.Description = "Day";
            serviceList.push(serviceItem);
            $('#Subservice').val($('#Subservice').val() + OperationDaysTxt + " Days \n");
        });
    })

</script>
