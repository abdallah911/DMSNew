
@{
    ViewBag.Title = "Index";
}
<br />
<br />
@Html.Partial("_ApprovalsSearchCards")
<div class="editeRquest fw-bold portlet box green">
    <div class=" portlet-title">
        <div class="caption">
            <i class="fa fa-home me-3"></i>Approvals
        </div>

    </div>
    <div class="portlet-body">
        <br />
        <div class="row">
            <div class="d-flex gap-3 mt-4 ms-3 form-group">
                <div class="col-sm-3">
                    <input id="AddCardTxt" type="text" placeholder="Add Card" class="admin-form-control ps-2" value="@ViewBag.cardId" />
                </div>
                <div class="col-sm-3">
                    <button id="AddCard" class="btn rounded-3 text-white" data-toggle="modal" data-target="#exampleModal"> search</button>
                </div>

            </div>
        </div>
        <br />
        <br />
        <div style="white-space:nowrap" class="cs-bg w-100 m-auto px-4 my-4 pb-5">
            <div class="table-responsive">
                <table id="example" class="table table-striped mt-3 text-center">
                    <thead>
                        <tr>
                            <th scope="col">Approval Id</th>
                            <th scope="col">Id</th>
                            <th scope="col">Category</th>
                            <th scope="col" align="center">Name</th>
                            @*<th scope="col">Branch Id</th>*@
                            <th scope="col">Branch Name</th>
                            <th scope="col">Amount</th>
                            <th scope="col">Status</th>

                            <th scope="col">&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody></tbody>

                </table>
            </div>
        </div>
    </div>
    </div>
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/Scripts/DMS/DoctorRaysLabsMedicinesApproval.js?V=1"></script>
