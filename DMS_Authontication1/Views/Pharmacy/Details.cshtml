@model DMS_Authontication1.ViewModel.PharmacyAdmin.PharmacyAdminVm

@{
    ViewBag.Title = "Details";
}
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>
<script src="~/assets/HomeTemplete/Scripts/toastr.min.js"></script>
<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>
<div style="padding-left: 93px;">
    <h2>Details</h2>
    <p>
        <a id="Backbutton" href="/Pharmacy/index"><i class=" btn btn-primary glyphicon glyphicon-arrow-left">  Back</i> </a>

    </p>
    <table class="table">
        <tr>
            <th>
                @Html.DisplayName("MedicienCode")
            </th>
            <th>
                @Html.DisplayName("MedicienName")
            </th>
            <th>
                @Html.DisplayName("DOSAGE_FORM")
            </th>
            <th>
                @Html.DisplayName("PACK_PRICE")
            </th>
            <th>
                @Html.DisplayName("PACK_SIZE")
            </th>
            <th>
                @Html.DisplayName("UNIT_NO")
            </th>

            <th>
                @Html.DisplayName("UNIT_PRICE")
            </th>
            <th>
                @Html.DisplayName("Dose")
            </th>
            <th>
                @Html.DisplayName("Duration")
            </th>
            <th>
                @Html.DisplayName("TotalDuration")
            </th>
            <th>
                @Html.DisplayName("TotalUnits")
            </th>
            <th>
                @Html.DisplayName("Amount")
            </th>

            <th></th>
        </tr>

        @foreach (var item in Model.RoshDetsils)
        {
            <tr>

                <td>
                    @Html.DisplayFor(modelItem => item.MedicienCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MedicienName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DOSAGE_FORM)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PACK_PRICE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PACK_SIZE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UNIT_NO)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UNIT_PRICE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Dose)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Duration)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalDuration)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalUnits)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Amount)
                </td>
            </tr>
        }

    </table>
</div>

