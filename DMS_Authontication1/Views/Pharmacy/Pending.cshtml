@model DMS_Authontication1.Models.Notification
@{
    ViewBag.Title = "Pending";
}
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<div class="container">
    <div class="panel panel-info">
        <h2 class="panel-heading" style="margin:1px;">Pending</h2>
        <div class="panel-body">
            <input type="text" id="CardId" name="CardId" hidden value="@Model.Details" />
            @*<div class="input-group col-md-3">
                    <span class="input-group-addon"><i class="glyphicon glyphicon-search"></i></span>
                    <input id="txtSearchApproval" class="form-control" placeholder="Click To Search">
                </div>*@
            <table class="table" id="Index">
                <thead>
                    <tr>
                        <th scope="col" hidden>Medicine Id</th>
                        <th scope="col" align="center">Name</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Medical Reply</th>
                        <th scope="col">Dispense</th>
                        <th scope="col">Note</th>
                        <th></th>
                    </tr>

                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Roshita.RoshitaDetails.Count; i++)
                    {
                    <tr>
                        <td hidden>
                            @Model.Roshita.RoshitaDetails.ElementAt(i).Id
                        </td>
                        <td>
                            @Model.Roshita.RoshitaDetails.ElementAt(i).MedicienName
                        </td>
                        <td>
                            @Model.Roshita.RoshitaDetails.ElementAt(i).Amount
                        </td>
                        <td>
                            @Model.Roshita.RoshitaDetails.ElementAt(i).PaymentGroup
                        </td>
                        <td>
                            @Model.Roshita.RoshitaDetails.ElementAt(i).IsDealed
                        </td>
                        <td>
                            @Model.NotePharmacy
                        </td>
                        @if ((Model.Roshita.RoshitaDetails.ElementAt(i).PaymentGroup == "Accepted" || Model.Roshita.RoshitaDetails.ElementAt(i).PaymentGroup == "Rejected")
                             && Model.Roshita.RoshitaDetails.ElementAt(i).IsDealed == false)
                        {
                            <td>
                                <select id='ChangeStatus' class='form-control' onchange='SelectDealed(this);'>
                                    <option value='N'> Change IsDealed</option>
                                    <option value='true'>Yes</option>
                                    <option value='false'>No</option>
                                </select>
                            </td>
                        }
                        else
                        {
                            <td>
                                <select disabled id='ChangeStatus' class='form-control' onchange='SelectDealed(this);'>
                                    <option value='N'> Change IsDealed</option>
                                    <option value='true'>Yes</option>
                                    <option value='false'>No</option>
                                </select>
                            </td>
                        }

                    </tr>
                    }
                </tbody>
            </table>
            <div class="row">

                <div class="col-md-3">
                    <label class="control-label">Total Amount</label>
                    <input id="TotalAmount" disabled class="form-control col-md-3" />
                </div>
            </div>
            <br />
        </div>
    </div>
</div>
<script>
    var CardId = $('#CardId').val();
    var CompanyPayment;
    var AnuualLimit;
    $(function () {

        $("#Index").DataTable({
            "bPaginate": false,
            "bLengthChange": false,
            "bFilter": false,
            "bInfo": false,
            "bAutoWidth": false
        });

        $('#TotalAmount').val('0');
        $('#Cash').val('0')
        var companid = $('#CardId').val().split('-')[0];
        if (companid == "500118" || companid == "500119" || companid == "500120" || companid == "500121" || companid == "500122") {
            link = '/Pharmacy/CellingAmountAirPort';
        }
        else {
            link = '/Pharmacy/CellingAmount';
        }
        $.ajax({
            type: "POST",
            dataType: "json",
            url: link,
            data: {
                id: CardId,
                ServiceCode: '11601'
            },
            success: function (r) {
                if (r.Validation == false) {
                    // toastr.info("Exceeded his annual contract limit");
                    toastr.info(r.Message);
                    window.location.replace("/Pharmacy/Pharmacy");
                } else {
                    CompanyPayment = r.CeilingPert;
                    AnuualLimit = r.Limit;
                    //   $("#no_data_yet").val(100 - $("#ddEmp_CEILING_PERT").val());

                }
            },
            error: function (err) {
                alert("No Company Annual Amount");
                location.reload();
            }
        });
        $('#Print').click(function () {

            var PentingPrintViewModels = new Array();
            $('#Index TBODY TR').each(function () {
                var row = $(this);
                if (row.find("TD").eq(4).html() == "true" && row.find("TD").eq(5).html().search("disabled") == -1) {
                    var PentingPrintViewModel = {};
                    PentingPrintViewModel.Id = parseFloat(row.find("TD").eq(1).html());
                    PentingPrintViewModel.Amount = $('#TotalAmount').val();
                    PentingPrintViewModel.Cash = $('#Cash').val();
                    PentingPrintViewModels.push(PentingPrintViewModel);
                }
            });

            var params = JSON.stringify(PentingPrintViewModels);
            window.open('/Pharmacy/PendingReport?id=' + params);
        });
    });
    function SelectDealed(button) {
        var row = $(button).closest("TR");
        var MedicineId = $("TD", row).eq(0).html();
        MedicineId = parseInt(MedicineId);
        //debugger;
        $.ajax({
            type: 'POST',
            url: '/Pharmacy/ChangeStatus',
            dataType: 'Json',
            data: {
                MedicineId: MedicineId,
                status: $(button).val()
            },
            dataType: 'Json',
            success: function (r) {
                if ($(button).val() != "N" && r != -2) {
                    $("TD", row).eq(4).html($(button).val());
                    $("#ChangeStatus").prop('disabled', 'disabled');
                    //if ($(button).val() == "false") {
                    //    $("TD", row).eq(4).html('Accepted');
                    //}
                    toastr.success("Saved");
                    Calculation();

                } else if (r == -2) { toastr.info("Dispensed before"); }

            },
            error: function () {
                alert("Error Retrieve");
            }
        });


    }
    function Calculation() {
        var sum = 0;
        var Cash = 0;
        // debugger;
        $('#Index TBODY TR').each(function () {
            var row = $(this);
            if (row.find("TD").eq(4).html() == "true" && row.find("TD").eq(5).html().search("disabled") == -1) {
                if (row.find("TD").eq(3).html() == "Accepted") {
                    sum += parseFloat(row.find("TD").eq(2).html());
                }
                else if (row.find("TD").eq(3).html() == "Rejected") {
                    Cash += parseFloat(row.find("TD").eq(2).html());
                }
            }
        });
        var person = parseFloat(100 - CompanyPayment);//percentage
        Cash += parseFloat(sum * (person / 100));
        if (Cash > 0 || sum > 0)
            $('#Print').attr("disabled", false);
        else {
            $('#Print').attr("disabled", true);
        }
        $('#TotalAmount').val(sum);
        $('#Cash').val(Cash);
    }
</script>
