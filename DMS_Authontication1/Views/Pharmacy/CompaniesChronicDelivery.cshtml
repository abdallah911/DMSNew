
@{
    ViewBag.Title = "CompaniesChronicDelivery";
}
<style>
    .ui-datepicker-calendar {
        display: none;
    }
</style>
<div class=" dms-container ">
    <div class="portlet box ">
        <div class="portlet-title title-bg">
            <div class="caption">
                <i class="fa fa-gift"></i>Companies Chronic Search
            </div>
        </div>
        <div class="portlet-body">
            <div class="row row-cols-sm-2 row-cols-lg-3 d-flex g-2 mx-auto mt-3 ">
                <div class="forLabel">
                    @Html.DropDownList("ddlCompanies", null, "", htmlAttributes: new { @class = "form-control", @required = "true", @id = "ddlCompanies" })
                    <span>Company</span>
                </div>
                <div class="forLabel">
                    <input id="Date" required type="text" class="col-md-2 form-control " placeholder="" />
                    <span>Month</span>
                </div>
                <div class="forLabel" required data-step="6" data-intro="Select Preception type Default is Daily">
                    <select id="ddlGroups" class="form-control">
                        <option value=""></option>
                    </select>
                    <span>Select Group</span>
                </div>
                <div class="forLabel">
                    <input id="CardId" type="text" class="col-md-2 form-control " required placeholder="" />
                    <span>Card ID</span>
                </div>

            </div>
            <br />
            <div class="panel-footer d-flex justify-content-between justify-content-center justify-content-sm-end my-3 px-3 gap-2" style="text-align:right;">
                <input id="ResetSearch" type="button" value="Reset" onclick="ClearSearchData();" class="btn btn-warning" />
                <input id="Print" type="button" value="Print" class="btn btn-primary " />
                <input id="Search" type="button" value="Search" class="btn btn-default   " />
            </div>
        </div>
    </div>

    <div class="portlet box   ">
        <div class="portlet-title title-bg">
            <div class="caption">
                <i class="fa fa-gift"></i>Companies Chronic Medicines
            </div>

        </div>
        <br />
        <div class="portlet-body">

            <table class="ui celled table" id="Index" width="100%">
                <thead>
                    <tr>
                        <th scope="col">CardId</th>
                        <th scope="col">Company Group</th>
                        <th scope="col" align="center">Medicien Code</th>
                        <th scope="col" align="center">Name</th>
                        <th scope="col">Dosage</th>
                        <th scope="col">Package Size</th>
                        <th scope="col">Package Price</th>
                        <th scope="col">Unit Number</th>
                        <th scope="col">Unit Price</th>
                        <th scope="col">Dose</th>
                        <th scope="col">Duration</th>
                        <th scope="col">Total Duration</th>
                        <th scope="col">Total Units</th>
                        <th scope="col">Amount</th>
                        @*<th scope="col">Medicine Type</th>*@
                        <th scope="col">Month</th>
                        <th scope="col">Act</th>
                    </tr>
                </thead>
                <tbody></tbody>

            </table>
        </div>
    </div>

    <div class="portlet box   ">
        <div class="portlet-title title-bg">
            <div class="caption">
                <i class="fa fa-gift"></i>Count
            </div>
        </div>
        <div class="portlet-body">
            <table class="ui celled table" id="Counts" width="100%">
                <thead>
                    <tr>
                        <th>
                            Total Counts
                        </th>
                        <th>
                            Total Cards
                        </th>
                        <th>
                            Total Value
                        </th>


                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            0
                        </td>
                        <td>
                            0
                        </td>
                        <td>
                            0
                        </td>


                    </tr>
                </tbody>

            </table>
        </div>

    </div>
</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/CompaniesChronicDelivery.js?V=1"></script>

