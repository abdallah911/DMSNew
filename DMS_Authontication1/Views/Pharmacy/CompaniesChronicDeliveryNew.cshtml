
@{
    ViewBag.Title = "CompaniesChronicDelivery";
    Layout = "~/Views/Shared/_Layout_DashboardNew.cshtml";
}
<style>
    tr {
        text-align: center;
    }
</style>

<!-- start section -->
<div style="display: flex; flex-direction: column">
    <section style="min-height: 100vh;display: flex;flex-direction: column;flex-grow: 1;">
        <div class="sios-overlay container-fluid">
            <div class="container">
                <i class="fa-solid fa-house"></i>
                <h3>Companies Chronic Search</h3>
            </div>
        </div>

        <section>
            <form name="formValidation"
                  id="formValidation"
                  action="Pharmacy_Chronicdelivery.html">
                <div class="container chronic-search-section">
                    <div class="chronic-search-input row row-cols-sm-3 col-lg-8 m-auto m-sm-0">
                        <div class="forLabel">
                            @Html.DropDownList("ddlCompanies", null, null, htmlAttributes: new { @class = "chronic-form-control mb-3 ps-3", @id = "ddlCompanies" })
                            <span for="company-percent">Company</span>
                        </div>
                        <div class="forLabel">
                            <input class="chronic-form-control mb-3 ps-3"
                                   type="date" id="Date"
                                   name="prescription-date"
                                   required="required" />
                            <span for="prescription-date">End Date</span>
                        </div>
                        <div class="forLabel">
                            <select class="chronic-form-control mb-3 ps-3"
                                    name="Select Group" id="ddlGroups"
                                    required>
                                <option value="" style="font-weight: 800"></option>
                                <option value="" style="font-weight: 800"></option>
                            </select>
                            <span for="Select Group">Select Group</span>
                        </div>
                        <div class="forLabel">
                            <input class="chronic-form-control mb-3 ps-3"
                                   type="text" id="CardId"
                                   name="CardID"
                                   required="required" />
                            <span for="CardID">Card ID</span>
                        </div>
                    </div>
                    <div class="d-flex chronic-search-action mb-2">
                        <input id="ResetSearch" type="button" value="Reset" onclick="ClearSearchData();" class="reset-btn" />
                        <input id="Print" type="button" value="Print" class="print-btn ms-2" />
                        <input id="Search" type="button" value="Search" class="chronic-search-btn ms-2" />
                    </div>
                </div>
            </form>
        </section>
        <section id="chronicMedicinesSection">
            <div class="sios-overlay container-fluid">
                <div class="container">
                    <i class="fa-solid fa-house"></i>
                    <h3 class="">Companies Chronic Medicines</h3>
                </div>
            </div>

            <div class="chronic-section-select">
                @*<div id="searchAction"
