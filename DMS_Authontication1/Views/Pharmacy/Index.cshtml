@using Microsoft.AspNet.Identity;
@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var role = 1;
    if (User.IsInRole("Admin"))
    {
        role = 0;
        var modellist = new List<ModulesPagesViewModel>();
        var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
        if (claim != null)
        {
            modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
            if (modellist != null)
            {
                var obj = modellist.Where(x => x.ModuleName == "Pharmacies Management" && x.PageId == 4 && (x.FullControl || x.EditPermission
                                              || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
                if (obj != null)
                {
                    edit = obj.EditPermission;
                    delete = obj.ActivationControl;
                    view = obj.Preview;
                    fullcontroll = obj.FullControl;

                }
            }
        }

    }
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardAdminNew.cshtml";
}
<input id="role" value="@role.ToString()" hidden />
@if (!User.IsInRole("Admin"))
{
    <div class=" editeRquest fw-bold pt-4 portlet box  green">
        <div class="row bg-overlay portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa fa-gift"></i>Print Claims
            </div>
        </div>
        <div class="portlet-body">
            <div class="row">
                <div class="col-md-2">
                    <input id="From" type="text" class="chronic-form-control  ps-3 " placeholder="From" />
                </div>
                <div class="col-md-2">
                    <input id="To" type="text" class="chronic-form-control  ps-3 " placeholder="To" />
                </div>
                <div class="col-md-2">
                    <input id="PharmacyApprovalNo" type="text" class="chronic-form-control  ps-3 " placeholder="ApprovalNo" />
                </div>
                <div class="col-md-2">
                    <input id="PharmacyCardId" type="text" class="chronic-form-control  ps-3 " placeholder="Card ID" />
                </div>
                <div class="col-sm-2" data-step="6" data-intro="Select Preception type Default is Daily">
                    <select id="PharmacyddlType" class="form-control">
                        <option value="">Select Type</option>
                        <option value="Daily">Daily</option>
                        <option value="Monthly">Monthly</option>
                        <option value="Pharmacy_Chronic">Pharmacy_Chronic</option>
                        @*<option value="11604">Doctor</option>*@
                    </select>
                </div>
                @if (User.IsInRole("Pharmacy_Admin"))
                {
                    <div class="col-md-2">
                        @Html.DropDownList("ddlUsers", null, "All", htmlAttributes: new { @class = "form-control", @id = "ddlUsers" })
                    </div>
                }
            </div>
            
            <div class="row" style=" text-align:right">
                <div class="col-md-12">
                    <input id="PharmacyResetSearch" type="button" value="Reset" onclick="ClearPharmacySearchData();" class="btn btn-warning" />
                    <input id="Print" type="button" value="Print" class="btn btn-primary fa fa-file-pdf-o" />
                    @*<input id="PrintExcel" type="button" value="Excel" class="btn btn-success fa-file-excel-o " />*@
                    <input id="PharmacyAdminSearch" type="button" value="Search" class="btn btn-default  fa fa-search" />

                </div>
            </div>
        </div>
    </div>
}
@if (User.IsInRole("Admin") && (edit || delete || view || fullcontroll))
{

    <div class="  editeRquest fw-bold pt-4 portlet box  green">
        <div class="row bg-overlay portlet-title">
            <div class="m-3 fs-3 text-white caption">
                <i class="fa fa-gift me-3"></i>Admin Search
            </div>
        </div>
        <div class="container pt-4 portlet-body">
            <input id="edit" value="@edit.ToString()" hidden />
            <input id="delete" value="@delete.ToString()" hidden />
            <input id="view" value="@view.ToString()" hidden />
            <input id="fullcontroll" value="@fullcontroll.ToString()" hidden />

            <div class="row" style="padding-bottom: 15px;">
                <div class="col-md-2">
                    <input id="AdminFrom" type="text" class="chronic-form-control  ps-3 " placeholder="From" />
                </div>
