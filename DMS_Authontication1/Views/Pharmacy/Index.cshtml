@using Microsoft.AspNet.Identity;
@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var role = 1;
    if (User.IsInRole("Admin"))
    {
        role = 0;
        var modellist = new List<ModulesPagesViewModel>();
        var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
        if (claim != null)
        {
            modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
            if (modellist != null)
            {
                var obj = modellist.Where(x => x.ModuleName == "Pharmacies Management" && x.PageId == 4 && (x.FullControl || x.EditPermission
                                              || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
                if (obj != null)
                {
                    edit = obj.EditPermission;
                    delete = obj.ActivationControl;
                    view = obj.Preview;
                    fullcontroll = obj.FullControl;

                }
            }
        }

    }
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_DashboardPharmacy.cshtml";
}<div class="pharm-container">
    <input id="role" value="@role.ToString()" hidden />
    @if (!User.IsInRole("Admin"))
    {

        <div class=" portlet box  green">
            <div class="sios-overlay container-fluid my-4 portlet-title">
                <div class="container ms-0 fs-3 text-white caption">
                    <i class="fa-solid fa-home me-1"></i>Print Claims
                </div>
            </div>
            <div class="container portlet-body">
                <div class="row row-cols-sm-2 row-cols-lg-3 row-gap-2">
                    <div class="forLabel admin-form-control border-0 px-2 ">
                        <input id="From" type="text" class="admin-form-control w-100  ps-3 " placeholder="" required />
                        <span style="padding-left:12px;">From</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 ">
                        <input id="To" type="text" class="admin-form-control w-100  ps-3 " placeholder="" required />
                        <span style="padding-left:12px;">To</span> 
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 ">
                        <input id="PharmacyApprovalNo" type="text" class="admin-form-control w-100  ps-3 " placeholder="" required />
                        <span style="padding-left:12px;">ApprovalNo</span>

                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 ">
                        <input id="PharmacyCardId" type="text" class="admin-form-control w-100  ps-3 " placeholder="" required />
                        <span style="padding-left:12px;">Card ID</span>

                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 " data-step="6" data-intro="Select Preception type Default is Daily">
                        <select id="PharmacyddlType" class="admin-form-control w-100  ps-3 form-control" required>
                            <option value=""></option>
                            <option value="Daily">Daily</option>
                            <option value="Monthly">Monthly</option>
                            <option value="Pharmacy_admin">Pharmacy_admin</option>
                            @*<option value="11604">Doctor</option>*@
                        </select>
                        <span style="padding-left:12px;">Select Type</span> 
                    </div>
                    @if (User.IsInRole("Pharmacy_Admin"))
                    {
                        <div class="forLabel admin-form-control border-0 px-2 ">
                            @Html.DropDownList("ddlUsers", null, "All", htmlAttributes: new { @class = "form-control", @id = "ddlUsers" })
                        </div>
                    }
                    <div style=" text-align:right">
                        <input id="resetSearch" type="button" value="Reset" onclick="ClearSearchData();" class="btn fw-bold text-white rounded-3" />
                        <input id="PrintExcel" type="button" value="Excel" class="btn fw-bold text-white rounded-3 fa-file-excel-o " />
                        <input id="adminSearch" type="button" value="Search" class="btn fw-bold text-white rounded-3 " />
                    </div>
                </div>

              
            </div>
        </div>
    }
    @if (User.IsInRole("Admin") && (edit || delete || view || fullcontroll))
    {

        <div class="  editeRquest fw-bold pt-4 portlet box  green">
            <div class="row bg-overlay portlet-title">
                <div class="m-3 fs-3 text-white caption"> Admin Search
                </div>
            </div>
            <div class="container pt-4 portlet-body">
                <input id="edit" value="@edit.ToString()" hidden />
                <input id="delete" value="@delete.ToString()" hidden />
                <input id="view" value="@view.ToString()" hidden />
                <input id="fullcontroll" value="@fullcontroll.ToString()" hidden />

                <div class="row row-cols-sm-2 row-cols-lg-3 row-gap-2" style="padding-bottom: 15px;">
                    <div class="forLabel admin-form-control border-0 px-2 ">
                        <input id="AdminFrom" type="text" class="admin-form-control w-100  ps-3 " placeholder="" required />
                        <span style="padding-left:12px;">From</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 ">
                        <input id="Provider" type="text" class="admin-form-control w-100  ps-3 " placeholder="" required />
                        <span style="padding-left:12px;">Provider</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 ">
                        <input id="Company" type="text" class="admin-form-control w-100  ps-3 " placeholder="" required />
                        <span style="padding-left:12px;">Company</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 ">
                        <input id="ApprovalNo" type="text" class="admin-form-control w-100  ps-3 " placeholder="" required />
                        <span style="padding-left:12px;">ApprovalNo</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 ">
                        <input id="AdminTo" type="text" class="admin-form-control w-100  ps-3 " placeholder="" required />
                        <span style="padding-left:12px;">To</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 ">
                        <input id="Branch" type="text" class="admin-form-control w-100  ps-3 " placeholder="" required />
                        <span style="padding-left:12px;">Branch</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2 ">
                        <input id="CardId" type="text" class="admin-form-control w-100  ps-3 " placeholder="" required />
                        <span style="padding-left:12px;">Card ID</span>
                    </div>
                    <div class="forLabel admin-form-control border-0 px-2  " data-step="6" data-intro="Select Preception type Default is Daily">
                        <select style="height:40px;" id="ddlType" class="admin-form-control w-100  ps-3 form-control" required>
                            <option value=""></option>
                            <option value="Daily">Daily</option>
                            <option value="Monthly">Monthly</option>
                            <option value="Pharmacy_admin">Pharmacy_admin</option>
                            <option value="Pharmacy_Data">Pharmacy_Data</option>
                            @*<option value="11604">Doctor</option>*@
                        </select>
                        <span style="padding-left:12px;">Select Type</span>
                    </div>
                    <div style=" text-align:right">
                        <input id="resetSearch" type="button" value="Reset" onclick="ClearSearchData();" class="btn fw-bold text-white rounded-3" />
                        <input id="PrintExcel" type="button" value="Excel" class="btn fw-bold text-white rounded-3 fa-file-excel-o " />
                        <input id="adminSearch" type="button" value="Search" class="btn fw-bold text-white rounded-3 " />
                    </div>
                </div>

             
            </div>
        </div>
    }
    <div class="  editeRquest fw-bold py-4 portlet box  green">
        <div class="row bg-overlay portlet-title">
            <div class="m-3 fs-3 text-white caption"> Claims
            </div>

        </div>
        <div class="sios-bg container-fluid my-4">
            <div class="table-responsive mx-lg-5 portlet-body">
                <table class="table table-striped mt-3 text-center ui celled" id="Index" width="100%">
                    <thead>
                        <tr>

                            <th>
                                Approval No
                            </th>
                            <th>
                                Card Id
                            </th>
                            <th>
                                Company Percent
                            </th>
                            <th>
                                Total Value
                            </th>
                            <th>
                                Manager
                            </th>

                            <th>
                                CreatedBy
                            </th>

                            <th>
                                CreatedDate
                            </th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>

                </table>
            </div>
        </div>
    </div>
    @if (User.IsInRole("Admin") && fullcontroll)
    {
        <div class=" editeRquest fw-bold pt-4portlet box  green">
            <div class="row bg-overlay portlet-title">
                <div class="m-3 fs-3 text-white caption">
                    <i class="fa fa-gift me-3"></i>Admin Count
                </div>
            </div>
            <div class="cs-bg w-100 m-auto px-4 my-4 pb-5">
                <div class="table-responsive portlet-body">
                    <table class="table table-striped mt-3 text-center ui celled table" id="Counts" width="100%">
                        <thead>
                            <tr>
                                <th>
                                    Count
                                </th>
                                <th>
                                    Total Value
                                </th>
                                <th>
                                    Company Payment
                                </th>
                                <th>
                                    Person Payment
                                </th>
                                <th>
                                    Cash
                                </th>

                                <th>
                                    Over Insurance
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    0
                                </td>
                                <td>
                                    0
                                </td>
                                <td>
                                    0
                                </td>
                                <td>
                                    0
                                </td>
                                <td>
                                    0
                                </td>
                                <td>
                                    0
                                </td>

                            </tr>
                        </tbody>

                    </table>
                </div>
            </div>
        </div>

    }
</div>
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/PharmacyIndex.js?V=6.2"></script>