@using Microsoft.AspNet.Identity;
@using System.Security.Claims;
@using DMS_TEST.ViewModel;
@using Newtonsoft.Json;
@{
    var edit = false;
    var delete = false;
    var view = false;
    var fullcontroll = false;
    var role = 1;
    if (User.IsInRole("Admin"))
    {
        role = 0;
        var modellist = new List<ModulesPagesViewModel>();
        var claim = ((ClaimsIdentity)User.Identity).FindFirst("SomeClaimType");
        if (claim != null)
        {
            modellist = JsonConvert.DeserializeObject<List<ModulesPagesViewModel>>(claim.Value);
            if (modellist != null)
            {
                var obj = modellist.Where(x => x.ModuleName == "Pharmacies Management" && x.PageId == 4 && (x.FullControl || x.EditPermission
                                              || x.AddPermission || x.ActivationControl || x.Preview)).FirstOrDefault();
                if (obj != null)
                {
                    edit = obj.EditPermission;
                    delete = obj.ActivationControl;
                    view = obj.Preview;
                    fullcontroll = obj.FullControl;

                }
            }
        }

    }
    ViewBag.Title = "Index";
}
<div class="dms-container">
    <input id="role" value="@role.ToString()" hidden />
    @if (!User.IsInRole("Admin"))
    {
        <div class="portlet box  ">
            <div class="portlet-title title-bg">
                <div class="caption">
                    <i class="fa fa-"></i>Print Claims
                </div>
            </div>
            <div class="portlet-body">
                <div class="row row-cols-sm-2 row-cols-lg-3 d-flex g-2 mx-auto mt-3 ">
                    <div class="forLabel">
                        <input id="From" type="text"required  class="form-control " placeholder="" />
                        <span>From</span>
                    </div>
                    <div class="forLabel">
                        <input id="To" type="text" required class="form-control " placeholder="" />
                        <span>To</span>
                    </div>
                    <div class="forLabel">
                        <input id="PharmacyApprovalNo"required  type="text" class="form-control " placeholder="" />
                        <span>ApprovalNo</span>
                    </div>
                    <div class="forLabel">
                        <input id="PharmacyCardId"required  type="text" class="form-control " placeholder="" />
                        <span>Card ID</span>
                    </div>
                    <div class="forLabel" data-step="6" data-intro="Select Preception type Default is Daily">
                        <select id="PharmacyddlType"required class="form-control">
                            <option value=""></option>
                            <option value="Daily">Daily</option>
                            <option value="Monthly">Monthly</option>
                            <option value="Pharmacy_Chronic">Pharmacy_Chronic</option>
                            @*<option value="11604">Doctor</option>*@
                        </select>
                        <span>Select Type</span>
                    </div>
                    <div class="forLabel">
                        @Html.DropDownList("comphoder", null, htmlAttributes: new { @class = "form-control",@required="true", @id = "comphoder" })
                        <span>All</span>
                    </div>

                    @if (User.IsInRole("Pharmacy_Admin"))
                    {
                        <div class="forLabel">
                            @Html.DropDownList("ddlUsers", null, "", htmlAttributes: new { @class = "form-control", @required="true", @id = "ddlUsers" })
                            <span>All</span>
                        </div>
                    }
                </div>
                <br />
                <div class="panel-footer d-flex justify-content-between justify-content-center justify-content-sm-end my-3 px-3 gap-2" style="text-align:right;">
                    <input id="PharmacyResetSearch" type="button" value="Reset" onclick="ClearPharmacySearchData();" class="btn btn-warning" />
                    <input id="Print" type="button" value="Print" class="btn btn-primary " />
                    @*<input id="PrintExcel" type="button" value="Excel" class="btn btn-success fa-file-excel-o " />*@
                    <input id="PharmacyAdminSearch" type="button" value="Search" class="btn  " />
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole("Admin") && (edit || delete || view || fullcontroll))
    {

        <div class="portlet box ">
            <div class="portlet-title title-bg">
                <div class="caption fw-bold">
                    <i class="fa fa-"></i>Admin Search
                </div>
            </div>
            <div class="portlet-body">
                <input id="edit" value="@edit.ToString()" hidden />
                <input id="delete" value="@delete.ToString()" hidden />
                <input id="view" value="@view.ToString()" hidden />
                <input id="fullcontroll" value="@fullcontroll.ToString()" hidden />

                <div class="row row-cols-sm-2 row-cols-md-3 row-cols-lg-4 d-flex row-gap-2 mx-auto mb-2 ">
                    <div class="forLabel">
                        <input id="AdminFrom" type="text" class="form-control " placeholder="From" />
                    </div>
                    <div class="forLabel">
                        <input id="Provider" type="text" class="form-control " placeholder="Provider" />
                    </div>
                    <div class="forLabel">
                        <input id="Company" type="text" class="form-control " placeholder="Company" />
                    </div>
                    <div class="forLabel">
                        <input id="ApprovalNo" type="text" class="form-control " placeholder="ApprovalNo" />
                    </div>
                    <div class="forLabel">
                        @Html.DropDownList("comphoder", null, htmlAttributes: new { @class = "form-control", @id = "comphoder" })
                    </div>
                    <div class="forLabel">
                        <input id="AdminTo" type="text" class="form-control " placeholder="To" />
                    </div>
                    <div class="forLabel">
                        <input id="Branch" type="text" class="form-control " placeholder="Branch" />
                    </div>
                    <div class="forLabel">
                        <input id="CardId" type="text" class="form-control " placeholder="Card ID" />
                    </div>
                    <div class="forLabel" data-step="6" data-intro="Select Preception type Default is Daily">
                        <select id="ddlType" class="form-control">
                            <option value="">Select Type</option>
                            <option value="Daily">Daily</option>
                            <option value="Monthly">Monthly</option>
                            <option value="Pharmacy_Chronic">Pharmacy_Chronic</option>
                            <option value="Pharmacy_Data">Pharmacy_Data</option>
                            @*<option value="11604">Doctor</option>*@
                        </select>
                    </div>
                </div>
                <div style=" text-align:right">
                    <input id="resetSearch" type="button" value="Reset" onclick="ClearSearchData();" class="btn btn-warning" />
                    <input id="PrintExcel" type="button" value="Excel" class="btn btn-success fa-file-excel-o " />
                    <input id="adminSearch" type="button" value="Search" class="btn btn-primary fa fa-search" />
                </div>
            </div>
        </div>
    }
    <div class="portlet box  ">
        <div class="portlet-title title-bg">
            <div class="caption">
                <i class="fa fa-"></i>Claims
            </div>

        </div>
        <div class="portlet-body">

            <table class="ui celled table" id="Index" width="100%">
                <thead>
                    <tr>

                        <th>
                            Approval No
                        </th>
                        <th>
                            Card Id
                        </th>
                        <th>
                            Company Percent
                        </th>
                        <th>
                            Total Value
                        </th>
                        <th>
                            Manager
                        </th>

                        <th>
                            CreatedBy
                        </th>

                        <th>
                            CreatedDate
                        </th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>

            </table>
        </div>
    </div>
    @if (User.IsInRole("Admin") && fullcontroll)
    {
        <div class="portlet box   ">
            <div class="portlet-title title-bg">
                <div class="caption">
                    <i class="fa fa-"></i>Admin Count
                </div>
            </div>
            <div class="portlet-body">
                <table class="ui celled table" id="Counts" width="100%">
                    <thead>
                        <tr>
                            <th>
                                Count
                            </th>
                            <th>
                                Total Value
                            </th>
                            <th>
                                Company Payment
                            </th>
                            <th>
                                Person Payment
                            </th>
                            <th>
                                Cash
                            </th>

                            <th>
                                Over Insurance
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                0
                            </td>
                            <td>
                                0
                            </td>
                            <td>
                                0
                            </td>
                            <td>
                                0
                            </td>
                            <td>
                                0
                            </td>
                            <td>
                                0
                            </td>

                        </tr>
                    </tbody>

                </table>
            </div>

        </div>

    }
</div>
<br />
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/PharmacyIndex.js?V=6.2"></script>

