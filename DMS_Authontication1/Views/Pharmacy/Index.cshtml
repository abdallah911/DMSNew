                </div>

            </div>
            <div class="row">
                <div class="col-md-2">
                    <input id="AdminTo" type="text" class="chronic-form-control  ps-3 " placeholder="To" />
                </div>
                <div class="col-md-2">
                    <input id="Branch" type="text" class="chronic-form-control  ps-3 " placeholder="Branch" />
                </div>
                <div class="col-md-2">
                    <input id="CardId" type="text" class="chronic-form-control  ps-3 " placeholder="Card ID" />
                </div>
                <div class="col-sm-2" data-step="6" data-intro="Select Preception type Default is Daily">
                    <select style="height:40px;" id="ddlType" class="chronic-form-control  ps-3 form-control">
                        <option value="">Select Type</option>
                        <option value="Daily">Daily</option>
                        <option value="Monthly">Monthly</option>
                        <option value="Pharmacy_Chronic">Pharmacy_Chronic</option>
                        <option value="Pharmacy_Data">Pharmacy_Data</option>
                        @*<option value="11604">Doctor</option>*@
                    </select>
                </div>
            </div>
            <div style=" text-align:right">
                <input id="resetSearch" type="button" value="Reset" onclick="ClearSearchData();" class="btn fw-bold text-white rounded-3" />
                <input id="PrintExcel" type="button" value="Excel" class="btn fw-bold text-white rounded-3 fa-file-excel-o " />
                <input id="adminSearch" type="button" value="Search" class="btn fw-bold text-white rounded-3 fa fa-search" />
            </div>
        </div>
    </div>
}
