                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.compEmp.INS_START_DATE)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.compEmp.INS_END_DATE)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.compEmp.BIRTH_DATE)
                            </th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
