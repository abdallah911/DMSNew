@*@model List<DMS_Authontication1.Models.NewReport>*@

@{
    Layout = "~/Views/Shared/_Reports.cshtml";
}



<!-- Start Section -->
<form class="reports-form overflow-x-hidden" action="Reports.html">
    <div class="container">
        <div class="row  ">
            <div class="contract-sec-parent d-flex justify-content-end ">
                <div class="  col-12 col-sm-10 col-lg-11 ">
                    <div class=" ms-sm-auto">
                        <div class="contract-reports-box bg-secondary  mb-0  py-3 pe-3  rounded-2">
                            <div class="   m-auto rounded-1">
                                <select style="border: none;margin-right: 12%;"
                                        class="reports-box-field  reports-field w-50  home-2-field w-50 ms-auto "
                                        name=""
                                        id="TypeRepotLossRatio">
                                    <option value="">نوع التقارير</option>
                                    <option value="0">Loss Ratio Report</option>
                                    @*<option value="1">Order Without Print</option>
                                    <option value="2">Print Without Review</option>
                                    <option value="3">Print With Review</option>
                                    <option value="4">Print With Delivery</option>*@

                                </select>
                            </div>
                            <div class="reports-field home-2-field w-75 ms-auto mb-2">
                                <h6>الشركة</h6>
                                <div class="reports-input-parent">
                                    @*<select style="border: none;"
                        class="reports-select home-2-field    "
                        name=""
                        id="">
                    <option value="">من</option>
                </select>
                <select style="border: none;"
                        class="reports-select home-2-field    "
                        name=""
                        id="">
                    <option value="">الى</option>
                </select>*@

                                    @Html.DropDownList("CopmanyName", ViewBag.company as SelectList, "من", new { @class = "reports-select home-2-field", id = "CompFromLossRatio" })

                                    @Html.DropDownList("CopmanyName", ViewBag.company as SelectList, "الى", new { @class = "reports-select home-2-field", id = "CompToLossRatio" })

                                </div>
                            </div>
                            <div class="reports-field home-2-field w-75 ms-auto mb-2">
                                <h6>نوع الطباعة</h6>
                                <div class="reports-input-parent  ">
                                    <div style="    width: 100%; margin-left: 10px !important;"
                                         class="reports-select  d-flex align-items-center justify-content-center ">
                                        <div class="d-flex ms-4">
                                            <input class="ms-2"
                                                   id="excelLossRatio"
                                                   name="radio1"
                                                   type="radio" />
                                            <label for="radio1">Excel</label>
                                        </div>
                                        <div class="d-flex ">
                                            <input class="ms-2"
                                                   id="PdfLossRatio"
                                                   name="radio1"
                                                   type="radio" />
                                            <label for="radio2">pdf</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="action-btns w-25 mt-4 ">
                                <button type="button"
                                        class="d-flex align-items-center justify-content-center action-btn" onclick="PrintingLossRatio()">
                                    <i class="fa-solid fa-print me-2"></i>طباعة
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
<!-- End Section -->
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>
<script src="~/Scripts/DMS/NewReport.js?V=3.2"></script>