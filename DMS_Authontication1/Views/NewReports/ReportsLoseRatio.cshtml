@*@model List<DMS_Authontication1.Models.NewReport>*@

@{
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}

<div class="reports-container">
    <div class="sidebar-parent">
        <div class="sideBar">
            <div class="operation-btns">
                <a href="/NewReports/OperationReport">
                    <button class="sidebar-item " id="reportsOperation">
                        Operation
                    </button>
                </a>
                <br />
                <a href="/NewReports/ApprovalReports">
                    <button class="sidebar-item" id="reportsApproval">
                        Medical Approval
                    </button>
                </a>
                <a href="/NewReports/ReportsPrinting">
                    <button class="sidebar-item" id="reportsPrinting">
                        Printing
                    </button>
                </a>
                <br />
                <a href="/NewReports/ConsumptionReport">
                    <button class="sidebar-item" id="reportsConsumption">
                        Consumption
                    </button>
                </a>
                <a href="/NewReports/ReportsLoseRatio">
                    <button class="sidebar-item" id="reportsLoseRatio">
                        Lose Ratio
                    </button>
                </a>
                <a href="/NewReports/ReportsCustomerServices">
                    <button class="sidebar-item" id="reportsCustomerServices">
                        Customer Services
                    </button>
                </a>
                <a href="/NewReports/ReportsContract">
                    <button class="sidebar-item" id="reportsContract">
                        Contract
                    </button>
                </a>
                <a href="/NewReports/ReportsPharmacy">
                    <button class="sidebar-item" id="reportsPharmacy">
                        Pharmacy
                    </button>
                </a>
            </div>
        </div>
    </div>

    <!-- Start Section -->
    <form class="reports-form overflow-x-hidden" action="Reports.html">
        <div class="container">
            <div class="row  ">
                <div class="contract-sec-parent d-flex justify-content-start ">
                    <div class="  col-12 col-sm-10 col-lg-11 ">
                        <div class=" ms-sm-auto">
                            <div class="contract-reports-box bg-secondary  mb-0  py-3 pe-3  rounded-2" style="padding:16px !important">
                                <div class="   m-auto rounded-1">
                                    <select style="border: none; "
                                            class="reports-box-field  reports-field w-50  home-2-field w-50 ms-auto "
                                            name=""
                                            id="TypeRepotLossRatio">
                                        <option value="">نوع التقارير</option>
                                        <option value="0" dir="ltr">1- تقرير Loss Ratio</option>
                                        <option value="1" dir="ltr">2- الشركات من حيث المسؤول البيع (محفظة مكتملة) ملخص</option>
                                        <option value="2" dir="ltr">3- الشركات من حيث المسؤول البيع (محفظة مكتملة) مفصل</option>
                                        <option value="3" dir="ltr">4- الشركات من حيث المسؤول البيع (محفظة حالية) ملخص</option>
                                        <option value="4" dir="ltr">5- الشركات من حيث المسؤول البيع (محفظة حالية) مفصل</option>
                                        <option value="5" dir="ltr">6- الشركات من حيث المسؤول عن المتابعة بعد البيع (محفظة مكتملة) ملخص</option>
                                        <option value="6" dir="ltr">7- الشركات من حيث المسؤول عن المتابعة بعد البيع (محفظة مكتملة) مفصل</option>
                                        <option value="7" dir="ltr">8- الشركات من حيث المسؤول عن المتابعة بعد البيع (محفظة حالية) ملخص</option>
                                        <option value="8" dir="ltr">9- الشركات من حيث المسؤول عن المتابعة بعد البيع (محفظة حالية) مفصل</option>
                                        <option value="9" dir="ltr">10- الشركات الخسرانة</option>
                                        <option value="10" dir="ltr">11- الشركات الكسبانة</option>
                                        <option value="11" dir="ltr">12- أعلى 10 الشركات الخسرانة</option>
                                        <option value="12" dir="ltr">13- أعلى 10 الشركات الكسبانة</option>
                                        <option value="13" dir="ltr">14- تقرير مفصل عن الشركات حسب نسبة Loss Ratio</option>
                                        <option value="14" dir="ltr">15- شركات التجديد خلال الربع</option>
                                        <option value="15" dir="ltr">16- مقارنة لجميع الشركات بين المحفظة الحالية والمحفظة المكتملة</option>
                                        <option value="16" dir="ltr">17- مقارنة مفصلة (محفظة مكتملة)</option>
                                        <option value="17" dir="ltr">18- مقارنة مفصلة (محفظة حالية)</option>



                                        @*<option value="4" dir="ltr">2- الشركات من حيث المسؤول البيع (محفظة مكتملة)</option>*@

                                    </select>
                                </div>
                                <div class="reports-field home-2-field w-75 ms-auto mb-2">
                                    <h6>الشركة</h6>
                                    <div class="reports-select2-parent gap-2">
                                        @*<select style="border: none;"
                                                    class="reports-select home-2-field    "
                                                    name=""
                                                    id="">
                                                <option value="">من</option>
                                            </select>
                                            <select style="border: none;"
                                                    class="reports-select home-2-field    "
                                                    name=""
                                                    id="">
                                                <option value="">الى</option>
                                            </select>*@
                                        <div class="ps-0">

                                            @Html.DropDownList("CopmanyName", ViewBag.company as SelectList, "من", new { @style = "width:100% !important", @class = "reports-select home-2-field ms-0", id = "CompFromLossRatio" })
                                        </div>
                                        <div class="">

                                            @Html.DropDownList("CopmanyName", ViewBag.company as SelectList, "الى", new { @style = "width:100% !important", @class = "reports-select home-2-field ms-0", id = "CompToLossRatio" })
                                        </div>
                                    </div>
                                </div>
                                <div class="reports-field home-2-field w-75 ms-auto mb-2">
                                    <h6>نوع الطباعة</h6>
                                    <div class="reports-input-parent  ">
                                        <div style="    width: 100%; margin-left: 10px !important;"
                                             class="reports-select  d-flex align-items-center justify-content-center ">
                                            <div class="d-flex ms-4">
                                                <input class="ms-2"
                                                       id="excelLossRatio"
                                                       name="radio1"
                                                       type="radio" />
                                                <label for="excelLossRatio">Excel</label>
                                            </div>
                                            <div class="d-flex ">
                                                <input class="ms-2"
                                                       id="PdfLossRatio"
                                                       name="radio1"
                                                       type="radio" />
                                                <label for="PdfLossRatio">pdf</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="action-btns w-25 mt-4 me-auto ms-0 ">
                                    <button type="button"
                                            class="d-flex align-items-center justify-content-center action-btn" onclick="PrintingLossRatio()">
                                        <i class="fa-solid fa-print me-2"></i>طباعة
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div><!-- End Section -->
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script> 