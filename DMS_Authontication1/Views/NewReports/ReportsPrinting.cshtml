@*@model List<DMS_Authontication1.Models.NewReport>*@

@{
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}


<div class="reports-container">
    <div class="sidebar-parent">
        <div class="sideBar">
            <div class="operation-btns">
                <a href="/NewReports/OperationReport">
                    <button class="sidebar-item " id="reportsOperation">
                        Operation
                    </button>
                </a>
                <br />
                <a href="/NewReports/ApprovalReports">
                    <button class="sidebar-item" id="reportsApproval">
                        Medical Approval
                    </button>
                </a>
                <a href="/NewReports/ReportsPrinting">
                    <button class="sidebar-item" id="reportsPrinting">
                        Printing
                    </button>
                </a>
                <br />
                <a href="/NewReports/ConsumptionReport">
                    <button class="sidebar-item" id="reportsConsumption">
                        Consumption
                    </button>
                </a>
                <a href="/NewReports/ReportsLoseRatio">
                    <button class="sidebar-item" id="reportsLoseRatio">
                        Lose Ratio
                    </button>
                </a>
                <a href="/NewReports/ReportsCustomerServices">
                    <button class="sidebar-item" id="reportsCustomerServices">
                        Customer Services
                    </button>
                </a>
                <a href="/NewReports/ReportsContract">
                    <button class="sidebar-item" id="reportsContract">
                        Contract
                    </button>
                </a>
                <a href="/NewReports/ReportsPharmacy">
                    <button class="sidebar-item" id="reportsPharmacy">
                        Pharmacy
                    </button>
                </a>
            </div>
        </div>
    </div>

    <div class="portlet-title title-bg text-white fw-bold">
        <div class="caption">
            <i class="fa-solid fa-home"></i> Printing
        </div>
    </div>
    <!-- Start Section -->
    <form class="reports-form overflow-x-hidden" action="Reports.html">
        <div class="row ">
            <div class="Consumption-sec-parent  d-flex justify-content-center container-fluid ">
                <div class="Consumption-sec col-10 col-sm-8 col-lg-10 d-flex">
                    <div class=" m-auto w-100" >
                        <div style="margin-right:70px ;padding-bottom: 20px;"
                             class="consumption-reports-box w-100 bg-secondary pt-4 pe-3  rounded-2">
                            <div class="   m-auto rounded-1">
                                <select style="border: none; "
                                        class="reports-box-field  reports-field w-75  home-2-field   mx-auto "
                                        name=""
                                        id="TypeRepotPrint">
                                    <option value="">نوع التقارير</option>
                                    <option value="0">Transaction Without Print</option>
                                    <option value="1">Order Without Print</option>
                                    <option value="2">Print Without Review</option>
                                    <option value="3">Print With Review</option>
                                    <option value="4">Print With Delivery</option>

                                </select>
                            </div>
                            <div class="reports-field w-75 m-auto home-2-field mt-3">
                                <h6>تاريخ التسجيل</h6>
                                <div class="reports-input-parent">
                                    <input type="text"
                                           class="date-input reports-inp"
                                           placeholder="من" id="DateFrom" />
                                    <input type="text"
                                           class="date-input reports-inp"
                                           placeholder="الى" id="DateTo" />
                                </div>
                            </div>

                            <div class="reports-field w-75 m-auto home-2-field mt-3">
                                <h6>الشركة</h6>
                                <div class="reports-select2-parent gap-0">
                                    @*<select style="border: none;"
                                                class="reports-select     "
                                                name=""
                                                id="">
                                            <option value="">من</option>
                                        </select>
                                        <select style="border: none;"
                                                class="reports-select     "
                                                name=""
                                                id="">
                                            <option value="">الى</option>
                                        </select>*@
                                    <div>

                                        @Html.DropDownList("CopmanyName", ViewBag.company as SelectList, "من", new { @class = "reports-select home-2-field ", id = "CompFromPrint" })
                                    </div>
                                    <div>

                                        @Html.DropDownList("CopmanyName", ViewBag.company as SelectList, "الى", new { @class = "reports-select home-2-field ", id = "CompToPrint" })
                                    </div>
                                </div>
                            </div>
                            <div class="reports-field w-75 m-auto  home-2-field mt-3">
                                <h6>نوع الطباعة</h6>
                                <div class="reports-input-parent  ">
                                    <div style="    width: 100%; margin-left: 10px !important;"
                                         class="reports-select  d-flex align-items-center justify-content-center ">
                                        <div class="d-flex ms-4">
                                            <input class="ms-2"
                                                   id="excelPrint"
                                                   name="radio1"
                                                   type="radio" />
                                            <label for="excelPrint">اكسل</label>
                                        </div>
                                        <div class="d-flex ">
                                            <input class="ms-2"
                                                   id="PdfPrint"
                                                   name="radio1"
                                                   type="radio" />
                                            <label for="PdfPrint">pdf</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="action-btns-sec mt-auto col-4 ">
                                <div class="action-btns mt-3 ">
                                    <button type="button" class="action-btn fw-bold" onclick="NewPrint()">
                                        جديد
                                    </button>
                                    <button type="button" class="action-btn fw-bold" onclick="PrintingPrint()">
                                        طباعة
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div><!-- End Section -->
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>


<script src="~/Scripts/DMS/NewReport.js?V=3.2"></script> 