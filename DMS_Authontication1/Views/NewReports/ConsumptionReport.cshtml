    <!-- Start Section -->
    <form class="reports-form overflow-x-hidden" action="Reports.html">
        <div class="row ">
            <div class="Consumption-sec-parent  d-flex justify-content-center container-fluid ">
                <div class="Consumption-sec col-10 col-sm-8 col-lg-10 d-flex">
                    <div class=" m-auto w-100">
                        <div style=" "
                             class="consumption-reports-box w-100 bg-secondary pb-1 pt-4 pe-3  rounded-2">
                            <div class="   m-auto rounded-1">
                                <select style="border: none;"
                                        class="reports-box-field reports-field home-2-field w-50 ms-auto "
                                        id="RepotTypeConsum">
                                    <option value="">نوع التقارير</option>
                                    <option value="901">Report Details 901</option>
                                    <option value="9011">Report Claim 901-1</option>
                                    <option value="902">Top 20 employees in terms of Values (902)  </option>
                                    <option value="903">Top 20 employees in terms of Usage (903)</option>
                                    <option value="904">consumption per Provider with the highest according to values (904)</option>
                                    <option value="905">consumption per Provider with the highest according to Usage (905)</option>
                                    <option value="906">consumption per type of service according to values (906)</option>
                                    @*<option value="907">Consumption per type of service provider according to Usage (907)</option>*@
                                    <option value="908">Consumption per type of service according to values (908)</option>
                                    <option value="909">Consumption per type of service according to Usage (909)</option>
                                    <option value="910">Consumption per service according to values (910)</option>
                                    <option value="911">Consumption per service according to Usage (911)</option>
                                    <option value="912">Consumption according to the type of medical card (912) </option>
                                    <option value="913">Consumption according to the Month of service (913)</option>
                                    <option value="914">onsumption according to the Month of service  and type of service (914)</option>
                                    <option value="915">Consumption per Card (915)</option>
                                    <option value="916">Consumption per Card according to service Type (916)</option>
                                    <option value="917">Consumption per Card and type of service provider(917)</option>
                                    <option value="918">Consumption per Card and service (918)</option>
                                </select>
                            </div>
                            <div class="reports-field home-2-field">
                                <h6>تاريخ التسجيل</h6>
                                <div class="reports-input-parent">
                                    <input type="text"
                                           class="date-input reports-inp"
                                           placeholder="من" id="RegistrationFromConsum" />
                                    <input type="text"
                                           class="date-input reports-inp"
                                           placeholder="الى" id="RegistrationToConsum" />
                                </div>
                            </div>
                            <div class="reports-field home-2-field">
                                <h6>تاريخ الخدمة</h6>
                                <div class="reports-input-parent">
                                    <input type="text"
                                           class="date-input reports-inp"
                                           placeholder="من" id="ServiceFrom" />
                                    <input type="text"
                                           class="date-input reports-inp"
                                           placeholder="الى" id="ServiceTo" />
                                </div>
                            </div>
                            <div class="reports-field home-2-field">
                                <h6>رقم الشركة</h6>
                                <div class="reports-select2-parent">
                                    @*<select style="border: none;"
                                                class="reports-select home-2-field    "
                                                name=""
                                                id="">
                                            <option value="">من</option>
                                        </select>
                                        <select style="border: none;"
                                                class="reports-select home-2-field    "
                                                name=""
                                                id="">
                                            <option value="">الى</option>
                                        </select>*@
                                    <div>

                                        @Html.DropDownList("CopmanyName", ViewBag.company as SelectList, "من", new { @class = "reports-select home-2-field ", id = "CopmanyNumberFrom" })
                                    </div>
                                    <div>

                                        @Html.DropDownList("CopmanyName", ViewBag.company as SelectList, "الى", new { @class = "reports-select home-2-field ", id = "CopmanyNumberTo" })
                                    </div>

                                </div>
                            </div>
                            <div class="reports-field home-2-field">
                                <h6>كود الفئة</h6>
                                <div class="reports-input-parent">
                                    <select class="reports-inp w-100" name="" id="ClassCodeConsum">
                                        <option value="">Select Class</option>
                                    </select>
                                </div>
                            </div>

                            <div class="reports-field home-2-field">
                                <h6>رقم الكارت</h6>
                                <div class="reports-select2-parent">
                                    <div>
                                        <select style="border: none;"
                                                class="reports-select home-2-field    "
                                                name=""
                                                id="CardIdFrom">
                                            <option value="">من</option>
                                        </select>
                                    </div>

                                    <div>

                                        <select style="border: none;"
                                                class="reports-select home-2-field    "
                                                name=""
                                                id="CardIdTo">
                                            <option value="">الى</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
