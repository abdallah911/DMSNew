                                <div class="reports-input-parent  ">
                                    <div style="    width: 100%; margin-left: 10px !important;"
                                         class="reports-select  d-flex align-items-center justify-content-center ">
                                        <div class="d-flex ms-4">
                                            <input class="ms-2"
                                                   id="excelConsum"
                                                   name="radio1"
                                                   type="radio" />
                                            <label for="excelConsum">Excel</label>
                                        </div>
                                        <div class="d-flex ">
                                            <input class="ms-2"
                                                   id="PdfConsum"
                                                   name="radio1"
                                                   type="radio" />
                                            <label for="PdfConsum">pdf</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="action-btns-sec col-3">
                                <div class="action-btns  ">
                                    <button type="button" class="action-btn fw-bold" onclick="ConsumptionNew()">
                                        جديد
                                    </button>
                                    <button type="button" class="action-btn fw-bold" onclick="ConsumptionPrint()">
                                        طباعة
