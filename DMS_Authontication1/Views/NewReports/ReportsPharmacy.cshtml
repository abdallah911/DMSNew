                                    <button type="button" class=" d-flex align-items-center action-btn fw-bold" onclick="PrintReportMed()">
                                        طباعة
                                        <i class="fa-solid fa-print me-2"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="Pharmacy-form ">
