@*@model List<DMS_Authontication1.Models.NewReport>*@

@{
    Layout = "~/Views/Shared/_Reports.cshtml";
}




<!-- Start Section -->
<form style="direction: rtl;" class="reports-form overflow-hidden " action="Reports.html">
    <div class="container">
        <div class="row col-sm-10 col-md-10 ms-sm-auto">
            <div class="Pharmacy-form-parent  col-10 m-auto ms-sm-auto me-sm-0 col-sm-10  col-lg-6">
                <div class="Pharmacy-form">
                    <div class=" m-auto">
                        <div style="background-color: #d8d8d859 !important" class="reports-box  bg-secondary pb-1 pt-4 rounded-4">
                            <h3 class="me-3 fw-bold">أدوية مزمنة</h3>
                            <div class="reports-field">
                                <h6>تاريخ التسجيل</h6>
                                <div class="reports-input-parent">
                                    <input type="text" class="date-input reports-inp" placeholder="من" id="RegistrationFrom">
                                    <input type="text" class="date-input reports-inp" placeholder="الى" id="RegistrationTo">
                                </div>
                            </div>
                            @*<div class="reports-field">
                                    <h6>تاريخ التسجيل</h6>
                                    <div class="reports-input-parent">
                                        <select class="reports-select w-100 " name="" id="">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>*@
                            <div class="reports-field">
                                <h6>رقم الشركة</h6>
                                <div class="reports-input-parent">
                                    @*<select class="reports-select w-100 " name="" id="">
                                            <option value=""></option>
                                        </select>*@
                                    @Html.DropDownList("CopmanyName", ViewBag.company as SelectList, "Select Company", new { @class = "reports-select w-100", id = "CompNo" })

                                </div>
                            </div>
                            <div class="reports-field">
                                <h6>رقم الكارت</h6>
                                <div class="reports-input-parent">
                                    <select class="reports-select w-100" id="CardNo">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                            <div class="reports-field">
                                <h6>اسم المستخدم</h6>
                                <div class="reports-input-parent">
                                    @*<select class="reports-select w-100 " name="" id="">
                                            <option value=""></option>
                                        </select>*@
                                    @Html.DropDownList("userName", ViewBag.users as SelectList, "Select User", new { @class = "reports-select w-100", @id = "userName" })

                                </div>
                            </div>
                            <div class="reports-field">
                                <h6>Manager</h6>
                                <div class="reports-input-parent">
                                    @*<select class="reports-select w-100 " name="" id="">
                                            <option value=""></option>
                                        </select>*@
                                    <select id="TypeManager" class="reports-select w-100">
                                        <option value="All">All</option>
                                        <option value="Daily">Daily</option>
                                        <option value="Monthly">Monthly</option>
                                        <option value="Pharmacy_Chronic">Pharmacy_Chronic</option>
                                        <option value="Pharmacy_Doctor">Pharmacy_Doctor</option>


                                    </select>
                                </div>
                            </div>
                            <div class="reports-field">
                                <h6>كود الدواء</h6>
                                <div class="reports-input-parent">
                                    @*<select class="reports-select w-100 " name="" id="">
                                            <option value=""></option>
                                        </select>*@
                                    <select id="AddMedicine" class="reports-select w-100">
                                        <option value="">select medicine</option>
                                    </select>
                                </div>
                            </div>
                            <div class="reports-field">
                                <h6>نوع الحالة</h6>
                                <div class="reports-input-parent">
                                    @*<select class="reports-select w-100 " name="" id="">
                                            <option value=""></option>
                                        </select>*@
                                    <select id="Type" class="reports-select w-100">
                                        <option value="All">All</option>
                                        <option value="New">New</option>/option>
                                        <option value="Edit">Edit</option>
                                    </select>
                                </div>
                            </div>
                            <div class="reports-field">
                                <h6>نوع التقرير</h6>
                                <div class="reports-input-parent">
                                    @*<select class="reports-select w-100 " name="" id="">
                                            <option value=""></option>
                                        </select>*@
                                    <select id="RepotType" class="reports-select w-100">
                                        <option value="1">Report Edit Medicine Monthly</option>
                                        <option value="2">Medication dispensing details</option>/option>
                                        <option value="3">Online medication dispensing per card</option>
                                        <option value="4">Repeat Dispensing Medicine</option>

                                    </select>
                                </div>
                            </div>
                            <div class="reports-field">
                                <h6>نوع الطباعة</h6>
                                <div class="reports-input-parent  ">
                                    <div style="    width: 100%; margin-left: 10px !important;" class="reports-select  d-flex align-items-center justify-content-center ">
                                        <div class="d-flex ms-4">
                                            <input class="ms-2" id="excel" name="radio1" type="radio">
                                            <label for="excel">Excel</label>
                                        </div>
                                        <div class="d-flex ">
                                            <input class="ms-2" id="pdf" name="radio1" type="radio">
                                            <label for="pdf">pdf</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="action-btns-sec m-auto ms-0 col-6">
                                <div style="grid-template-columns: repeat(3, auto);" class="action-btns  ">
                                    <button type="button" class="action-btn fw-bold" onclick="ClearAll()">
                                        جديد
                                    </button>
                                    <button type="button" class=" d-flex align-items-center action-btn fw-bold" onclick="PrintReport()">
                                        طباعة
                                        <i class="fa-solid fa-print me-2"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="Pharmacy-form-parent  col-10 m-auto ms-sm-auto me-sm-0 col-sm-10  col-lg-6">
                <div class="Pharmacy-form ">
