                                    </select>
                                </div>
                            </div>
                            <div class="reports-field">
                                <h6>نوع الطباعة</h6>
                                <div class="reports-input-parent  ">
                                    <div style="    width: 100%; margin-left: 10px !important;" class="reports-select  d-flex align-items-center justify-content-center ">
                                        <div class="d-flex ms-4">
                                            <input class="ms-2" id="excelMed" name="radio2" type="radio">
                                            <label for="excelMed">Excel</label>
                                        </div>
                                        <div class="d-flex ">
                                            <input class="ms-2" id="pdfMed" name="radio2" type="radio">
                                            <label for="pdfMed">pdf</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="action-btns-sec m-auto ms-0 col-6">
                                <div style="grid-template-columns: repeat(3, auto);" class="action-btns  ">
                                    <button type="button" class="action-btn fw-bold" onclick="ClearAllMed()">
