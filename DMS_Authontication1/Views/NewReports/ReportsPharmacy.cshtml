                                    <input type="text" class="date-input reports-inp" placeholder="الى" id="RegistrationToMed">
                                </div>
                            </div>
                            <div class="reports-field">
                                <h6>رقم الشركة</h6>
                                <div class="reports-input-parent">
                                    @*<select class="reports-select w-100 " name="" id="">
