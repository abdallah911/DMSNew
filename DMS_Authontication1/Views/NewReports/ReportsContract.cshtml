@*@model List<DMS_Authontication1.Models.NewReport>*@

@{
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
}


<div class="reports-container">
    <div class="sidebar-parent">
        <div class="sideBar">
            <div class="operation-btns">
                <a href="/NewReports/OperationReport">
                    <button class="sidebar-item " id="reportsOperation">
                        Operation
                    </button>
                </a>
                <br />
                <a href="/NewReports/ApprovalReports">
                    <button class="sidebar-item" id="reportsApproval">
                        Medical Approval
                    </button>
                </a>
                <a href="/NewReports/ReportsPrinting">
                    <button class="sidebar-item" id="reportsPrinting">
                        Printing
                    </button>
                </a>
                <br />
                <a href="/NewReports/ConsumptionReport">
                    <button class="sidebar-item" id="reportsConsumption">
                        Consumption
                    </button>
                </a>
                <a href="/NewReports/ReportsLoseRatio">
                    <button class="sidebar-item" id="reportsLoseRatio">
                        Lose Ratio
                    </button>
                </a>
                <a href="/NewReports/ReportsCustomerServices">
                    <button class="sidebar-item" id="reportsCustomerServices">
                        Customer Services
                    </button>
                </a>
                <a href="/NewReports/ReportsContract">
                    <button class="sidebar-item" id="reportsContract">
                        Contract
                    </button>
                </a>
                <a href="/NewReports/ReportsPharmacy">
                    <button class="sidebar-item" id="reportsPharmacy">
                        Pharmacy
                    </button>
                </a>
            </div>
        </div>
    </div>
    <!-- Start Section -->
    <form class="reports-form overflow-x-hidden" action="Reports.html">
        <div class="container">
            <div class="row  ">
                <div class="contract-sec-parent d-flex justify-content-start ">
                    <div class="  col-12 col-sm-10 col-lg-11 ">
                        <div class=" ms-sm-auto">
                            <div class="contract-reports-box bg-secondary  mb-0  py-3 pe-3  rounded-2">
                                <div class="   m-auto rounded-1 pt-4">
                                    <select style="border: none; "
                                            class="reports-box-field  reports-field home-2-field w-50 ms-auto "
                                            name=""
                                            id="TypeRepotContract">
                                        <option value="">نوع التقارير</option>
                                        <option value="0" dir="ltr">201- طباعة شركات إنتهى التعاقد معها منذ 10 شهر</option>
                                        <option value="1" dir="ltr">202- طباعة شركات سينتهي التعاقد معها بعد شهرين</option>
                                    </select>
                                </div>
                                <div class="reports-field home-2-field w-75 ms-auto mb-2">
                                    <h6>نوع الطباعة</h6>
                                    <div class="reports-input-parent  ">
                                        <div style="    width: 100%; margin-left: 10px !important;"
                                             class="reports-select  d-flex align-items-center justify-content-center ">
                                            <div class="d-flex ms-4">
                                                <input class="ms-2"
                                                       id="excelContract"
                                                       name="radio1"
                                                       type="radio" />
                                                <label for="excelContract">Excel</label>
                                            </div>
                                            <div class="d-flex ">
                                                <input class="ms-2"
                                                       id="pdfContract"
                                                       name="radio1"
                                                       type="radio" />
                                                <label for="pdfContract">pdf</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="action-btns w-25 mt-4 ">
                                    <button type="button"
                                            class="d-flex align-items-center justify-content-center action-btn" onclick="ContractPrint()">
                                        <i class="fa-solid fa-print me-2"></i>طباعة
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div><!-- End Section -->
<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script> 