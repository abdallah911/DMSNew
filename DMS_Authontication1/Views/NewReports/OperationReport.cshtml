@*@model List<DMS_Authontication1.Models.NewReport>*@

@{
    Layout = "~/Views/Shared/_Reports.cshtml";
}
<script src="~/assets/HomeTemplete/scripts/jquery-3.0.0.js"></script>

<script src="~/assets/HomeTemplete/scripts/select2.min.js"></script>



<!-- Start Section -->
<form class="reports-form" action="Home.html">
    <div class="container d-flex justify-content-end">
        <div class="row col-sm-10 ">
            <div class="col-lg-10 m-md-auto ">
                <div>
                    <div class="reports-select-parent w-100 ">
                        <select style="height: 65px;border: none;"
                                class="first-reports-field operation-reports-field " id="TypeReport">
                            <option value="">انواع التقارير</option>
                            <option value="1-1">401 - 1 - إضافات</option>
                            <option value="1-2">401 - 2 - إلغاءات</option>
                            <option value="1-3">401 - 3 - تغير فئة</option>
                            <option value="1-4">401 - 4 - إعادة تفعيل</option>
                            <option value="1-5">401 - 5 - تغير اسم</option>
                            <option value="1-6">401 - 6 - Missing</option>
                            <option value="1-7">401 - 7 - بدل فاقد</option>
                            <option value="1-8">401 - 8 - تغير صورة</option>
                            <option value="1-9">401 - 9 - تغير فرع</option>
                            <option value="1-10">401 - 10 -تغير كود</option>
                            <option value="1-11">401 - 11 -تغير الكود والفئة</option>
                            <option value="2-1">402 - 1 - قائمة الموظفين المفعلين</option>
                            <option value="2-2">402 - 2 - قائمة الموظفين الموقوفين</option>
                            <option value="2-3">402 - 3 - قائمة الموظفين الموقوفين حد اقصى</option>
                            <option value="2-4">402 - 4 - قائمة الموظفين المفعلين شركة منتهية</option>
                            <option value="2-5">402 - 5 - قائمة الموظفين الموقوفين شركة منتهية</option>
                        </select>
                    </div>
                </div>
                <div class="operation-reports-field reports-field">
                    <h6>الشركة</h6>
                    <div class="reports-select-parent">

                        @Html.DropDownList("CopmanyName", ViewBag.company as SelectList, "من", new { @class = "select2 reports-select", id = "CopmanyNameReportsFrom" })

                        @Html.DropDownList("CopmanyName", ViewBag.company as SelectList, "الى", new { @class = "select2 reports-select", id = "CopmanyNameReportsTo" })

                    </div>
                </div>
                <div class="operation-reports-field reports-field">
                    <h6>تاريخ التسجيل</h6>
                    <div class="reports-input-parent">
                        <input id="RegistrationFrom" type="text"
                               class="date-input reports-inp"
                               placeholder="من" />
                        <input id="RegistrationTo" type="text"
                               class="date-input reports-inp"
                               placeholder="الى" />
                    </div>
                </div>
                <div class="operation-reports-field reports-field">
                    <h6>تاريخ التفعيل</h6>
                    <div class="reports-input-parent">
                        <input id="ActivationFrom" type="text"
                               class="date-input reports-inp"
                               placeholder="من" />
                        <input id="ActivationTo" type="text"
                               class="date-input reports-inp"
                               placeholder="الى" />
                    </div>
                </div>
                <div class="reports-field">
                    <h6>نوع الطباعة</h6>
                    <div class="reports-input-parent">
                        <div style="    width: 100%; margin-left: 10px !important;"
                             class="reports-select  d-flex align-items-center justify-content-center ">
                            <div class="d-flex ms-4">
                                <input class="ms-2"
                                       id="excel"
                                       name="radio1"
                                       type="radio" />
                                <label for="radio1">اكسل</label>
                            </div>
                            <div class="d-flex ">
                                <input class="ms-2"
                                       id="pdff"
                                       name="radio1"
                                       type="radio" />
                                <label for="radio2">pdf</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="action-btns-sec text-center mt-3 mt-lg-auto  mb-lg-0 ms-2 col-6  col-lg-3">
                    <div style="justify-content: center ;" class="action-btns  ">
                        <button type="button" class="action-btn" onclick="PrintReportTransaction()">
                            transaction
                        </button>
                        <button type="button" id="PrintReportsOperation" onclick="PrintReportOperation()"
                                class="d-flex align-items-center action-btn">
                            <i class="fa-solid fa-print me-2"></i>طباعة
                        </button>
                    </div>
                </div>

            </div>

            @*<div class="action-btns-sec text-center mt-3 mt-lg-auto  mb-lg-0 ms-2 col-6  col-lg-3">
                    <div style="justify-content: center ;" class="action-btns  ">
                        <button type="button" class="action-btn" onclick="PrintReportTransaction()">transaction</button>
                        <button id="PrintReportsOperation" type="button" class="action-btn" onclick="PrintReportOperation()">طباعة</button>
                    </div>
                </div>*@
            @*<div class="col-md-8">
                    <div class="form-group">
                        <label class="control-label sbold col-md-3">
                            Print Type :
                        </label>
                        <div class="col-md-2">
                            <div class="checkbox-inline">
                                <input type="checkbox" id="pdf" name="pdf" value="pdf" data-name="pdf">
                                <label for="pdf">
                                    PDF
                                </label>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="checkbox-inline">
                                <input type="checkbox" id="excel" name="excel" value="excel" data-name="excel">
                                <label for="excel">
                                    EXCEL
                                </label>
                            </div>
                        </div>
                    </div>
                    <br />
                </div>*@
        </div>
    </div>
</form>
<!-- End Section -->
@*<script src="~/assets/HomeTemplete/Scripts/jquery-3.0.0.min.js"></script>*@

